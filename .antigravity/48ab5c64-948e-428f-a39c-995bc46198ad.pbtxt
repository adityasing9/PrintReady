    command_line: "set -eu\nVALID_SIG=$(node -e \"const fs=require(\'fs\'),c=require(\'crypto\'); const m=fs.readFileSync(\'.env\',\'utf8\').match(/^RAZORPAY_KEY_SECRET=(.*)$/m); process.stdout.write(c.createHmac(\'sha256\', m[1].trim()).update(\'order_test123|pay_test456\').digest(\'hex\'));\")\necho \"=== Verify Payment Valid HMAC-SHA256 Signature (expect 200) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"razorpay_order_id\\\":\\\"order_test123\\\",\\\"razorpay_payment_id\\\":\\\"pay_test456\\\",\\\"razorpay_signature\\\":\\\"$VALID_SIG\\\"}\"\n\necho \"=== Confirm KEY_SECRET is absent from client bundle & source ===\"\nif grep -rn \"8rddLLnuZ62rlykDcI3Wa45m\" src/ dist/ index.html server.ts server/ 2>/dev/null; then\n  echo \"LEAK FOUND!\"\n  exit 1\nelse\n  echo \"OK: RAZORPAY_KEY_SECRET not hardcoded in source or present in client bundle.\"\nfi\n"
