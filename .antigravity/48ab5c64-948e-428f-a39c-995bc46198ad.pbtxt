\": \\\"number\\\" },\\n        \\\"isOpen\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"pickupAvailable\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"deliveryAvailable\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"deliveryFee\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"turnaroundMinutes\\\": { \\\"type\\\": \\\"integer\\\" },\\n        \\\"verificationStatus\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"pending\\\", \\\"verified\\\", \\\"rejected\\\", \\\"suspended\\\"] },\\n        \\\"rating\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"reviewCount\\\": { \\\"type\\\": \\\"integer\\\" },\\n        \\\"services\\\": { \\\"type\\\": \\\"array\\\" },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"ownerId\\\", \\\"name\\\", \\\"address\\\", \\\"city\\\", \\\"isOpen\\\", \\\"pickupAvailable\\\", \\\"deliveryAvailable\\\", \\\"verificationStatus\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"ShopInventoryItem\\\": {\\n      \\\"title\\\": \\\"ShopInventoryItem\\\",\\n      \\\"description\\\": \\\"Printing supply stock item belonging to a shop.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"shopId\\\": { \\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"name\\\": { \\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"maxLength\\\": 100 },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"paper\\\", \\\"ink\\\", \\\"toner\\\", \\\"photo_paper\\\", \\\"binding\\\", \\\"lamination\\\", \\\"other\\\"] },\\n        \\\"quantity\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"unit\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"re