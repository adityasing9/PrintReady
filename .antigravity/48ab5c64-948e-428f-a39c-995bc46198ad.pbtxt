  view_file {
    absolute_path_uri: "file:///server.ts"
    end_line: 74
    content: "import \'dotenv/config\';\nimport crypto from \'node:crypto\';\nimport fs from \'node:fs\';\nimport path from \'node:path\';\nimport express from \'express\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\n\nconst PORT = Number(process.env.PORT || 3000);\nconst isProduction = process.env.NODE_ENV === \'production\';\n\n// Sliding-window in-memory rate limiter for API routes\nconst rateBuckets = new Map<string, { count: number; resetAt: number }>();\nfunction apiRateLimiter(req: express.Request, res: express.Response, next: express.NextFunction) {\n  const key = req.ip || \'local\';\n  const now = Date.now();\n  const bucket = rateBuckets.get(key);\n  if (!bucket || now > bucket.resetAt) {\n    rateBuckets.set(key, { count: 1, resetAt: now + 60_000 });\n    return next();\n  }\n  if (bucket.count >= 90) {\n    return res.status(429).json({ error: \'Too many requests. Please wait a minute and retry.\' });\n  }\n  bucket.count += 1;\n  return next();\n}\n\nfunction getGeminiClient(): GoogleGenAI {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey || apiKey === \'MY_GEMINI_API_KEY\') {\n    throw new Error(\'GEMINI_API_KEY is not configured on the server.\');\n  }\n  return new GoogleGenAI({\n    apiKey,\n    httpOptions: {\n      headers: {\n        \'User-Agent\': \'aistudio-build\',\n      },\n    },\n  });\n}\n\n// Server-side idempotency & sandbox payment intent registry\ninterface PaymentRecord {\n  intentId: string;\n  orderId: string;\n  orderNumber: string;\n  amount: number;\n  currency: string;\n  method: string;\n  mode: \'razorpay_live\' | \'server_sandbox\';\n  status: \'initiated\' | \'verified\' | \'refunded\';\n  transactionId?: string;\n  serverSignature: string;\n  createdAt: string;\n  verifiedAt?: string;\n}\nconst paymentStore = new Map<string, PaymentRecord>();\nconst PAYMENT_HMAC_SECRET = process.env.RAZORPAY_KEY_SECRET || \'printready-dev-sandbox-hmac-key\';\n\nfunction signPaymentPayload(intentId: string, orderId: string, amount: number): string {\n  return crypto\n    .createHmac(\'sha256\', PAYMENT_HMAC_SECRET)\n    .update(`${intentId}|${orderId}|${amount.toFixed(2)}`)\n    .digest(\'hex\');\n}\n\nasync function createServer() {\n  const app = express();\n  app.use(express.json({ limit: \'15mb\' }));\n  app.use(\'/api\', apiRateLimiter);\n\n  // 1. Honest Integration Health & Readiness Endpoint\n  app.get(\'/api/integrations/status\', (_req, res) => {\n    const hasGemini = Boolean(process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \'MY_GEMINI_API_KEY\');"
    num_lines: 485
    num_bytes: 18259
    line_range_bytes: 2429
  }
}
