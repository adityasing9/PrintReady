      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update package.json dev and start scripts to run Express server via tsx/node\", \"EndLine\":12, \"Instruction\":\"Update dev and start scripts in package.json for full-stack Express + Vite server\", \"ReplacementContent\":\"  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"tsx server.ts\\\",\\n    \\\"start\\\": \\\"node server.ts\\\",\\n    \\\"build\\\": \\\"vite build\\\",\\n    \\\"preview\\\": \\\"vite preview\\\",\\n    \\\"clean\\\": \\\"rm -rf dist server.js\\\",\\n    \\\"lint\\\": \\\"tsc --noEmit\\\",\\n    \\\"lint:rules\\\": \\\"eslint firestore.rules DRAFT_firestore.rules\\\",\\n    \\\"test\\\": \\\"tsx --test src/domain/*.test.ts\\\"\\n  },\", \"StartLine\":6, \"TargetContent\":\"  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"vite --port=3000 --host=0.0.0.0\\\",\\n    \\\"build\\\": \\\"vite build\\\",\\n    \\\"preview\\\": \\\"vite preview\\\",\\n    \\\"clean\\\": \\\"rm -rf dist server.js\\\",\\n    \\\"lint\\\": \\\"tsc --noEmit\\\"\\n  },\", \"TargetFile\":\"/package.json\", \"toolAction\":\"Updating package.json scripts\", \"toolSummary\":\"Update package.json scripts\"}"
