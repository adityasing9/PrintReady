            }
            lines {
              text: "export function roundCurrency(value: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.round(value * 100) / 100;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
