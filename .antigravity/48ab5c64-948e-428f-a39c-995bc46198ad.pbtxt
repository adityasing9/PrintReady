              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Copy,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Download,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Eye,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
