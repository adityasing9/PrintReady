  view_file {
    absolute_path_uri: "file:///server.ts"
    end_line: 498
    content: "import \'dotenv/config\';\nimport crypto from \'node:crypto\';\nimport fs from \'node:fs\';\nimport path from \'node:path\';\nimport express from \'express\';\nimport Razorpay from \'razorpay\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport { validateRazorpayOrderAmount, verifyRazorpaySignature } from \'./server/razorpay.ts\';\n\nconst PORT = Number(process.env.PORT || 3000);\nconst isProduction = process.env.NODE_ENV === \'production\';\n\n// Sliding-window in-memory rate limiter for API routes\nconst rateBuckets = new Map<string, { count: number; resetAt: number }>();\nfunction apiRateLimiter(req: express.Request, res: express.Response, next: express.NextFunction) {\n  const key = req.ip || \'local\';\n  const now = Date.now();\n  const bucket = rateBuckets.get(key);\n  if (!bucket || now > bucket.resetAt) {\n    rateBuckets.set(key, { count: 1, resetAt: now + 60_000 });\n    return next();\n  }\n  if (bucket.count >= 90) {\n    return res.status(429).json({ error: \'Too many requests. Please wait a minute and retry.\' });\n  }\n  bucket.count += 1;\n  return next();\n}\n\nfunction getGeminiClient(): GoogleGenAI {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey || apiKey === \'MY_GEMINI_API_KEY\') {\n    throw new Error(\'GEMINI_API_KEY is not configured on the server.\');\n  }\n  return new GoogleGenAI({\n    apiKey,\n    httpOptions: {\n      headers: {\n        \'User-Agent\': \'aistudio-build\',\n      },\n    },\n  });\n}\n\n// Server-side verified Razorpay payment registry (idempotency & audit tracking)\ninterface VerifiedRazorpayRecord {\n  razorpay_order_id: string;\n  razorpay_payment_id: string;\n  verifiedAt: string;\n  mode: \'razorpay_test\' | \'razorpay_live\';\n}\nconst verifiedRazorpayPayments = new Map<string, VerifiedRazorpayRecord>();\n\nfunction getRazorpayClient(): { client: Razorpay; keyId: string; keySecret: string } {\n  const keyId = process.env.RAZORPAY_KEY_ID?.trim() || \'\';\n  const keySecret = process.env.RAZORPAY_KEY_SECRET?.trim() || \'\';\n  if (!keyId || !keySecret) {\n    const err = new Error(\'Razorpay credentials are not configured on the server.\');\n    (err as Error & { statusCode?: number }).statusCode = 401;\n    throw err;\n  }\n  return {\n    client: new Razorpay({ key_id: keyId, key_secret: keySecret }),\n    keyId,\n    keySecret,\n  };\n}\n\nasync function createServer() {\n  const app = express();\n  app.use(express.json({ limit: \'15mb\' }));\n  app.use(\'/api\', apiRateLimiter);\n\n  // 1. Honest Integration Health & Readiness Endpoint\n  app.get(\'/api/integrations/status\', (_req, res) => {\n    const hasGemini = Boolean(process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \'MY_GEMINI_API_KEY\');\n    const razorpayKeyId = process.env.RAZORPAY_KEY_ID?.trim() || \'\';\n    const hasRazorpay = Boolean(razorpayKeyId && process.env.RAZORPAY_KEY_SECRET?.trim());\n    const isTestRazorpay = razorpayKeyId.startsWith(\'rzp_test_\');\n    const hasEmail = Boolean(process.env.EMAIL_SMTP_HOST && process.env.EMAIL_SMTP_USER);\n    const hasWhatsAppCloud = Boolean(process.env.WHATSAPP_ACCESS_TOKEN && process.env.WHATSAPP_PHONE_NUMBER_ID);\n\n    res.json({\n      geminiAi: { configured: hasGemini, model: \'gemini-4-hydrogen\' },\n      firebase: { configured: true, mode: \'client_sdk_firestore\' },\n      payments: {\n        provider: \'razorpay\',\n        liveConfigured: hasRazorpay,\n        mode: !hasRazorpay ? \'unconfigured\' : isTestRazorpay ? \'razorpay_test\' : \'razorpay_live\',\n        note: !hasRazorpay\n          ? \'Configure RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET in .env to enable Razorpay Standard Checkout.\'\n          : isTestRazorpay\n          ? \'Razorpay Standard Checkout active in Test Mode (rzp_test_*).\'\n          : \'Razorpay Standard Checkout active in Live Mode.\',\n      },\n      email: {\n        configured: hasEmail,\n        fallback: \'mailto_composer\',\n      },\n      whatsapp: {\n        cloudApiConfigured: hasWhatsAppCloud,\n        directShareSupported: true,\n        note: \'Direct WhatsApp & Web Share API open user confirmation flow; official Cloud API requires business approval.\',\n      },\n    });\n  });\n\n  // 2. AI Document Classification & OCR via Server-Side Gemini\n  app.post(\'/api/ai/classify\', async (req, res) => {\n    try {\n      const { fileName, textSnippet, imageBase64, mimeType } = req.body as {\n        fileName?: string;\n        textSnippet?: string;\n        imageBase64?: string;\n        mimeType?: string;\n      };\n      if (!fileName) {\n        return res.status(400).json({ error: \'fileName is required.\' });\n      }\n\n      const ai = getGeminiClient();\n      const parts: Array<{ text?: string; inlineData?: { mimeType: string; data: string } }> = [];\n\n      if (imageBase64 && mimeType && mimeType.startsWith(\'image/\')) {\n        const cleaned = imageBase64.includes(\',\') ? imageBase64.split(\',\')[1] : imageBase64;\n        parts.push({\n          inlineData: {\n            mimeType,\n            data: cleaned,\n          },\n        });\n      }\n\n      parts.push({\n        text:\n          `Analyze this document for the PrintReady document wallet.\\n` +\n          `Filename: ${fileName}\\n` +\n          (textSnippet ? `Extracted text / notes: ${textSnippet.slice(0, 4000)}\\n` : \'\') +\n          `Classify its document type, suggest a crisp title, category, folder name, up to 5 concise tags, ` +\n          `an expiryDate (YYYY-MM-DD if applicable such as ID/Passport/License/Certificate, otherwise empty string), ` +\n          `a 1-2 sentence summary, and any OCR text visible in the image (or empty string if no image was provided).`,\n      });\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: { parts },\n        config: {\n          systemInstruction:\n            \'You are the PrintReady Document Intelligence engine. Return accurate, concise structured JSON metadata for document organization and printing.\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              documentType: { type: Type.STRING },\n              suggestedTitle: { type: Type.STRING },\n              category: { type: Type.STRING },\n              suggestedFolder: { type: Type.STRING },\n              tags: { type: Type.ARRAY, items: { type: Type.STRING } },\n              expiryDate: { type: Type.STRING },\n              summary: { type: Type.STRING },\n              ocrText: { type: Type.STRING },\n              recommendedColorMode: { type: Type.STRING },\n              recommendedSides: { type: Type.STRING },\n            },\n          },\n        },\n      });\n\n      const parsed = JSON.parse((response.text ?? \'{}\').trim());\n      return res.json({ ...parsed, provider: \'gemini\' });\n    } catch (error) {\n      const msg = error instanceof Error ? error.message : \'AI classification unavailable\';\n      console.warn(\'[AI Classify Fallback]\', msg);\n      const { fileName = \'Document\', textSnippet = \'\' } = req.body as { fileName?: string; textSnippet?: string };\n      const lower = `${fileName} ${textSnippet}`.toLowerCase();\n      const category = lower.includes(\'resume\') || lower.includes(\'cv\')\n        ? \'Resume\'\n        : lower.includes(\'passport\') || lower.includes(\'aadhaar\') || lower.includes(\'id\')\n        ? \'Identity\'\n        : lower.includes(\'bank\') || lower.includes(\'invoice\') || lower.includes(\'receipt\')\n        ? \'Banking\'\n        : lower.includes(\'report\') || lower.includes(\'notes\') || lower.includes(\'semester\') || lower.includes(\'lab\')\n        ? \'College\'\n        : \'Personal\';\n      const suggestedFolder =\n        category === \'Resume\'\n          ? \'Resumes & Career\'\n          : category === \'Identity\'\n          ? \'Identity & KYC\'\n          : category === \'Banking\'\n          ? \'Banking & Invoices\'\n          : category === \'College\'\n          ? \'Semester 7 Coursework\'\n          : \'General Vault\';\n      const cleanBase = fileName.replace(/\\.[^.]+$/, \'\').replace(/[_-]+/g, \' \').trim();\n      return res.json({\n        documentType: category,\n        suggestedTitle: cleanBase || fileName,\n        category,\n        suggestedFolder,\n        tags: [category.toLowerCase(), \'print-ready\', \'indexed\'],\n        expiryDate: \'\',\n        summary: `Indexed ${fileName} under ${category} for print preparation and quick search.`,\n        ocrText: textSnippet || `Indexed document: ${cleanBase || fileName}. Ready for printing.`,\n        recommendedColorMode: category === \'Identity\' || category === \'Resume\' ? \'color\' : \'bw\',\n        recommendedSides: category === \'College\' ? \'double\' : \'single\',\n        provider: \'heuristic\',\n      });\n    }\n  });\n\n  // 3. AI Natural-Language Vault Search via Server-Side Gemini\n  app.post(\'/api/ai/search\', async (req, res) => {\n    try {\n      const { query, documents } = req.body as {\n        query?: string;\n        documents?: Array<{\n          id: string;\n          name: string;\n          category: string;\n          tags: string[];\n          ocrText: string;\n          summary: string;\n          createdAt: string;\n        }>;\n      };\n\n      if (!query || !Array.isArray(documents)) {\n        return res.status(400).json({ error: \'query and documents array are required.\' });\n      }\n\n      const ai = getGeminiClient();\n      const catalog = documents.slice(0, 60).map((d) => ({\n        id: d.id,\n        name: d.name,\n        category: d.category,\n        tags: d.tags,\n        summary: d.summary,\n        ocrSnippet: (d.ocrText || \'\').slice(0, 300),\n        createdAt: d.createdAt,\n      }));\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: `User natural-language query: \"${query}\"\\n\\nVault documents:\\n${JSON.stringify(catalog)}`,\n        config: {\n          systemInstruction:\n            \'You are a precise document search ranker. Return the IDs of matching documents ordered by relevance and a brief 1-sentence explanation.\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              matchedIds: { type: Type.ARRAY, items: { type: Type.STRING } },\n              explanation: { type: Type.STRING },\n            },\n          },\n        },\n      });\n\n      const parsed = JSON.parse((response.text ?? \'{\"matchedIds\":[],\"explanation\":\"\"}\').trim());\n      return res.json({ ...parsed, provider: \'gemini\' });\n    } catch (error) {\n      const msg = error instanceof Error ? error.message : \'AI search unavailable\';\n      console.warn(\'[AI Search Fallback]\', msg);\n      const { query = \'\', documents = [] } = req.body as {\n        query?: string;\n        documents?: Array<{ id: string; name: string; category: string; tags?: string[]; ocrText?: string; summary?: string }>;\n      };\n      const tokens = query.toLowerCase().split(/\\s+/).filter((t) => t.length > 1);\n      const matchedIds = documents\n        .filter((d) => {\n          const hay = `${d.name} ${d.category} ${(d.tags || []).join(\' \')} ${d.ocrText || \'\'} ${d.summary || \'\'}`.toLowerCase();\n          return tokens.some((t) => hay.includes(t));\n        })\n        .map((d) => d.id);\n      return res.json({\n        matchedIds,\n        explanation: `Matched ${matchedIds.length} document(s) locally across filenames, tags, and indexed text.`,\n        provider: \'heuristic\',\n      });\n    }\n  });\n\n  // 4. AI Document Summarizer & Smart Print Advisor\n  app.post(\'/api/ai/summarize\', async (req, res) => {\n    try {\n      const { fileName, textContent, pageCount } = req.body as {\n        fileName?: string;\n        textContent?: string;\n        pageCount?: number;\n      };\n      if (!fileName) {\n        return res.status(400).json({ error: \'fileName is required.\' });\n      }\n\n      const ai = getGeminiClient();\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: `Document: ${fileName} (${pageCount || 1} pages)\\nContent:\\n${(textContent || \'No extracted text available.\').slice(0, 5000)}`,\n        config: {\n          systemInstruction:\n            \'Summarize the document concisely in 2-3 sentences, list 3 key points, and suggest optimal print configuration (paper size, B&W vs color, single vs double-sided, binding).\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              summary: { type: Type.STRING },\n              keyPoints: { type: Type.ARRAY, items: { type: Type.STRING } },\n              recommendedSettingsNote: { type: Type.STRING },\n            },\n          },\n        },\n      });\n\n      const parsed = JSON.parse((response.text ?? \'{}\').trim());\n      return res.json({ ...parsed, provider: \'gemini\' });\n    } catch (error) {\n      const msg = error instanceof Error ? error.message : \'AI summarization unavailable\';\n      console.warn(\'[AI Summarize Fallback]\', msg);\n      const { fileName = \'Document\', pageCount = 1 } = req.body as { fileName?: string; pageCount?: number };\n      const isLong = pageCount >= 8;\n      return res.json({\n        summary: `${fileName} (${pageCount} page${pageCount === 1 ? \'\' : \'s\'}) is prepared in your PrintReady vault.`,\n        keyPoints: [\n          `Detected ${pageCount} total page(s) ready for print layout.`,\n          isLong ? \'Double-sided (duplex) printing will reduce paper usage by up to 50%.\' : \'Single-sided printing recommended for crisp presentation.\',\n          \'Review page ranges and margin fit before final shop submission.\',\n        ],\n        recommendedSettingsNote: isLong\n          ? \'Recommended: A4, B&W, Double-sided, Spiral Binding\'\n          : \'Recommended: A4, Color or B&W, Single-sided, Standard 80gsm/100gsm\',\n        provider: \'heuristic\',\n      });\n    }\n  });\n\n  // 5. Razorpay Standard Checkout \342\200\224 Step 1: Create Order\n  app.post(\'/api/create-order\', async (req, res) => {\n    const { amount, currency = \'INR\', receipt, notes } = req.body as {\n      amount?: number;\n      currency?: string;\n      receipt?: string;\n      notes?: Record<string, string>;\n    };\n\n    const validation = validateRazorpayOrderAmount(amount);\n    if (!validation.valid || !validation.amountPaise) {\n      return res.status(400).json({ error: validation.error || \'Amount must be at least 100 paise.\' });\n    }\n\n    let razorpayClient: Razorpay;\n    let keyId: string;\n    try {\n      const ctx = getRazorpayClient();\n      razorpayClient = ctx.client;\n      keyId = ctx.keyId;\n    } catch (err) {\n      return res.status(401).json({\n        error: err instanceof Error ? err.message : \'Razorpay authentication credentials missing.\',\n      });\n    }\n\n    try {\n      const safeReceipt = String(receipt || `pr_${Date.now()}`).slice(0, 40);\n      const order = await razorpayClient.orders.create({\n        amount: validation.amountPaise,\n        currency: String(currency || \'INR\').toUpperCase(),\n        receipt: safeReceipt,\n        notes: notes || {},\n      });\n\n      return res.json({\n        order_id: order.id,\n        amount: order.amount,\n        currency: order.currency,\n        receipt: order.receipt,\n        key_id: keyId,\n      });\n    } catch (err: unknown) {\n      const rzpErr = err as { statusCode?: number; error?: { description?: string; code?: string }; message?: string };\n      const statusCode = rzpErr?.statusCode === 401 ? 401 : 500;\n      const message =\n        rzpErr?.error?.description ||\n        rzpErr?.message ||\n        \'Failed to create Razorpay order.\';\n      console.error(\'[Razorpay Create Order Error]\', statusCode, message);\n      return res.status(statusCode).json({ error: message });\n    }\n  });\n\n  // 6. Razorpay Standard Checkout \342\200\224 Step 3: Verify Payment Signature\n  app.post(\'/api/verify-payment\', (req, res) => {\n    const { razorpay_order_id, razorpay_payment_id, razorpay_signature } = req.body as {\n      razorpay_order_id?: string;\n      razorpay_payment_id?: string;\n      razorpay_signature?: string;\n    };\n\n    const keySecret = process.env.RAZORPAY_KEY_SECRET?.trim() || \'\';\n    const keyId = process.env.RAZORPAY_KEY_ID?.trim() || \'\';\n    const verification = verifyRazorpaySignature({\n      razorpay_order_id,\n      razorpay_payment_id,\n      razorpay_signature,\n      keySecret,\n    });\n\n    if (!verification.valid) {\n      return res.status(verification.statusCode).json({\n        verified: false,\n        error: verification.error,\n      });\n    }\n\n    const existing = verifiedRazorpayPayments.get(razorpay_payment_id!);\n    if (existing) {\n      return res.json({\n        verified: true,\n        duplicatePrevented: true,\n        razorpay_order_id: existing.razorpay_order_id,\n        razorpay_payment_id: existing.razorpay_payment_id,\n        transactionId: existing.razorpay_payment_id,\n        verifiedAt: existing.verifiedAt,\n        mode: existing.mode,\n      });\n    }\n\n    const record: VerifiedRazorpayRecord = {\n      razorpay_order_id: razorpay_order_id!,\n      razorpay_payment_id: razorpay_payment_id!,\n      verifiedAt: new Date().toISOString(),\n      mode: keyId.startsWith(\'rzp_test_\') ? \'razorpay_test\' : \'razorpay_live\',\n    };\n    verifiedRazorpayPayments.set(record.razorpay_payment_id, record);\n\n    return res.json({\n      verified: true,\n      razorpay_order_id: record.razorpay_order_id,\n      razorpay_payment_id: record.razorpay_payment_id,\n      transactionId: record.razorpay_payment_id,\n      verifiedAt: record.verifiedAt,\n      mode: record.mode,\n    });\n  });\n\n  app.post(\'/api/payments/webhook\', (req, res) => {\n    const signature = req.header(\'x-razorpay-signature\');\n    const webhookSecret = process.env.RAZORPAY_WEBHOOK_SECRET;\n    if (!webhookSecret) {\n      return res.status(503).json({\n        error: \'Webhook secret not configured. Set RAZORPAY_WEBHOOK_SECRET in server environment.\',\n      });\n    }\n    if (!signature) {\n      return res.status(400).json({ error: \'Missing x-razorpay-signature header.\' });\n    }\n    const digest = crypto\n      .createHmac(\'sha256\', webhookSecret)\n      .update(JSON.stringify(req.body))\n      .digest(\'hex\');\n    const sigBuf = Buffer.from(signature);\n    const digBuf = Buffer.from(digest);\n    if (sigBuf.length !== digBuf.length || !crypto.timingSafeEqual(sigBuf, digBuf)) {\n      return res.status(403).json({ error: \'Invalid webhook signature.\' });\n    }\n    return res.json({ received: true });\n  });\n\n  // Mount Vite dev server or production static bundle\n  if (!isProduction) {\n    const { createServer: createViteServer } = await import(\'vite\');\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (_req, res) => {\n      const indexHtml = path.join(distPath, \'index.html\');\n      if (fs.existsSync(indexHtml)) {\n        res.sendFile(indexHtml);\n      } else {\n        res.status(404).send(\'Build output not found. Run npm run build first.\');\n      }\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`PrintReady full-stack server running at http://localhost:${PORT}`);\n  });\n}\n\ncreateServer().catch((err) => {\n  console.error(\'Failed to start PrintReady server:\', err);\n  process.exit(1);\n});\n"
    num_lines: 499
    num_bytes: 19155
    line_range_bytes: 19155
  }
}
