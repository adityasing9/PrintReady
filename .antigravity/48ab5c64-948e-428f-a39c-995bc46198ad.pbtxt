    command_line: "set -eu\nmkdir -p .playwright-cli\n\necho \"=== 1. Integration Status ===\"\ncurl -sf http://localhost:3000/api/integrations/status && echo \"\"\n\necho \"=== 2. Create Order Validation (<100 paise -> expect 400) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/create-order \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"amount\":50,\"currency\":\"INR\",\"receipt\":\"test_low\"}\'\n\necho \"=== 3. Create Real Razorpay Test Order (48000 paise -> expect 200 & order_*) ===\"\nCREATE_RESP=$(curl -s -w \"\\nHTTP %{http_code}\" -X POST http://localhost:3000/api/create-order \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"amount\":48000,\"currency\":\"INR\",\"receipt\":\"PR-2026-101\"}\')\necho \"$CREATE_RESP\"\n\necho \"=== 4. Verify Payment Missing Fields (expect 400) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"razorpay_order_id\":\"order_abc\"}\'\n\necho \"=== 5. Verify Payment Signature Mismatch (expect 400) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"razorpay_order_id\":\"order_abc\",\"razorpay_payment_id\":\"pay_xyz\",\"razorpay_signature\":\"invalid_sig\"}\'\n\necho \"=== 6. Verify Payment Valid HMAC-SHA256 Signature (expect 200) ===\"\nVALID_SIG=$(node -e \"const c=require(\'crypto\'); require(\'dotenv\').config(); console.log(c.createHmac(\'sha256\', process.env.RAZORPAY_KEY_SECRET).update(\'order_test123|pay_test456\').digest(\'hex\'));\")\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"razorpay_order_id\\\":\\\"order_test123\\\",\\\"razorpay_payment_id\\\":\\\"pay_test456\\\",\\\"razorpay_signature\\\":\\\"$VALID_SIG\\\"}\"\n\necho \"=== 7. Browser Verification (Razorpay Checkout.js + Real Modal) ===\"\ntrap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\nplaywright-cli open http://localhost:3000\nplaywright-cli resize 1440 900\n\nplaywright-cli run-code \"async page => {\n  const consoleErrors = [];\n  const createOrderCalls = [];\n  page.on(\'console\', msg => { if (msg.type() === \'error\') consoleErrors.push(msg.text()); });\n  page.on(\'response\', async res => {\n    if (res.url().includes(\'/api/create-order\')) {\n      const body = await res.json().catch(() => ({}));\n      createOrderCalls.push({ status: res.status(), order_id: body.order_id, amount: body.amount, currency: body.currency });\n    }\n  });\n\n  await page.waitForSelector(\'h1\');\n  await page.waitForTimeout(800);\n\n  const hasRazorpayScript = await page.evaluate(() => typeof window.Razorpay === \'function\');\n  const secretLeakedInHtml = await page.evaluate(() => document.documentElement.innerHTML.includes(\'8rddLLnuZ62rlykDcI3Wa45m\'));\n\n  await page.getByRole(\'button\', { name: /Orders & Chat/i }).first().click();\n  await page.waitForTimeout(400);\n  await page.getByRole(\'button\', { name: /Approve Price & Pay/i }).first().click();\n  await page.waitForTimeout(350);\n  await page.screenshot({ path: \'.playwright-cli/rzp-modal.png\', fullPage: false });\n\n  await page.getByRole(\'button\', { name: /Pay .* with Razorpay/i }).first().click();\n  await page.waitForTimeout(2500);\n  const rzpFrameCount = await page.locator(\'iframe.razorpay-checkout-frame, iframe[src*=\\\"razorpay\\\"]\').count();\n  await page.screenshot({ path: \'.playwright-cli/rzp-checkout-open.png\', fullPage: false });\n\n  console.log(JSON.stringify({\n    hasRazorpayScript,\n    secretLeakedInHtml,\n    createOrderCalls,\n    rzpFrameCount,\n    consoleErrors\n  }, null, 2));\n}\"\n"
    proposed_command_line: "set -eu\nmkdir -p .playwright-cli\n\necho \"=== 1. Integration Status ===\"\ncurl -sf http://localhost:3000/api/integrations/status && echo \"\"\n\necho \"=== 2. Create Order Validation (<100 paise -> expect 400) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/create-order \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"amount\":50,\"currency\":\"INR\",\"receipt\":\"test_low\"}\'\n\necho \"=== 3. Create Real Razorpay Test Order (48000 paise -> expect 200 & order_*) ===\"\nCREATE_RESP=$(curl -s -w \"\\nHTTP %{http_code}\" -X POST http://localhost:3000/api/create-order \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"amount\":48000,\"currency\":\"INR\",\"receipt\":\"PR-2026-101\"}\')\necho \"$CREATE_RESP\"\n\necho \"=== 4. Verify Payment Missing Fields (expect 400) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"razorpay_order_id\":\"order_abc\"}\'\n\necho \"=== 5. Verify Payment Signature Mismatch (expect 400) ===\"\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"razorpay_order_id\":\"order_abc\",\"razorpay_payment_id\":\"pay_xyz\",\"razorpay_signature\":\"invalid_sig\"}\'\n\necho \"=== 6. Verify Payment Valid HMAC-SHA256 Signature (expect 200) ===\"\nVALID_SIG=$(node -e \"const c=require(\'crypto\'); require(\'dotenv\').config(); console.log(c.createHmac(\'sha256\', process.env.RAZORPAY_KEY_SECRET).update(\'order_test123|pay_test456\').digest(\'hex\'));\")\ncurl -s -w \"\\nHTTP %{http_code}\\n\" -X POST http://localhost:3000/api/verify-payment \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"razorpay_order_id\\\":\\\"order_test123\\\",\\\"razorpay_payment_id\\\":\\\"pay_test456\\\",\\\"razorpay_signature\\\":\\\"$VALID_SIG\\\"}\"\n\necho \"=== 7. Browser Verification (Razorpay Checkout.js + Real Modal) ===\"\ntrap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\nplaywright-cli open http://localhost:3000\nplaywright-cli resize 1440 900\n\nplaywright-cli run-code \"async page => {\n  const consoleErrors = [];\n  const createOrderCalls = [];\n  page.on(\'console\', msg => { if (msg.type() === \'error\') consoleErrors.push(msg.text()); });\n  page.on(\'response\', async res => {\n    if (res.url().includes(\'/api/create-order\')) {\n      const body = await res.json().catch(() => ({}));\n      createOrderCalls.push({ status: res.status(), order_id: body.order_id, amount: body.amount, currency: body.currency });\n    }\n  });\n\n  await page.waitForSelector(\'h1\');\n  await page.waitForTimeout(800);\n\n  const hasRazorpayScript = await page.evaluate(() => typeof window.Razorpay === \'function\');\n  const secretLeakedInHtml = await page.evaluate(() => document.documentElement.innerHTML.includes(\'8rddLLnuZ62rlykDcI3Wa45m\'));\n\n  await page.getByRole(\'button\', { name: /Orders & Chat/i }).first().click();\n  await page.waitForTimeout(400);\n  await page.getByRole(\'button\', { name: /Approve Price & Pay/i }).first().click();\n  await page.waitForTimeout(350);\n  await page.screenshot({ path: \'.playwright-cli/rzp-modal.png\', fullPage: false });\n\n  await page.getByRole(\'button\', { name: /Pay .* with Razorpay/i }).first().click();\n  await page.waitForTimeout(2500);\n  const rzpFrameCount = await page.locator(\'iframe.razorpay-checkout-frame, iframe[src*=\\\"razorpay\\\"]\').count();\n  await page.screenshot({ path: \'.playwright-cli/rzp-checkout-open.png\', fullPage: false });\n\n  console.log(JSON.stringify({\n    hasRazorpayScript,\n    secretLeakedInHtml,\n    createOrderCalls,\n    rzpFrameCount,\n    consoleErrors\n  }, null, 2));\n}\"\n"
    shell_name: "bash"
  }
