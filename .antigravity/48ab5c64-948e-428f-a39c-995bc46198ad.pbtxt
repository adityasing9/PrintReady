r/i }).first();\\n  let shopAccepted = false;\\n  if (await acceptBtn.isVisible().catch(() => false)) {\\n    await acceptBtn.click();\\n    await page.waitForTimeout(400);\\n    shopAccepted = true;\\n  }\\n\\n  await page.getByRole(\'tab\', { name: /^Customer$/i }).click();\\n  await page.waitForTimeout(300);\\n  await page.getByRole(\'button\', { name: /Orders & Chat/i }).first().click();\\n  await page.waitForTimeout(400);\\n\\n  const payBtn = page.getByRole(\'button\', { name: /Approve Price & Pay|Pay Now|Verify & Pay/i }).first();\\n  let paidTriggered = false;\\n  if (await payBtn.isVisible().catch(() => false)) {\\n    await payBtn.click();\\n    await page.waitForTimeout(900);\\n    paidTriggered = true;\\n  }\\n  await page.screenshot({ path: \'.playwright-cli/r1-customer-orders.png\', fullPage: false });\\n  const hasVerifiedBadge = await page.getByText(/Paid|Payment Verified|TXN|pay_/i).first().isVisible().catch(() => false);\\n\\n  await page.getByRole(\'tab\', { name: /^Shop$/i }).click();\\n  await page.waitForTimeout(300);\\n  await page.getByRole(\'button\', { name: /Orders & Queue/i }).first().click();\\n  await page.waitForTimeout(300);\\n  for (const label of [/Start Printing/i, /Quality Check/i, /Ready for Pickup/i, /Mark Completed|Complete Order/i]) {\\n    const b = page.getByRole(\'button\', { name: label }).first();\\n    if (await b.isVisible().catch(() => false)) {\\n      await b.click();\\n      await page.waitForTimeout(250);\\n    }\\n  }\\n  await page.getByRole(\'button\', { name: /Shop Dashboard/i }).first().click();\\n  await page.waitForTimeout(500);\\n  await page.screenshot({ path: \'.playwright-cli/r1-shop-dashboard.png\', fullPage: false });\\n\\n  // JOURNEY 3: Scanner/PDF Tools -> Print Shops Map/List -> Admin Verification -> Dark Mode + Mobile\\n  await page.getByRole(\'tab\', { name: /^Customer$/i }).click();\\n  await page.waitForTimeout(300);\\n  await page.getByRole(\'button\', { name: /Scanner & PDF Tools/i }).first().click();\\n  await page.waitForTimeout(400);\\n  const sampleScanBtn = page.getByRole(\'button\', { name: /Add Sample Scan/i }).first();\\n  let scanExported = false;\\n  if (await sampleScanBtn.isVisible().catch(() => false)) {\\n    await sampleScanBtn.click();\\n    await page.waitForTimeout(400);\\n    const savePdfBtn = page.getByRole(\'button\', { name: /Save PDF to Vault/i }).first();\\n    if (await savePdfBtn.isVisible().catch(() => false)) {\\n      await savePdfBtn.click();\\n      await page.waitForTimeout(700);\\n      scanExported = true;\\n    }\\n  }\\n\\n  await page.getByRole(\'button\', { name: /Print Shops/i }).first().click();\\n  await page.waitForTimeout(500);\\n  const imgStats = await page.evaluate(() => {\\n    const imgs = Array.from(document.querySelectorAll(\'img\'));\\n    return imgs.map(i => ({ src: i.getAttribute(\'src\'), complete: i.complete, nw: i.naturalWidth }));\\n  });\\n  await page.screenshot({ path: \'.playwright-cli/r1-shops-list.png\', fullPage: false });\\n  const mapBtn = page.getByRole(\'button\', { name: /Map View|Map/i }).first();\\n  if (await mapBtn.isVisible().catch(() => false)) {\\n    await mapBtn.click();\\n    await page.waitForTimeout(400);\\n    await page.screenshot({ path: \'.playwright-cli/r1-shops-map.png\', fullPage: false });\\n  }\\n\\n  await page.getByRole(\'tab\', { name: /^Admin$/i }).click();\\n  await page.waitForTimeout(400);\\n  await page.screenshot({ path: \'.playwright-cli/r1-admin-overview.png\', fullPage: false });\\n  await page.getByRole(\'button\', { name: /Shop Verification/i }).first().click();\\n  await page.waitForTimeout(400);\\n  const approveShopBtn = page.getByRole(\'button\', { name: /^Approve$/i }).first();\\n  let adminApprovedShop = false;\\n  if (await approveShopBtn.isVisible().catch(() => false)) {\\n    await approveShopBtn.click();\\n    await page.waitForTimeout(400);\\n    adminApprovedShop = true;\\n  }\\n  await page.getByRole(\'button\', { name: /Settings & Audit Logs/i }).first().click();\\n  await page.waitForTimeout(400);\\n  const hasApprovalAudit = await page.getByText(/Approved shop|approved|QuickCopy/i).first().isVisible().catch(() => false);\\n\\n  await page.getByRole(\'tab\', { name: /^Customer$/i }).click();\\n  await page.waitForTimeout(300);\\n  await page.getByRole(\'button\', { name: /Switch to dark mode/i }).first().click();\\n  await page.waitForTimeout(300);\\n  await page.screenshot({ path: \'.playwright-cli/r1-desktop-dark.png\', fullPage: false });\\n\\n  await page.setViewportSize({ width: 390, height: 844 });\\n  await page.waitForTimeout(400);\\n  const overflowMobile = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\\n  await page.screenshot({ path: \'.playwright-cli/r1-mobile-dark.png\', fullPage: false });\\n\\n  console.log(JSON.stringify({\\n    overflowDesktop,\\n    overflowMobile,\\n    hasJobFolder,\\n    invalidWarningShown,\\n    shareOpened,\\n    submitVisible,\\n    shopAccepted,\\n    paidTriggered,\\n    hasVerifiedBadge,\\n    scanExported,\\n    imgStats,\\n    adminApprovedShop,\\n    hasApprovalAudit,\\n    consoleErrors,\\n    pageErrors,\\n    failedRequests\\n  }, null, 2));\\n}\\\"\\n\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running Round 1 E2E browser verification\", \"toolSummary\":\"Run Round 1 E2E verification\"}"
