    action_spec {
      create_file {
        instruction: "{\n  \"entities\": {\n    \"UserProfile\": {\n      \"title\": \"UserProfile\",\n      \"description\": \"Private user account profile and preferences. PII isolated to owner and admins.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"displayName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"email\": { \"type\": \"string\", \"format\": \"email\", \"maxLength\": 160 },\n        \"phone\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"role\": { \"type\": \"string\", \"enum\": [\"customer\", \"shop_owner\", \"shop_employee\", \"admin\", \"support\"] },\n        \"preferredLanguage\": { \"type\": \"string\", \"maxLength\": 16 },\n        \"theme\": { \"type\": \"string\", \"enum\": [\"light\", \"dark\", \"system\"] },\n        \"subscriptionPlan\": { \"type\": \"string\", \"enum\": [\"free\", \"premium\"] },\n        \"loyaltyPoints\": { \"type\": \"integer\" },\n        \"storageUsedBytes\": { \"type\": \"integer\" },\n        \"aiEnabled\": { \"type\": \"boolean\" },\n        \"cloudBackupEnabled\": { \"type\": \"boolean\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"displayName\", \"email\", \"role\", \"createdAt\", \"updatedAt\"]\n    },\n    \"Folder\": {\n      \"title\": \"Folder\",\n      \"description\": \"Customer document folder inside the private document vault.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"category\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 40 },\n        \"color\": { \"type\": \"string\", \"maxLength\": 24 },\n        \"parentId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"isFavourite\": { \"type\": \"boolean\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"ownerId\", \"name\", \"category\", \"isFavourite\", \"createdAt\", \"updatedAt\"]\n    },\n    \"VaultDocument\": {\n      \"title\": \"VaultDocument\",\n      \"description\": \"Private customer document metadata, OCR text, tags, and version details.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 160 },\n        \"mimeType\": { \"type\": \"string\", \"minLength\": 3, \"maxLength\": 120 },\n        \"extension\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 16 },\n        \"sizeBytes\": { \"type\": \"integer\" },\n        \"pageCount\": { \"type\": \"integer\" },\n        \"folderId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"category\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 40 },\n        \"tags\": { \"type\": \"array\" },\n        \"ocrText\": { \"type\": \"string\", \"maxLength\": 10000 },\n        \"summary\": { \"type\": \"string\", \"maxLength\": 1000 },\n        \"checksum\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"expiryDate\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"version\": { \"type\": \"integer\" },\n        \"isFavourite\": { \"type\": \"boolean\" },\n        \"isTrashed\": { \"type\": \"boolean\" },\n        \"syncStatus\": { \"type\": \"string\", \"enum\": [\"local\", \"synced\", \"pending\"] },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"ownerId\", \"name\", \"mimeType\", \"extension\", \"sizeBytes\", \"pageCount\", \"category\", \"isFavourite\", \"isTrashed\", \"version\", \"createdAt\", \"updatedAt\"]\n    },\n    \"PrintPreset\": {\n      \"title\": \"PrintPreset\",\n      \"description\": \"Reusable printing configuration preset.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 64 },\n        \"paperSize\": { \"type\": \"string\", \"enum\": [\"A4\", \"A3\", \"A5\", \"Letter\", \"Legal\", \"Custom\"] },\n        \"colorMode\": { \"type\": \"string\", \"enum\": [\"bw\", \"color\"] },\n        \"sides\": { \"type\": \"string\", \"enum\": [\"single\", \"double\"] },\n        \"orientation\": { \"type\": \"string\", \"enum\": [\"portrait\", \"landscape\"] },\n        \"copies\": { \"type\": \"integer\" },\n        \"pagesPerSheet\": { \"type\": \"integer\" },\n        \"binding\": { \"type\": \"string\", \"enum\": [\"none\", \"staple\", \"spiral\", \"hardcover\", \"lamination\"] },\n        \"isFavourite\": { \"type\": \"boolean\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"ownerId\", \"name\", \"paperSize\", \"colorMode\", \"sides\", \"orientation\", \"copies\", \"createdAt\", \"updatedAt\"]\n    },\n    \"SavedShop\": {\n      \"title\": \"SavedShop\",\n      \"description\": \"Customer-saved printing shop entry (registered or unregistered local print shop).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"shopName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 120 },\n        \"registeredShopId\": { \"type\": \"string\", \"maxLength\": 128 },\n        \"phone\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"whatsapp\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"email\": { \"type\": \"string\", \"maxLength\": 160 },\n        \"address\": { \"type\": \"string\", \"maxLength\": 240 },\n        \"group\": { \"type\": \"string\", \"maxLength\": 40 },\n        \"preferredContact\": { \"type\": \"string\", \"enum\": [\"whatsapp\", \"email\", \"marketplace\", \"phone\"] },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"isFavourite\": { \"type\": \"boolean\" },\n        \"isDefault\": { \"type\": \"boolean\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"ownerId\", \"shopName\", \"group\", \"preferredContact\", \"isFavourite\", \"createdAt\", \"updatedAt\"]\n    },\n    \"PrintShop\": {\n      \"title\": \"PrintShop\",\n      \"description\": \"Registered printing business listed in the PrintReady marketplace.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 2, \"maxLength\": 120 },\n        \"ownerName\": { \"type\": \"string\", \"minLength\": 2, \"maxLength\": 100 },\n        \"address\": { \"type\": \"string\", \"minLength\": 4, \"maxLength\": 240 },\n        \"city\": { \"type\": \"string\", \"minLength\": 2, \"maxLength\": 80 },\n        \"phone\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"whatsapp\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"email\": { \"type\": \"string\", \"maxLength\": 160 },\n        \"lat\": { \"type\": \"number\" },\n        \"lng\": { \"type\": \"number\" },\n        \"isOpen\": { \"type\": \"boolean\" },\n        \"pickupAvailable\": { \"type\": \"boolean\" },\n        \"deliveryAvailable\": { \"type\": \"boolean\" },\n        \"deliveryFee\": { \"type\": \"number\" },\n        \"turnaroundMinutes\": { \"type\": \"integer\" },\n        \"verificationStatus\": { \"type\": \"string\", \"enum\": [\"pending\", \"verified\", \"rejected\", \"suspended\"] },\n        \"rating\": { \"type\": \"number\" },\n        \"reviewCount\": { \"type\": \"integer\" },\n        \"services\": { \"type\": \"array\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"ownerId\", \"name\", \"address\", \"city\", \"isOpen\", \"pickupAvailable\", \"deliveryAvailable\", \"verificationStatus\", \"createdAt\", \"updatedAt\"]\n    },\n    \"ShopInventoryItem\": {\n      \"title\": \"ShopInventoryItem\",\n      \"description\": \"Printing supply stock item belonging to a shop.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"shopId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"category\": { \"type\": \"string\", \"enum\": [\"paper\", \"ink\", \"toner\", \"photo_paper\", \"binding\", \"lamination\", \"other\"] },\n        \"quantity\": { \"type\": \"number\" },\n        \"unit\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"reorderLevel\": { \"type\": \"number\" },\n        \"supplier\": { \"type\": \"string\", \"maxLength\": 100 },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"shopId\", \"name\", \"category\", \"quantity\", \"unit\", \"reorderLevel\", \"updatedAt\"]\n    },\n    \"PrintOrder\": {\n      \"title\": \"PrintOrder\",\n      \"description\": \"Marketplace digital printing order connecting a customer and a registered shop.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"orderNumber\": { \"type\": \"string\", \"minLength\": 4, \"maxLength\": 40, \"pattern\": \"^PR-[A-Z0-9\\\\-]+$\" },\n        \"customerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"customerName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"shopId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"shopOwnerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"shopName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 120 },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"draft\", \"submitted\", \"received\", \"awaiting_shop_response\", \"accepted\",\n            \"rejected\", \"price_pending_approval\", \"approved\", \"payment_pending\",\n            \"paid\", \"printing\", \"quality_check\", \"ready_for_pickup\",\n            \"out_for_delivery\", \"delivered\", \"completed\", \"cancelled\",\n            \"refund_requested\", \"refunded\"\n          ]\n        },\n        \"fulfillmentType\": { \"type\": \"string\", \"enum\": [\"pickup\", \"delivery\"] },\n        \"estimatedTotal\": { \"type\": \"number\" },\n        \"confirmedTotal\": { \"type\": \"number\" },\n        \"paymentStatus\": { \"type\": \"string\", \"enum\": [\"unpaid\", \"pending\", \"verified\", \"refunded\", \"failed\"] },\n        \"itemCount\": { \"type\": \"integer\" },\n        \"totalPages\": { \"type\": \"integer\" },\n        \"specialInstructions\": { \"type\": \"string\", \"maxLength\": 600 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"orderNumber\", \"customerId\", \"customerName\", \"shopId\", \"shopOwnerId\", \"shopName\", \"status\", \"fulfillmentType\", \"estimatedTotal\", \"paymentStatus\", \"itemCount\", \"totalPages\", \"createdAt\", \"updatedAt\"]\n    },\n    \"OrderMessage\": {\n      \"title\": \"OrderMessage\",\n      \"description\": \"Order-scoped chat message between customer and shop.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"orderId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"senderId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"senderName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"senderRole\": { \"type\": \"string\", \"enum\": [\"customer\", \"shop\", \"admin\"] },\n        \"text\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 1200 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"orderId\", \"senderId\", \"senderName\", \"senderRole\", \"text\", \"createdAt\"]\n    },\n    \"ShopReview\": {\n      \"title\": \"ShopReview\",\n      \"description\": \"Verified order review for a print shop.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"shopId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"orderId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"customerId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"customerName\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"rating\": { \"type\": \"integer\" },\n        \"comment\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 800 },\n        \"verifiedOrder\": { \"type\": \"boolean\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"shopId\", \"orderId\", \"customerId\", \"customerName\", \"rating\", \"comment\", \"verifiedOrder\", \"createdAt\"]\n    },\n    \"AuditLog\": {\n      \"title\": \"AuditLog\",\n      \"description\": \"Immutable privileged admin audit log.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"actorId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"actorEmail\": { \"type\": \"string\", \"maxLength\": 160 },\n        \"action\": { \"type\": \"string\", \"minLength\": 2, \"maxLength\": 100 },\n        \"targetType\": { \"type\": \"string\", \"minLength\": 2, \"maxLength\": 40 },\n        \"targetId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128 },\n        \"details\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"actorId\", \"action\", \"targetType\", \"targetId\", \"createdAt\"]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}\": {\n      \"schema\": { \"$ref\": \"#/entities/UserProfile\" },\n      \"description\": \"Private user account profiles with isolated PII.\"\n    },\n    \"/users/{userId}/folders/{folderId}\": {\n      \"schema\": { \"$ref\": \"#/entities/Folder\" },\n      \"description\": \"Private customer folders inside document vault.\"\n    },\n    \"/users/{userId}/documents/{documentId}\": {\n      \"schema\": { \"$ref\": \"#/entities/VaultDocument\" },\n      \"description\": \"Private customer document vault entries.\"\n    },\n    \"/users/{userId}/printPresets/{presetId}\": {\n      \"schema\": { \"$ref\": \"#/entities/PrintPreset\" },\n      \"description\": \"Customer reusable print presets.\"\n    },\n    \"/users/{userId}/savedShops/{savedShopId}\": {\n      \"schema\": { \"$ref\": \"#/entities/SavedShop\" },\n      \"description\": \"Customer saved shops directory.\"\n    },\n    \"/shops/{shopId}\": {\n      \"schema\": { \"$ref\": \"#/entities/PrintShop\" },\n      \"description\": \"Registered print shops in the PrintReady marketplace.\"\n    },\n    \"/shops/{shopId}/inventory/{itemId}\": {\n      \"schema\": { \"$ref\": \"#/entities/ShopInventoryItem\" },\n      \"description\": \"Shop inventory tracking.\"\n    },\n    \"/orders/{orderId}\": {\n      \"schema\": { \"$ref\": \"#/entities/PrintOrder\" },\n      \"description\": \"Marketplace print orders between customers and shops.\"\n    },\n    \"/orders/{orderId}/messages/{messageId}\": {\n      \"schema\": { \"$ref\": \"#/entities/OrderMessage\" },\n      \"description\": \"Order-scoped chat messages.\"\n    },\n    \"/reviews/{reviewId}\": {\n      \"schema\": { \"$ref\": \"#/entities/ShopReview\" },\n      \"description\": \"Verified shop reviews.\"\n    },\n    \"/auditLogs/{logId}\": {\n      \"schema\": { \"$ref\": \"#/entities/AuditLog\" },\n      \"description\": \"Immutable administrative audit logs.\"\n    }\n  }\n}\n"
