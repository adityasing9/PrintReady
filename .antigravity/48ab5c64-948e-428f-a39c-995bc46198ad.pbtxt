    replacement_infos {
      original_chunk {
        target_content: "  const {\n    orders,\n    integrations,\n    transitionOrderStatus,\n    sendOrderMessage,\n    submitReview,\n    notify,\n  } = usePrintReady();\n\n  const [selectedOrderId, setSelectedOrderId] = useState<string>(orders[0]?.id || \'\');\n  const [chatText, setChatText] = useState(\'\');\n\n  // Server-verified Payment Modal\n  const [payingOrder, setPayingOrder] = useState<PrintOrder | null>(null);\n  const [paymentMethod, setPaymentMethod] = useState<\'UPI\' | \'QR\' | \'Card\' | \'Cash\'>(\'UPI\');\n  const [paymentBusy, setPaymentBusy] = useState(false);"
        replacement_content: "  const {\n    orders,\n    userProfile,\n    integrations,\n    transitionOrderStatus,\n    sendOrderMessage,\n    submitReview,\n    notify,\n  } = usePrintReady();\n\n  const [selectedOrderId, setSelectedOrderId] = useState<string>(orders[0]?.id || \'\');\n  const [chatText, setChatText] = useState(\'\');\n\n  // Razorpay Standard Checkout Modal state\n  const [payingOrder, setPayingOrder] = useState<PrintOrder | null>(null);\n  const [paymentBusy, setPaymentBusy] = useState(false);\n  const [paymentError, setPaymentError] = useState<string | null>(null);"
        start_line: 19
        end_line: 36
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "  const handleServerVerifiedPayment = async () => {\n    if (!payingOrder) return;\n    setPaymentBusy(true);\n    try {\n      const finalAmount = payingOrder.confirmedTotal ?? payingOrder.estimatedTotal;\n\n      // Step 1: Customer approves price if pending\n      if (payingOrder.status === \'price_pending_approval\') {\n        transitionOrderStatus(payingOrder.id, \'approved\', \'customer\', {\n          note: `Customer approved final price of ${formatCurrency(finalAmount, payingOrder.currency)}.`,\n        });\n      }\n\n      // Step 2: Initiate payment intent on backend\n      const initResp = await fetch(\'/api/payments/initiate\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          orderId: payingOrder.id,\n          orderNumber: payingOrder.orderNumber,\n          amount: finalAmount,\n          currency: payingOrder.currency,\n          method: paymentMethod,\n          idempotencyKey: `idem-${payingOrder.id}-${finalAmount}`,\n        }),\n      });\n      const initData = await initResp.json();\n      if (!initResp.ok) throw new Error(initData.error || \'Failed to initiate payment.\');\n\n      // Step 3: Verify HMAC-signed transaction on backend (never trust client-only state)\n      const verifyResp = await fetch(\'/api/payments/verify\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          intentId: initData.intentId,\n          signatureToken: initData.signatureToken,\n        }),\n      });\n      const verifyData = await verifyResp.json();\n      if (!verifyResp.ok || !verifyData.verified) {\n        throw new Error(verifyData.error || \'Backend payment verification failed.\');\n      }\n\n      transitionOrderStatus(payingOrder.id, \'paid\', \'system\', {\n        paymentTransactionId: verifyData.transactionId,\n        paymentMethod,\n        note: `${paymentMethod} payment verified (${verifyData.transactionId} \302\267 ${verifyData.mode === \'razorpay_live\' ? \'Razorpay Live\' : \'Server HMAC Sandbox\'}).`,\n      });\n      notify(\n        \'Payment Verified\',\n        `Receipt ${verifyData.transactionId} confirmed for ${payingOrder.orderNumber}.`,\n        \'success\'\n      );\n      setPayingOrder(null);\n    } catch (err) {\n      notify(\'Payment verification failed\', err instanceof Error ? err.message : \'Try again.\', \'error\');\n    } finally {\n      setPaymentBusy(false);\n    }\n  };"
        replacement_content: "  const handleRazorpayCheckout = async () => {\n    if (!payingOrder) return;\n    setPaymentError(null);\n    setPaymentBusy(true);\n\n    try {\n      const finalAmount = payingOrder.confirmedTotal ?? payingOrder.estimatedTotal;\n      const amountPaise = Math.round(finalAmount * 100);\n\n      if (amountPaise < 100) {\n        throw new Error(\'Order total must be at least \342\202\2711.00 (100 paise) for Razorpay checkout.\');\n      }\n\n      if (typeof window === \'undefined\' || typeof window.Razorpay !== \'function\') {\n        throw new Error(\'Razorpay Checkout script did not load. Please check your network connection and retry.\');\n      }\n\n      // Step 1: Create Razorpay order on backend\n      const createResp = await fetch(\'/api/create-order\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          amount: amountPaise,\n          currency: payingOrder.currency || \'INR\',\n          receipt: payingOrder.orderNumber,\n          notes: {\n            printready_order_id: payingOrder.id,\n            shop_name: payingOrder.shopName,\n          },\n        }),\n      });\n      const orderData = await createResp.json();\n      if (!createResp.ok || !orderData.order_id) {\n        throw new Error(orderData.error || \'Could not create Razorpay order.\');\n      }\n\n      const checkoutKey = import.meta.env.VITE_RAZORPAY_KEY_ID || orderData.key_id;\n      if (!checkoutKey) {\n        throw new Error(\'Razorpay Key ID is missing. Configure VITE_RAZORPAY_KEY_ID in .env.\');\n      }\n\n      const targetOrder = payingOrder;\n\n      // Step 2: Open Razorpay Standard Checkout modal\n      const rzp = new window.Razorpay({\n        key: checkoutKey,\n        amount: orderData.amount,\n        currency: orderData.currency,\n        name: \'PrintReady\',\n        description: `${targetOrder.orderNumber} \302\267 ${targetOrder.shopName}`,\n        order_id: orderData.order_id,\n        prefill: {\n          name: userProfile.displayName,\n          email: userProfile.email,\n          contact: userProfile.phone,\n        },\n        notes: {\n          printready_order_id: targetOrder.id,\n          order_number: targetOrder.orderNumber,\n        },\n        theme: {\n          color: \'#4338CA\',\n        },\n        modal: {\n          ondismiss: () => {\n            setPaymentBusy(false);\n            setPaymentError(\'Payment window was closed before completion. Your order has not been charged.\');\n            notify(\'Payment cancelled\', \'You closed Razorpay checkout before completing payment.\', \'info\');\n          },\n        },\n        handler: async (response) => {\n          try {\n            // Step 3: Verify HMAC-SHA256 signature on backend before marking paid\n            const verifyResp = await fetch(\'/api/verify-payment\', {\n              method: \'POST\',\n              headers: { \'Content-Type\': \'application/json\' },\n              body: JSON.stringify({\n                razorpay_order_id: response.razorpay_order_id,\n                razorpay_payment_id: response.razorpay_payment_id,\n                razorpay_signature: response.razorpay_signature,\n              }),\n            });\n            const verifyData = await verifyResp.json();\n            if (!verifyResp.ok || !verifyData.verified) {\n              throw new Error(verifyData.error || \'Payment signature verification failed.\');\n            }\n\n            if (targetOrder.status === \'price_pending_approval\') {\n              transitionOrderStatus(targetOrder.id, \'approved\', \'customer\', {\n                note: `Customer approved final price of ${formatCurrency(finalAmount, targetOrder.currency)}.`,\n              });\n            }\n\n            transitionOrderStatus(targetOrder.id, \'paid\', \'system\', {\n              paymentTransactionId: response.razorpay_payment_id,\n              paymentMethod: \'UPI\',\n              note: `Razorpay payment verified (${response.razorpay_payment_id} \302\267 ${\n                verifyData.mode === \'razorpay_test\' ? \'Razorpay Test Mode\' : \'Razorpay Live\'\n              }).`,\n            });\n\n            notify(\n              \'Payment Verified\',\n              `Razorpay receipt ${response.razorpay_payment_id} confirmed for ${targetOrder.orderNumber}.`,\n              \'success\'\n            );\n            setPaymentError(null);\n            setPayingOrder(null);\n          } catch (verifyErr) {\n            const msg = verifyErr instanceof Error ? verifyErr.message : \'Unable to verify payment signature.\';\n            setPaymentError(msg);\n            notify(\'Verification failed\', msg, \'error\');\n          } finally {\n            setPaymentBusy(false);\n          }\n        },\n      });\n\n      rzp.on(\'payment.failed\', (failedResp) => {\n        const reason =\n          failedResp?.error?.description ||\n          failedResp?.error?.reason ||\n          \'Payment failed in Razorpay checkout.\';\n        setPaymentBusy(false);\n        setPaymentError(reason);\n        notify(\'Payment failed\', reason, \'error\');\n      });\n\n      rzp.open();\n    } catch (err) {\n      const msg = err instanceof Error ? err.message : \'Unable to start Razorpay checkout.\';\n      setPaymentError(msg);\n      setPaymentBusy(false);\n      notify(\'Checkout error\', msg, \'error\');\n    }\n  };"
        start_line: 43
        end_line: 103
