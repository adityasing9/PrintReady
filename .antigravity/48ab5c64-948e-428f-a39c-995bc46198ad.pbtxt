      thinking_signature: "\022\374\031\n\371\031\001i\024}\023X#,\367br\222\341A\005\000\375+\377\022Z\347\177\303\235|\337hG\236\375\241kA?\337\003\350\245X\024\366wf\330r\361/\210\003\"E\232\242\004\350q\273\343cy{\357\346\337XSy\r\341|\037\n>\274\333\254\226\370\021Cv\217\307\017\214\257F\271)\324\026\273\250\2352\231\327\326c\t\212*,\261O\3722\022\361\313\250\006c0\343gt)W\300CZ<\256\312p\330\253\017\006\326\200\034\330\346aTm\241^\263\226.\246\270\273\300\25789\3666\222\212\024.S\222\272\335\222\362~\265J\353Q\340\372#Q\3373h>\244;\330L\377\307\352\267\336\217?\341J\373qx\277Kt\3631\302\337\375\035\261\306\274\242\030q\027BV\376\030\215?>\333\035^\273ZIh\260(\247\364\263Y\364\t\261\221nl\333\214\327\342\332?\330\264\2143;h\302`\215B>\2434\303\024-%<{`\372\300\2023\337\026\371\320\341?\t\3239\262\'\025\241\224\326\343\360 \275\214\274/ \207\367\234r\332\026\031\v\311>\245\265\236\300\'\244\373\334\315d\235?h\000a\331\000\027\327%P!\215?>k\322\246\345\304\000%|$\216\336\377\213c\246c{\335O\217f7\200\037c\240d z\366\352\006\217D\327\312\016\373\274\236\226\367\375\321Dc\226\337\361\253\203\202\250vI\300\337pQ\334\216Lf>\214\270\3718\307\270\000\340\225iMqZ_L\315]\226\357x\204\345?\033\367\346\326\216F\303\311\246\203{\343m\022\245\236\t\252\345\322\252\227\237\273\224\273\356\262\350\035\221\032\024\332_\343\220\231\352\265\371,`\023\222m\204\'~\271\207\b\362)\000\001\371\371$\247\317\276V\320\201m\302q\202\347\017y:\356\315\314\3537\331\203\347\034\230a,)\357\'\361\371\'\334U\027>;\255\323p\020\243\227\267\303\2566\031\0275\340\3215e\002\244x \334):[\210\342V23Og\250s\314\353v\301\000\300\272\244\306\252\200\335\022\003?W\363\334av\252>\a)/\317\321\351)s\350\"\2018B\211\227\204\213q\240\242\352\177\017\"5\316R\b\213\330<\357\002E\223\033\a\344-\027\245;\362 (\004\355\220oe{)\332\253\262\323\021[\225\037\004N\003\253\227?6T\2320\234\213\231\205\022\275C,#\267A\3768\256\202Yv\356\207Y>\207\032l]\341\267\234\"E:\202\352\253\202t\031\036\224\257\252G\232\212z\301\33