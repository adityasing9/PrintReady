            lines {
              text: "export function parsePageRange(rangeInput: string, totalPages: number): PageRangeResult {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const safeTotal = Math.max(1, Math.floor(totalPages));"
