      create_file {
        instruction: "export type UserRole = \'customer\' | \'shop_owner\' | \'shop_employee\' | \'admin\' | \'support\';\n\nexport type AppPortal = \'customer\' | \'shop\' | \'admin\';\n\nexport type DocumentCategory =\n  | \'Identity\'\n  | \'Education\'\n  | \'College\'\n  | \'Job\'\n  | \'Resume\'\n  | \'Certificates\'\n  | \'Banking\'\n  | \'Government\'\n  | \'Travel\'\n  | \'Medical\'\n  | \'Personal\'\n  | \'Photos\'\n  | \'Business\'\n  | \'Other\';\n\nexport const DEFAULT_CATEGORIES: DocumentCategory[] = [\n  \'Identity\',\n  \'Education\',\n  \'College\',\n  \'Job\',\n  \'Resume\',\n  \'Certificates\',\n  \'Banking\',\n  \'Government\',\n  \'Travel\',\n  \'Medical\',\n  \'Personal\',\n  \'Photos\',\n  \'Business\',\n  \'Other\',\n];\n\nexport type PaperSize = \'A4\' | \'A3\' | \'A5\' | \'Letter\' | \'Legal\' | \'Custom\';\nexport type ColorMode = \'bw\' | \'color\';\nexport type PrintSides = \'single\' | \'double\';\nexport type PrintOrientation = \'portrait\' | \'landscape\';\nexport type PrintScaling = \'fit\' | \'actual\' | \'custom\';\nexport type PaperType = \'standard_75gsm\' | \'premium_100gsm\' | \'glossy_photo\' | \'bond_executive\';\nexport type BindingOption = \'none\' | \'staple\' | \'spiral\' | \'hardcover\' | \'lamination\';\n\nexport interface PrintSettings {\n  copies: number;\n  paperSize: PaperSize;\n  colorMode: ColorMode;\n  sides: PrintSides;\n  orientation: PrintOrientation;\n  pageRange: string; // \'all\' or e.g. \'1-5, 8, 10-12\'\n  scaling: PrintScaling;\n  customScalePercent: number;\n  paperType: PaperType;\n  pagesPerSheet: 1 | 2 | 4;\n  collate: boolean;\n  binding: BindingOption;\n  specialInstructions: string;\n}\n\nexport const DEFAULT_PRINT_SETTINGS: PrintSettings = {\n  copies: 1,\n  paperSize: \'A4\',\n  colorMode: \'bw\',\n  sides: \'double\',\n  orientation: \'portrait\',\n  pageRange: \'all\',\n  scaling: \'fit\',\n  customScalePercent: 100,\n  paperType: \'standard_75gsm\',\n  pagesPerSheet: 1,\n  collate: true,\n  binding: \'none\',\n  specialInstructions: \'\',\n};\n\nexport interface UserProfile {\n  uid: string;\n  displayName: string;\n  email: string;\n  phone: string;\n  role: UserRole;\n  preferredLanguage: string;\n  theme: \'light\' | \'dark\' | \'system\';\n  subscriptionPlan: \'free\' | \'premium\';\n  loyaltyPoints: number;\n  storageQuotaBytes: number;\n  aiEnabled: boolean;\n  cloudBackupEnabled: boolean;\n  addresses: { id: string; label: string; line1: string; city: string; postalCode: string; isDefault: boolean }[];\n  notificationsEnabled: {\n    orders: boolean;\n    chat: boolean;\n    expiryReminders: boolean;\n    promotions: boolean;\n  };\n  createdAt: string;\n}\n\nexport interface VaultFolder {\n  id: string;\n  name: string;\n  category: string;\n  color: string;\n  parentId: string | null;\n  isFavourite: boolean;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface VaultDocument {\n  id: string;\n  name: string;\n  mimeType: string;\n  extension: string;\n  sizeBytes: number;\n  pageCount: number;\n  folderId: string | null;\n  category: string;\n  tags: string[];\n  ocrText: string;\n  summary: string;\n  checksum: string;\n  expiryDate?: string;\n  version: number;\n  isFavourite: boolean;\n  isTrashed: boolean;\n  trashedAt?: string;\n  syncStatus: \'local\' | \'synced\' | \'pending\';\n  lastOpenedAt?: string;\n  lastPrintedAt?: string;\n  lastSharedAt?: string;\n  previewDataUrl?: string; // Local preview data URL or blob URL for uploaded/scanned files\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface PrintPreset {\n  id: string;\n  name: string;\n  settings: PrintSettings;\n  isFavourite: boolean;\n  createdAt: string;\n}\n\nexport interface PrintBasketItem {\n  id: string;\n  documentId: string;\n  documentName: string;\n  extension: string;\n  pageCount: number;\n  sizeBytes: number;\n  settings: PrintSettings;\n}\n\nexport interface SavedPrintBasket {\n  id: string;\n  name: string;\n  items: PrintBasketItem[];\n  createdAt: string;\n}\n\nexport interface ShopPricingTable {\n  currency: string;\n  bwPerPageA4: number;\n  colorPerPageA4: number;\n  duplexDiscountFactor: number; // e.g. 0.9 means 10% off per page on double-sided\n  sizeMultipliers: Record<PaperSize, number>;\n  paperSurchargePerSheet: Record<PaperType, number>;\n  bindingPrices: Record<BindingOption, number>;\n  serviceChargeFlat: number;\n  taxRatePercent: number;\n  deliveryFee: number;\n  scanPerPage: number;\n  photocopyPerPage: number;\n  idCardPrint: number;\n}\n\nexport interface RegisteredShop {\n  id: string;\n  ownerId: string;\n  name: string;\n  ownerName: string;\n  address: string;\n  city: string;\n  phone: string;\n  whatsapp: string;\n  email: string;\n  lat: number;\n  lng: number;\n  distanceKm: number;\n  photoUrl: string;\n  openingHours: string;\n  isOpen: boolean;\n  pickupAvailable: boolean;\n  deliveryAvailable: boolean;\n  onlineOrdering: boolean;\n  turnaroundMinutes: number;\n  verificationStatus: \'pending\' | \'verified\' | \'rejected\' | \'suspended\';\n  rating: number;\n  reviewCount: number;\n  services: string[];\n  paymentMethods: (\'UPI\' | \'QR\' | \'Card\' | \'Cash\')[];\n  pricing: ShopPricingTable;\n  plan: \'free\' | \'pro\';\n  createdAt: string;\n}\n\nexport interface SavedShop {\n  id: string;\n  shopName: string;\n  registeredShopId?: string;\n  ownerName?: string;\n  phone: string;\n  whatsapp: string;\n  email: string;\n  address: string;\n  googleMapsUrl?: string;\n  openingHours?: string;\n  group: string;\n  preferredContact: \'whatsapp\' | \'email\' | \'marketplace\' | \'phone\';\n  notes: string;\n  defaultSettings?: Partial<PrintSettings>;\n  isFavourite: boolean;\n  isDefault: boolean;\n  createdAt: string;\n}\n\nexport type OrderStatus =\n  | \'draft\'\n  | \'submitted\'\n  | \'received\'\n  | \'awaiting_shop_response\'\n  | \'accepted\'\n  | \'rejected\'\n  | \'price_pending_approval\'\n  | \'approved\'\n  | \'payment_pending\'\n  | \'paid\'\n  | \'printing\'\n  | \'quality_check\'\n  | \'ready_for_pickup\'\n  | \'out_for_delivery\'\n  | \'delivered\'\n  | \'completed\'\n  | \'cancelled\'\n  | \'refund_requested\'\n  | \'refunded\';\n\nexport interface OrderEvent {\n  id: string;\n  status: OrderStatus;\n  actorRole: \'customer\' | \'shop\' | \'admin\' | \'system\';\n  actorName: string;\n  note: string;\n  timestamp: string;\n}\n\nexport interface OrderMessage {\n  id: string;\n  orderId: string;\n  senderId: string;\n  senderName: string;\n  senderRole: \'customer\' | \'shop\' | \'admin\';\n  text: string;\n  attachmentName?: string;\n  read: boolean;\n  createdAt: string;\n}\n\nexport interface PrintOrder {\n  id: string;\n  orderNumber: string;\n  customerId: string;\n  customerName: string;\n  customerPhone: string;\n  shopId: string;\n  shopOwnerId: string;\n  shopName: string;\n  items: PrintBasketItem[];\n  status: OrderStatus;\n  fulfillmentType: \'pickup\' | \'delivery\';\n  deliveryAddress?: string;\n  preferredTime: string;\n  pickupCode: string;\n  specialInstructions: string;\n  estimatedTotal: number;\n  confirmedTotal?: number;\n  discountAmount: number;\n  couponCode?: string;\n  currency: string;\n  paymentStatus: \'unpaid\' | \'pending\' | \'verified\' | \'refunded\' | \'failed\';\n  paymentMethod?: \'UPI\' | \'QR\' | \'Card\' | \'Cash\';\n  paymentTransactionId?: string;\n  priority: \'normal\' | \'urgent\';\n  assignedStaffName?: string;\n  assignedPrinterName?: string;\n  events: OrderEvent[];\n  messages: OrderMessage[];\n  reviewed: boolean;\n  fileRetentionExpiresAt: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface ShopInventoryItem {\n  id: string;\n  shopId: string;\n  name: string;\n  category: \'paper\' | \'ink\' | \'toner\' | \'photo_paper\' | \'binding\' | \'lamination\' | \'other\';\n  quantity: number;\n  unit: string;\n  reorderLevel: number;\n  supplier: string;\n  lastRestockedAt: string;\n}\n\nexport interface ShopPrinter {\n  id: string;\n  shopId: string;\n  name: string;\n  type: \'laser_mono\' | \'laser_color\' | \'inkjet_photo\' | \'wide_format\';\n  supportedSizes: PaperSize[];\n  colorSupport: boolean;\n  duplexSupport: boolean;\n  status: \'online\' | \'busy\' | \'maintenance\' | \'offline\';\n  assignedJobsCount: number;\n  lastMaintenanceDate: string;\n}\n\nexport interface ShopStaffMember {\n  id: string;\n  shopId: string;\n  name: string;\n  email: string;\n  role: \'Owner\' | \'Manager\' | \'Operator\' | \'Cashier\' | \'Delivery\';\n  status: \'active\' | \'invited\';\n  ordersHandled: number;\n}\n\nexport interface ShopReview {\n  id: string;\n  shopId: string;\n  orderId: string;\n  customerId: string;\n  customerName: string;\n  rating: number;\n  comment: string;\n  shopResponse?: string;\n  verifiedOrder: boolean;\n  flagged: boolean;\n  createdAt: string;\n}\n\nexport interface Coupon {\n  code: string;\n  description: string;\n  discountType: \'percent\' | \'flat\';\n  value: number;\n  minOrderAmount: number;\n  maxDiscount?: number;\n  active: boolean;\n  expiresAt: string;\n}\n\nexport interface NotificationItem {\n  id: string;\n  portal: AppPortal;\n  title: string;\n  body: string;\n  type: \'order\' | \'chat\' | \'inventory\' | \'security\' | \'expiry\' | \'system\';\n  read: boolean;\n  createdAt: string;\n}\n\nexport interface SupportTicket {\n  id: string;\n  userId: string;\n  userName: string;\n  subject: string;\n  category: \'order_dispute\' | \'refund\' | \'shop_complaint\' | \'technical\';\n  status: \'open\' | \'investigating\' | \'resolved\';\n  orderNumber?: string;\n  createdAt: string;\n}\n\nexport interface AuditLogEntry {\n  id: string;\n  actorName: string;\n  actorEmail: string;\n  action: string;\n  targetType: \'shop\' | \'user\' | \'order\' | \'payment\' | \'settings\' | \'review\';\n  targetId: string;\n  details: string;\n  createdAt: string;\n}\n\nexport interface ShareTemplate {\n  id: string;\n  name: string;\n  body: string;\n  shopId?: string;\n  isDefault: boolean;\n}\n"
