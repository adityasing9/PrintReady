        replacement_content: "  const [orders, setOrders] = useState<PrintOrder[]>(() => loadLocal(\'orders\', INITIAL_ORDERS));\n  const ordersRef = useRef<PrintOrder[]>(orders);\n  ordersRef.current = orders;"
