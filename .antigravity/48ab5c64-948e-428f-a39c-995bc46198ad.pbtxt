    tool_calls {
      id: "call_18054687131319574626"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  ArrowDown,\\n  ArrowUp,\\n  Bookmark,\\n  CheckCircle2,\\n  Mail,\\n  MessageCircle,\\n  Plus,\\n  Printer,\\n  Send,\\n  Share2,\\n  Trash2,\\n  X,\\n} from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport {\\n  buildMailtoUrl,\\n  buildWhatsAppUrl,\\n  formatFileSize,\\n  renderShareTemplate,\\n} from \'../../domain/fileValidation\';\\nimport { calculateOrderEstimate, formatCurrency, parsePageRange } from \'../../domain/printCalculator\';\\nimport {\\n  BindingOption,\\n  DEFAULT_PRINT_SETTINGS,\\n  PaperSize,\\n  PaperType,\\n} from \'../../domain/types\';\\n\\nexport function PrintBasketView() {\\n  const {\\n    documents,\\n    basket,\\n    savedBaskets,\\n    presets,\\n    shops,\\n    savedShops,\\n    shareTemplates,\\n    coupons,\\n    userProfile,\\n    addToBasket,\\n    removeFromBasket,\\n    reorderBasket,\\n    updateBasketItemSettings,\\n    applyPresetToAllBasket,\\n    saveCurrentBasket,\\n    loadSavedBasket,\\n    createPreset,\\n    deletePreset,\\n    createMarketplaceOrder,\\n    addShareTemplate,\\n    setActiveTab,\\n    notify,\\n  } = usePrintReady();\\n\\n  const verifiedShops = useMemo(\\n    () => shops.filter((s) => s.verificationStatus === \'verified\'),\\n    [shops]\\n  );\\n\\n  const [selectedShopId, setSelectedShopId] = useState<string>(verifiedShops[0]?.id || shops[0]?.id || \'\');\\n  const [fulfillmentType, setFulfillmentType] = useState<\'pickup\' | \'delivery\'>(\'pickup\');\\n  const [deliveryAddress, setDeliveryAddress] = useState(\\n    userProfile.addresses.find((a) => a.isDefault)?.line1 || \'\'\\n  );\\n  const [preferredTime, setPreferredTime] = useState(\'Today, 06:00 PM\');\\n  const [orderInstructions, setOrderInstructions] = useState(\'\');\\n  const [priority, setPriority] = useState<\'normal\' | \'urgent\'>(\'normal\');\\n  const [couponInput, setCouponInput] = useState(\'\');\\n  const [appliedCouponCode, setAppliedCouponCode] = useState<string | null>(null);\\n\\n  // Preset & Collection modal states\\n  const [showSaveCollection, setShowSaveCollection] = useState(false);\\n  const [collectionName, setCollectionName] = useState(\'\');\\n  const [showNewPreset, setShowNewPreset] = useState(false);\\n  const [newPresetName, setNewPresetName] = useState(\'\');\\n  const [newPresetSettings, setNewPresetSettings] = useState(DEFAULT_PRINT_SETTINGS);\\n\\n  // Direct Share modal state (WhatsApp, Email, Native Share, Templates)\\n  const [showShareModal, setShowShareModal] = useState(false);\\n  const [shareSavedShopId, setShareSavedShopId] = useState(savedShops[0]?.id || \'\');\\n  const [selectedTemplateId, setSelectedTemplateId] = useState(shareTemplates[0]?.id || \'\');\\n  const [emailCc, setEmailCc] = useState(\'\');\\n  const [newTplName, setNewTplName] = useState(\'\');\\n  const [newTplBody, setNewTplBody] = useState(\'\');\\n\\n  const selectedShop = useMemo(\\n    () => shops.find((s) => s.id === selectedShopId) || verifiedShops[0] || shops[0],\\n    [selectedShopId, shops, verifiedShops]\\n  );\\n\\n  const appliedCoupon = useMemo(\\n    () => (appliedCouponCode ? coupons.find((c) => c.code === appliedCouponCode) || null : null),\\n    [appliedCouponCode, coupons]\\n  );\\n\\n  const estimate = useMemo(\\n    () =>\\n      calculateOrderEstimate(basket, selectedShop?.pricing, {\\n        fulfillmentType,\\n        coupon: appliedCoupon,\\n      }),\\n    [appliedCoupon, basket, fulfillmentType, selectedShop]\\n  );\\n\\n  const activeDocsNotInBasket = useMemo(\\n    () =>\\n      documents.filter(\\n        (d) => !d.isTrashed && !basket.some((b) => b.documentId === d.id)\\n      ),\\n    [basket, documents]\\n  );\\n\\n  const hasInvalidPageRange = useMemo(\\n    () =>\\n      basket.some((item) => !parsePageRange(item.settings.pageRange, item.pageCount).valid),\\n    [basket]\\n  );\\n\\n  const handleApplyCoupon = () => {\\n    const code = couponInput.trim().toUpperCase();\\n    const match = coupons.find((c) => c.code.toUpperCase() === code);\\n    if (!match) {\\n      notify(\'Invalid coupon code\', `No coupon found matching \\\"${code}\\\". Try STUDENT10.`, \'error\');\\n      return;\\n    }\\n    setAppliedCouponCode(match.code);\\n    notify(\'Coupon applied\', `${match.code}: ${match.description}`, \'success\');\\n  };\\n\\n  const handlePlaceMarketplaceOrder = () => {\\n    if (basket.length === 0) {\\n      notify(\'Print basket is empty\', \'Add at least one document before ordering.\', \'warning\');\\n      return;\\n    }\\n    if (hasInvalidPageRange) {\\n      notify(\'Fix page range errors\', \'One or more documents have an invalid page range.\', \'error\');\\n      return;\\n    }\\n    if (!selectedShop) {\\n      notify(\'Select a shop\', \'Choose a verified printing shop.\', \'warning\');\\n      return;\\n    }\\n    if (fulfillmentType === \'delivery\' && !deliveryAddress.trim()) {\\n      notify(\'Delivery address required\', \'Enter a delivery address or switch to Pickup.\', \'warning\');\\n      return;\\n    }\\n\\n    createMarketplaceOrder({\\n      shopId: selectedShop.id,\\n      items: basket,\\n      fulfillmentType,\\n      deliveryAddress: fulfillmentType === \'delivery\' ? deliveryAddress : undefined,\\n      preferredTime,\\n      specialInstructions: orderInstructions,\\n      estimatedTotal: estimate.grandTotal,\\n      discountAmount: estimate.discount,\\n      couponCode: appliedCoupon?.code,\\n      priority,\\n    });\\n    setActiveTab(\'orders\');\\n  };\\n\\n  // Direct Share composed message\\n  const activeShareShop = savedShops.find((s) => s.id === shareSavedShopId) || savedShops[0];\\n  const activeTemplate = shareTemplates.find((t) => t.id === selectedTemplateId) || shareTemplates[0];\\n\\n  const shareSummarySettings = basket\\n    .map(\\n      (b) =>\\n        `${b.documentName} [${b.settings.paperSize}, ${b.settings.colorMode === \'color\' ? \'Color\' : \'B&W\'}, ${\\n          b.settings.sides === \'double\' ? \'Duplex\' : \'Single\'\\n        }, Pages: ${b.settings.pageRange}, Binding: ${b.settings.binding}]`\\n    )\\n    .join(\'; \');\\n\\n  const composedShareText = renderShareTemplate(\\n    activeTemplate?.body ||\\n      \'Hello {{shopName}}, please print {{documents}}. Settings: {{settings}}. Copies: {{copies}}.\',\\n    {\\n      customerName: userProfile.displayName,\\n      shopName: activeShareShop?.shopName || selectedShop?.name || \'Print Shop\',\\n      documents: basket.map((b) => b.documentName).join(\', \') || \'No files selected\',\\n      copies: String(estimate.totalCopies || 1),\\n      settings: shareSummarySettings || \'Standard A4 B&W\',\\n      pickupTime: preferredTime,\\n      orderNumber: `DIRECT-${Date.now().toString(36).toUpperCase().slice(-5)}`,\\n    }\\n  );\\n\\n  const handleNativeWebShare = async () => {\\n    if (typeof navigator !== \'undefined\' && \'share\' in navigator) {\\n      try {\\n        await navigator.share({\\n          title: `PrintReady Job \342\200\224 ${basket.length} document(s)`,\\n          text: composedShareText,\\n        });\\n        notify(\'Shared via system sheet\', \'Print instructions sent to native share sheet.\', \'success\');\\n      } catch {\\n        notify(\'Share cancelled\', \'You can also copy the message or open WhatsApp/Email below.\', \'info\');\\n      }\\n    } else {\\n      await navigator.clipboard?.writeText(composedShareText);\\n      notify(\'Copied to clipboard\', \'Native share sheet is unavailable in this browser; message copied.\', \'info\');\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n      {/* Left 8 Columns: Basket Items, Per-Doc Print Settings & Presets */}\\n      <div className=\\\"lg:col-span-8 space-y-6\\\">\\n        {/* Presets & Collections Bar */}\\n        <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n            <div>\\n              <h2 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Print Presets & Collections</h2>\\n              <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                Apply a saved preset to all queued files or save this basket for repeat printing.\\n              </p>\\n            </div>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowNewPreset((v) => !v)}\\n                className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 rounded-lg whitespace-nowrap\\\"\\n              >\\n                <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                New Preset\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                disabled={basket.length === 0}\\n                onClick={() => setShowSaveCollection((v) => !v)}\\n                className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-lg disabled:opacity-40 whitespace-nowrap\\\"\\n              >\\n                <Bookmark className=\\\"w-3.5 h-3.5\\\" />\\n                Save Basket\\n              </button>\\n            </div>\\n          </div>\\n\\n          {showSaveCollection && (\\n            <div className=\\\"flex gap-2 p-3 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={collectionName}\\n                onChange={(e) => setCollectionName(e.target.value)}\\n                placeholder=\\\"Collection name (e.g. Placement Interview Pack)\\\"\\n                aria-label=\\\"Collection name\\\"\\n                className=\\\"flex-1 px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  if (collectionName.trim()) {\\n                    saveCurrentBasket(collectionName);\\n                    setCollectionName(\'\');\\n                    setShowSaveCollection(false);\\n                  }\\n                }}\\n                className=\\\"px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-700 rounded-md\\\"\\n              >\\n                Save\\n              </button>\\n            </div>\\n          )}\\n\\n          {showNewPreset && (\\n            <div className=\\\"p-4 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800 space-y-3\\\">\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-4 gap-2.5\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  value={newPresetName}\\n                  onChange={(e) => setNewPresetName(e.target.value)}\\n                  placeholder=\\\"Preset name (e.g. Legal Brief)\\\"\\n                  aria-label=\\\"Preset name\\\"\\n                  className=\\\"sm:col-span-2 px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                />\\n                <select\\n                  value={newPresetSettings.paperSize}\\n                  onChange={(e) =>\\n                    setNewPresetSettings((s) => ({ ...s, paperSize: e.target.value as PaperSize }))\\n                  }\\n                  aria-label=\\\"Preset paper size\\\"\\n                  className=\\\"px-2.5 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                >\\n                  {[\'A4\', \'A3\', \'A5\', \'Letter\', \'Legal\', \'Custom\'].map((sz) => (\\n                    <option key={sz} value={sz}>{sz}</option>\\n                  ))}\\n                </select>\\n                <select\\n                  value={newPresetSettings.colorMode}\\n                  onChange={(e) =>\\n                    setNewPresetSettings((s) => ({ ...s, colorMode: e.target.value as \'bw\' | \'color\' }))\\n                  }\\n                  aria-label=\\\"Preset color mode\\\"\\n                  className=\\\"px-2.5 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                >\\n                  <option value=\\\"bw\\\">Black & White</option>\\n                  <option value=\\\"color\\\">Color</option>\\n                </select>\\n              </div>\\n              <div className=\\\"flex justify-end gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowNewPreset(false)}\\n                  className=\\\"px-3 py-1.5 text-xs text-slate-600 dark:text-slate-400\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    if (newPresetName.trim()) {\\n                      createPreset(newPresetName, newPresetSettings);\\n                      setNewPresetName(\'\');\\n                      setShowNewPreset(false);\\n                    }\\n                  }}\\n                  className=\\\"px-3.5 py-1.5 text-xs font-medium text-white bg-indigo-700 rounded-md\\\"\\n                >\\n                  Save Preset\\n                </button>\\n              </div>\\n            </div>\\n          )}\\n\\n          <div className=\\\"flex flex-wrap gap-2\\\">\\n            {presets.map((p) => (\\n              <div\\n                key={p.id}\\n                className=\\\"inline-flex items-center gap-1.5 border border-slate-200 dark:border-slate-700 rounded-lg px-2.5 py-1.5 text-xs\\\"\\n              >\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => applyPresetToAllBasket(p)}\\n                  className=\\\"font-medium text-slate-800 dark:text-slate-200 hover:text-indigo-700 dark:hover:text-indigo-300 whitespace-nowrap\\\"\\n                >\\n                  {p.name}\\n                </button>\\n                <span className=\\\"text-slate-400\\\">\302\267</span>\\n                <span className=\\\"text-slate-500 whitespace-nowrap\\\">\\n                  {p.settings.paperSize} {p.settings.colorMode === \'color\' ? \'Color\' : \'B&W\'}\\n                </span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => deletePreset(p.id)}\\n                  aria-label={`Delete preset ${p.name}`}\\n                  className=\\\"text-slate-400 hover:text-red-600 ml-1\\\"\\n                >\\n                  <X className=\\\"w-3 h-3\\\" />\\n                </button>\\n              </div>\\n            ))}\\n          </div>\\n\\n          {savedBaskets.length > 0 && (\\n            <div className=\\\"pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center gap-2 text-xs\\\">\\n              <span className=\\\"text-slate-500\\\">Saved collections:</span>\\n              {savedBaskets.map((sb) => (\\n                <button\\n                  key={sb.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => loadSavedBasket(sb.id)}\\n                  className=\\\"text-indigo-700 dark:text-indigo-400 hover:underline font-medium\\\"\\n                >\\n                  {sb.name} ({sb.items.length})\\n                </button>\\n              ))}\\n            </div>\\n          )}\\n        </section>\\n\\n        {/* Basket Items & Per-Document Configuration */}\\n        <section className=\\\"space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">\\n              Queued Documents ({basket.length})\\n            </h3>\\n            {activeDocsNotInBasket.length > 0 && (\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <label htmlFor=\\\"quick-add-doc\\\" className=\\\"text-xs text-slate-500\\\">\\n                  Add from Vault:\\n                </label>\\n                <select\\n                  id=\\\"quick-add-doc\\\"\\n                  defaultValue=\\\"\\\"\\n                  onChange={(e) => {\\n                    const doc = documents.find((d) => d.id === e.target.value);\\n                    if (doc) addToBasket(doc);\\n                    e.target.value = \'\';\\n                  }}\\n                  className=\\\"px-2.5 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg max-w-xs\\\"\\n                >\\n                  <option value=\\\"\\\">Choose document...</option>\\n                  {activeDocsNotInBasket.map((d) => (\\n                    <option key={d.id} value={d.id}>\\n                      {d.name} ({d.pageCount}p)\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            )}\\n          </div>\\n\\n          {basket.length === 0 ? (\\n            <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-10 text-center space-y-3\\\">\\n              <Printer className=\\\"w-8 h-8 text-slate-400 mx-auto\\\" />\\n              <p className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Your print basket is empty</p>\\n              <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                Select files from your Document Vault above or browse your folders to queue documents.\\n              </p>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'vault\')}\\n                className=\\\"px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n              >\\n                Browse Document Vault\\n              </button>\\n            </div>\\n          ) : (\\n            basket.map((item, idx) => {\\n              const rangeCheck = parsePageRange(item.settings.pageRange, item.pageCount);\\n              const breakdown = estimate.items.find((b) => b.itemId === item.id);\\n\\n              return (\\n                <article\\n                  key={item.id}\\n                  className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\"\\n                >\\n                  <div className=\\\"flex items-start justify-between gap-3\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <h4 className=\\\"text-sm font-semibold text-slate-900 dark:text-white truncate\\\">\\n                        {idx + 1}. {item.documentName}\\n                      </h4>\\n                      <p className=\\\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\\\">\\n                        {item.extension.toUpperCase()} \302\267 <span className=\\\"font-mono tabular-nums\\\">{item.pageCount} total pages</span> \302\267{\' \'}\\n                        <span className=\\\"font-mono tabular-nums\\\">{formatFileSize(item.sizeBytes)}</span>\\n                        {breakdown && (\\n                          <>\\n                            {\' \'}\302\267 Est. <span className=\\\"font-mono tabular-nums font-semibold text-slate-800 dark:text-slate-200\\\">{breakdown.estimatedSheets} sheets</span> \302\267{\' \'}\\n                            <span className=\\\"font-mono tabular-nums font-semibold text-indigo-700 dark:text-indigo-400\\\">\\n                              {formatCurrency(breakdown.itemTotal, estimate.currency)}\\n                            </span>\\n                          </>\\n                        )}\\n                      </p>\\n                    </div>\\n                    <div className=\\\"flex items-center gap-1 shrink-0\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        disabled={idx === 0}\\n                        onClick={() => reorderBasket(idx, idx - 1)}\\n                        aria-label={`Move ${item.documentName} up`}\\n                        className=\\\"p-1.5 text-slate-400 hover:text-slate-700 disabled:opacity-30 rounded\\\"\\n                      >\\n                        <ArrowUp className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        disabled={idx === basket.length - 1}\\n                        onClick={() => reorderBasket(idx, idx + 1)}\\n                        aria-label={`Move ${item.documentName} down`}\\n                        className=\\\"p-1.5 text-slate-400 hover:text-slate-700 disabled:opacity-30 rounded\\\"\\n                      >\\n                        <ArrowDown className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => removeFromBasket(item.id)}\\n                        aria-label={`Remove ${item.documentName} from basket`}\\n                        className=\\\"p-1.5 text-slate-400 hover:text-red-600 rounded\\\"\\n                      >\\n                        <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n\\n                  {/* Per-Document Settings Grid */}\\n                  <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\\\">\\n                    <div>\\n                      <label htmlFor={`copies-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Copies\\n                      </label>\\n                      <input\\n                        id={`copies-${item.id}`}\\n                        type=\\\"number\\\"\\n                        min={1}\\n                        max={500}\\n                        value={item.settings.copies}\\n                        onChange={(e) =>\\n                          updateBasketItemSettings(item.id, { copies: Math.max(1, Number(e.target.value) || 1) })\\n                        }\\n                        className=\\\"w-full px-2.5 py-1.5 font-mono tabular-nums bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                      />\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`size-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Paper Size\\n                      </label>\\n                      <select\\n                        id={`size-${item.id}`}\\n                        value={item.settings.paperSize}\\n                        onChange={(e) =>\\n                          updateBasketItemSettings(item.id, { paperSize: e.target.value as PaperSize })\\n                        }\\n                        className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                      >\\n                        {([\'A4\', \'A3\', \'A5\', \'Letter\', \'Legal\', \'Custom\'] as PaperSize[]).map((sz) => (\\n                          <option key={sz} value={sz}>{sz}</option>\\n                        ))}\\n                      </select>\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`color-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Color Mode\\n                      </label>\\n                      <select\\n                        id={`color-${item.id}`}\\n                        value={item.settings.colorMode}\\n                        onChange={(e) =>\\n                          updateBasketItemSettings(item.id, { colorMode: e.target.value as \'bw\' | \'color\' })\\n                        }\\n                        className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                      >\\n                        <option value=\\\"bw\\\">Black & White</option>\\n                        <option value=\\\"color\\\">Full Color</option>\\n                      </select>\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`sides-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Sides\\n                      </label>\\n                      <select\\n                        id={`sides-${item.id}`}\\n                        value={item.settings.sides}\\n                        onChange={(e) =>\\n                          updateBasketItemSettings(item.id, { sides: e.target.value as \'single\' | \'double\' })\\n                        }\\n                        className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                      >\\n                        <option value=\\\"single\\\">Single-sided</option>\\n                        <option value=\\\"double\\\">Double-sided (Duplex)</option>\\n                      </select>\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`range-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Page Range\\n                      </label>\\n                      <input\\n                        id={`range-${item.id}`}\\n                        type=\\\"text\\\"\\n                        value={item.settings.pageRange}\\n                        onChange={(e) => updateBasketItemSettings(item.id, { pageRange: e.target.value })}\\n                        placeholder=\\\"all or 1-3, 5\\\"\\n                        className={`w-full px-2.5 py-1.5 font-mono bg-slate-50 dark:bg-slate-950 border rounded-md ${\\n                          rangeCheck.valid\\n                            ? \'border-slate-200 dark:border-slate-700\'\\n                            : \'border-red-500 text-red-700 dark:text-red-400\'\\n                        }`}\\n                      />\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`orient-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Orientation & N-up\\n                      </label>\\n                      <div className=\\\"flex gap-1\\\">\\n                        <select\\n                          id={`orient-${item.id}`}\\n                          value={item.settings.orientation}\\n                          onChange={(e) =>\\n                            updateBasketItemSettings(item.id, {\\n                              orientation: e.target.value as \'portrait\' | \'landscape\',\\n                            })\\n                          }\\n                          className=\\\"flex-1 min-w-0 px-1.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                        >\\n                          <option value=\\\"portrait\\\">Portrait</option>\\n                          <option value=\\\"landscape\\\">Landscape</option>\\n                        </select>\\n                        <select\\n                          aria-label={`Pages per sheet for ${item.documentName}`}\\n                          value={item.settings.pagesPerSheet}\\n                          onChange={(e) =>\\n                            updateBasketItemSettings(item.id, {\\n                              pagesPerSheet: Number(e.target.value) as 1 | 2 | 4,\\n                            })\\n                          }\\n                          className=\\\"w-16 px-1.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                        >\\n                          <option value={1}>1-up</option>\\n                          <option value={2}>2-up</option>\\n                          <option value={4}>4-up</option>\\n                        </select>\\n                      </div>\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`paper-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Paper Quality\\n                      </label>\\n                      <select\\n                        id={`paper-${item.id}`}\\n                        value={item.settings.paperType}\\n                        onChange={(e) =>\\n                          updateBasketItemSettings(item.id, { paperType: e.target.value as PaperType })\\n                        }\\n                        className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                      >\\n                        <option value=\\\"standard_75gsm\\\">Standard 75gsm</option>\\n                        <option value=\\\"premium_100gsm\\\">Premium 100gsm</option>\\n                        <option value=\\\"bond_executive\\\">Executive Bond</option>\\n                        <option value=\\\"glossy_photo\\\">Glossy Photo</option>\\n                      </select>\\n                    </div>\\n\\n                    <div>\\n                      <label htmlFor={`bind-${item.id}`} className=\\\"block text-slate-500 dark:text-slate-400 mb-1\\\">\\n                        Binding / Finish\\n                      </label>\\n                      <select\\n                        id={`bind-${item.id}`}\\n                        value={item.settings.binding}\\n                        onChange={(e) =>\\n                          updateBasketItemSettings(item.id, { binding: e.target.value as BindingOption })\\n                        }\\n                        className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                      >\\n                        <option value=\\\"none\\\">None</option>\\n                        <option value=\\\"staple\\\">Corner Staple</option>\\n                        <option value=\\\"spiral\\\">Spiral Binding</option>\\n                        <option value=\\\"hardcover\\\">Hardcover</option>\\n                        <option value=\\\"lamination\\\">Lamination</option>\\n                      </select>\\n                    </div>\\n                  </div>\\n\\n                  {/* Live Layout Preview + Validation Warnings */}\\n                  <div className=\\\"pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n                    <div className=\\\"flex items-center gap-3\\\">\\n                      {/* Visual paper orientation & color indicator */}\\n                      <div\\n                        aria-hidden=\\\"true\\\"\\n                        className={`border border-slate-300 dark:border-slate-600 rounded flex items-center justify-center text-[9px] font-mono ${\\n                          item.settings.orientation === \'landscape\' ? \'w-12 h-9\' : \'w-9 h-12\'\\n                        } ${\\n                          item.settings.colorMode === \'color\'\\n                            ? \'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300\'\\n                            : \'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300\'\\n                        }`}\\n                      >\\n                        {item.settings.paperSize}\\n                      </div>\\n                      <div className=\\\"text-xs text-slate-500 dark:text-slate-400 space-y-0.5\\\">\\n                        <p>\\n                          Preview: {item.settings.orientation} \302\267 {item.settings.scaling} scaling \302\267 {item.settings.pagesPerSheet} page/sheet \302\267{\' \'}\\n                          {item.settings.collate ? \'Collated\' : \'Uncollated\'}\\n                        </p>\\n                        <p className=\\\"text-[11px] text-slate-400\\\">\\n                          Layout preview is approximate; final color & margins depend on shop printer hardware.\\n                        </p>\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  {(!rangeCheck.valid || (breakdown && breakdown.warnings.length > 0)) && (\\n                    <div className=\\\"text-xs text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 rounded-lg p-3 space-y-1\\\">\\n                      {!rangeCheck.valid && (\\n                        <p className=\\\"flex items-center gap-1.5 font-medium text-red-700 dark:text-red-400\\\">\\n                          <AlertTriangle className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                          {rangeCheck.error}\\n                        </p>\\n                      )}\\n                      {breakdown?.warnings\\n                        .filter((w) => w !== rangeCheck.error)\\n                        .map((w, i) => (\\n                          <p key={i} className=\\\"flex items-center gap-1.5\\\">\\n                            <AlertTriangle className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                            {w}\\n                          </p>\\n                        ))}\\n                    </div>\\n                  )}\\n                </article>\\n              );\\n            })\\n          )}\\n        </section>\\n      </div>\\n\\n      {/* Right 4 Columns: Cost Calculator, Direct Share & Marketplace Checkout */}\\n      <div className=\\\"lg:col-span-4 space-y-5\\\">\\n        <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n          <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Print Cost Estimate & Checkout</h3>\\n\\n          <div>\\n            <label htmlFor=\\\"checkout-shop\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n              Registered Print Shop\\n            </label>\\n            <select\\n              id=\\\"checkout-shop\\\"\\n              value={selectedShopId}\\n              onChange={(e) => setSelectedShopId(e.target.value)}\\n              className=\\\"w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            >\\n              {verifiedShops.map((s) => (\\n                <option key={s.id} value={s.id}>\\n                  {s.name} ({s.distanceKm} km \302\267 \342\202\271{s.pricing.bwPerPageA4}/p B&W)\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setFulfillmentType(\'pickup\')}\\n              className={`py-2 text-xs font-medium rounded-lg border transition-colors ${\\n                fulfillmentType === \'pickup\'\\n                  ? \'border-indigo-600 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-200\'\\n                  : \'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300\'\\n              }`}\\n            >\\n              Shop Pickup\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              disabled={!selectedShop?.deliveryAvailable}\\n              onClick={() => setFulfillmentType(\'delivery\')}\\n              className={`py-2 text-xs font-medium rounded-lg border transition-colors disabled:opacity-40 ${\\n                fulfillmentType === \'delivery\'\\n                  ? \'border-indigo-600 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-200\'\\n                  : \'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300\'\\n              }`}\\n            >\\n              Delivery ({formatCurrency(selectedShop?.pricing.deliveryFee || 0)})\\n            </button>\\n          </div>\\n\\n          {fulfillmentType === \'delivery\' && (\\n            <div>\\n              <label htmlFor=\\\"delivery-address\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                Delivery Address\\n              </label>\\n              <input\\n                id=\\\"delivery-address\\\"\\n                type=\\\"text\\\"\\n                value={deliveryAddress}\\n                onChange={(e) => setDeliveryAddress(e.target.value)}\\n                placeholder=\\\"Street, room/flat, landmark\\\"\\n                className=\\\"w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n          )}\\n\\n          <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n            <div>\\n              <label htmlFor=\\\"pref-time\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                Preferred Time\\n              </label>\\n              <input\\n                id=\\\"pref-time\\\"\\n                type=\\\"text\\\"\\n                value={preferredTime}\\n                onChange={(e) => setPreferredTime(e.target.value)}\\n                className=\\\"w-full px-2.5 py-1.5 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"order-priority\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                Priority\\n              </label>\\n              <select\\n                id=\\\"order-priority\\\"\\n                value={priority}\\n                onChange={(e) => setPriority(e.target.value as \'normal\' | \'urgent\')}\\n                className=\\\"w-full px-2.5 py-1.5 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              >\\n                <option value=\\\"normal\\\">Standard</option>\\n                <option value=\\\"urgent\\\">Urgent</option>\\n              </select>\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label htmlFor=\\\"order-notes\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n              Special Instructions for Shop\\n            </label>\\n            <textarea\\n              id=\\\"order-notes\\\"\\n              rows={2}\\n              value={orderInstructions}\\n              onChange={(e) => setOrderInstructions(e.target.value)}\\n              placeholder=\\\"e.g. Call before binding if margins look tight\\\"\\n              className=\\\"w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n          </div>\\n\\n          {/* Coupon Input */}\\n          <div className=\\\"flex gap-1.5\\\">\\n            <input\\n              type=\\\"text\\\"\\n              value={couponInput}\\n              onChange={(e) => setCouponInput(e.target.value)}\\n              placeholder=\\\"Coupon (e.g. STUDENT10)\\\"\\n              aria-label=\\\"Coupon code\\\"\\n              className=\\\"flex-1 min-w-0 px-3 py-1.5 text-xs font-mono uppercase bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleApplyCoupon}\\n              className=\\\"px-3 py-1.5 text-xs font-medium text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 rounded-lg whitespace-nowrap\\\"\\n            >\\n              Apply\\n            </button>\\n          </div>\\n          {estimate.couponError && (\\n            <p className=\\\"text-xs text-amber-700 dark:text-amber-400\\\">{estimate.couponError}</p>\\n          )}\\n\\n          {/* Price Breakdown Table */}\\n          <div className=\\\"pt-3 border-t border-slate-200 dark:border-slate-800 space-y-1.5 text-xs\\\">\\n            <div className=\\\"flex justify-between text-slate-600 dark:text-slate-400\\\">\\n              <span>Pages / Estimated Sheets</span>\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {estimate.totalPrintedPages}p / {estimate.totalSheets} sheets\\n              </span>\\n            </div>\\n            <div className=\\\"flex justify-between text-slate-600 dark:text-slate-400\\\">\\n              <span>Printing & Finishing Subtotal</span>\\n              <span className=\\\"font-mono tabular-nums\\\">{formatCurrency(estimate.subtotal, estimate.currency)}</span>\\n            </div>\\n            {estimate.discount > 0 && (\\n              <div className=\\\"flex justify-between text-emerald-700 dark:text-emerald-400\\\">\\n                <span>Coupon Discount ({appliedCoupon?.code})</span>\\n                <span className=\\\"font-mono tabular-nums\\\">-{formatCurrency(estimate.discount, estimate.currency)}</span>\\n              </div>\\n            )}\\n            <div className=\\\"flex justify-between text-slate-600 dark:text-slate-400\\\">\\n              <span>Service Fee</span>\\n              <span className=\\\"font-mono tabular-nums\\\">{formatCurrency(estimate.serviceCharge, estimate.currency)}</span>\\n            </div>\\n            {estimate.deliveryFee > 0 && (\\n              <div className=\\\"flex justify-between text-slate-600 dark:text-slate-400\\\">\\n                <span>Delivery Fee</span>\\n                <span className=\\\"font-mono tabular-nums\\\">{formatCurrency(estimate.deliveryFee, estimate.currency)}</span>\\n              </div>\\n            )}\\n            <div className=\\\"flex justify-between text-slate-600 dark:text-slate-400\\\">\\n              <span>Estimated Tax ({selectedShop?.pricing.taxRatePercent ?? 5}%)</span>\\n              <span className=\\\"font-mono tabular-nums\\\">{formatCurrency(estimate.tax, estimate.currency)}</span>\\n            </div>\\n            <div className=\\\"flex justify-between pt-2 border-t border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white\\\">\\n              <span>Estimated Total</span>\\n              <span className=\\\"font-mono tabular-nums\\\">{formatCurrency(estimate.grandTotal, estimate.currency)}</span>\\n            </div>\\n            <p className=\\\"text-[11px] text-slate-500 dark:text-slate-400 pt-1\\\">\\n              Price remains an estimate until confirmed by the shop. You approve any price change before paying.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"space-y-2 pt-1\\\">\\n            <button\\n              type=\\\"button\\\"\\n              disabled={basket.length === 0 || hasInvalidPageRange}\\n              onClick={handlePlaceMarketplaceOrder}\\n              className=\\\"w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-indigo-700 hover:bg-indigo-800 disabled:opacity-50 rounded-lg transition-colors\\\"\\n            >\\n              <Send className=\\\"w-4 h-4\\\" />\\n              Submit Marketplace Order\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              disabled={basket.length === 0}\\n              onClick={() => setShowShareModal(true)}\\n              className=\\\"w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 rounded-lg transition-colors\\\"\\n            >\\n              <Share2 className=\\\"w-3.5 h-3.5\\\" />\\n              Direct Share (WhatsApp / Email / Native)\\n            </button>\\n          </div>\\n        </section>\\n      </div>\\n\\n      {/* Direct Sharing Modal (WhatsApp, Email, Native Share, Message Templates) */}\\n      {showShareModal && (\\n        <div className=\\\"fixed inset-0 z-50 bg-slate-950/50 flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div>\\n                <h3 className=\\\"text-lg font-bold text-slate-900 dark:text-white\\\">Direct Share to Print Shop</h3>\\n                <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                  Send print instructions to any saved shop (registered or unregistered) via WhatsApp, Email, or native share.\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowShareModal(false)}\\n                aria-label=\\\"Close direct share modal\\\"\\n                className=\\\"p-1.5 text-slate-400 hover:text-slate-800 dark:hover:text-white\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"share-shop-select\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                  Saved Print Shop\\n                </label>\\n                <select\\n                  id=\\\"share-shop-select\\\"\\n                  value={shareSavedShopId}\\n                  onChange={(e) => setShareSavedShopId(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                >\\n                  {savedShops.map((s) => (\\n                    <option key={s.id} value={s.id}>\\n                      {s.shopName} ({s.group})\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"share-template-select\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                  Message Template\\n                </label>\\n                <select\\n                  id=\\\"share-template-select\\\"\\n                  value={selectedTemplateId}\\n                  onChange={(e) => setSelectedTemplateId(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                >\\n                  {shareTemplates.map((t) => (\\n                    <option key={t.id} value={t.id}>\\n                      {t.name}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"share-preview-text\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                Prepared Message Preview\\n              </label>\\n              <textarea\\n                id=\\\"share-preview-text\\\"\\n                readOnly\\n                rows={4}\\n                value={composedShareText}\\n                className=\\\"w-full px-3 py-2 text-xs font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg text-slate-800 dark:text-slate-200\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"share-cc\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                Email CC (optional)\\n              </label>\\n              <input\\n                id=\\\"share-cc\\\"\\n                type=\\\"email\\\"\\n                value={emailCc}\\n                onChange={(e) => setEmailCc(e.target.value)}\\n                placeholder=\\\"colleague@company.com\\\"\\n                className=\\\"w-full px-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg text-xs text-slate-600 dark:text-slate-400 space-y-1\\\">\\n              <p className=\\\"font-medium text-slate-800 dark:text-slate-200 flex items-center gap-1.5\\\">\\n                <CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                Honest Platform Behavior\\n              </p>\\n              <p>\\n                Ordinary WhatsApp and email composers require you to attach files and tap Send inside the app. On Android/mobile browsers, Native Share passes files where supported.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap gap-2.5\\\">\\n              <a\\n                href={buildWhatsAppUrl(activeShareShop?.whatsapp || \'\', composedShareText)}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                onClick={() => notify(\'WhatsApp composer prepared\', \'Confirm attachment and tap Send in WhatsApp.\', \'info\')}\\n                className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg\\\"\\n              >\\n                <MessageCircle className=\\\"w-3.5 h-3.5\\\" />\\n                Open WhatsApp\\n              </a>\\n              <a\\n                href={buildMailtoUrl(\\n                  activeShareShop?.email || \'\',\\n                  `Print Request \342\200\224 ${basket.length} file(s) from ${userProfile.displayName}`,\\n                  composedShareText,\\n                  emailCc\\n                )}\\n                onClick={() => notify(\'Email composer prepared\', \'Recipient, subject, and print instructions populated.\', \'info\')}\\n                className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n              >\\n                <Mail className=\\\"w-3.5 h-3.5\\\" />\\n                Open Email Composer\\n              </a>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleNativeWebShare}\\n                className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg\\\"\\n              >\\n                <Share2 className=\\\"w-3.5 h-3.5\\\" />\\n                Native Share / Copy\\n              </button>\\n            </div>\\n\\n            {/* Add Custom Share Template */}\\n            <div className=\\\"pt-4 border-t border-slate-200 dark:border-slate-800 space-y-2\\\">\\n              <p className=\\\"text-xs font-semibold text-slate-800 dark:text-slate-200\\\">Create Custom Template</p>\\n              <div className=\\\"flex flex-col sm:flex-row gap-2\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  value={newTplName}\\n                  onChange={(e) => setNewTplName(e.target.value)}\\n                  placeholder=\\\"Template name\\\"\\n                  className=\\\"sm:w-44 px-2.5 py-1.5 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                />\\n                <input\\n                  type=\\\"text\\\"\\n                  value={newTplBody}\\n                  onChange={(e) => setNewTplBody(e.target.value)}\\n                  placeholder=\\\"Variables: {{customerName}}, {{shopName}}, {{documents}}, {{copies}}, {{settings}}\\\"\\n                  className=\\\"flex-1 px-2.5 py-1.5 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                />\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    if (newTplName.trim() && newTplBody.trim()) {\\n                      addShareTemplate(newTplName, newTplBody);\\n                      setNewTplName(\'\');\\n                      setNewTplBody(\'\');\\n                    }\\n                  }}\\n                  className=\\\"px-3 py-1.5 text-xs font-medium text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 rounded-md whitespace-nowrap\\\"\\n                >\\n                  Save Template\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build PrintBasketView with per-document settings, presets, page range validation, print preview, cost calculator, coupons, direct WhatsApp/Email sharing, and marketplace checkout\", \"Overwrite\":true, \"TargetFile\":\"/src/components/customer/PrintBasketView.tsx\", \"toolAction\":\"Creating PrintBasketView component\", \"toolSummary\":\"Create PrintBasketView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_18054687131319576425"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Bookmark,\\n  CheckCircle2,\\n  Clock,\\n  LocateFixed,\\n  Mail,\\n  Map as MapIcon,\\n  MapPin,\\n  MessageCircle,\\n  Phone,\\n  Plus,\\n  Search,\\n  Star,\\n  Store,\\n  Trash2,\\n  X,\\n} from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport { buildMailtoUrl, buildWhatsAppUrl } from \'../../domain/fileValidation\';\\nimport { formatCurrency } from \'../../domain/printCalculator\';\\nimport { RegisteredShop } from \'../../domain/types\';\\n\\nexport function ShopDiscoveryView() {\\n  const {\\n    shops,\\n    savedShops,\\n    reviews,\\n    addSavedShop,\\n    toggleSavedShopFavourite,\\n    setDefaultSavedShop,\\n    deleteSavedShop,\\n    setActiveTab,\\n    notify,\\n  } = usePrintReady();\\n\\n  const [section, setSection] = useState<\'discover\' | \'saved\'>(\'discover\');\\n  const [viewMode, setViewMode] = useState<\'list\' | \'map\'>(\'list\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [manualCity, setManualCity] = useState(\'Bengaluru\');\\n  const [filterOpenNow, setFilterOpenNow] = useState(false);\\n  const [filterDelivery, setFilterDelivery] = useState(false);\\n  const [filterVerifiedOnly, setFilterVerifiedOnly] = useState(true);\\n  const [sortBy, setSortBy] = useState<\'distance\' | \'rating\' | \'price\'>(\'distance\');\\n  const [selectedShop, setSelectedShop] = useState<RegisteredShop | null>(null);\\n\\n  // Saved shops group filter & add custom shop form\\n  const [savedGroupFilter, setSavedGroupFilter] = useState(\'All\');\\n  const [showAddSavedForm, setShowAddSavedForm] = useState(false);\\n  const [customShopForm, setCustomShopForm] = useState({\\n    shopName: \'\',\\n    ownerName: \'\',\\n    phone: \'\',\\n    whatsapp: \'\',\\n    email: \'\',\\n    address: \'\',\\n    group: \'Near home\',\\n    preferredContact: \'whatsapp\' as \'whatsapp\' | \'email\' | \'marketplace\' | \'phone\',\\n    notes: \'\',\\n  });\\n\\n  const discoverShops = useMemo(() => {\\n    let list = shops.filter((s) => s.verificationStatus !== \'suspended\' && s.verificationStatus !== \'rejected\');\\n    if (filterVerifiedOnly) {\\n      list = list.filter((s) => s.verificationStatus === \'verified\');\\n    }\\n    if (filterOpenNow) {\\n      list = list.filter((s) => s.isOpen);\\n    }\\n    if (filterDelivery) {\\n      list = list.filter((s) => s.deliveryAvailable);\\n    }\\n    if (searchQuery.trim()) {\\n      const q = searchQuery.trim().toLowerCase();\\n      list = list.filter(\\n        (s) =>\\n          s.name.toLowerCase().includes(q) ||\\n          s.address.toLowerCase().includes(q) ||\\n          s.services.some((sv) => sv.toLowerCase().includes(q))\\n      );\\n    }\\n    return [...list].sort((a, b) => {\\n      if (sortBy === \'rating\') return b.rating - a.rating;\\n      if (sortBy === \'price\') return a.pricing.bwPerPageA4 - b.pricing.bwPerPageA4;\\n      return a.distanceKm - b.distanceKm;\\n    });\\n  }, [filterDelivery, filterOpenNow, filterVerifiedOnly, searchQuery, shops, sortBy]);\\n\\n  const savedGroups = useMemo(() => {\\n    const groups = new Set([\'Near home\', \'College\', \'Office\', \'Trusted\', \'Cheapest\']);\\n    savedShops.forEach((s) => groups.add(s.group));\\n    return [\'All\', ...Array.from(groups)];\\n  }, [savedShops]);\\n\\n  const filteredSavedShops = useMemo(() => {\\n    if (savedGroupFilter === \'All\') return savedShops;\\n    return savedShops.filter((s) => s.group === savedGroupFilter);\\n  }, [savedGroupFilter, savedShops]);\\n\\n  const requestGpsLocation = () => {\\n    if (!navigator.geolocation) {\\n      notify(\'Geolocation unavailable\', \'Enter your city or neighborhood manually.\', \'info\');\\n      return;\\n    }\\n    navigator.geolocation.getCurrentPosition(\\n      (pos) => {\\n        setManualCity(`${pos.coords.latitude.toFixed(3)}, ${pos.coords.longitude.toFixed(3)}`);\\n        notify(\'Location updated\', \'Showing nearby printing shops sorted by distance.\', \'success\');\\n      },\\n      () => {\\n        notify(\'Location access optional\', \'Manual city filter remains active.\', \'info\');\\n      }\\n    );\\n  };\\n\\n  const handleSaveUnregisteredShop = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!customShopForm.shopName.trim()) {\\n      notify(\'Shop name required\', \'Enter the name of the printing shop.\', \'warning\');\\n      return;\\n    }\\n    addSavedShop({\\n      ...customShopForm,\\n      isFavourite: false,\\n      isDefault: savedShops.length === 0,\\n    });\\n    setCustomShopForm({\\n      shopName: \'\',\\n      ownerName: \'\',\\n      phone: \'\',\\n      whatsapp: \'\',\\n      email: \'\',\\n      address: \'\',\\n      group: \'Near home\',\\n      preferredContact: \'whatsapp\',\\n      notes: \'\',\\n    });\\n    setShowAddSavedForm(false);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Header & Section Toggle */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h2 className=\\\"text-xl font-bold text-slate-900 dark:text-white\\\">Print Shops Directory</h2>\\n          <p className=\\\"text-sm text-slate-500 dark:text-slate-400\\\">\\n            Discover verified marketplace print shops or save your own trusted local shops for quick sharing.\\n          </p>\\n        </div>\\n        <div className=\\\"inline-flex p-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg self-start\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setSection(\'discover\')}\\n            className={`px-3.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n              section === \'discover\'\\n                ? \'bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 shadow-xs\'\\n                : \'text-slate-600 dark:text-slate-400\'\\n            }`}\\n          >\\n            Discover Shops ({discoverShops.length})\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setSection(\'saved\')}\\n            className={`px-3.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n              section === \'saved\'\\n                ? \'bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 shadow-xs\'\\n                : \'text-slate-600 dark:text-slate-400\'\\n            }`}\\n          >\\n            Saved Shops ({savedShops.length})\\n          </button>\\n        </div>\\n      </div>\\n\\n      {section === \'discover\' ? (\\n        <div className=\\\"space-y-5\\\">\\n          {/* Search, Manual Location & Filters */}\\n          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 space-y-3\\\">\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-12 gap-2.5\\\">\\n              <div className=\\\"md:col-span-5 relative\\\">\\n                <Search className=\\\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n                <input\\n                  type=\\\"search\\\"\\n                  value={searchQuery}\\n                  onChange={(e) => setSearchQuery(e.target.value)}\\n                  placeholder=\\\"Search shop name, spiral binding, CAD, lamination...\\\"\\n                  aria-label=\\\"Search printing shops\\\"\\n                  className=\\\"w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg\\\"\\n                />\\n              </div>\\n              <div className=\\\"md:col-span-4 flex gap-1.5\\\">\\n                <div className=\\\"relative flex-1\\\">\\n                  <MapPin className=\\\"w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={manualCity}\\n                    onChange={(e) => setManualCity(e.target.value)}\\n                    aria-label=\\\"Location city or area\\\"\\n                    placeholder=\\\"City or area\\\"\\n                    className=\\\"w-full pl-8 pr-2.5 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={requestGpsLocation}\\n                  aria-label=\\\"Use current GPS location\\\"\\n                  className=\\\"px-2.5 py-2 text-xs border border-slate-200 dark:border-slate-700 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800\\\"\\n                  title=\\\"Use GPS (optional)\\\"\\n                >\\n                  <LocateFixed className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n              <div className=\\\"md:col-span-3 flex items-center justify-end gap-2\\\">\\n                <select\\n                  aria-label=\\\"Sort shops by\\\"\\n                  value={sortBy}\\n                  onChange={(e) => setSortBy(e.target.value as \'distance\' | \'rating\' | \'price\')}\\n                  className=\\\"px-2.5 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg\\\"\\n                >\\n                  <option value=\\\"distance\\\">Nearest first</option>\\n                  <option value=\\\"rating\\\">Highest rated</option>\\n                  <option value=\\\"price\\\">Lowest B&W rate</option>\\n                </select>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setViewMode((v) => (v === \'list\' ? \'map\' : \'list\'))}\\n                  className=\\\"inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 rounded-lg whitespace-nowrap\\\"\\n                >\\n                  <MapIcon className=\\\"w-3.5 h-3.5\\\" />\\n                  {viewMode === \'list\' ? \'Map View\' : \'List View\'}\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-4 text-xs\\\">\\n              <label className=\\\"inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={filterOpenNow}\\n                  onChange={(e) => setFilterOpenNow(e.target.checked)}\\n                  className=\\\"accent-indigo-700\\\"\\n                />\\n                Open now\\n              </label>\\n              <label className=\\\"inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={filterDelivery}\\n                  onChange={(e) => setFilterDelivery(e.target.checked)}\\n                  className=\\\"accent-indigo-700\\\"\\n                />\\n                Delivery available\\n              </label>\\n              <label className=\\\"inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={filterVerifiedOnly}\\n                  onChange={(e) => setFilterVerifiedOnly(e.target.checked)}\\n                  className=\\\"accent-indigo-700\\\"\\n                />\\n                Verified shops only\\n              </label>\\n            </div>\\n          </div>\\n\\n          {viewMode === \'map\' ? (\\n            /* Interactive Local Coordinate Map View */\\n            <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <p className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">\\n                  Nearby Print Shops Map \342\200\224 {manualCity}\\n                </p>\\n                <p className=\\\"text-xs text-slate-500\\\">Click any pin to inspect pricing and turnaround.</p>\\n              </div>\\n              <div className=\\\"relative h-80 bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\\\">\\n                {/* Clean geometric grid lines simulating urban map */}\\n                <svg className=\\\"absolute inset-0 w-full h-full text-slate-200 dark:text-slate-800\\\" aria-hidden=\\\"true\\\">\\n                  <defs>\\n                    <pattern id=\\\"map-grid\\\" width=\\\"48\\\" height=\\\"48\\\" patternUnits=\\\"userSpaceOnUse\\\">\\n                      <path d=\\\"M 48 0 L 0 0 0 48\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1\\\" />\\n                    </pattern>\\n                  </defs>\\n                  <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"url(#map-grid)\\\" />\\n                </svg>\\n\\n                {discoverShops.map((shop, idx) => {\\n                  const left = 16 + ((idx * 24 + 12) % 72);\\n                  const top = 22 + ((idx * 19 + 14) % 58);\\n                  return (\\n                    <button\\n                      key={shop.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => setSelectedShop(shop)}\\n                      style={{ left: `${left}%`, top: `${top}%` }}\\n                      className=\\\"absolute -translate-x-1/2 -translate-y-1/2 bg-white dark:bg-slate-900 border border-indigo-600 rounded-lg px-2.5 py-1.5 shadow-md hover:scale-105 transition-transform text-left\\\"\\n                    >\\n                      <p className=\\\"text-xs font-semibold text-slate-900 dark:text-white whitespace-nowrap\\\">{shop.name}</p>\\n                      <p className=\\\"text-[11px] font-mono text-indigo-700 dark:text-indigo-400\\\">\\n                        {shop.distanceKm} km \302\267 \342\202\271{shop.pricing.bwPerPageA4}/p\\n                      </p>\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          ) : (\\n            /* Shop Directory Grid */\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\\\">\\n              {discoverShops.map((shop) => (\\n                <article\\n                  key={shop.id}\\n                  className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden flex flex-col\\\"\\n                >\\n                  <div className=\\\"aspect-[4/3] bg-slate-100 dark:bg-slate-800 relative overflow-hidden\\\">\\n                    <img\\n                      src={shop.photoUrl}\\n                      alt={shop.name}\\n                      referrerPolicy=\\\"no-referrer\\\"\\n                      className=\\\"w-full h-full object-cover\\\"\\n                    />\\n                  </div>\\n                  <div className=\\\"p-5 flex-1 flex flex-col justify-between space-y-4\\\">\\n                    <div className=\\\"space-y-1.5\\\">\\n                      <h3 className=\\\"text-base font-bold text-slate-900 dark:text-white leading-snug\\\">{shop.name}</h3>\\n                      <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                        {shop.verificationStatus === \'verified\' ? \'Verified\' : \'Pending Review\'} \302\267{\' \'}\\n                        <span className={shop.isOpen ? \'text-emerald-700 dark:text-emerald-400 font-medium\' : \'text-red-600\'}>\\n                          {shop.isOpen ? \'Open\' : \'Closed\'}\\n                        </span>{\' \'}\\n                        \302\267 <span className=\\\"font-mono tabular-nums\\\">{shop.distanceKm} km</span> \302\267{\' \'}\\n                        <span className=\\\"font-mono tabular-nums\\\">{shop.rating > 0 ? `${shop.rating} \342\230\205 (${shop.reviewCount})` : \'New\'}</span>\\n                      </p>\\n                      <p className=\\\"text-xs text-slate-600 dark:text-slate-300 truncate\\\">{shop.address}</p>\\n                      <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                        B&W <span className=\\\"font-mono tabular-nums font-semibold text-slate-900 dark:text-white\\\">{formatCurrency(shop.pricing.bwPerPageA4)}</span>/p \302\267 Color{\' \'}\\n                        <span className=\\\"font-mono tabular-nums font-semibold text-slate-900 dark:text-white\\\">{formatCurrency(shop.pricing.colorPerPageA4)}</span>/p \302\267 ~{shop.turnaroundMinutes}m\\n                      </p>\\n                      <p className=\\\"text-xs text-slate-500 dark:text-slate-400 truncate\\\">\\n                        {shop.services.slice(0, 4).join(\' \302\267 \')}\\n                      </p>\\n                    </div>\\n\\n                    <div className=\\\"flex items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-800\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setSelectedShop(shop)}\\n                        className=\\\"flex-1 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors\\\"\\n                      >\\n                        View Profile & Pricing\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          addSavedShop({\\n                            shopName: shop.name,\\n                            registeredShopId: shop.id,\\n                            ownerName: shop.ownerName,\\n                            phone: shop.phone,\\n                            whatsapp: shop.whatsapp,\\n                            email: shop.email,\\n                            address: shop.address,\\n                            openingHours: shop.openingHours,\\n                            group: \'Trusted\',\\n                            preferredContact: \'marketplace\',\\n                            notes: `Saved from discovery (${shop.distanceKm} km).`,\\n                            isFavourite: false,\\n                            isDefault: false,\\n                          })\\n                        }\\n                        aria-label={`Save ${shop.name}`}\\n                        className=\\\"p-2 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg\\\"\\n                      >\\n                        <Bookmark className=\\\"w-4 h-4\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n                </article>\\n              ))}\\n            </div>\\n          )}\\n        </div>\\n      ) : (\\n        /* Saved Shops Directory (Registered + Unregistered) */\\n        <div className=\\\"space-y-5\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n            <div className=\\\"flex flex-wrap gap-1.5\\\">\\n              {savedGroups.map((g) => (\\n                <button\\n                  key={g}\\n                  type=\\\"button\\\"\\n                  onClick={() => setSavedGroupFilter(g)}\\n                  className={`px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors ${\\n                    savedGroupFilter === g\\n                      ? \'border-indigo-600 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-200\'\\n                      : \'border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400\'\\n                  }`}\\n                >\\n                  {g}\\n                </button>\\n              ))}\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setShowAddSavedForm((v) => !v)}\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg whitespace-nowrap\\\"\\n            >\\n              <Plus className=\\\"w-3.5 h-3.5\\\" />\\n              Save Custom / Local Shop\\n            </button>\\n          </div>\\n\\n          {showAddSavedForm && (\\n            <form\\n              onSubmit={handleSaveUnregisteredShop}\\n              className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\"\\n            >\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">\\n                Add Printing Shop (Works even if unregistered on PrintReady)\\n              </h3>\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={customShopForm.shopName}\\n                  onChange={(e) => setCustomShopForm((f) => ({ ...f, shopName: e.target.value }))}\\n                  placeholder=\\\"Shop Name *\\\"\\n                  className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n                <input\\n                  type=\\\"text\\\"\\n                  value={customShopForm.whatsapp}\\n                  onChange={(e) => setCustomShopForm((f) => ({ ...f, whatsapp: e.target.value, phone: e.target.value }))}\\n                  placeholder=\\\"WhatsApp / Phone (+91 ...)\\\"\\n                  className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n                <input\\n                  type=\\\"email\\\"\\n                  value={customShopForm.email}\\n                  onChange={(e) => setCustomShopForm((f) => ({ ...f, email: e.target.value }))}\\n                  placeholder=\\\"Shop Email\\\"\\n                  className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n                <input\\n                  type=\\\"text\\\"\\n                  value={customShopForm.address}\\n                  onChange={(e) => setCustomShopForm((f) => ({ ...f, address: e.target.value }))}\\n                  placeholder=\\\"Address / Landmark\\\"\\n                  className=\\\"sm:col-span-2 px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n                <select\\n                  value={customShopForm.group}\\n                  onChange={(e) => setCustomShopForm((f) => ({ ...f, group: e.target.value }))}\\n                  className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                >\\n                  <option value=\\\"Near home\\\">Near home</option>\\n                  <option value=\\\"College\\\">College</option>\\n                  <option value=\\\"Office\\\">Office</option>\\n                  <option value=\\\"Trusted\\\">Trusted</option>\\n                  <option value=\\\"Cheapest\\\">Cheapest</option>\\n                </select>\\n              </div>\\n              <div className=\\\"flex justify-end gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddSavedForm(false)}\\n                  className=\\\"px-3 py-1.5 text-xs text-slate-600 dark:text-slate-400\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n                >\\n                  Save Shop\\n                </button>\\n              </div>\\n            </form>\\n          )}\\n\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            {filteredSavedShops.map((shop) => (\\n              <div\\n                key={shop.id}\\n                className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\"\\n              >\\n                <div className=\\\"flex items-start justify-between gap-2\\\">\\n                  <div>\\n                    <h4 className=\\\"text-sm font-bold text-slate-900 dark:text-white\\\">\\n                      {shop.shopName}\\n                      {shop.isDefault && (\\n                        <span className=\\\"ml-2 text-xs font-medium text-emerald-700 dark:text-emerald-400\\\">Default</span>\\n                      )}\\n                    </h4>\\n                    <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                      {shop.group} \302\267 Preferred: {shop.preferredContact} \302\267 {shop.registeredShopId ? \'Registered\' : \'Local Contact\'}\\n                    </p>\\n                  </div>\\n                  <div className=\\\"flex items-center gap-1\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => toggleSavedShopFavourite(shop.id)}\\n                      aria-label={`Favourite ${shop.shopName}`}\\n                      className={`p-1.5 rounded ${shop.isFavourite ? \'text-amber-500\' : \'text-slate-400 hover:text-amber-500\'}`}\\n                    >\\n                      <Star className={`w-4 h-4 ${shop.isFavourite ? \'fill-amber-500\' : \'\'}`} />\\n                    </button>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => deleteSavedShop(shop.id)}\\n                      aria-label={`Delete ${shop.shopName}`}\\n                      className=\\\"p-1.5 text-slate-400 hover:text-red-600 rounded\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                {shop.address && <p className=\\\"text-xs text-slate-600 dark:text-slate-300\\\">{shop.address}</p>}\\n                {shop.notes && <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">{shop.notes}</p>}\\n\\n                <div className=\\\"flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs\\\">\\n                  {shop.whatsapp && (\\n                    <a\\n                      href={buildWhatsAppUrl(shop.whatsapp, `Hello ${shop.shopName}, I have documents to print via PrintReady.`)}\\n                      target=\\\"_blank\\\"\\n                      rel=\\\"noopener noreferrer\\\"\\n                      className=\\\"inline-flex items-center gap-1 px-2.5 py-1.5 text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 rounded-md font-medium\\\"\\n                    >\\n                      <MessageCircle className=\\\"w-3.5 h-3.5\\\" />\\n                      WhatsApp\\n                    </a>\\n                  )}\\n                  {shop.email && (\\n                    <a\\n                      href={buildMailtoUrl(shop.email, \'Print Request via PrintReady\', `Hello ${shop.shopName},`)}\\n                      className=\\\"inline-flex items-center gap-1 px-2.5 py-1.5 text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/50 rounded-md font-medium\\\"\\n                    >\\n                      <Mail className=\\\"w-3.5 h-3.5\\\" />\\n                      Email\\n                    </a>\\n                  )}\\n                  {!shop.isDefault && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setDefaultSavedShop(shop.id)}\\n                      className=\\\"px-2.5 py-1.5 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800\\\"\\n                    >\\n                      Set Default\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Shop Profile Drawer */}\\n      {selectedShop && (\\n        <div className=\\\"fixed inset-0 z-50 bg-slate-950/50 flex justify-end\\\">\\n          <div className=\\\"w-full max-w-xl bg-white dark:bg-slate-900 h-full overflow-y-auto p-6 space-y-5 border-l border-slate-200 dark:border-slate-800\\\">\\n            <div className=\\\"flex items-start justify-between gap-3\\\">\\n              <div>\\n                <h3 className=\\\"text-lg font-bold text-slate-900 dark:text-white\\\">{selectedShop.name}</h3>\\n                <p className=\\\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\\\">\\n                  Owner: {selectedShop.ownerName} \302\267 {selectedShop.city} \302\267{\' \'}\\n                  <span className=\\\"text-emerald-700 dark:text-emerald-400 font-medium\\\">\\n                    {selectedShop.verificationStatus === \'verified\' ? \'Verified Business\' : selectedShop.verificationStatus}\\n                  </span>\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setSelectedShop(null)}\\n                aria-label=\\\"Close shop profile\\\"\\n                className=\\\"p-1.5 text-slate-500 hover:text-slate-900 dark:hover:text-white\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <img\\n              src={selectedShop.photoUrl}\\n              alt={selectedShop.name}\\n              referrerPolicy=\\\"no-referrer\\\"\\n              className=\\\"w-full h-48 object-cover rounded-xl border border-slate-200 dark:border-slate-800\\\"\\n            />\\n\\n            <div className=\\\"grid grid-cols-2 gap-3 text-xs\\\">\\n              <div className=\\\"p-3 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800\\\">\\n                <p className=\\\"text-slate-500 flex items-center gap-1\\\"><Clock className=\\\"w-3.5 h-3.5\\\" /> Hours</p>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white mt-0.5\\\">{selectedShop.openingHours}</p>\\n              </div>\\n              <div className=\\\"p-3 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800\\\">\\n                <p className=\\\"text-slate-500 flex items-center gap-1\\\"><Store className=\\\"w-3.5 h-3.5\\\" /> Turnaround</p>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white mt-0.5\\\">~{selectedShop.turnaroundMinutes} mins</p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"space-y-2 text-xs\\\">\\n              <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">Published Price List ({selectedShop.pricing.currency})</p>\\n              <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 border border-slate-200 dark:border-slate-800 rounded-lg\\\">\\n                <div className=\\\"px-3.5 py-2 flex justify-between\\\"><span>A4 Black & White</span><span className=\\\"font-mono tabular-nums\\\">{formatCurrency(selectedShop.pricing.bwPerPageA4)} / page</span></div>\\n                <div className=\\\"px-3.5 py-2 flex justify-between\\\"><span>A4 Full Color</span><span className=\\\"font-mono tabular-nums\\\">{formatCurrency(selectedShop.pricing.colorPerPageA4)} / page</span></div>\\n                <div className=\\\"px-3.5 py-2 flex justify-between\\\"><span>Spiral Binding</span><span className=\\\"font-mono tabular-nums\\\">{formatCurrency(selectedShop.pricing.bindingPrices.spiral)}</span></div>\\n                <div className=\\\"px-3.5 py-2 flex justify-between\\\"><span>Hardcover Binding</span><span className=\\\"font-mono tabular-nums\\\">{formatCurrency(selectedShop.pricing.bindingPrices.hardcover)}</span></div>\\n                <div className=\\\"px-3.5 py-2 flex justify-between\\\"><span>Lamination</span><span className=\\\"font-mono tabular-nums\\\">{formatCurrency(selectedShop.pricing.bindingPrices.lamination)}</span></div>\\n                <div className=\\\"px-3.5 py-2 flex justify-between\\\"><span>Delivery Fee</span><span className=\\\"font-mono tabular-nums\\\">{selectedShop.deliveryAvailable ? formatCurrency(selectedShop.pricing.deliveryFee) : \'Pickup only\'}</span></div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"space-y-2 text-xs\\\">\\n              <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">Verified Customer Reviews</p>\\n              {reviews.filter((r) => r.shopId === selectedShop.id).length === 0 ? (\\n                <p className=\\\"text-slate-500\\\">No reviews yet for this shop.</p>\\n              ) : (\\n                reviews\\n                  .filter((r) => r.shopId === selectedShop.id)\\n                  .map((rev) => (\\n                    <div key={rev.id} className=\\\"p-3 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800 space-y-1\\\">\\n                      <div className=\\\"flex justify-between\\\">\\n                        <span className=\\\"font-semibold text-slate-900 dark:text-white\\\">\\n                          {rev.customerName}{\' \'}\\n                          {rev.verifiedOrder && (\\n                            <span className=\\\"font-normal text-emerald-700 dark:text-emerald-400\\\">\302\267 Verified Order</span>\\n                          )}\\n                        </span>\\n                        <span className=\\\"font-mono text-amber-600\\\">{rev.rating} \342\230\205</span>\\n                      </div>\\n                      <p className=\\\"text-slate-600 dark:text-slate-300\\\">{rev.comment}</p>\\n                      {rev.shopResponse && (\\n                        <p className=\\\"text-slate-500 pt-1\\\">Shop reply: {rev.shopResponse}</p>\\n                      )}\\n                    </div>\\n                  ))\\n              )}\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setSelectedShop(null);\\n                  setActiveTab(\'basket\');\\n                }}\\n                className=\\\"flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n              >\\n                <CheckCircle2 className=\\\"w-4 h-4\\\" />\\n                Order from {selectedShop.name}\\n              </button>\\n              <a\\n                href={`tel:${selectedShop.phone}`}\\n                className=\\\"inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-medium border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              >\\n                <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                Call\\n              </a>\\n              <a\\n                href={buildWhatsAppUrl(selectedShop.whatsapp, `Hello ${selectedShop.name}, checking print availability via PrintReady.`)}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-medium text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900 rounded-lg\\\"\\n              >\\n                <MessageCircle className=\\\"w-3.5 h-3.5\\\" />\\n                WhatsApp\\n              </a>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build ShopDiscoveryView with List and Map views, filters, optional geolocation, Shop Profile drawer, and Saved Shops directory for registered and unregistered shops\", \"Overwrite\":true, \"TargetFile\":\"/src/components/customer/ShopDiscoveryView.tsx\", \"toolAction\":\"Creating ShopDiscoveryView component\", \"toolSummary\":\"Create ShopDiscoveryView.tsx\"}"
      original_name: "write_to_file"
    }
