            }
            lines {
              text: "): ItemCostBreakdown {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const warnings: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const parsedRange = parsePageRange(item.settings.pageRange, item.pageCount);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const selectedPages = parsedRange.valid ? parsedRange.pages.length : item.pageCount;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!parsedRange.valid && parsedRange.error) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
