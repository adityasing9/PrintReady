    tool_calls {
      id: "call_12613047492304899460"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Configure VitePWA with Web App Manifest, Workbox caching, and devOptions in vite.config.ts while preserving existing plugins\", \"EndLine\":20, \"Instruction\":\"Import VitePWA and add it to the plugins array in vite.config.ts\", \"ReplacementContent\":\"import tailwindcss from \'@tailwindcss/vite\';\\nimport react from \'@vitejs/plugin-react\';\\nimport fs from \'fs\';\\nimport path from \'path\';\\nimport {defineConfig} from \'vite\';\\nimport {VitePWA} from \'vite-plugin-pwa\';\\n\\nexport default defineConfig(() => {\\n  return {\\n    plugins: [\\n      react(),\\n      tailwindcss(),\\n      VitePWA({\\n        registerType: \'autoUpdate\',\\n        includeAssets: [\'icon.svg\', \'apple-touch-icon.png\', \'pwa-192x192.png\', \'pwa-512x512.png\', \'pwa-maskable-512x512.png\'],\\n        manifest: {\\n          id: \'/\',\\n          name: \'PrintReady\',\\n          short_name: \'PrintReady\',\\n          description: \'Upload once. Print anywhere. Private document vault, mobile scanner, print presets, and nearby verified print shops.\',\\n          theme_color: \'#4338ca\',\\n          background_color: \'#f8fafc\',\\n          display: \'standalone\',\\n          start_url: \'/\',\\n          scope: \'/\',\\n          icons: [\\n            {\\n              src: \'/pwa-192x192.png\',\\n              sizes: \'192x192\',\\n              type: \'image/png\',\\n              purpose: \'any\',\\n            },\\n            {\\n              src: \'/pwa-512x512.png\',\\n              sizes: \'512x512\',\\n              type: \'image/png\',\\n              purpose: \'any\',\\n            },\\n            {\\n              src: \'/pwa-maskable-512x512.png\',\\n              sizes: \'512x512\',\\n              type: \'image/png\',\\n              purpose: \'maskable\',\\n            },\\n          ],\\n        },\\n        workbox: {\\n          globPatterns: [\'**/*.{js,css,html,ico,png,svg,jpg,woff,woff2}\'],\\n          navigateFallbackDenylist: [/^\\\\/api\\\\//],\\n          runtimeCaching: [\\n            {\\n              urlPattern: /^https:\\\\/\\\\/fonts\\\\.googleapis\\\\.com\\\\/.*/i,\\n              handler: \'CacheFirst\',\\n              options: {\\n                cacheName: \'google-fonts-cache\',\\n                expiration: {\\n                  maxEntries: 10,\\n                  maxAgeSeconds: 60 * 60 * 24 * 365,\\n                },\\n                cacheableResponse: {\\n                  statuses: [0, 200],\\n                },\\n              },\\n            },\\n            {\\n              urlPattern: /^https:\\\\/\\\\/fonts\\\\.gstatic\\\\.com\\\\/.*/i,\\n              handler: \'CacheFirst\',\\n              options: {\\n                cacheName: \'gstatic-fonts-cache\',\\n                expiration: {\\n                  maxEntries: 10,\\n                  maxAgeSeconds: 60 * 60 * 24 * 365,\\n                },\\n                cacheableResponse: {\\n                  statuses: [0, 200],\\n                },\\n              },\\n            },\\n          ],\\n        },\\n        devOptions: {\\n          enabled: true,\\n          type: \'module\',\\n        },\\n      }),\", \"StartLine\":1, \"TargetContent\":\"import tailwindcss from \'@tailwindcss/vite\';\\nimport react from \'@vitejs/plugin-react\';\\nimport fs from \'fs\';\\nimport path from \'path\';\\nimport {defineConfig} from \'vite\';\\n\\nexport default defineConfig(() => {\\n  return {\\n    plugins: [\\n      react(),\\n      tailwindcss(),\", \"TargetFile\":\"/vite.config.ts\", \"toolAction\":\"Configuring VitePWA in vite.config.ts\", \"toolSummary\":\"Update vite.config.ts with VitePWA\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_12613047492304898895"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add vite-plugin-pwa/client to TypeScript compilerOptions.types\", \"EndLine\":8, \"Instruction\":\"Add vite-plugin-pwa/client to types array in tsconfig.json\", \"ReplacementContent\":\"    \\\"types\\\": [\\\"vite/client\\\", \\\"vite-plugin-pwa/client\\\"],\", \"StartLine\":6, \"TargetContent\":\"    \\\"types\\\": [\\\"vite/client\\\"],\", \"TargetFile\":\"/tsconfig.json\", \"toolAction\":\"Updating TypeScript PWA types\", \"toolSummary\":\"Update tsconfig.json types\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_12613047492304898330"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add PWA theme-color, iOS Safari apple-touch-icon, and mobile-web-app meta tags to index.html\", \"EndLine\":26, \"Instruction\":\"Add theme-color, mobile-web-app-capable, apple-mobile-web-app tags, and icon links to index.html head\", \"ReplacementContent\":\"    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\" />\\n    <meta name=\\\"theme-color\\\" content=\\\"#4338ca\\\" />\\n    <meta name=\\\"mobile-web-app-capable\\\" content=\\\"yes\\\" />\\n    <meta name=\\\"apple-mobile-web-app-capable\\\" content=\\\"yes\\\" />\\n    <meta name=\\\"apple-mobile-web-app-status-bar-style\\\" content=\\\"default\\\" />\\n    <meta name=\\\"apple-mobile-web-app-title\\\" content=\\\"PrintReady\\\" />\\n    <link rel=\\\"icon\\\" type=\\\"image/svg+xml\\\" href=\\\"/icon.svg\\\" />\\n    <link rel=\\\"apple-touch-icon\\\" href=\\\"/apple-touch-icon.png\\\" />\\n    <title>PrintReady \342\200\224 Upload Once. Print Anywhere.</title>\\n    <meta\\n      name=\\\"description\\\"\\n      content=\\\"Upload once. Print anywhere. Private document vault, mobile scanner, smart print presets, and nearby verified print shops.\\\"\\n    />\\n    <meta property=\\\"og:title\\\" content=\\\"PrintReady \342\200\224 Upload Once. Print Anywhere.\\\" />\\n    <meta\\n      property=\\\"og:description\\\"\\n      content=\\\"Private document vault, mobile scanner, smart print presets, and nearby verified print shops.\\\"\\n    />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link\\n      href=\\\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap\\\"\\n      rel=\\\"stylesheet\\\"\\n    />\\n    <script src=\\\"https://checkout.razorpay.com/v1/checkout.js\\\"></script>\\n  </head>\", \"StartLine\":5, \"TargetContent\":\"    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>PrintReady \342\200\224 Upload Once. Print Anywhere.</title>\\n    <meta\\n      name=\\\"description\\\"\\n      content=\\\"Upload once. Print anywhere. All-in-one document wallet, smart printing workspace, print shop marketplace, and business operations platform.\\\"\\n    />\\n    <meta property=\\\"og:title\\\" content=\\\"PrintReady \342\200\224 Upload Once. Print Anywhere.\\\" />\\n    <meta\\n      property=\\\"og:description\\\"\\n      content=\\\"All-in-one document wallet, smart printing workspace, print shop marketplace, and business operations platform.\\\"\\n    />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link\\n      href=\\\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap\\\"\\n      rel=\\\"stylesheet\\\"\\n    />\\n    <script src=\\\"https://checkout.razorpay.com/v1/checkout.js\\\"></script>\\n  </head>\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating index.html with PWA metadata\", \"toolSummary\":\"Update index.html PWA tags\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_12613047492304897765"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Initialize PrintReady portal from optional URL query param (?portal=shop or ?portal=admin) while defaulting to the dedicated customer app\", \"EndLine\":237, \"Instruction\":\"Read optional ?portal query param cleanly on initial load, defaulting to customer / home\", \"ReplacementContent\":\"function getInitialPortal(): AppPortal {\\n  if (typeof window === \'undefined\') return \'customer\';\\n  const param = new URLSearchParams(window.location.search).get(\'portal\');\\n  if (param === \'shop\' || param === \'admin\') return param;\\n  return \'customer\';\\n}\\n\\nexport function PrintReadyProvider({ children }: { children: React.ReactNode }) {\\n  const [portal, setPortalState] = useState<AppPortal>(getInitialPortal);\\n  const [activeTab, setActiveTab] = useState<string>(() => {\\n    const p = getInitialPortal();\\n    if (p === \'shop\') return \'shop-dashboard\';\\n    if (p === \'admin\') return \'admin-overview\';\\n    return \'home\';\\n  });\", \"StartLine\":231, \"TargetContent\":\"export function PrintReadyProvider({ children }: { children: React.ReactNode }) {\\n  const [portal, setPortalState] = useState<AppPortal>(\'customer\');\\n  const [activeTab, setActiveTab] = useState<string>(\'home\');\", \"TargetFile\":\"/src/context/PrintReadyContext.tsx\", \"toolAction\":\"Updating initial portal routing in context\", \"toolSummary\":\"Update PrintReadyContext portal init\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_12613047492304897200"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Focus LayoutShell exclusively on the Customer App experience (remove Shop/Admin workspace tabs, add mobile bottom navigation bar and PWAInstallButton)\", \"EndLine\":355, \"Instruction\":\"Update LayoutShell with customer-focused navigation, Back to Customer App exit when in Partner/Admin mode, PWAInstallButton in header, and fixed mobile bottom tab bar\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport {\\n  ArrowLeft,\\n  Bell,\\n  Building2,\\n  FileText,\\n  Home,\\n  LogIn,\\n  LogOut,\\n  Menu,\\n  Moon,\\n  Package,\\n  Printer,\\n  ScanLine,\\n  Settings,\\n  ShieldCheck,\\n  ShoppingBag,\\n  Store,\\n  Sun,\\n  Upload,\\n  WifiOff,\\n  X,\\n} from \'lucide-react\';\\nimport { usePrintReady } from \'../context/PrintReadyContext\';\\nimport { AppPortal } from \'../domain/types\';\\nimport { PWAInstallButton } from \'./PWAInstallButton\';\\n\\ninterface NavItem {\\n  id: string;\\n  label: string;\\n  shortLabel?: string;\\n  icon: React.ComponentType<{ className?: string }>;\\n  badge?: number;\\n}\\n\\nexport function LayoutShell({ children }: { children: React.ReactNode }) {\\n  const {\\n    portal,\\n    setPortal,\\n    activeTab,\\n    setActiveTab,\\n    theme,\\n    toggleTheme,\\n    isCloudMode,\\n    isOnline,\\n    userProfile,\\n    signInWithGoogle,\\n    signOutUser,\\n    basket,\\n    orders,\\n    shops,\\n    notifications,\\n    markAllNotificationsRead,\\n    toasts,\\n    dismissToast,\\n  } = usePrintReady();\\n\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n  const [notifOpen, setNotifOpen] = useState(false);\\n\\n  const pendingShopOrders = orders.filter(\\n    (o) => ![\'completed\', \'cancelled\', \'rejected\', \'refunded\'].includes(o.status)\\n  ).length;\\n  const pendingVerifications = shops.filter((s) => s.verificationStatus === \'pending\').length;\\n  const portalNotifs = notifications.filter((n) => n.portal === portal);\\n  const unreadCount = portalNotifs.filter((n) => !n.read).length;\\n\\n  const navByPortal: Record<AppPortal, NavItem[]> = {\\n    customer: [\\n      { id: \'home\', label: \'Home\', shortLabel: \'Home\', icon: Home },\\n      { id: \'vault\', label: \'Document Vault\', shortLabel: \'Vault\', icon: FileText },\\n      { id: \'scanner\', label: \'Scanner & PDF Tools\', shortLabel: \'Scan\', icon: ScanLine },\\n      { id: \'basket\', label: \'Print Basket\', shortLabel: \'Basket\', icon: ShoppingBag, badge: basket.length },\\n      { id: \'shops\', label: \'Print Shops\', shortLabel: \'Shops\', icon: Store },\\n      { id: \'orders\', label: \'Orders & Chat\', shortLabel: \'Orders\', icon: Package, badge: pendingShopOrders },\\n      { id: \'account\', label: \'Account & Security\', shortLabel: \'Account\', icon: Settings },\\n    ],\\n    shop: [\\n      { id: \'shop-dashboard\', label: \'Shop Dashboard\', icon: Building2 },\\n      { id: \'shop-orders\', label: \'Orders & Queue\', icon: Printer, badge: pendingShopOrders },\\n      { id: \'shop-pricing\', label: \'Pricing & Profile\', icon: Store },\\n      { id: \'shop-inventory\', label: \'Inventory & Printers\', icon: Package },\\n      { id: \'shop-team\', label: \'Team & Reviews\', icon: FileText },\\n      { id: \'shop-onboarding\', label: \'Register Shop\', icon: ShieldCheck },\\n    ],\\n    admin: [\\n      { id: \'admin-overview\', label: \'Platform Overview\', icon: ShieldCheck },\\n      { id: \'admin-shops\', label: \'Shop Verification\', icon: Store, badge: pendingVerifications },\\n      { id: \'admin-orders\', label: \'Orders & Disputes\', icon: Package },\\n      { id: \'admin-promos\', label: \'Coupons & Reviews\', icon: ShoppingBag },\\n      { id: \'admin-settings\', label: \'Settings & Audit Logs\', icon: Settings },\\n    ],\\n  };\\n\\n  const mobileBottomTabs: NavItem[] = [\\n    navByPortal.customer[0], // Home\\n    navByPortal.customer[1], // Vault\\n    navByPortal.customer[2], // Scan\\n    navByPortal.customer[3], // Basket\\n    navByPortal.customer[5], // Orders\\n  ];\\n\\n  const navItems = navByPortal[portal];\\n  const currentItem = navItems.find((n) => n.id === activeTab) || navItems[0];\\n\\n  const portalLabel =\\n    portal === \'customer\' ? \'PrintReady\' : portal === \'shop\' ? \'Partner Portal\' : \'Admin Console\';\\n\\n  const handleNavClick = (id: string) => {\\n    setActiveTab(id);\\n    setMobileMenuOpen(false);\\n  };\\n\\n  const sidebarContent = (\\n    <div className=\\\"flex flex-col h-full bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800\\\">\\n      {/* Brand Wordmark */}\\n      <div className=\\\"px-5 h-16 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 shrink-0\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => handleNavClick(navItems[0].id)}\\n          className=\\\"text-lg font-bold tracking-tight text-slate-900 dark:text-white font-display whitespace-nowrap shrink-0 flex items-center gap-2.5\\\"\\n        >\\n          <span className=\\\"w-7 h-7 rounded-lg bg-indigo-700 text-white flex items-center justify-center\\\">\\n            <Printer className=\\\"w-4 h-4\\\" />\\n          </span>\\n          PrintReady\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setMobileMenuOpen(false)}\\n          aria-label=\\\"Close navigation menu\\\"\\n          className=\\\"lg:hidden p-1.5 text-slate-500 hover:text-slate-900 dark:hover:text-white rounded-md\\\"\\n        >\\n          <X className=\\\"w-5 h-5\\\" />\\n        </button>\\n      </div>\\n\\n      {/* Contextual Return Banner when viewing Shop Partner or Admin routes */}\\n      {portal !== \'customer\' && (\\n        <div className=\\\"px-4 py-3 border-b border-slate-100 dark:border-slate-800/80\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setPortal(\'customer\');\\n              setMobileMenuOpen(false);\\n            }}\\n            className=\\\"w-full flex items-center gap-2 px-3 py-2 text-xs font-medium text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 rounded-lg transition-colors\\\"\\n          >\\n            <ArrowLeft className=\\\"w-3.5 h-3.5\\\" />\\n            Back to Customer App\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Primary Navigation */}\\n      <nav className=\\\"flex-1 overflow-y-auto px-3 py-4 space-y-1\\\" aria-label={`${portalLabel} navigation`}>\\n        {navItems.map((item) => {\\n          const Icon = item.icon;\\n          const active = activeTab === item.id;\\n          return (\\n            <button\\n              key={item.id}\\n              type=\\\"button\\\"\\n              onClick={() => handleNavClick(item.id)}\\n              className={`w-full flex items-center justify-between gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-left ${\\n                active\\n                  ? \'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-200\'\\n                  : \'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/70 hover:text-slate-900 dark:hover:text-white\'\\n              }`}\\n            >\\n              <span className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n                <Icon className={`w-4 h-4 shrink-0 ${active ? \'text-indigo-700 dark:text-indigo-300\' : \'text-slate-400 dark:text-slate-500\'}`} />\\n                <span className=\\\"truncate\\\">{item.label}</span>\\n              </span>\\n              {typeof item.badge === \'number\' && item.badge > 0 && (\\n                <span className=\\\"font-mono tabular-nums text-xs text-indigo-700 dark:text-indigo-300 font-semibold shrink-0\\\">\\n                  {item.badge}\\n                </span>\\n              )}\\n            </button>\\n          );\\n        })}\\n      </nav>\\n\\n      {/* Account & Theme Footer */}\\n      <div className=\\\"p-4 border-t border-slate-200 dark:border-slate-800 space-y-3 shrink-0\\\">\\n        <div className=\\\"flex items-center justify-between gap-2\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <p className=\\\"text-sm font-semibold text-slate-900 dark:text-white truncate\\\">{userProfile.displayName}</p>\\n            <p className=\\\"text-xs text-slate-500 dark:text-slate-400 truncate\\\">\\n              {isCloudMode ? \'Cloud Synced\' : \'Local Vault\'} \302\267 {userProfile.subscriptionPlan === \'premium\' ? \'Pro\' : \'Free\'}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={toggleTheme}\\n            aria-label={theme === \'dark\' ? \'Switch to light mode\' : \'Switch to dark mode\'}\\n            className=\\\"p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shrink-0\\\"\\n          >\\n            {theme === \'dark\' ? <Sun className=\\\"w-4 h-4\\\" /> : <Moon className=\\\"w-4 h-4\\\" />}\\n          </button>\\n        </div>\\n\\n        {isCloudMode ? (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={signOutUser}\\n            className=\\\"w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap\\\"\\n          >\\n            <LogOut className=\\\"w-3.5 h-3.5\\\" />\\n            Sign Out\\n          </button>\\n        ) : (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={signInWithGoogle}\\n            className=\\\"w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium text-indigo-700 dark:text-indigo-200 bg-indigo-50 dark:bg-indigo-950/70 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 rounded-lg transition-colors whitespace-nowrap\\\"\\n          >\\n            <LogIn className=\\\"w-3.5 h-3.5\\\" />\\n            Sign In with Google\\n          </button>\\n        )}\\n      </div>\\n    </div>\\n  );\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex\\\">\\n      {/* Desktop Sidebar */}\\n      <aside className=\\\"hidden lg:block w-64 shrink-0 sticky top-0 h-screen\\\">{sidebarContent}</aside>\\n\\n      {/* Mobile Drawer */}\\n      {mobileMenuOpen && (\\n        <div className=\\\"fixed inset-0 z-50 lg:hidden flex\\\">\\n          <div className=\\\"fixed inset-0 bg-slate-950/50\\\" onClick={() => setMobileMenuOpen(false)} />\\n          <div className=\\\"relative w-72 max-w-[85vw] h-full z-10\\\">{sidebarContent}</div>\\n        </div>\\n      )}\\n\\n      {/* Main Column */}\\n      <div className=\\\"flex-1 min-w-0 flex flex-col\\\">\\n        {/* Top Bar Contract: Breadcrumbs left, concise actions right */}\\n        <header className=\\\"sticky top-0 z-30 h-16 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-b border-slate-200 dark:border-slate-800 px-4 sm:px-6 flex items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setMobileMenuOpen(true)}\\n              aria-label=\\\"Open navigation menu\\\"\\n              className=\\\"lg:hidden p-2 -ml-1 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg\\\"\\n            >\\n              <Menu className=\\\"w-5 h-5\\\" />\\n            </button>\\n            <div className=\\\"flex items-center gap-2 text-sm min-w-0 truncate\\\">\\n              <span className=\\\"text-slate-500 dark:text-slate-400 hidden sm:inline whitespace-nowrap\\\">{portalLabel}</span>\\n              <span className=\\\"text-slate-300 dark:text-slate-600 hidden sm:inline\\\">/</span>\\n              <h1 className=\\\"font-semibold text-slate-900 dark:text-white truncate\\\">{currentItem.label}</h1>\\n            </div>\\n            {!isOnline && (\\n              <span className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 dark:text-amber-400 ml-2 whitespace-nowrap\\\">\\n                <WifiOff className=\\\"w-3.5 h-3.5\\\" />\\n                Offline\\n              </span>\\n            )}\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2.5 shrink-0\\\">\\n            <PWAInstallButton variant=\\\"header\\\" />\\n\\n            <div className=\\\"relative\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setNotifOpen((o) => !o)}\\n                aria-label={`Notifications (${unreadCount} unread)`}\\n                className=\\\"relative p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors\\\"\\n              >\\n                <Bell className=\\\"w-4 h-4\\\" />\\n                {unreadCount > 0 && (\\n                  <span className=\\\"absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 bg-indigo-700 text-white text-[10px] font-mono tabular-nums font-semibold rounded-full flex items-center justify-center\\\">\\n                    {unreadCount}\\n                  </span>\\n                )}\\n              </button>\\n\\n              {notifOpen && (\\n                <div className=\\\"absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg z-50 overflow-hidden\\\">\\n                  <div className=\\\"px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between\\\">\\n                    <span className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Notifications</span>\\n                    {unreadCount > 0 && (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => markAllNotificationsRead(portal)}\\n                        className=\\\"text-xs font-medium text-indigo-700 dark:text-indigo-400 hover:underline\\\"\\n                      >\\n                        Mark all read\\n                      </button>\\n                    )}\\n                  </div>\\n                  <div className=\\\"max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800\\\">\\n                    {portalNotifs.length === 0 ? (\\n                      <p className=\\\"p-4 text-xs text-slate-500 dark:text-slate-400\\\">No notifications yet.</p>\\n                    ) : (\\n                      portalNotifs.slice(0, 10).map((n) => (\\n                        <div key={n.id} className={`p-3.5 text-left ${!n.read ? \'bg-indigo-50/40 dark:bg-indigo-950/20\' : \'\'}`}>\\n                          <p className=\\\"text-xs font-semibold text-slate-900 dark:text-white\\\">{n.title}</p>\\n                          <p className=\\\"text-xs text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed\\\">{n.body}</p>\\n                          <p className=\\\"text-[11px] text-slate-400 mt-1 font-mono tabular-nums\\\">\\n                            {new Date(n.createdAt).toLocaleString()}\\n                          </p>\\n                        </div>\\n                      ))\\n                    )}\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n\\n            {portal === \'customer\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'vault\')}\\n                className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n              >\\n                <Upload className=\\\"w-3.5 h-3.5\\\" />\\n                Upload File\\n              </button>\\n            )}\\n            {portal === \'shop\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'shop-orders\')}\\n                className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n              >\\n                <Printer className=\\\"w-3.5 h-3.5\\\" />\\n                Print Queue ({pendingShopOrders})\\n              </button>\\n            )}\\n            {portal === \'admin\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'admin-shops\')}\\n                className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n              >\\n                <ShieldCheck className=\\\"w-3.5 h-3.5\\\" />\\n                Verify Shops ({pendingVerifications})\\n              </button>\\n            )}\\n          </div>\\n        </header>\\n\\n        {/* Main Viewport */}\\n        <main className={`flex-1 p-4 sm:p-6 lg:p-8 max-w-[1440px] w-full mx-auto ${portal === \'customer\' ? \'pb-24 lg:pb-8\' : \'\'}`}>\\n          {children}\\n        </main>\\n      </div>\\n\\n      {/* Mobile Customer Bottom Navigation Bar */}\\n      {portal === \'customer\' && (\\n        <nav\\n          aria-label=\\\"Mobile quick navigation\\\"\\n          className=\\\"lg:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-t border-slate-200 dark:border-slate-800 px-2 py-1.5\\\"\\n        >\\n          <div className=\\\"grid grid-cols-5 gap-1\\\">\\n            {mobileBottomTabs.map((item) => {\\n              const Icon = item.icon;\\n              const active = activeTab === item.id;\\n              return (\\n                <button\\n                  key={item.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => handleNavClick(item.id)}\\n                  className={`relative flex flex-col items-center justify-center py-1.5 rounded-lg text-[11px] font-medium transition-colors ${\\n                    active\\n                      ? \'text-indigo-700 dark:text-indigo-300 bg-indigo-50/70 dark:bg-indigo-950/50\'\\n                      : \'text-slate-500 dark:text-slate-400\'\\n                  }`}\\n                >\\n                  <span className=\\\"relative\\\">\\n                    <Icon className=\\\"w-4 h-4\\\" />\\n                    {typeof item.badge === \'number\' && item.badge > 0 && (\\n                      <span className=\\\"absolute -top-1.5 -right-2.5 min-w-4 h-4 px-1 bg-indigo-700 text-white text-[9px] font-mono tabular-nums font-semibold rounded-full flex items-center justify-center\\\">\\n                        {item.badge}\\n                      </span>\\n                    )}\\n                  </span>\\n                  <span className=\\\"mt-0.5 truncate\\\">{item.shortLabel || item.label}</span>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </nav>\\n      )}\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Bell,\\n  Building2,\\n  FileText,\\n  Home,\\n  LogIn,\\n  LogOut,\\n  Menu,\\n  Moon,\\n  Package,\\n  Printer,\\n  ScanLine,\\n  Settings,\\n  ShieldCheck,\\n  ShoppingBag,\\n  Store,\\n  Sun,\\n  Upload,\\n  WifiOff,\\n  X,\\n} from \'lucide-react\';\\nimport { usePrintReady } from \'../context/PrintReadyContext\';\\nimport { AppPortal } from \'../domain/types\';\\n\\ninterface NavItem {\\n  id: string;\\n  label: string;\\n  icon: React.ComponentType<{ className?: string }>;\\n  badge?: number;\\n}\\n\\nexport function LayoutShell({ children }: { children: React.ReactNode }) {\\n  const {\\n    portal,\\n    setPortal,\\n    activeTab,\\n    setActiveTab,\\n    theme,\\n    toggleTheme,\\n    isCloudMode,\\n    isOnline,\\n    userProfile,\\n    signInWithGoogle,\\n    signOutUser,\\n    basket,\\n    orders,\\n    shops,\\n    notifications,\\n    markAllNotificationsRead,\\n    toasts,\\n    dismissToast,\\n  } = usePrintReady();\\n\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n  const [notifOpen, setNotifOpen] = useState(false);\\n\\n  const pendingShopOrders = orders.filter(\\n    (o) => ![\'completed\', \'cancelled\', \'rejected\', \'refunded\'].includes(o.status)\\n  ).length;\\n  const pendingVerifications = shops.filter((s) => s.verificationStatus === \'pending\').length;\\n  const portalNotifs = notifications.filter((n) => n.portal === portal);\\n  const unreadCount = portalNotifs.filter((n) => !n.read).length;\\n\\n  const navByPortal: Record<AppPortal, NavItem[]> = {\\n    customer: [\\n      { id: \'home\', label: \'Home\', icon: Home },\\n      { id: \'vault\', label: \'Document Vault\', icon: FileText },\\n      { id: \'scanner\', label: \'Scanner & PDF Tools\', icon: ScanLine },\\n      { id: \'basket\', label: \'Print Basket\', icon: ShoppingBag, badge: basket.length },\\n      { id: \'shops\', label: \'Print Shops\', icon: Store },\\n      { id: \'orders\', label: \'Orders & Chat\', icon: Package, badge: pendingShopOrders },\\n      { id: \'account\', label: \'Account & Security\', icon: Settings },\\n    ],\\n    shop: [\\n      { id: \'shop-dashboard\', label: \'Shop Dashboard\', icon: Building2 },\\n      { id: \'shop-orders\', label: \'Orders & Queue\', icon: Printer, badge: pendingShopOrders },\\n      { id: \'shop-pricing\', label: \'Pricing & Profile\', icon: Store },\\n      { id: \'shop-inventory\', label: \'Inventory & Printers\', icon: Package },\\n      { id: \'shop-team\', label: \'Team & Reviews\', icon: FileText },\\n      { id: \'shop-onboarding\', label: \'Register Shop\', icon: ShieldCheck },\\n    ],\\n    admin: [\\n      { id: \'admin-overview\', label: \'Platform Overview\', icon: ShieldCheck },\\n      { id: \'admin-shops\', label: \'Shop Verification\', icon: Store, badge: pendingVerifications },\\n      { id: \'admin-orders\', label: \'Orders & Disputes\', icon: Package },\\n      { id: \'admin-promos\', label: \'Coupons & Reviews\', icon: ShoppingBag },\\n      { id: \'admin-settings\', label: \'Settings & Audit Logs\', icon: Settings },\\n    ],\\n  };\\n\\n  const navItems = navByPortal[portal];\\n  const currentItem = navItems.find((n) => n.id === activeTab) || navItems[0];\\n\\n  const portalLabel =\\n    portal === \'customer\' ? \'Customer Portal\' : portal === \'shop\' ? \'Print Shop Operations\' : \'Admin Console\';\\n\\n  const handleNavClick = (id: string) => {\\n    setActiveTab(id);\\n    setMobileMenuOpen(false);\\n  };\\n\\n  const sidebarContent = (\\n    <div className=\\\"flex flex-col h-full bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800\\\">\\n      {/* Brand Wordmark */}\\n      <div className=\\\"px-5 h-16 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 shrink-0\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => handleNavClick(navItems[0].id)}\\n          className=\\\"text-lg font-bold tracking-tight text-slate-900 dark:text-white font-display whitespace-nowrap shrink-0 flex items-center gap-2.5\\\"\\n        >\\n          <span className=\\\"w-7 h-7 rounded-lg bg-indigo-700 text-white flex items-center justify-center\\\">\\n            <Printer className=\\\"w-4 h-4\\\" />\\n          </span>\\n          PrintReady\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setMobileMenuOpen(false)}\\n          aria-label=\\\"Close navigation menu\\\"\\n          className=\\\"lg:hidden p-1.5 text-slate-500 hover:text-slate-900 dark:hover:text-white rounded-md\\\"\\n        >\\n          <X className=\\\"w-5 h-5\\\" />\\n        </button>\\n      </div>\\n\\n      {/* Workspace Portal Switcher */}\\n      <div className=\\\"px-4 pt-4 pb-3 border-b border-slate-100 dark:border-slate-800/80\\\">\\n        <p className=\\\"text-xs font-medium text-slate-500 dark:text-slate-400 mb-2\\\">Workspace</p>\\n        <div className=\\\"grid grid-cols-3 gap-1 p-1 bg-slate-100 dark:bg-slate-950 rounded-lg\\\" role=\\\"tablist\\\" aria-label=\\\"Portal workspace\\\">\\n          {([\\n            { id: \'customer\', label: \'Customer\' },\\n            { id: \'shop\', label: \'Shop\' },\\n            { id: \'admin\', label: \'Admin\' },\\n          ] as { id: AppPortal; label: string }[]).map((p) => (\\n            <button\\n              key={p.id}\\n              type=\\\"button\\\"\\n              role=\\\"tab\\\"\\n              aria-selected={portal === p.id}\\n              onClick={() => {\\n                setPortal(p.id);\\n                setMobileMenuOpen(false);\\n              }}\\n              className={`px-2 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n                portal === p.id\\n                  ? \'bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 shadow-xs\'\\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\\n              }`}\\n            >\\n              {p.label}\\n            </button>\\n          ))}\\n        </div>\\n      </div>\\n\\n      {/* Primary Navigation */}\\n      <nav className=\\\"flex-1 overflow-y-auto px-3 py-3 space-y-1\\\" aria-label={`${portalLabel} navigation`}>\\n        {navItems.map((item) => {\\n          const Icon = item.icon;\\n          const active = activeTab === item.id;\\n          return (\\n            <button\\n              key={item.id}\\n              type=\\\"button\\\"\\n              onClick={() => handleNavClick(item.id)}\\n              className={`w-full flex items-center justify-between gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-left ${\\n                active\\n                  ? \'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-200\'\\n                  : \'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/70 hover:text-slate-900 dark:hover:text-white\'\\n              }`}\\n            >\\n              <span className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n                <Icon className={`w-4 h-4 shrink-0 ${active ? \'text-indigo-700 dark:text-indigo-300\' : \'text-slate-400 dark:text-slate-500\'}`} />\\n                <span className=\\\"truncate\\\">{item.label}</span>\\n              </span>\\n              {typeof item.badge === \'number\' && item.badge > 0 && (\\n                <span className=\\\"font-mono tabular-nums text-xs text-indigo-700 dark:text-indigo-300 font-semibold shrink-0\\\">\\n                  {item.badge}\\n                </span>\\n              )}\\n            </button>\\n          );\\n        })}\\n      </nav>\\n\\n      {/* Account & Theme Footer */}\\n      <div className=\\\"p-4 border-t border-slate-200 dark:border-slate-800 space-y-3 shrink-0\\\">\\n        <div className=\\\"flex items-center justify-between gap-2\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <p className=\\\"text-sm font-semibold text-slate-900 dark:text-white truncate\\\">{userProfile.displayName}</p>\\n            <p className=\\\"text-xs text-slate-500 dark:text-slate-400 truncate\\\">\\n              {isCloudMode ? \'Cloud Synced\' : \'Demo Workspace\'} \302\267 {userProfile.subscriptionPlan === \'premium\' ? \'Pro\' : \'Free\'}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={toggleTheme}\\n            aria-label={theme === \'dark\' ? \'Switch to light mode\' : \'Switch to dark mode\'}\\n            className=\\\"p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shrink-0\\\"\\n          >\\n            {theme === \'dark\' ? <Sun className=\\\"w-4 h-4\\\" /> : <Moon className=\\\"w-4 h-4\\\" />}\\n          </button>\\n        </div>\\n\\n        {isCloudMode ? (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={signOutUser}\\n            className=\\\"w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap\\\"\\n          >\\n            <LogOut className=\\\"w-3.5 h-3.5\\\" />\\n            Sign Out\\n          </button>\\n        ) : (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={signInWithGoogle}\\n            className=\\\"w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium text-indigo-700 dark:text-indigo-200 bg-indigo-50 dark:bg-indigo-950/70 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 rounded-lg transition-colors whitespace-nowrap\\\"\\n          >\\n            <LogIn className=\\\"w-3.5 h-3.5\\\" />\\n            Sign In with Google\\n          </button>\\n        )}\\n      </div>\\n    </div>\\n  );\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex\\\">\\n      {/* Desktop Sidebar */}\\n      <aside className=\\\"hidden lg:block w-64 shrink-0 sticky top-0 h-screen\\\">{sidebarContent}</aside>\\n\\n      {/* Mobile Drawer */}\\n      {mobileMenuOpen && (\\n        <div className=\\\"fixed inset-0 z-50 lg:hidden flex\\\">\\n          <div className=\\\"fixed inset-0 bg-slate-950/50\\\" onClick={() => setMobileMenuOpen(false)} />\\n          <div className=\\\"relative w-72 max-w-[85vw] h-full z-10\\\">{sidebarContent}</div>\\n        </div>\\n      )}\\n\\n      {/* Main Column */}\\n      <div className=\\\"flex-1 min-w-0 flex flex-col\\\">\\n        {/* Top Bar Contract: Breadcrumbs left, concise actions right */}\\n        <header className=\\\"sticky top-0 z-30 h-16 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-b border-slate-200 dark:border-slate-800 px-4 sm:px-6 flex items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setMobileMenuOpen(true)}\\n              aria-label=\\\"Open navigation menu\\\"\\n              className=\\\"lg:hidden p-2 -ml-1 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg\\\"\\n            >\\n              <Menu className=\\\"w-5 h-5\\\" />\\n            </button>\\n            <div className=\\\"flex items-center gap-2 text-sm min-w-0 truncate\\\">\\n              <span className=\\\"text-slate-500 dark:text-slate-400 hidden sm:inline whitespace-nowrap\\\">{portalLabel}</span>\\n              <span className=\\\"text-slate-300 dark:text-slate-600 hidden sm:inline\\\">/</span>\\n              <h1 className=\\\"font-semibold text-slate-900 dark:text-white truncate\\\">{currentItem.label}</h1>\\n            </div>\\n            {!isOnline && (\\n              <span className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 dark:text-amber-400 ml-2 whitespace-nowrap\\\">\\n                <WifiOff className=\\\"w-3.5 h-3.5\\\" />\\n                Offline\\n              </span>\\n            )}\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2.5 shrink-0\\\">\\n            <div className=\\\"relative\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setNotifOpen((o) => !o)}\\n                aria-label={`Notifications (${unreadCount} unread)`}\\n                className=\\\"relative p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors\\\"\\n              >\\n                <Bell className=\\\"w-4 h-4\\\" />\\n                {unreadCount > 0 && (\\n                  <span className=\\\"absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 bg-indigo-700 text-white text-[10px] font-mono tabular-nums font-semibold rounded-full flex items-center justify-center\\\">\\n                    {unreadCount}\\n                  </span>\\n                )}\\n              </button>\\n\\n              {notifOpen && (\\n                <div className=\\\"absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg z-50 overflow-hidden\\\">\\n                  <div className=\\\"px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between\\\">\\n                    <span className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Notifications</span>\\n                    {unreadCount > 0 && (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => markAllNotificationsRead(portal)}\\n                        className=\\\"text-xs font-medium text-indigo-700 dark:text-indigo-400 hover:underline\\\"\\n                      >\\n                        Mark all read\\n                      </button>\\n                    )}\\n                  </div>\\n                  <div className=\\\"max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800\\\">\\n                    {portalNotifs.length === 0 ? (\\n                      <p className=\\\"p-4 text-xs text-slate-500 dark:text-slate-400\\\">No notifications in this workspace.</p>\\n                    ) : (\\n                      portalNotifs.slice(0, 10).map((n) => (\\n                        <div key={n.id} className={`p-3.5 text-left ${!n.read ? \'bg-indigo-50/40 dark:bg-indigo-950/20\' : \'\'}`}>\\n                          <p className=\\\"text-xs font-semibold text-slate-900 dark:text-white\\\">{n.title}</p>\\n                          <p className=\\\"text-xs text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed\\\">{n.body}</p>\\n                          <p className=\\\"text-[11px] text-slate-400 mt-1 font-mono tabular-nums\\\">\\n                            {new Date(n.createdAt).toLocaleString()}\\n                          </p>\\n                        </div>\\n                      ))\\n                    )}\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n\\n            {portal === \'customer\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'vault\')}\\n                className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n              >\\n                <Upload className=\\\"w-3.5 h-3.5\\\" />\\n                Upload File\\n              </button>\\n            )}\\n            {portal === \'shop\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'shop-orders\')}\\n                className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n              >\\n                <Printer className=\\\"w-3.5 h-3.5\\\" />\\n                Print Queue ({pendingShopOrders})\\n              </button>\\n            )}\\n            {portal === \'admin\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'admin-shops\')}\\n                className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n              >\\n                <ShieldCheck className=\\\"w-3.5 h-3.5\\\" />\\n                Verify Shops ({pendingVerifications})\\n              </button>\\n            )}\\n          </div>\\n        </header>\\n\\n        {/* Main Viewport */}\\n        <main className=\\\"flex-1 p-4 sm:p-6 lg:p-8 max-w-[1440px] w-full mx-auto\\\">{children}</main>\\n      </div>\", \"TargetFile\":\"/src/components/LayoutShell.tsx\", \"toolAction\":\"Refocusing LayoutShell as a customer app\", \"toolSummary\":\"Update LayoutShell for customer app\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_12613047492304896635"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Make AccountSettingsView consumer-friendly with PWA App Install and optional Print Shop Partner entry instead of developer diagnostics\", \"Instruction\":\"Import PWAInstallButton and Store/Smartphone icons, simplify heading, and replace developer integration matrix with Install App and Shop Partner cards\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":22, \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport { Download, Shield, Smartphone, Sparkles, Store, User } from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport { formatFileSize } from \'../../domain/fileValidation\';\\nimport { PWAInstallButton } from \'../PWAInstallButton\';\\n\\nexport function AccountSettingsView() {\\n  const {\\n    userProfile,\\n    updateUserProfile,\\n    setPortal,\\n    isCloudMode,\\n    signInWithGoogle,\\n    signOutUser,\\n    documents,\\n    folders,\\n    orders,\\n    coupons,\\n    notify,\\n  } = usePrintReady();\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport { CheckCircle2, Download, KeyRound, Shield, Sparkles, User } from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport { formatFileSize } from \'../../domain/fileValidation\';\\n\\nexport function AccountSettingsView() {\\n  const {\\n    userProfile,\\n    updateUserProfile,\\n    isCloudMode,\\n    firestoreConnected,\\n    signInWithGoogle,\\n    signOutUser,\\n    documents,\\n    folders,\\n    orders,\\n    coupons,\\n    integrations,\\n    notify,\\n  } = usePrintReady();\"}, {\"AllowMultiple\":false, \"EndLine\":66, \"ReplacementContent\":\"      <div>\\n        <h2 className=\\\"text-xl font-bold text-slate-900 dark:text-white\\\">Account & Privacy</h2>\\n        <p className=\\\"text-sm text-slate-500 dark:text-slate-400\\\">\\n          Manage your profile, Google Cloud backup, AI assistance preferences, storage plan, and app installation.\\n        </p>\\n      </div>\", \"StartLine\":60, \"TargetContent\":\"      <div>\\n        <h2 className=\\\"text-xl font-bold text-slate-900 dark:text-white\\\">Account, Privacy & Integrations</h2>\\n        <p className=\\\"text-sm text-slate-500 dark:text-slate-400\\\">\\n          Manage authentication, AI processing consent, cloud backup, subscription tiers, and verified integration readiness.\\n        </p>\\n      </div>\"}, {\"AllowMultiple\":false, \"EndLine\":150, \"ReplacementContent\":\"              <div>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white\\\">Google Account Sync</p>\\n                <p className=\\\"text-slate-500\\\">\\n                  {isCloudMode\\n                    ? `Signed in (${userProfile.email}) \302\267 Synced across devices`\\n                    : \'Saved on this device \302\267 Sign in with Google to back up to the cloud\'}\\n                </p>\\n              </div>\", \"StartLine\":142, \"TargetContent\":\"              <div>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white\\\">Firebase Google Authentication</p>\\n                <p className=\\\"text-slate-500\\\">\\n                  {isCloudMode\\n                    ? `Signed in (${userProfile.email}) \302\267 Cloud Firestore Active`\\n                    : `Demo Workspace Mode \302\267 Firestore Reachable: ${firestoreConnected ? \'Yes\' : \'Checking\'}`}\\n                </p>\\n              </div>\"}, {\"AllowMultiple\":false, \"EndLine\":310, \"ReplacementContent\":\"      {/* Install Mobile/Desktop App & Print Shop Partner Entry */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n        <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-1.5\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n              <Smartphone className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              Install PrintReady App\\n            </h3>\\n            <p className=\\\"text-xs text-slate-600 dark:text-slate-400 leading-relaxed\\\">\\n              Add PrintReady to your phone or desktop home screen for instant camera scanning, offline document access, and faster checkout at print shops.\\n            </p>\\n          </div>\\n          <div>\\n            <PWAInstallButton variant=\\\"card\\\" />\\n          </div>\\n        </section>\\n\\n        <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-1.5\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n              <Store className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              Run a Print Shop?\\n            </h3>\\n            <p className=\\\"text-xs text-slate-600 dark:text-slate-400 leading-relaxed\\\">\\n              List your shop on PrintReady, accept digital print jobs, confirm custom pricing, and manage your print queue in real time.\\n            </p>\\n          </div>\\n          <div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setPortal(\'shop\')}\\n              className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors\\\"\\n            >\\n              <Store className=\\\"w-3.5 h-3.5\\\" />\\n              Open Print Shop Partner Portal\\n            </button>\\n          </div>\\n        </section>\\n      </div>\\n    </div>\", \"StartLine\":276, \"TargetContent\":\"      {/* Honest External Integration Readiness Matrix */}\\n      <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-3\\\">\\n        <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n          <KeyRound className=\\\"w-4 h-4 text-indigo-600\\\" />\\n          External Integration Configuration Status\\n        </h3>\\n        <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">Cloud Firestore & Firebase Auth</span>\\n            <span className=\\\"text-emerald-700 dark:text-emerald-400 inline-flex items-center gap-1\\\">\\n              <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" /> Provisioned & Hardened Rules Deployed\\n            </span>\\n          </div>\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">Server-Side Gemini AI (gemini-4-hydrogen)</span>\\n            <span className={integrations?.geminiAi.configured ? \'text-emerald-700 dark:text-emerald-400\' : \'text-amber-700 dark:text-amber-400\'}>\\n              {integrations?.geminiAi.configured ? \'Configured on Backend\' : \'Awaiting GEMINI_API_KEY in Secrets\'}\\n            </span>\\n          </div>\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">Payment Gateway (Razorpay Abstraction)</span>\\n            <span className=\\\"text-slate-600 dark:text-slate-300\\\">\\n              {integrations?.payments.note || \'Server-verified HMAC sandbox active.\'}\\n            </span>\\n          </div>\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">WhatsApp & Email Sharing</span>\\n            <span className=\\\"text-slate-600 dark:text-slate-300\\\">\\n              Direct WhatsApp / Mailto / Native Share active (user confirms send; official Cloud API optional via .env).\\n            </span>\\n          </div>\\n        </div>\\n      </section>\\n    </div>\"}], \"TargetFile\":\"/src/components/customer/AccountSettingsView.tsx\", \"toolAction\":\"Updating AccountSettingsView for customers\", \"toolSummary\":\"Update AccountSettingsView.tsx\"}"
      original_name: "multi_replace_file_content"
    }
