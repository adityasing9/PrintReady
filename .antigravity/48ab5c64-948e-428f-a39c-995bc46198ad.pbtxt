      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Lift mobile toast stack above mobile bottom nav bar and add iOS safe-area bottom padding\", \"EndLine\":400, \"Instruction\":\"Update mobile bottom nav bar safe-area padding and toast stack positioning on mobile\", \"ReplacementContent\":\"      {/* Mobile Customer Bottom Navigation Bar */}\\n      {portal === \'customer\' && (\\n        <nav\\n          aria-label=\\\"Mobile quick navigation\\\"\\n          className=\\\"lg:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-t border-slate-200 dark:border-slate-800 px-2 pt-1.5 pb-[calc(0.375rem+env(safe-area-inset-bottom))]\\\"\\n        >\\n          <div className=\\\"grid grid-cols-5 gap-1\\\">\\n            {mobileBottomTabs.map((item) => {\\n              const Icon = item.icon;\\n              const active = activeTab === item.id;\\n              return (\\n                <button\\n                  key={item.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => handleNavClick(item.id)}\\n                  className={`relative flex flex-col items-center justify-center py-1.5 rounded-lg text-[11px] font-medium transition-colors ${\\n                    active\\n                      ? \'text-indigo-700 dark:text-indigo-300 bg-indigo-50/70 dark:bg-indigo-950/50\'\\n                      : \'text-slate-500 dark:text-slate-400\'\\n                  }`}\\n                >\\n                  <span className=\\\"relative\\\">\\n                    <Icon className=\\\"w-4 h-4\\\" />\\n                    {typeof item.badge === \'number\' && item.badge > 0 && (\\n                      <span className=\\\"absolute -top-1.5 -right-2.5 min-w-4 h-4 px-1 bg-indigo-700 text-white text-[9px] font-mono tabular-nums font-semibold rounded-full flex items-center justify-center\\\">\\n                        {item.badge}\\n                      </span>\\n                    )}\\n                  </span>\\n                  <span className=\\\"mt-0.5 truncate\\\">{item.shortLabel || item.label}</span>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </nav>\\n      )}\\n\\n      {/* Toast Stack */}\\n      {toasts.length > 0 && (\\n        <div\\n          className={`fixed ${portal === \'customer\' ? \'bottom-20 lg:bottom-4\' : \'bottom-4\'} right-4 left-4 sm:left-auto z-50 flex flex-col gap-2 sm:max-w-sm pointer-events-none`}\\n          aria-live=\\\"polite\\\"\\n        >\", \"StartLine\":356, \"TargetContent\":\"      {/* Mobile Customer Bottom Navigation Bar */}\\n      {portal === \'customer\' && (\\n        <nav\\n          aria-label=\\\"Mobile quick navigation\\\"\\n          className=\\\"lg:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-t border-slate-200 dark:border-slate-800 px-2 py-1.5\\\"\\n        >\\n          <div className=\\\"grid grid-cols-5 gap-1\\\">\\n            {mobileBottomTabs.map((item) => {\\n              const Icon = item.icon;\\n              const active = activeTab === item.id;\\n              return (\\n                <button\\n                  key={item.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => handleNavClick(item.id)}\\n                  className={`relative flex flex-col items-center justify-center py-1.5 rounded-lg text-[11px] font-medium transition-colors ${\\n                    active\\n                      ? \'text-indigo-700 dark:text-indigo-300 bg-indigo-50/70 dark:bg-indigo-950/50\'\\n                      : \'text-slate-500 dark:text-slate-400\'\\n                  }`}\\n                >\\n                  <span className=\\\"relative\\\">\\n                    <Icon className=\\\"w-4 h-4\\\" />\\n                    {typeof item.badge === \'number\' && item.badge > 0 && (\\n                      <span className=\\\"absolute -top-1.5 -right-2.5 min-w-4 h-4 px-1 bg-indigo-700 text-white text-[9px] font-mono tabular-nums font-semibold rounded-full flex items-center justify-center\\\">\\n                        {item.badge}\\n                      </span>\\n                    )}\\n                  </span>\\n                  <span className=\\\"mt-0.5 truncate\\\">{item.shortLabel || item.label}</span>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </nav>\\n      )}\\n\\n      {/* Toast Stack */}\\n      {toasts.length > 0 && (\\n        <div className=\\\"fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none\\\" aria-live=\\\"polite\\\">\", \"TargetFile\":\"/src/components/LayoutShell.tsx\", \"toolAction\":\"Updating mobile toast and bottom nav spacing\", \"toolSummary\":\"Mobile toast and bottom nav update\"}"
