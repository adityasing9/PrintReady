      thinking_signature: "\022\231\017\n\226\017\001i\024}\023\017\306s \302!\ay\220.)\330\255c\300VL\343\263k7\227\300\205\262\266\204\027\372\225\356\373We+Z\363\207\210\356\305]\t\270A\357=)]\315\177\266\032\025L,o\307\327\241\v\347\370\027j\3746\231\245|\3152\300J\363\rV\351J\270\030\3358<G\230c\256\356\274\262n3\320\\\002\353\263\224l\313Z\363_\310z\b\334>\022\350\240u\373\225XU\253\277c}\207D\312htN\300\204}\245\272\324\356B\315,(\363\027\242\f\263\310\003\244\024\243\263\373\th\225Hb\222,w\277\202d\2267\005-\322\202A\260\263Q(\f\277\242!\331M\033\307\364\242\364\245\316\201>\000\236$&\252\243I\377\030\300\256#\330S!\363\266\030\267\313\005\221u\2004+&\004[\177\3059\3755sx\n?\333\370\357@\210\031\003\3117\230U\266X\321I\365[wf\n\350S\277\351tm\037\326K\302\303\343,}\377\350{M\362\316\221\234\016\034\337\230\035+\343\356\340Zc\366X\277\371\353\001\246\016hO\331\031\306%A\017Q\371\260H?\t(Q*c\327\266\b\236\223\232\254\320\005\035\220e\365\372\305\244s\265Q\r+\255J\2465\252\222\273\364;\205\025\361\331J\033\346\343\205\325\261\016\310\327u\275.\371\375#\314\033\376X\306Z\212\313\217\352\351]\371\020\n\275\263<\351\312\272\374\323u\033Y\314Q\355\360\330\202\235\223\r`\3219\a\347g6C\263$\002/8\325\021\303|\262\242)\337\343\357S\365\n\264\t\374Qs5\353\204\vG\355\352\345\214{\363)\227\273 Y$\255l\3177f\205\363\246jJ\206\362\230\326\230`\327L\247\203\211\2245:\017\263\240\203\232\271\n\271\251Kw\273\264\223O\242<h\266vDfM\002N\307\213\022\v\3133i\275\215\274K \212\271\232\016|G\326X\307\221\334r\332r0\311\331h\224O\233=V\217\362Fd/\341\235w\345H\327\335\374\237&\003\275\260\211\227.\3428\031a\0023|7z\240k\305\302\223\323\021\3615s\313h\225G\032\025\274\341\261Y\377\211\036\203\344P\221:\342\222&\002\311I\250\312R\370\223\v\001\347+\220\211\264\300\216d\257\331w\032;ZC/t\004~K1\251[\335\356\357\t\337\245\224\353\030\307AE\002`\3009~>\203\353\256\265\366T\272\331\004C\357c\376~\331\3479\027\353\255`\033\257m\220\273oRj\263t\310\263\227\314t\030*\371\265W\357?W\204\v>_\314{95\261\210\004d\263\310\245t\0374,\332\323r\302\000\252\240\2542:\265\301WW\324\356Kp\363\255\271\246\245\305\360\230&\177\252\272\255\"\b\316\241\336\vC&\256\245\345M[\2022\253\234^\204\270{\263\323\036~\302Xj`\021\232\257a\320\316\200`\221e7[8\362\320\0339H\376\2366\a\320N\370\202\017h\342o\213\346\204\374A\212;\362Y=Sg\357\002:\373\253\337\035\206XR\022\036f\243\217\026w\263\310\236\260=\226\b\030,\024\026\356\177\364\333\237\335\001\320\254] \316\331(\312\250[\246e\004\261_\236\235\326?&P\234\332\bi\36093c\377\032%\273\260 \021\250\021\034\225\300\207\362\232b\232\021\276N>\'\247\247\312\235\250\376\a\332\360\023{\b\331\235\212%\361\324\251\021TX\220\3606\032o\201\237\376\357S\303`\234)\002W\206iD\375\004\274\000\340\250\323Z\3548\200{\"\372P6\027\025\236\303i\252\315\356*3\343`\203\373\261L@\'\v\365\261V%\002\2208X\227\233?\221\220\231i\r:\226J\330\327\374\377\213\220\\W\350\323\340\304W\352:X\311\307\016\363,U2_\335\264\275\267\235\370\305\020l2\217\250\3149\227\276C3\321$\206\362Xl\244\324P\016\350i\367\234%\302\301\364\237;j\346\322\2507\334\212\2727\233:?G~\212\225\301\276N\351|\337%\320\3116ew\200A%\330\v\355\aF\017(\302\314\227\177K\225m\032SvW=\366\313\342dt#b\321O\315G\b\265a\352\224\375\343\027#\325\200F\3124\260R\313g\311\022\322\244=OC\267\373\311\346\230\210\337\301\200\367\250\252]\n\224\321\212\316\216\r\253\213\204BW\361\372N\236\354\204\205\004\216K\332\250A\247e\227\270\311D\022u\361z\254\266 CS\2405\005]K\034\344\326\2728\006\276\330\363\276\003I8\276,\242{\367\310r,\340\216Pq\366\277\315I7$;um\334S\356\002\024t\337m\244\340y\274wn{\002M\222\346\300\034G\000\222qW\313\020\246\272\230<\017\277Y}\274\037\017\222\2641\273\216\202\227te\250\036\371\220x\331l\206<\371#\332\024\371\267Rt\200\273I\231\355\026\025\003_(\224\025\222\'\025v\314V\212\320\njd\323\350\253ug\304pf\021F\213}M^\3668,W}Xma\211#.\365tr\355p8%-\233\204\277\330\372\266 \217\372\037X,&^\3476\\\236;\032\301\343\217O\027g\025\017\"=Z6i\325A\003\236\270i\206\267\2712G\271]\3219\020zW\b\304\241\372\271A\331\370\272\272\324)hy!+\265\021\271\267\020o\224\247s\t\344\035\020\373JM\315|`\350\030\304\\>al\324\310\342\206Wc\242wc\245\245\032kiX\377\222t:\345+!}\026\240\232pv\177`h\375\231\256\343\275\375\204\234\224\"\246\252\354#\030\335~\323#\356\213)J\245\314|4W\023Kwf\342|\026\202C\025\202\210<Q\"#\370\254._\345+7\377\255\202\334\202\b\360\234hX\272\334\337\351\257=p\332\237\305\366\242L\242\362%\355\270\371?Bh\021\025G\002\313\r\004\252|\340\177B\265\276_\242\201\273\265\231f\340?|\335\326[z\273\024\304\260\251\272\264\000mu\204o\037:[\232\246rI\\(U\367\377\354\374bo7N7\312\274\335\"\360\003\276\211\333\304\326Z\261K\227Z\214W\355F\206(\247\326\377[\373\255\026Bx\334\035&\260\006\377y\vZ\2141S\023k\2376d\273\207\350e\a\025\225\0362\371\254\201?R*\327\201G\356)\276 \r\204\201\265\253H\362\217o\376P\377\000\000\213\324\n\017gf\031\377\200xs\027i\230\216\355\243Z\205\f\373\371Y\312\335b\bg9\367)T\344\304\363\t\03551\335\231\005\343\026B\274\202\030SV\020}\343&\333~\213\303\004\334\313E02\023\307C!o\022\214\377\r\241\255\223\267\315>K\253}Y\331\377\304\335\341^\342\375\336\353\023\311HE\357,\016\027\251{\256\352\324\351*\314\004\027\207~L\317t\230\374\257\325an!DV\214\222E\324?\262\317\016\213\351\247m\343=_\271\2008I>v*<\375\232Lb\372\211B\251\302\005Z\343m\024\316\n-\"_\001\322\311\2578:\001\267\204\031\220Ab\236\321)3\364\244\347\327\235\301\b$ \314\336<\353`\210E\261v\260\306\244\347\315X\017\3063\203UC\264|\203\315\230\2271\360\200:A\270\246\322?\254$0[\320\301\241<\337\271\3432\376\n>\306\302Q"
