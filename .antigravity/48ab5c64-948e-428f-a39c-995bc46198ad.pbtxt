          target_content: "// Server-side idempotency & sandbox payment intent registry\ninterface PaymentRecord {\n  intentId: string;\n  orderId: string;\n  orderNumber: string;\n  amount: number;\n  currency: string;\n  method: string;\n  mode: \'razorpay_live\' | \'server_sandbox\';\n  status: \'initiated\' | \'verified\' | \'refunded\';\n  transactionId?: string;\n  serverSignature: string;\n  createdAt: string;\n  verifiedAt?: string;\n}\nconst paymentStore = new Map<string, PaymentRecord>();\nconst PAYMENT_HMAC_SECRET = process.env.RAZORPAY_KEY_SECRET || \'printready-dev-sandbox-hmac-key\';\n\nfunction signPaymentPayload(intentId: string, orderId: string, amount: number): string {\n  return crypto\n    .createHmac(\'sha256\', PAYMENT_HMAC_SECRET)\n    .update(`${intentId}|${orderId}|${amount.toFixed(2)}`)\n    .digest(\'hex\');\n}"
          replacement_content: "// Server-side verified Razorpay payment registry (idempotency & audit tracking)\ninterface VerifiedRazorpayRecord {\n  razorpay_order_id: string;\n  razorpay_payment_id: string;\n  verifiedAt: string;\n  mode: \'razorpay_test\' | \'razorpay_live\';\n}\nconst verifiedRazorpayPayments = new Map<string, VerifiedRazorpayRecord>();\n\nfunction getRazorpayClient(): { client: Razorpay; keyId: string; keySecret: string } {\n  const keyId = process.env.RAZORPAY_KEY_ID?.trim() || \'\';\n  const keySecret = process.env.RAZORPAY_KEY_SECRET?.trim() || \'\';\n  if (!keyId || !keySecret) {\n    const err = new Error(\'Razorpay credentials are not configured on the server.\');\n    (err as Error & { statusCode?: number }).statusCode = 401;\n    throw err;\n  }\n  return {\n    client: new Razorpay({ key_id: keyId, key_secret: keySecret }),\n    keyId,\n    keySecret,\n  };\n}"
          start_line: 43
          end_line: 67
        }
        replacement_chunks {
          target_content: "    const hasRazorpay = Boolean(process.env.RAZORPAY_KEY_ID && process.env.RAZORPAY_KEY_SECRET);\n    const hasEmail = Boolean(process.env.EMAIL_SMTP_HOST && process.env.EMAIL_SMTP_USER);\n    const hasWhatsAppCloud = Boolean(process.env.WHATSAPP_ACCESS_TOKEN && process.env.WHATSAPP_PHONE_NUMBER_ID);\n\n    res.json({\n      geminiAi: { configured: hasGemini, model: \'gemini-4-hydrogen\' },\n      firebase: { configured: true, mode: \'client_sdk_firestore\' },\n      payments: {\n        provider: \'razorpay\',\n        liveConfigured: hasRazorpay,\n        mode: hasRazorpay ? \'razorpay_live\' : \'server_sandbox\',\n        note: hasRazorpay\n          ? \'Live Razorpay merchant keys active.\'\n          : \'Server-verified HMAC sandbox active. Configure RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET for live settlements.\',\n      },"
          replacement_content: "    const razorpayKeyId = process.env.RAZORPAY_KEY_ID?.trim() || \'\';\n    const hasRazorpay = Boolean(razorpayKeyId && process.env.RAZORPAY_KEY_SECRET?.trim());\n    const isTestRazorpay = razorpayKeyId.startsWith(\'rzp_test_\');\n    const hasEmail = Boolean(process.env.EMAIL_SMTP_HOST && process.env.EMAIL_SMTP_USER);\n    const hasWhatsAppCloud = Boolean(process.env.WHATSAPP_ACCESS_TOKEN && process.env.WHATSAPP_PHONE_NUMBER_ID);\n\n    res.json({\n      geminiAi: { configured: hasGemini, model: \'gemini-4-hydrogen\' },\n      firebase: { configured: true, mode: \'client_sdk_firestore\' },\n      payments: {\n        provider: \'razorpay\',\n        liveConfigured: hasRazorpay,\n        mode: !hasRazorpay ? \'unconfigured\' : isTestRazorpay ? \'razorpay_test\' : \'razorpay_live\',\n        note: !hasRazorpay\n          ? \'Configure RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET in .env to enable Razorpay Standard Checkout.\'\n          : isTestRazorpay\n          ? \'Razorpay Standard Checkout active in Test Mode (rzp_test_*).\'\n          : \'Razorpay Standard Checkout active in Live Mode.\',\n      },"
          start_line: 76
          end_line: 92
        }
        replacement_chunks {
          target_content: "  // 5. Secure Server-Side Payment Initiation & Verification Abstraction\n  app.post(\'/api/payments/initiate\', (req, res) => {\n    const { orderId, orderNumber, amount, currency, method, idempotencyKey } = req.body as {\n      orderId?: string;\n      orderNumber?: string;\n      amount?: number;\n      currency?: string;\n      method?: string;\n      idempotencyKey?: string;\n    };\n\n    if (!orderId || !orderNumber || typeof amount !== \'number\' || amount <= 0) {\n      return res.status(400).json({ error: \'Valid orderId, orderNumber, and positive amount are required.\' });\n    }\n\n    const existingKey = idempotencyKey && paymentStore.get(idempotencyKey);\n    if (existingKey) {\n      return res.json(existingKey);\n    }\n\n    const hasLiveRazorpay = Boolean(process.env.RAZORPAY_KEY_ID && process.env.RAZORPAY_KEY_SECRET);\n    const intentId = `pay_int_${crypto.randomBytes(8).toString(\'hex\')}`;\n    const serverSignature = signPaymentPayload(intentId, orderId, amount);\n\n    const record: PaymentRecord = {\n      intentId,\n      orderId,\n      orderNumber,\n      amount,\n      currency: currency || \'INR\',\n      method: method || \'UPI\',\n      mode: hasLiveRazorpay ? \'razorpay_live\' : \'server_sandbox\',\n      status: \'initiated\',\n      serverSignature,\n      createdAt: new Date().toISOString(),\n    };\n\n    paymentStore.set(intentId, record);\n    if (idempotencyKey) {\n      paymentStore.set(idempotencyKey, record);\n    }\n\n    return res.json({\n      intentId: record.intentId,\n      orderId: record.orderId,\n      amount: record.amount,\n      currency: record.currency,\n      method: record.method,\n      mode: record.mode,\n      signatureToken: record.serverSignature,\n      createdAt: record.createdAt,\n    });\n  });\n\n  app.post(\'/api/payments/verify\', (req, res) => {\n    const { intentId, signatureToken } = req.body as {\n      intentId?: string;\n      signatureToken?: string;\n    };\n\n    if (!intentId || !signatureToken) {\n      return res.status(400).json({ error: \'intentId and signatureToken are required.\' });\n    }\n\n    const record = paymentStore.get(intentId);\n    if (!record) {\n      return res.status(404).json({ error: \'Payment intent not found.\' });\n    }\n\n    const expected = signPaymentPayload(record.intentId, record.orderId, record.amount);\n    const sigBuf = Buffer.from(signatureToken);\n    const expBuf = Buffer.from(expected);\n    if (sigBuf.length !== expBuf.length || !crypto.timingSafeEqual(sigBuf, expBuf)) {\n      return res.status(403).json({ error: \'Payment signature verification failed.\' });\n    }\n\n    if (record.status === \'verified\') {\n      return res.json({\n        verified: true,\n        duplicatePrevented: true,\n        transactionId: record.transactionId,\n        verifiedAt: record.verifiedAt,\n        mode: record.mode,\n      });\n    }\n\n    record.status = \'verified\';\n    record.transactionId = `TXN-${Date.now().toString(36).toUpperCase()}-${crypto.randomBytes(3).toString(\'hex\').toUpperCase()}`;\n    record.verifiedAt = new Date().toISOString();\n\n    return res.json({\n      verified: true,\n      transactionId: record.transactionId,\n      verifiedAt: record.verifiedAt,\n      mode: record.mode,\n      amount: record.amount,\n      currency: record.currency,\n    });\n  });"
          replacement_content: "  // 5. Razorpay Standard Checkout \342\200\224 Step 1: Create Order\n  app.post(\'/api/create-order\', async (req, res) => {\n    const { amount, currency = \'INR\', receipt, notes } = req.body as {\n      amount?: number;\n      currency?: string;\n      receipt?: string;\n      notes?: Record<string, string>;\n    };\n\n    const validation = validateRazorpayOrderAmount(amount);\n    if (!validation.valid || !validation.amountPaise) {\n      return res.status(400).json({ error: validation.error || \'Amount must be at least 100 paise.\' });\n    }\n\n    let razorpayClient: Razorpay;\n    let keyId: string;\n    try {\n      const ctx = getRazorpayClient();\n      razorpayClient = ctx.client;\n      keyId = ctx.keyId;\n    } catch (err) {\n      return res.status(401).json({\n        error: err instanceof Error ? err.message : \'Razorpay authentication credentials missing.\',\n      });\n    }\n\n    try {\n      const safeReceipt = String(receipt || `pr_${Date.now()}`).slice(0, 40);\n      const order = await razorpayClient.orders.create({\n        amount: validation.amountPaise,\n        currency: String(currency || \'INR\').toUpperCase(),\n        receipt: safeReceipt,\n        notes: notes || {},\n      });\n\n      return res.json({\n        order_id: order.id,\n        amount: order.amount,\n        currency: order.currency,\n        receipt: order.receipt,\n        key_id: keyId,\n      });\n    } catch (err: unknown) {\n      const rzpErr = err as { statusCode?: number; error?: { description?: string; code?: string }; message?: string };\n      const statusCode = rzpErr?.statusCode === 401 ? 401 : 500;\n      const message =\n        rzpErr?.error?.description ||\n        rzpErr?.message ||\n        \'Failed to create Razorpay order.\';\n      console.error(\'[Razorpay Create Order Error]\', statusCode, message);\n      return res.status(statusCode).json({ error: message });\n    }\n  });\n\n  // 6. Razorpay Standard Checkout \342\200\224 Step 3: Verify Payment Signature\n  app.post(\'/api/verify-payment\', (req, res) => {\n    const { razorpay_order_id, razorpay_payment_id, razorpay_signature } = req.body as {\n      razorpay_order_id?: string;\n      razorpay_payment_id?: string;\n      razorpay_signature?: string;\n    };\n\n    const keySecret = process.env.RAZORPAY_KEY_SECRET?.trim() || \'\';\n    const keyId = process.env.RAZORPAY_KEY_ID?.trim() || \'\';\n    const verification = verifyRazorpaySignature({\n      razorpay_order_id,\n      razorpay_payment_id,\n      razorpay_signature,\n      keySecret,\n    });\n\n    if (!verification.valid) {\n      return res.status(verification.statusCode).json({\n        verified: false,\n        error: verification.error,\n      });\n    }\n\n    const existing = verifiedRazorpayPayments.get(razorpay_payment_id!);\n    if (existing) {\n      return res.json({\n        verified: true,\n        duplicatePrevented: true,\n        razorpay_order_id: existing.razorpay_order_id,\n        razorpay_payment_id: existing.razorpay_payment_id,\n        transactionId: existing.razorpay_payment_id,\n        verifiedAt: existing.verifiedAt,\n        mode: existing.mode,\n      });\n    }\n\n    const record: VerifiedRazorpayRecord = {\n      razorpay_order_id: razorpay_order_id!,\n      razorpay_payment_id: razorpay_payment_id!,\n      verifiedAt: new Date().toISOString(),\n      mode: keyId.startsWith(\'rzp_test_\') ? \'razorpay_test\' : \'razorpay_live\',\n    };\n    verifiedRazorpayPayments.set(record.razorpay_payment_id, record);\n\n    return res.json({\n      verified: true,\n      razorpay_order_id: record.razorpay_order_id,\n      razorpay_payment_id: record.razorpay_payment_id,\n      transactionId: record.razorpay_payment_id,\n      verifiedAt: record.verifiedAt,\n      mode: record.mode,\n    });\n  });"
          start_line: 332
          end_line: 432
        }
      }
    }
