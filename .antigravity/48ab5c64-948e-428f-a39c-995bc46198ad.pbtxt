            lines {
              text: "      : logicalSidesPerCopy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalPrintedPages = logicalSidesPerCopy * copies;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const estimatedSheets = sheetsPerCopy * copies;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
