            }
            lines {
              text: "    filters.push(\'grayscale(100%)\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (page.filter === \'bw\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    filters.push(\'grayscale(100%)\', \'contrast(190%)\');"
