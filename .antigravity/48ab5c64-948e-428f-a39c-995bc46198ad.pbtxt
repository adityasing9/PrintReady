  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  CheckCircle2,\n  Clock,\n  CreditCard,\n  MessageSquare,\n  QrCode,\n  Send,\n  ShieldCheck,\n  Star,\n  X,\n} from \'lucide-react\';\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\nimport { getAvailableOrderActions, STATUS_LABELS } from \'../../domain/orderStateMachine\';\nimport { formatCurrency } from \'../../domain/printCalculator\';\nimport { PrintOrder } from \'../../domain/types\';\n\nexport function CustomerOrdersView() {\n  const {\n    orders,\n    integrations,\n    transitionOrderStatus,\n    sendOrderMessage,\n    submitReview,\n    notify,\n  } = usePrintReady();\n\n  const [selectedOrderId, setSelectedOrderId] = useState<string>(orders[0]?.id || \'\');\n  const [chatText, setChatText] = useState(\'\');\n\n  // Server-verified Payment Modal\n  const [payingOrder, setPayingOrder] = useState<PrintOrder | null>(null);\n  const [paymentMethod, setPaymentMethod] = useState<\'UPI\' | \'QR\' | \'Card\' | \'Cash\'>(\'UPI\');\n  const [paymentBusy, setPaymentBusy] = useState(false);\n\n  // Verified Review Modal\n  const [reviewOrder, setReviewOrder] = useState<PrintOrder | null>(null);\n  const [reviewRating, setReviewRating] = useState(5);\n  const [reviewComment, setReviewComment] = useState(\'\');\n\n  const activeOrder = orders.find((o) => o.id === selectedOrderId) || orders[0] || null;\n\n  const handleServerVerifiedPayment = async () => {\n    if (!payingOrder) return;\n    setPaymentBusy(true);\n    try {\n      const finalAmount = payingOrder.confirmedTotal ?? payingOrder.estimatedTotal;\n\n      // Step 1: Customer approves price if pending\n      if (payingOrder.status === \'price_pending_approval\') {\n        transitionOrderStatus(payingOrder.id, \'approved\', \'customer\', {\n          note: `Customer approved final price of ${formatCurrency(finalAmount, payingOrder.currency)}.`,\n        });\n      }\n\n      // Step 2: Initiate payment intent on backend\n      const initResp = await fetch(\'/api/payments/initiate\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          orderId: payingOrder.id,\n          orderNumber: payingOrder.orderNumber,\n          amount: finalAmount,\n          currency: payingOrder.currency,\n          method: paymentMethod,\n          idempotencyKey: `idem-${payingOrder.id}-${finalAmount}`,\n        }),\n      });\n      const initData = await initResp.json();\n      if (!initResp.ok) throw new Error(initData.error || \'Failed to initiate payment.\');\n\n      // Step 3: Verify HMAC-signed transaction on backend (never trust client-only state)\n      const verifyResp = await fetch(\'/api/payments/verify\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          intentId: initData.intentId,\n          signatureToken: initData.signatureToken,\n        }),\n      });\n      const verifyData = await verifyResp.json();\n      if (!verifyResp.ok || !verifyData.verified) {\n        throw new Error(verifyData.error || \'Backend payment verification failed.\');\n      }\n\n      transitionOrderStatus(payingOrder.id, \'paid\', \'system\', {\n        paymentTransactionId: verifyData.transactionId,\n        paymentMethod,\n        note: `${paymentMethod} payment verified (${verifyData.transactionId} \302\267 ${verifyData.mode === \'razorpay_live\' ? \'Razorpay Live\' : \'Server HMAC Sandbox\'}).`,\n      });\n      notify(\n        \'Payment Verified\',\n        `Receipt ${verifyData.transactionId} confirmed for ${payingOrder.orderNumber}.`,\n        \'success\'\n      );\n      setPayingOrder(null);\n    } catch (err) {\n      notify(\'Payment verification failed\', err instanceof Error ? err.message : \'Try again.\', \'error\');\n    } finally {\n      setPaymentBusy(false);\n    }\n  };\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n      {/* Left 5 Cols: Order History List */}\n      <div className=\"lg:col-span-5 space-y-3\">\n        <h2 className=\"text-base font-semibold text-slate-900 dark:text-white\">\n          Your Print Orders ({orders.length})\n        </h2>\n        {orders.length === 0 ? (\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 text-center text-sm text-slate-500\">\n            No marketplace orders yet. Configure documents in Print Basket to place your first order.\n          </div>\n        ) : (\n          orders.map((ord) => {\n            const isSelected = activeOrder?.id === ord.id;\n            return (\n              <button\n                key={ord.id}\n                type=\"button\"\n                onClick={() => setSelectedOrderId(ord.id)}\n                className={`w-full text-left p-4 rounded-xl border transition-colors space-y-1.5 ${\n                  isSelected\n                    ? \'bg-indigo-50/50 dark:bg-indigo-950/40 border-indigo-600\'\n                    : \'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between gap-2\">\n                  <span className=\"font-mono text-sm font-bold text-slate-900 dark:text-white\">\n                    {ord.orderNumber}\n                  </span>\n                  <span className=\"font-mono tabular-nums text-sm font-semibold text-slate-900 dark:text-white\">\n                    {formatCurrency(ord.confirmedTotal ?? ord.estimatedTotal, ord.currency)}\n                  </span>\n                </div>\n                <p className=\"text-xs font-medium text-slate-700 dark:text-slate-300 truncate\">{ord.shopName}</p>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                  <span\n                    className={\n                      ord.status === \'completed\' || ord.status === \'ready_for_pickup\'\n                        ? \'text-emerald-700 dark:text-emerald-400 font-medium\'\n                        : ord.status === \'price_pending_approval\'\n                        ? \'text-amber-700 dark:text-amber-400 font-medium\'\n                        : \'text-indigo-700 dark:text-indigo-400 font-medium\'\n                    }\n                  >\n                    {STATUS_LABELS[ord.status]}\n                  </span>{\' \'}\n                  \302\267 {ord.items.length} file{ord.items.length > 1 ? \'s\' : \'\'} \302\267 {ord.fulfillmentType}\n                </p>\n              </button>\n            );\n          })\n        )}\n      </div>\n\n      {/* Right 7 Cols: Active Order Details, Timeline, Pickup Code & Chat */}\n      <div className=\"lg:col-span-7\">\n        {activeOrder ? (\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-6\">\n            {/* Order Header */}\n            <div className=\"flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800\">\n              <div>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                  {activeOrder.shopName} \302\267 {activeOrder.fulfillmentType === \'delivery\' ? \'Delivery\' : \'Shop Pickup\'}\n                </p>\n                <h3 className=\"text-xl font-bold font-mono text-slate-900 dark:text-white mt-0.5\">\n                  {activeOrder.orderNumber}\n                </h3>\n                <p className=\"text-xs mt-1\">\n                  Status:{\' \'}\n                  <span className=\"font-semibold text-indigo-700 dark:text-indigo-300\">\n                    {STATUS_LABELS[activeOrder.status]}\n                  </span>{\' \'}\n                  \302\267 Payment:{\' \'}\n                  <span className=\"font-semibold text-slate-800 dark:text-slate-200 capitalize\">\n                    {activeOrder.paymentStatus}\n                  </span>\n                  {activeOrder.paymentTransactionId && (\n                    <span className=\"font-mono text-slate-500\"> ({activeOrder.paymentTransactionId})</span>\n                  )}\n                </p>\n              </div>\n\n              <div className=\"text-left sm:text-right\">\n                <p className=\"text-xs text-slate-500\">\n                  {activeOrder.confirmedTotal !== undefined ? \'Confirmed Price\' : \'Estimated Price\'}\n                </p>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-slate-900 dark:text-white\">\n                  {formatCurrency(activeOrder.confirmedTotal ?? activeOrder.estimatedTotal, activeOrder.currency)}\n                </p>\n              </div>\n            </div>\n\n            {/* Contextual Customer Actions */}\n            <div className=\"flex flex-wrap items-center gap-2.5\">\n              {getAvailableOrderActions(activeOrder.status, \'customer\', activeOrder.fulfillmentType).map((act) => (\n                <button\n                  key={act.label}\n                  type=\"button\"\n                  onClick={() => {\n                    if (act.requiresPaymentFlow) {\n                      setPayingOrder(activeOrder);\n                    } else {\n                      transitionOrderStatus(activeOrder.id, act.nextStatus, \'customer\');\n                    }\n                  }}\n                  className={`inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium rounded-lg transition-colors whitespace-nowrap ${\n                    act.tone === \'primary\'\n                      ? \'bg-indigo-700 hover:bg-indigo-800 text-white\'\n                      : act.tone === \'danger\'\n                      ? \'border border-red-200 dark:border-red-900 text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30\'\n                      : \'border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200\'\n                  }`}\n                >\n                  {act.requiresPaymentFlow && <CreditCard className=\"w-3.5 h-3.5\" />}\n                  {act.label}\n                </button>\n              ))}\n\n              {activeOrder.status === \'completed\' && !activeOrder.reviewed && (\n                <button\n                  type=\"button\"\n                  onClick={() => setReviewOrder(activeOrder)}\n                  className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg\"\n                >\n                  <Star className=\"w-3.5 h-3.5\" />\n                  Leave Verified Review\n                </button>\n              )}\n            </div>\n\n            {/* Pickup Code / Delivery & Retention Info */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n              <div className=\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg flex items-center gap-3\">\n                <QrCode className=\"w-8 h-8 text-indigo-700 dark:text-indigo-400 shrink-0\" />\n                <div>\n                  <p className=\"text-slate-500\">Collection Verification Code</p>\n                  <p className=\"font-mono text-base font-bold text-slate-900 dark:text-white\">{activeOrder.pickupCode}</p>\n                  <p className=\"text-[11px] text-slate-500\">Preferred: {activeOrder.preferredTime}</p>\n                </div>\n              </div>\n              <div className=\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-1\">\n                <p className=\"font-semibold text-slate-800 dark:text-slate-200 flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  Temporary File Access Policy\n                </p>\n                <p className=\"text-slate-500 dark:text-slate-400 leading-relaxed\">\n                  Shop access to order print files expires automatically on{\' \'}\n                  <span className=\"font-mono\">{activeOrder.fileRetentionExpiresAt.slice(0, 10)}</span>. Your personal Vault copy remains untouched.\n                </p>\n              </div>\n            </div>\n\n            {/* Files in Order */}\n            <div className=\"space-y-2\">\n              <h4 className=\"text-xs font-semibold text-slate-700 dark:text-slate-300\">Order Files & Specifications</h4>\n              <div className=\"divide-y divide-slate-100 dark:divide-slate-800 border border-slate-200 dark:border-slate-800 rounded-lg text-xs\">\n                {activeOrder.items.map((item) => (\n                  <div key={item.id} className=\"px-3.5 py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\">\n                    <span className=\"font-medium text-slate-900 dark:text-white truncate\">{item.documentName}</span>\n                    <span className=\"text-slate-500 font-mono shrink-0\">\n                      {item.settings.copies}x \302\267 {item.settings.paperSize} \302\267 {item.settings.colorMode.toUpperCase()} \302\267 {item.settings.sides} \302\267 {item.settings.binding}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Order Timeline */}\n            <div className=\"space-y-2\">\n              <h4 className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5\">\n                <Clock className=\"w-3.5 h-3.5\" />\n                Order Timeline\n              </h4>\n              <ol className=\"space-y-2 text-xs\">\n                {activeOrder.events.map((ev) => (\n                  <li key={ev.id} className=\"flex items-start justify-between gap-3 py-1.5 border-b last:border-b-0 border-slate-100 dark:border-slate-800\">\n                    <div>\n                      <span className=\"font-semibold text-slate-900 dark:text-white\">{STATUS_LABELS[ev.status]}</span>\n                      <span className=\"text-slate-400\"> \302\267 {ev.actorName}</span>\n                      <p className=\"text-slate-600 dark:text-slate-400 mt-0.5\">{ev.note}</p>\n                    </div>\n                    <span className=\"font-mono text-[11px] text-slate-400 shrink-0\">\n                      {new Date(ev.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                    </span>\n                  </li>\n                ))}\n              </ol>\n            </div>\n\n            {/* Order-Based Chat */}\n            <div className=\"pt-4 border-t border-slate-200 dark:border-slate-800 space-y-3\">\n              <h4 className=\"text-xs font-semibold text-slate-900 dark:text-white flex items-center gap-1.5\">\n                <MessageSquare className=\"w-3.5 h-3.5 text-indigo-600\" />\n                Order Chat with {activeOrder.shopName}\n              </h4>\n              <div className=\"max-h-52 overflow-y-auto space-y-2 p-3 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800\">\n                {activeOrder.messages.length === 0 ? (\n                  <p className=\"text-xs text-slate-500\">No messages yet. Ask about paper stock, margins, or pickup time.</p>\n                ) : (\n                  activeOrder.messages.map((m) => (\n                    <div\n                      key={m.id}\n                      className={`p-2.5 rounded-lg text-xs max-w-[85%] ${\n                        m.senderRole === \'customer\'\n                          ? \'ml-auto bg-indigo-700 text-white\'\n                          : \'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200\'\n                      }`}\n                    >\n                      <p className=\"font-semibold text-[11px] opacity-80\">{m.senderName}</p>\n                      <p className=\"mt-0.5 leading-relaxed\">{m.text}</p>\n                    </div>\n                  ))\n                )}\n              </div>\n\n              <form\n                onSubmit={(e) => {\n                  e.preventDefault();\n                  if (chatText.trim()) {\n                    sendOrderMessage(activeOrder.id, \'customer\', chatText);\n                    setChatText(\'\');\n                  }\n                }}\n                className=\"flex gap-2\"\n              >\n                <input\n                  type=\"text\"\n                  value={chatText}\n                  onChange={(e) => setChatText(e.target.value)}\n                  placeholder=\"Write a message to the print shop...\"\n                  aria-label=\"Message print shop\"\n                  className=\"flex-1 px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\"\n                />\n                <button\n                  type=\"submit\"\n                  className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                  Send\n                </button>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-10 text-center text-sm text-slate-500\">\n            Select an order to inspect timeline, pickup code, and chat.\n          </div>\n        )}\n      </div>\n\n      {/* Server-Verified Payment Modal */}\n      {payingOrder && (\n        <div className=\"fixed inset-0 z-50 bg-slate-950/50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-md w-full p-6 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">Approve Price & Pay</h3>\n              <button\n                type=\"button\"\n                onClick={() => setPayingOrder(null)}\n                aria-label=\"Close payment modal\"\n                className=\"p-1 text-slate-400 hover:text-slate-700\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <div className=\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-1 text-xs\">\n              <p className=\"text-slate-500\">{payingOrder.orderNumber} \302\267 {payingOrder.shopName}</p>\n              <p className=\"text-xl font-bold font-mono tabular-nums text-slate-900 dark:text-white\">\n                {formatCurrency(payingOrder.confirmedTotal ?? payingOrder.estimatedTotal, payingOrder.currency)}\n              </p>\n              <p className=\"text-[11px] text-slate-500\">\n                {integrations?.payments.liveConfigured\n                  ? \'Razorpay Live Gateway active.\'\n                  : \'Server-Verified HMAC Sandbox active (set RAZORPAY_KEY_ID & SECRET for live capture).\'}\n              </p>\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <span className=\"block text-xs font-medium text-slate-700 dark:text-slate-300\">Payment Method</span>\n              <div className=\"grid grid-cols-2 gap-2\">\n                {([\'UPI\', \'QR\', \'Card\', \'Cash\'] as const).map((m) => (\n                  <button\n                    key={m}\n                    type=\"button\"\n                    onClick={() => setPaymentMethod(m)}\n                    className={`py-2 text-xs font-medium rounded-lg border ${\n                      paymentMethod === m\n                        ? \'border-indigo-600 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-200\'\n                        : \'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300\'\n                    }`}\n                  >\n                    {m}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              disabled={paymentBusy}\n              onClick={handleServerVerifiedPayment}\n              className=\"w-full inline-flex items-center justify-center gap-2 py-2.5 text-sm font-medium text-white bg-emerald-700 hover:bg-emerald-800 disabled:opacity-50 rounded-lg\"\n            >\n              <CheckCircle2 className=\"w-4 h-4\" />\n              {paymentBusy ? \'Verifying on Backend...\' : `Verify & Pay via ${paymentMethod}`}\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Verified Review Modal */}\n      {reviewOrder && (\n        <div className=\"fixed inset-0 z-50 bg-slate-950/50 flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-md w-full p-6 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n                Review {reviewOrder.shopName}\n              </h3>\n              <button type=\"button\" onClick={() => setReviewOrder(null)} aria-label=\"Close review modal\">\n                <X className=\"w-5 h-5 text-slate-400\" />\n              </button>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              {[1, 2, 3, 4, 5].map((star) => (\n                <button\n                  key={star}\n                  type=\"button\"\n                  onClick={() => setReviewRating(star)}\n                  aria-label={`Rate ${star} stars`}\n                  className=\"p-1\"\n                >\n                  <Star className={`w-6 h-6 ${star <= reviewRating ? \'text-amber-500 fill-amber-500\' : \'text-slate-300\'}`} />\n                </button>\n              ))}\n            </div>\n            <textarea\n              rows={3}\n              value={reviewComment}\n              onChange={(e) => setReviewComment(e.target.value)}\n              placeholder=\"Share print quality, binding finish, and turnaround experience...\"\n              className=\"w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\"\n            />\n            <button\n              type=\"button\"\n              onClick={() => {\n                if (reviewComment.trim()) {\n                  submitReview(reviewOrder.shopId, reviewOrder.id, reviewRating, reviewComment);\n                  setReviewComment(\'\');\n                  setReviewOrder(null);\n                }\n              }}\n              className=\"w-full py-2.5 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\"\n            >\n              Submit Verified Order Review\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
