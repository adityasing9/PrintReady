              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sizeMultiplier = pricing.sizeMultipliers[item.settings.paperSize] ?? 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const duplexFactor = item.settings.sides === \'double\' ? pricing.duplexDiscountFactor : 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const printCost = roundCurrency(totalPrintedPages * baseRate * sizeMultiplier * duplexFactor);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const paperSurcharge = roundCurrency("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estimatedSheets * (pricing.paperSurchargePerSheet[item.settings.paperType] ?? 0)"
