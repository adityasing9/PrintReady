              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateOrderEstimate("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  items: PrintBasketItem[],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  pricing: ShopPricingTable = DEFAULT_PRICING,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  options: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    fulfillmentType: \'pickup\' | \'delivery\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coupon?: Coupon | null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    nowIso?: string;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } = { fulfillmentType: \'pickup\' }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): OrderCostEstimate {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const breakdowns = items.map((item) => calculateItemPrintCost(item, pricing));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalCopies = breakdowns.reduce((sum, b) => sum + b.copies, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalPrintedPages = breakdowns.reduce((sum, b) => sum + b.totalPrintedPages, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalSheets = breakdowns.reduce((sum, b) => sum + b.estimatedSheets, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const subtotal = roundCurrency(breakdowns.reduce((sum, b) => sum + b.itemTotal, 0));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let discount = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let couponError: string | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (options.coupon) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const now = options.nowIso ? new Date(options.nowIso).getTime() : Date.now();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const expiry = new Date(options.coupon.expiresAt).getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!options.coupon.active) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      couponError = \'This coupon is no longer active.\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (now > expiry) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      couponError = \'This coupon has expired.\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (subtotal < options.coupon.minOrderAmount) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      couponError = `Minimum order of ${pricing.currency} ${options.coupon.minOrderAmount} required.`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const rawDiscount ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options.coupon.discountType === \'percent\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? (subtotal * options.coupon.value) / 100"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : options.coupon.value;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const capped = options.coupon.maxDiscount"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? Math.min(rawDiscount, options.coupon.maxDiscount)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : rawDiscount;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
