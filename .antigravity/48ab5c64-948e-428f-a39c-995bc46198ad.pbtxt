t & verify WhatsApp / Email redirect links + Custom recipient  await page.getByRole(\"button\", { name: /Print Basket/i }).click();  await page.waitForTimeout(400);  const waHref = await page.getByRole(\"link\", { name: /Send via WhatsApp/i }).getAttribute(\"href\");  const mailHref = await page.getByRole(\"link\", { name: /Send via Email/i }).getAttribute(\"href\");  console.log(\"BASKET_LINKS:\", JSON.stringify({ waStarts: waHref?.slice(0, 32), mailStarts: mailHref?.slice(0, 38) }));  if (!waHref?.startsWith(\"https://wa.me/\")) throw new Error(\"Invalid WhatsApp href: \" + waHref);  if (!mailHref?.startsWith(\"mailto:\")) throw new Error(\"Invalid Email href: \" + mailHref);  await page.screenshot({ path: \".playwright-cli/cust-only-basket.png\" });  // Test Custom WhatsApp / Email recipient option  await page.selectOption(\"#checkout-shop\", \"__custom__\");  await page.fill(\"#custom-shop-wa\", \"+91 99887 76655\");  await page.fill(\"#custom-shop-email\", \"customprint@example.com\");  await page.waitForTimeout(200);  const customWa = await page.getByRole(\"link\", { name: /Send via WhatsApp/i }).getAttribute(\"href\");  const customMail = await page.getByRole(\"link\", { name: /Send via Email/i }).getAttribute(\"href\");  if (!customWa?.includes(\"wa.me/919988776655\")) throw new Error(\"Custom WhatsApp href mismatch: \" + customWa);  if (!customMail?.includes(\"mailto:customprint%40example.com\")) throw new Error(\"Custom Email href mismatch: \" + customMail);  console.log(\"CUSTOM_REDIRECT_VERIFIED: true\");  // 2. Navigate to Print Requests & verify WhatsApp/Email redirect + zero payment checkout  await page.getByRole(\"button\", { name: /Print Requests/i }).click();  await page.waitForTimeout(400);  const reqText = await page.locator(\"main\").innerText();  if (reqText.toLowerCase().includes(\"razorpay\") || reqText.includes(\"Approve Price & Pay\")) {    throw new Error(\"Payment UI still present in Print Requests!\");  }  const reqWa = await page.getByRole(\"link\", { name: /Send on WhatsApp/i }).getAttribute(\"href\");  const reqMail = await page.getByRole(\"link\", { name: /Send via Email/i }).getAttribute(\"href\");  if (!reqWa?.startsWith(\"https://wa.me/\") || !reqMail?.startsWith(\"mailto:\")) {    throw new Error(\"Missing WhatsApp/Email redirect links in Print Requests\");  }  await page.screenshot({ path: \".playwright-cli/cust-only-requests.png\" });  // 3. Navigate to Print Shops & check cards  await page.getByRole(\"button\", { name: /Print Shops/i }).click();  await page.waitForTimeout(400);  await page.screenshot({ path: \".playwright-cli/cust-only-shops.png\" });  // 4. Navigate to Account & Security & verify zero Partner Portal card  await page.getByRole(\"button\", { name: /Account & Security/i }).click();  await page.waitForTimeout(400);  const accText = await page.locator(\"main\").innerText();  if (accText.includes(\"Partner Portal\") || accText.includes(\"Run a Print Shop\")) {    throw new Error(\"Shop Partner Portal card still in Account settings!\");  }  await page.screenshot({ path: \".playwright-cli/cust-only-account.png\" });})(page);```### Ran Playwright code```jsawait page.setViewportSize({ width: 390, height: 844 });```### Ran Playwright code```jsawait (async (page) => {  const nav = page.locator(\"nav[aria-label=\\\"Mobile quick navigation\\\"]\");  await nav.getByRole(\"button\", { name: /Basket/i }).click();  await page.waitForTimeout(400);  const overflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);  if (overflow) throw new Error(\"Mobile Basket horizontal overflow detected!\");  await page.screenshot({ path: \".playwright-cli/cust-only-mobile-basket.png\" });})(page);```=== 3. Console errors ===### ResultTotal messages: 3 (Errors: 0, Warnings: 0)Returning 0 messages for level \"error\"\n\n### Latest snapshot (.playwright-cli/page-2026-11-19T11-05-47-105Z.yml)\n```yaml\n- generic [ref=e3]:\n  - complementary [ref=e4]:\n    - generic [ref=e