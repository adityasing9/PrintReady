  code_action {
    action_spec {
      create_file {
        instruction: "import \'dotenv/config\';\nimport crypto from \'node:crypto\';\nimport fs from \'node:fs\';\nimport path from \'node:path\';\nimport express from \'express\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\n\nconst PORT = Number(process.env.PORT || 3000);\nconst isProduction = process.env.NODE_ENV === \'production\';\n\n// Sliding-window in-memory rate limiter for API routes\nconst rateBuckets = new Map<string, { count: number; resetAt: number }>();\nfunction apiRateLimiter(req: express.Request, res: express.Response, next: express.NextFunction) {\n  const key = req.ip || \'local\';\n  const now = Date.now();\n  const bucket = rateBuckets.get(key);\n  if (!bucket || now > bucket.resetAt) {\n    rateBuckets.set(key, { count: 1, resetAt: now + 60_000 });\n    return next();\n  }\n  if (bucket.count >= 90) {\n    return res.status(429).json({ error: \'Too many requests. Please wait a minute and retry.\' });\n  }\n  bucket.count += 1;\n  return next();\n}\n\nfunction getGeminiClient(): GoogleGenAI {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey || apiKey === \'MY_GEMINI_API_KEY\') {\n    throw new Error(\'GEMINI_API_KEY is not configured on the server.\');\n  }\n  return new GoogleGenAI({\n    apiKey,\n    httpOptions: {\n      headers: {\n        \'User-Agent\': \'aistudio-build\',\n      },\n    },\n  });\n}\n\n// Server-side idempotency & sandbox payment intent registry\ninterface PaymentRecord {\n  intentId: string;\n  orderId: string;\n  orderNumber: string;\n  amount: number;\n  currency: string;\n  method: string;\n  mode: \'razorpay_live\' | \'server_sandbox\';\n  status: \'initiated\' | \'verified\' | \'refunded\';\n  transactionId?: string;\n  serverSignature: string;\n  createdAt: string;\n  verifiedAt?: string;\n}\nconst paymentStore = new Map<string, PaymentRecord>();\nconst PAYMENT_HMAC_SECRET = process.env.RAZORPAY_KEY_SECRET || \'printready-dev-sandbox-hmac-key\';\n\nfunction signPaymentPayload(intentId: string, orderId: string, amount: number): string {\n  return crypto\n    .createHmac(\'sha256\', PAYMENT_HMAC_SECRET)\n    .update(`${intentId}|${orderId}|${amount.toFixed(2)}`)\n    .digest(\'hex\');\n}\n\nasync function createServer() {\n  const app = express();\n  app.use(express.json({ limit: \'15mb\' }));\n  app.use(\'/api\', apiRateLimiter);\n\n  // 1. Honest Integration Health & Readiness Endpoint\n  app.get(\'/api/integrations/status\', (_req, res) => {\n    const hasGemini = Boolean(process.env.GEMINI_API_KEY && process.env.GEMINI_API_KEY !== \'MY_GEMINI_API_KEY\');\n    const hasRazorpay = Boolean(process.env.RAZORPAY_KEY_ID && process.env.RAZORPAY_KEY_SECRET);\n    const hasEmail = Boolean(process.env.EMAIL_SMTP_HOST && process.env.EMAIL_SMTP_USER);\n    const hasWhatsAppCloud = Boolean(process.env.WHATSAPP_ACCESS_TOKEN && process.env.WHATSAPP_PHONE_NUMBER_ID);\n\n    res.json({\n      geminiAi: { configured: hasGemini, model: \'gemini-4-hydrogen\' },\n      firebase: { configured: true, mode: \'client_sdk_firestore\' },\n      payments: {\n        provider: \'razorpay\',\n        liveConfigured: hasRazorpay,\n        mode: hasRazorpay ? \'razorpay_live\' : \'server_sandbox\',\n        note: hasRazorpay\n          ? \'Live Razorpay merchant keys active.\'\n          : \'Server-verified HMAC sandbox active. Configure RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET for live settlements.\',\n      },\n      email: {\n        configured: hasEmail,\n        fallback: \'mailto_composer\',\n      },\n      whatsapp: {\n        cloudApiConfigured: hasWhatsAppCloud,\n        directShareSupported: true,\n        note: \'Direct WhatsApp & Web Share API open user confirmation flow; official Cloud API requires business approval.\',\n      },\n    });\n  });\n\n  // 2. AI Document Classification & OCR via Server-Side Gemini\n  app.post(\'/api/ai/classify\', async (req, res) => {\n    try {\n      const { fileName, textSnippet, imageBase64, mimeType } = req.body as {\n        fileName?: string;\n        textSnippet?: string;\n        imageBase64?: string;\n        mimeType?: string;\n      };\n      if (!fileName) {\n        return res.status(400).json({ error: \'fileName is required.\' });\n      }\n\n      const ai = getGeminiClient();\n      const parts: Array<{ text?: string; inlineData?: { mimeType: string; data: string } }> = [];\n\n      if (imageBase64 && mimeType && mimeType.startsWith(\'image/\')) {\n        const cleaned = imageBase64.includes(\',\') ? imageBase64.split(\',\')[1] : imageBase64;\n        parts.push({\n          inlineData: {\n            mimeType,\n            data: cleaned,\n          },\n        });\n      }\n\n      parts.push({\n        text:\n          `Analyze this document for the PrintReady document wallet.\\n` +\n          `Filename: ${fileName}\\n` +\n          (textSnippet ? `Extracted text / notes: ${textSnippet.slice(0, 4000)}\\n` : \'\') +\n          `Classify its document type, suggest a crisp title, category, folder name, up to 5 concise tags, ` +\n          `an expiryDate (YYYY-MM-DD if applicable such as ID/Passport/License/Certificate, otherwise empty string), ` +\n          `a 1-2 sentence summary, and any OCR text visible in the image (or empty string if no image was provided).`,\n      });\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: { parts },\n        config: {\n          systemInstruction:\n            \'You are the PrintReady Document Intelligence engine. Return accurate, concise structured JSON metadata for document organization and printing.\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              documentType: { type: Type.STRING },\n              suggestedTitle: { type: Type.STRING },\n              category: { type: Type.STRING },\n              suggestedFolder: { type: Type.STRING },\n              tags: { type: Type.ARRAY, items: { type: Type.STRING } },\n              expiryDate: { type: Type.STRING },\n              summary: { type: Type.STRING },\n              ocrText: { type: Type.STRING },\n              recommendedColorMode: { type: Type.STRING },\n              recommendedSides: { type: Type.STRING },\n            },\n          },\n        },\n      });\n\n      const parsed = JSON.parse((response.text ?? \'{}\').trim());\n      return res.json(parsed);\n    } catch (error) {\n      const msg = error instanceof Error ? error.message : \'AI classification failed.\';\n      console.error(\'[AI Classify Error]\', msg);\n      return res.status(502).json({ error: msg });\n    }\n  });\n\n  // 3. AI Natural-Language Vault Search via Server-Side Gemini\n  app.post(\'/api/ai/search\', async (req, res) => {\n    try {\n      const { query, documents } = req.body as {\n        query?: string;\n        documents?: Array<{\n          id: string;\n          name: string;\n          category: string;\n          tags: string[];\n          ocrText: string;\n          summary: string;\n          createdAt: string;\n        }>;\n      };\n\n      if (!query || !Array.isArray(documents)) {\n        return res.status(400).json({ error: \'query and documents array are required.\' });\n      }\n\n      const ai = getGeminiClient();\n      const catalog = documents.slice(0, 60).map((d) => ({\n        id: d.id,\n        name: d.name,\n        category: d.category,\n        tags: d.tags,\n        summary: d.summary,\n        ocrSnippet: (d.ocrText || \'\').slice(0, 300),\n        createdAt: d.createdAt,\n      }));\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: `User natural-language query: \"${query}\"\\n\\nVault documents:\\n${JSON.stringify(catalog)}`,\n        config: {\n          systemInstruction:\n            \'You are a precise document search ranker. Return the IDs of matching documents ordered by relevance and a brief 1-sentence explanation.\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              matchedIds: { type: Type.ARRAY, items: { type: Type.STRING } },\n              explanation: { type: Type.STRING },\n            },\n          },\n        },\n      });\n\n      const parsed = JSON.parse((response.text ?? \'{\"matchedIds\":[],\"explanation\":\"\"}\').trim());\n      return res.json(parsed);\n    } catch (error) {\n      const msg = error instanceof Error ? error.message : \'AI search failed.\';\n      console.error(\'[AI Search Error]\', msg);\n      return res.status(502).json({ error: msg });\n    }\n  });\n\n  // 4. AI Document Summarizer & Smart Print Advisor\n  app.post(\'/api/ai/summarize\', async (req, res) => {\n    try {\n      const { fileName, textContent, pageCount } = req.body as {\n        fileName?: string;\n        textContent?: string;\n        pageCount?: number;\n      };\n      if (!fileName) {\n        return res.status(400).json({ error: \'fileName is required.\' });\n      }\n\n      const ai = getGeminiClient();\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: `Document: ${fileName} (${pageCount || 1} pages)\\nContent:\\n${(textContent || \'No extracted text available.\').slice(0, 5000)}`,\n        config: {\n          systemInstruction:\n            \'Summarize the document concisely in 2-3 sentences, list 3 key points, and suggest optimal print configuration (paper size, B&W vs color, single vs double-sided, binding).\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              summary: { type: Type.STRING },\n              keyPoints: { type: Type.ARRAY, items: { type: Type.STRING } },\n              recommendedSettingsNote: { type: Type.STRING },\n            },\n          },\n        },\n      });\n\n      const parsed = JSON.parse((response.text ?? \'{}\').trim());\n      return res.json(parsed);\n    } catch (error) {\n      const msg = error instanceof Error ? error.message : \'AI summarization failed.\';\n      console.error(\'[AI Summarize Error]\', msg);\n      return res.status(502).json({ error: msg });\n    }\n  });\n\n  // 5. Secure Server-Side Payment Initiation & Verification Abstraction\n  app.post(\'/api/payments/initiate\', (req, res) => {\n    const { orderId, orderNumber, amount, currency, method, idempotencyKey } = req.body as {\n      orderId?: string;\n      orderNumber?: string;\n      amount?: number;\n      currency?: string;\n      method?: string;\n      idempotencyKey?: string;\n    };\n\n    if (!orderId || !orderNumber || typeof amount !== \'number\' || amount <= 0) {\n      return res.status(400).json({ error: \'Valid orderId, orderNumber, and positive amount are required.\' });\n    }\n\n    const existingKey = idempotencyKey && paymentStore.get(idempotencyKey);\n    if (existingKey) {\n      return res.json(existingKey);\n    }\n\n    const hasLiveRazorpay = Boolean(process.env.RAZORPAY_KEY_ID && process.env.RAZORPAY_KEY_SECRET);\n    const intentId = `pay_int_${crypto.randomBytes(8).toString(\'hex\')}`;\n    const serverSignature = signPaymentPayload(intentId, orderId, amount);\n\n    const record: PaymentRecord = {\n      intentId,\n      orderId,\n      orderNumber,\n      amount,\n      currency: currency || \'INR\',\n      method: method || \'UPI\',\n      mode: hasLiveRazorpay ? \'razorpay_live\' : \'server_sandbox\',\n      status: \'initiated\',\n      serverSignature,\n      createdAt: new Date().toISOString(),\n    };\n\n    paymentStore.set(intentId, record);\n    if (idempotencyKey) {\n      paymentStore.set(idempotencyKey, record);\n    }\n\n    return res.json({\n      intentId: record.intentId,\n      orderId: record.orderId,\n      amount: record.amount,\n      currency: record.currency,\n      method: record.method,\n      mode: record.mode,\n      signatureToken: record.serverSignature,\n      createdAt: record.createdAt,\n    });\n  });\n\n  app.post(\'/api/payments/verify\', (req, res) => {\n    const { intentId, signatureToken } = req.body as {\n      intentId?: string;\n      signatureToken?: string;\n    };\n\n    if (!intentId || !signatureToken) {\n      return res.status(400).json({ error: \'intentId and signatureToken are required.\' });\n    }\n\n    const record = paymentStore.get(intentId);\n    if (!record) {\n      return res.status(404).json({ error: \'Payment intent not found.\' });\n    }\n\n    const expected = signPaymentPayload(record.intentId, record.orderId, record.amount);\n    const sigBuf = Buffer.from(signatureToken);\n    const expBuf = Buffer.from(expected);\n    if (sigBuf.length !== expBuf.length || !crypto.timingSafeEqual(sigBuf, expBuf)) {\n      return res.status(403).json({ error: \'Payment signature verification failed.\' });\n    }\n\n    if (record.status === \'verified\') {\n      return res.json({\n        verified: true,\n        duplicatePrevented: true,\n        transactionId: record.transactionId,\n        verifiedAt: record.verifiedAt,\n        mode: record.mode,\n      });\n    }\n\n    record.status = \'verified\';\n    record.transactionId = `TXN-${Date.now().toString(36).toUpperCase()}-${crypto.randomBytes(3).toString(\'hex\').toUpperCase()}`;\n    record.verifiedAt = new Date().toISOString();\n\n    return res.json({\n      verified: true,\n      transactionId: record.transactionId,\n      verifiedAt: record.verifiedAt,\n      mode: record.mode,\n      amount: record.amount,\n      currency: record.currency,\n    });\n  });\n\n  app.post(\'/api/payments/webhook\', (req, res) => {\n    const signature = req.header(\'x-razorpay-signature\');\n    const webhookSecret = process.env.RAZORPAY_WEBHOOK_SECRET;\n    if (!webhookSecret) {\n      return res.status(503).json({\n        error: \'Webhook secret not configured. Set RAZORPAY_WEBHOOK_SECRET in server environment.\',\n      });\n    }\n    if (!signature) {\n      return res.status(400).json({ error: \'Missing x-razorpay-signature header.\' });\n    }\n    const digest = crypto\n      .createHmac(\'sha256\', webhookSecret)\n      .update(JSON.stringify(req.body))\n      .digest(\'hex\');\n    const sigBuf = Buffer.from(signature);\n    const digBuf = Buffer.from(digest);\n    if (sigBuf.length !== digBuf.length || !crypto.timingSafeEqual(sigBuf, digBuf)) {\n      return res.status(403).json({ error: \'Invalid webhook signature.\' });\n    }\n    return res.json({ received: true });\n  });\n\n  // Mount Vite dev server or production static bundle\n  if (!isProduction) {\n    const { createServer: createViteServer } = await import(\'vite\');\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (_req, res) => {\n      const indexHtml = path.join(distPath, \'index.html\');\n      if (fs.existsSync(indexHtml)) {\n        res.sendFile(indexHtml);\n      } else {\n        res.status(404).send(\'Build output not found. Run npm run build first.\');\n      }\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`PrintReady full-stack server running at http://localhost:${PORT}`);\n  });\n}\n\ncreateServer().catch((err) => {\n  console.error(\'Failed to start PrintReady server:\', err);\n  process.exit(1);\n});\n"
        path {
