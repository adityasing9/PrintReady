              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rad = ((page.rotation % 360) * Math.PI) / 180;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const swap = Math.abs(page.rotation % 180) === 90;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const width = swap ? img.naturalHeight : img.naturalWidth;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
