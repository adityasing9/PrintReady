]\") && document.body.innerText.includes(\"Workspace\");    const overflow = document.documentElement.scrollWidth > window.innerWidth;    const swRegistered = \"serviceWorker\" in navigator ? (await navigator.serviceWorker.getRegistrations()).length : -1;    return { manifestLink, appleIcon, themeColor, hasWorkspaceSwitcher, overflow, swRegistered };  });  console.log(\"DESKTOP_PWA_CHECK:\", JSON.stringify(pwaCheck));  if (!pwaCheck.manifestLink || !pwaCheck.appleIcon || !pwaCheck.themeColor) throw new Error(\"Missing PWA head tags\");  if (pwaCheck.hasWorkspaceSwitcher) throw new Error(\"Workspace switcher should not appear in Customer App\");  if (pwaCheck.overflow) throw new Error(\"Desktop horizontal overflow detected\");})(page);```### Result- [Screenshot of viewport](.playwright-cli/cust-desktop-home.png)### Ran Playwright code```js// Screenshot viewport and save it as .playwright-cli/cust-desktop-home.pngawait page.screenshot({  path: \'.playwright-cli/cust-desktop-home.png\',  scale: \'css\',  type: \'png\'});```### Ran Playwright code```jsawait (async (page) => {  await page.getByRole(\"button\", { name: \"Account & Security\" }).click();  await page.waitForTimeout(400);  const accountText = await page.locator(\"main\").innerText();  if (accountText.includes(\"External Integration Configuration Status\")) {    throw new Error(\"Developer diagnostics should not appear in customer Account settings\");  }  if (!accountText.includes(\"Install PrintReady App\") || !accountText.includes(\"Run a Print Shop?\")) {    throw new Error(\"Missing consumer Install App or Partner Portal cards in Account settings\");  }  // Open Add to Home Screen modal  await page.getByRole(\"button\", { name: /Add to Home Screen|Install/i }).first().click();  await page.waitForTimeout(300);  await page.screenshot({ path: \".playwright-cli/cust-install-modal.png\" });  await page.getByRole(\"button\", { name: \"Got it\" }).click();  await page.waitForTimeout(200);  await page.screenshot({ path: \".playwright-cli/cust-account.png\" });  // Switch to Shop Partner Portal and verify Back to Customer App  await page.getByRole(\"button\", { name: /Open Print Shop Partner Portal/i }).click();  await page.waitForTimeout(400);  const backBtn = page.getByRole(\"button\", { name: /Back to Customer App/i });  await backBtn.waitFor({ state: \"visible\", timeout: 5000 });  await backBtn.click();  await page.waitForTimeout(400);  const h1 = await page.locator(\"h1\").innerText();  console.log(\"RETURNED_TO_H1:\", h1);})(page);```### Ran Playwright code```jsawait page.setViewportSize({ width: 390, height: 844 });```### Ran Playwright code```jsawait (async (page) => {  await page.waitForTimeout(500);  const mobileHome = await page.evaluate(() => ({    overflow: document.documentElement.scrollWidth > window.innerWidth,    scrollWidth: document.documentElement.scrollWidth,    innerWidth: window.innerWidth,    bottomNavVisible: !!document.querySelector(\"nav[aria-label=\\\"Mobile quick navigation\\\"]\")  }));  console.log(\"MOBILE_HOME:\", JSON.stringify(mobileHome));  if (mobileHome.overflow) throw new Error(\"Mobile home horizontal overflow: \" + JSON.stringify(mobileHome));  if (!mobileHome.bottomNavVisible) throw new Error(\"Mobile bottom nav not visible\");})(page);```### Result- [Screenshot of viewport](.playwright-cli/cust-mobile-home.png)### Ran Playwright code```js// Screenshot viewport and save it as .playwright-cli/cust-mobile-home.pngawait page.screenshot({  path: \'.playwright-cli/cust-mobile-home.png\',  scale: \'css\',  type: \'png\'});```### Ran Playwright code```jsawait (async (page) => {  const nav = page.locator(\"nav[aria-label=\\\"Mobile quick navigation\\\"]\");  await nav.getByRole(\"button\", { name: /Vault/i }).click();  await page.waitForTimeout(400);  const h1Vault = await page.locator(\"h1\").innerText();  const overflowVault = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);  console.log(\"MOBILE_VAULT:\", JSON.stringify({ h1Vault, overflowVault }));  await page.screenshot({ path: \".playwright-cli/cust-mobile-vault.png\" });  await nav.getByRole(\"button\", { name: /Orders/i }).click();  await page.waitForTimeout(400);  const h1Orders = await page.locator(\"h1\").innerText();  const overflowOrders = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);  console.log(\"MOBILE_ORDERS:\", JSON.stringify({ h1Orders, overflowOrders }));  await page.screenshot({ path: \".playwright-cli/cust-mobile-orders.png\" });})(page);```=== 5. Console errors ===### ResultTotal messages: 4 (Errors: 0, Warnings: 1)Returning 0 messages for level \"error\"\n\n### Latest snapshot (.playwright-cli/page-2026-11-19T10-51-32-700Z.yml)\n```yaml\n- generic [ref=e3]:\n  - complementary [ref=e4]:\n    - generic [ref=e5]:\n      - button [ref=e7]\n      - navigation \"PrintReady navigation\" [ref=e13]:\n        - button \"Home\" [ref=e14]\n        - button \"Document Vault\" [ref=e20]\n        - button \"Scanner & PDF Tools\" [ref=e26]\n        - button \"Print Basket 1\" [ref=e34]:\n          - generic [ref=e35]: Print Basket\n          - generic [ref=e40]: \"1\"\n        - button \"Print Shops\" [ref=e41]\n        - button \"Orders & Chat 1\" [ref=e48]:\n          - generic [ref=e49]: Orders & Chat\n          - generic [ref=e55]: \"1\"\n        - button \"Account & Security\" [ref=e56]\n      - generic [ref=e62]:\n        - generic [ref=e63]:\n          - generic [ref=e64]:\n            - paragraph [ref=e65]: Aarav Mehta\n            - paragraph [ref=e66]: Local Vault \302\267 Pro\n          - button \"Switch to dark mode\" [ref=e67]\n        - button \"Sign In with Google\" [ref=e70]\n  - generic [ref=e74]:\n    - banner [ref=e75]:\n      - generic [ref=e77]:\n        - generic [ref=e78]: PrintReady\n        - generic [ref=e79]: /\n        - heading \"Home\" [level=1] [ref=e80]\n      - generic [ref=e81]:\n        - button \"Notifications (2 unread)\" [ref=e83]: