    }
    replacement_infos {
      original_chunk {
        target_content: "      const target = orders.find((o) => o.id === orderId);\n      if (!target) return false;\n\n      const check = canTransitionOrder(target.status, nextStatus, actorRole);\n      if (!check.allowed) {\n        notify(\'Invalid Status Transition\', check.reason || \'Action not permitted.\', \'error\');\n        return false;\n      }\n\n      const nowIso = new Date().toISOString();\n      const actorName =\n        actorRole === \'customer\'\n          ? userProfile.displayName\n          : actorRole === \'shop\'\n          ? target.shopName\n          : actorRole === \'admin\'\n          ? \'Platform Admin\'\n          : \'Payment Gateway\';\n\n      setOrders((prev) =>\n        prev.map((o) => {\n          if (o.id !== orderId) return o;\n          const nextPaymentStatus =\n            nextStatus === \'paid\'\n              ? \'verified\'\n              : nextStatus === \'refunded\'\n              ? \'refunded\'\n              : nextStatus === \'payment_pending\'\n              ? \'pending\'\n              : o.paymentStatus;\n\n          return {\n            ...o,\n            status: nextStatus,\n            confirmedTotal: options?.confirmedTotal ?? o.confirmedTotal,\n            paymentStatus: nextPaymentStatus,\n            paymentTransactionId: options?.paymentTransactionId ?? o.paymentTransactionId,\n            paymentMethod: options?.paymentMethod ?? o.paymentMethod,\n            updatedAt: nowIso,\n            events: [\n              ...o.events,\n              {\n                id: `ev-${Date.now()}-${Math.random().toString(36).slice(2, 5)}`,\n                status: nextStatus,\n                actorRole,\n                actorName,\n                note: options?.note || `Order moved to ${nextStatus.replace(/_/g, \' \')}.`,\n                timestamp: nowIso,\n              },\n            ],\n          };\n        })\n      );"
        replacement_content: "      const currentOrders = ordersRef.current;\n      const target = currentOrders.find((o) => o.id === orderId);\n      if (!target) return false;\n\n      const check = canTransitionOrder(target.status, nextStatus, actorRole);\n      if (!check.allowed) {\n        notify(\'Invalid Status Transition\', check.reason || \'Action not permitted.\', \'error\');\n        return false;\n      }\n\n      const nowIso = new Date().toISOString();\n      const actorName =\n        actorRole === \'customer\'\n          ? userProfile.displayName\n          : actorRole === \'shop\'\n          ? target.shopName\n          : actorRole === \'admin\'\n          ? \'Platform Admin\'\n          : \'Payment Gateway\';\n\n      const applyTransition = (list: PrintOrder[]) =>\n        list.map((o) => {\n          if (o.id !== orderId) return o;\n          const nextPaymentStatus =\n            nextStatus === \'paid\'\n              ? \'verified\'\n              : nextStatus === \'refunded\'\n              ? \'refunded\'\n              : nextStatus === \'payment_pending\'\n              ? \'pending\'\n              : o.paymentStatus;\n\n          return {\n            ...o,\n            status: nextStatus,\n            confirmedTotal: options?.confirmedTotal ?? o.confirmedTotal,\n            paymentStatus: nextPaymentStatus,\n            paymentTransactionId: options?.paymentTransactionId ?? o.paymentTransactionId,\n            paymentMethod: options?.paymentMethod ?? o.paymentMethod,\n            updatedAt: nowIso,\n            events: [\n              ...o.events,\n              {\n                id: `ev-${Date.now()}-${Math.random().toString(36).slice(2, 5)}`,\n                status: nextStatus,\n                actorRole,\n                actorName,\n                note: options?.note || `Order moved to ${nextStatus.replace(/_/g, \' \')}.`,\n                timestamp: nowIso,\n              },\n            ],\n          };\n        });\n\n      ordersRef.current = applyTransition(currentOrders);\n      setOrders((prev) => applyTransition(prev));"
        start_line: 902
        end_line: 958
      }
      num_matches: 1
