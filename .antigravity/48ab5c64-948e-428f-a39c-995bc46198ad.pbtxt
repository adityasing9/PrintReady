    tool_summary: "Draft Firestore security rules"
    tool_action: "Drafting Firestore security rules"
    started_at {
      seconds: 1795080048
      nanos: 181147488
    }
    model_api_content_id: "0b31252b9c194becaf68faf0a82f44a9"
  }
  code_action {
    action_spec {
      create_file {
        instruction: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Pillar 1: Global Default-Deny Safety Net\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // --- Primitive Helpers ---\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isVerifiedUser() {\n      return isSignedIn() && request.auth.token.email_verified == true;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    function isAdmin() {\n      return isVerifiedUser() && (\n        request.auth.token.email == \'cypt300@gmail.com\' ||\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid))\n      );\n    }\n\n    // --- Validation Blueprints (Anti-Update-Gap) ---\n    function isValidUserProfile(data, userId) {\n      return data.keys().hasAll([\'uid\', \'displayName\', \'email\', \'role\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\n          \'uid\', \'displayName\', \'email\', \'phone\', \'role\',\n          \'preferredLanguage\', \'theme\', \'subscriptionPlan\',\n          \'loyaltyPoints\', \'storageUsedBytes\', \'aiEnabled\',\n          \'cloudBackupEnabled\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.uid is string && data.uid == userId && isValidId(data.uid)\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100\n        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160\n        && data.role in [\'customer\', \'shop_owner\', \'shop_employee\', \'admin\', \'support\']\n        && (!(\'phone\' in data) || (data.phone is string && data.phone.size() <= 32))\n        && (!(\'preferredLanguage\' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 16))\n        && (!(\'theme\' in data) || data.theme in [\'light\', \'dark\', \'system\'])\n        && (!(\'subscriptionPlan\' in data) || data.subscriptionPlan in [\'free\', \'premium\'])\n        && (!(\'loyaltyPoints\' in data) || (data.loyaltyPoints is int && data.loyaltyPoints >= 0))\n        && (!(\'storageUsedBytes\' in data) || (data.storageUsedBytes is int && data.storageUsedBytes >= 0))\n        && (!(\'aiEnabled\' in data) || data.aiEnabled is bool)\n        && (!(\'cloudBackupEnabled\' in data) || data.cloudBackupEnabled is bool)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidFolder(data, userId) {\n      return data.keys().hasAll([\'ownerId\', \'name\', \'category\', \'isFavourite\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'ownerId\', \'name\', \'category\', \'color\', \'parentId\', \'isFavourite\', \'createdAt\', \'updatedAt\'])\n        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40\n        && (!(\'color\' in data) || (data.color is string && data.color.size() <= 24))\n        && (!(\'parentId\' in data) || (data.parentId is string && data.parentId.size() <= 128))\n        && data.isFavourite is bool\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidVaultDocument(data, userId) {\n      return data.keys().hasAll([\n          \'ownerId\', \'name\', \'mimeType\', \'extension\', \'sizeBytes\',\n          \'pageCount\', \'category\', \'isFavourite\', \'isTrashed\', \'version\',\n          \'createdAt\', \'updatedAt\'\n        ])\n        && data.keys().hasOnly([\n          \'ownerId\', \'name\', \'mimeType\', \'extension\', \'sizeBytes\',\n          \'pageCount\', \'folderId\', \'category\', \'tags\', \'ocrText\',\n          \'summary\', \'checksum\', \'expiryDate\', \'version\', \'isFavourite\',\n          \'isTrashed\', \'syncStatus\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160\n        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 120\n        && data.extension is string && data.extension.size() >= 1 && data.extension.size() <= 16\n        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 52428800\n        && data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 2000\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40\n        && (!(\'folderId\' in data) || (data.folderId is string && data.folderId.size() <= 128))\n        && (!(\'tags\' in data) || (data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32))))\n        && (!(\'ocrText\' in data) || (data.ocrText is string && data.ocrText.size() <= 10000))\n        && (!(\'summary\' in data) || (data.summary is string && data.summary.size() <= 1000))\n        && (!(\'checksum\' in data) || (data.checksum is string && data.checksum.size() <= 128))\n        && (!(\'expiryDate\' in data) || (data.expiryDate is string && data.expiryDate.size() <= 32))\n        && data.version is int && data.version >= 1\n        && data.isFavourite is bool\n        && data.isTrashed is bool\n        && (!(\'syncStatus\' in data) || data.syncStatus in [\'local\', \'synced\', \'pending\'])\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidPrintPreset(data, userId) {\n      return data.keys().hasAll([\n          \'ownerId\', \'name\', \'paperSize\', \'colorMode\', \'sides\',\n          \'orientation\', \'copies\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.keys().hasOnly([\n          \'ownerId\', \'name\', \'paperSize\', \'colorMode\', \'sides\',\n          \'orientation\', \'copies\', \'pagesPerSheet\', \'binding\',\n          \'isFavourite\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64\n        && data.paperSize in [\'A4\', \'A3\', \'A5\', \'Letter\', \'Legal\', \'Custom\']\n        && data.colorMode in [\'bw\', \'color\']\n        && data.sides in [\'single\', \'double\']\n        && data.orientation in [\'portrait\', \'landscape\']\n        && data.copies is int && data.copies >= 1 && data.copies <= 500\n        && (!(\'pagesPerSheet\' in data) || (data.pagesPerSheet is int && data.pagesPerSheet in [1, 2, 4]))\n        && (!(\'binding\' in data) || data.binding in [\'none\', \'staple\', \'spiral\', \'hardcover\', \'lamination\'])\n        && (!(\'isFavourite\' in data) || data.isFavourite is bool)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidSavedShop(data, userId) {\n      return data.keys().hasAll([\'ownerId\', \'shopName\', \'group\', \'preferredContact\', \'isFavourite\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\n          \'ownerId\', \'shopName\', \'registeredShopId\', \'phone\', \'whatsapp\',\n          \'email\', \'address\', \'group\', \'preferredContact\', \'notes\',\n          \'isFavourite\', \'isDefault\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)\n        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 120\n        && (!(\'registeredShopId\' in data) || (data.registeredShopId is string && data.registeredShopId.size() <= 128))\n        && (!(\'phone\' in data) || (data.phone is string && data.phone.size() <= 32))\n        && (!(\'whatsapp\' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32))\n        && (!(\'email\' in data) || (data.email is string && data.email.size() <= 160))\n        && (!(\'address\' in data) || (data.address is string && data.address.size() <= 240))\n        && data.group is string && data.group.size() >= 1 && data.group.size() <= 40\n        && data.preferredContact in [\'whatsapp\', \'email\', \'marketplace\', \'phone\']\n        && (!(\'notes\' in data) || (data.notes is string && data.notes.size() <= 500))\n        && data.isFavourite is bool\n        && (!(\'isDefault\' in data) || data.isDefault is bool)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidPrintShop(data) {\n      return data.keys().hasAll([\n          \'ownerId\', \'name\', \'address\', \'city\', \'isOpen\',\n          \'pickupAvailable\', \'deliveryAvailable\', \'verificationStatus\',\n          \'createdAt\', \'updatedAt\'\n        ])\n        && data.keys().hasOnly([\n          \'ownerId\', \'name\', \'ownerName\', \'address\', \'city\', \'phone\',\n          \'whatsapp\', \'email\', \'lat\', \'lng\', \'isOpen\', \'pickupAvailable\',\n          \'deliveryAvailable\', \'deliveryFee\', \'turnaroundMinutes\',\n          \'verificationStatus\', \'rating\', \'reviewCount\', \'services\',\n          \'createdAt\', \'updatedAt\'\n        ])\n        && data.ownerId is string && isValidId(data.ownerId)\n        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120\n        && (!(\'ownerName\' in data) || (data.ownerName is string && data.ownerName.size() <= 100))\n        && data.address is string && data.address.size() >= 4 && data.address.size() <= 240\n        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80\n        && (!(\'phone\' in data) || (data.phone is string && data.phone.size() <= 32))\n        && (!(\'whatsapp\' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32))\n        && (!(\'email\' in data) || (data.email is string && data.email.size() <= 160))\n        && (!(\'lat\' in data) || data.lat is number)\n        && (!(\'lng\' in data) || data.lng is number)\n        && data.isOpen is bool\n        && data.pickupAvailable is bool\n        && data.deliveryAvailable is bool\n        && (!(\'deliveryFee\' in data) || (data.deliveryFee is number && data.deliveryFee >= 0))\n        && (!(\'turnaroundMinutes\' in data) || (data.turnaroundMinutes is int && data.turnaroundMinutes >= 5))\n        && data.verificationStatus in [\'pending\', \'verified\', \'rejected\', \'suspended\']\n        && (!(\'rating\' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))\n        && (!(\'reviewCount\' in data) || (data.reviewCount is int && data.reviewCount >= 0))\n        && (!(\'services\' in data) || (data.services is list && data.services.size() <= 20 && (data.services.size() == 0 || (data.services[0] is string && data.services[0].size() <= 40))))\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidInventoryItem(data, shopId) {\n      return data.keys().hasAll([\'shopId\', \'name\', \'category\', \'quantity\', \'unit\', \'reorderLevel\', \'updatedAt\'])\n        && data.keys().hasOnly([\'shopId\', \'name\', \'category\', \'quantity\', \'unit\', \'reorderLevel\', \'supplier\', \'updatedAt\'])\n        && data.shopId is string && data.shopId == shopId && isValidId(data.shopId)\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100\n        && data.category in [\'paper\', \'ink\', \'toner\', \'photo_paper\', \'binding\', \'lamination\', \'other\']\n        && data.quantity is number && data.quantity >= 0\n        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 32\n        && data.reorderLevel is number && data.reorderLevel >= 0\n        && (!(\'supplier\' in data) || (data.supplier is string && data.supplier.size() <= 100))\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidPrintOrder(data) {\n      return data.keys().hasAll([\n          \'orderNumber\', \'customerId\', \'customerName\', \'shopId\', \'shopOwnerId\',\n          \'shopName\', \'status\', \'fulfillmentType\', \'estimatedTotal\',\n          \'paymentStatus\', \'itemCount\', \'totalPages\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.keys().hasOnly([\n          \'orderNumber\', \'customerId\', \'customerName\', \'shopId\', \'shopOwnerId\',\n          \'shopName\', \'status\', \'fulfillmentType\', \'estimatedTotal\', \'confirmedTotal\',\n          \'paymentStatus\', \'itemCount\', \'totalPages\', \'specialInstructions\',\n          \'createdAt\', \'updatedAt\'\n        ])\n        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches(\'^PR-[A-Z0-9\\\\-]+$\')\n        && data.customerId is string && isValidId(data.customerId)\n        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100\n        && data.shopId is string && isValidId(data.shopId)\n        && data.shopOwnerId is string && isValidId(data.shopOwnerId)\n        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 120\n        && data.status in [\n          \'draft\', \'submitted\', \'received\', \'awaiting_shop_response\', \'accepted\',\n          \'rejected\', \'price_pending_approval\', \'approved\', \'payment_pending\',\n          \'paid\', \'printing\', \'quality_check\', \'ready_for_pickup\',\n          \'out_for_delivery\', \'delivered\', \'completed\', \'cancelled\',\n          \'refund_requested\', \'refunded\'\n        ]\n        && data.fulfillmentType in [\'pickup\', \'delivery\']\n        && data.estimatedTotal is number && data.estimatedTotal >= 0\n        && (!(\'confirmedTotal\' in data) || (data.confirmedTotal is number && data.confirmedTotal >= 0))\n        && data.paymentStatus in [\'unpaid\', \'pending\', \'verified\', \'refunded\', \'failed\']\n        && data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 100\n        && data.totalPages is int && data.totalPages >= 1 && data.totalPages <= 10000\n        && (!(\'specialInstructions\' in data) || (data.specialInstructions is string && data.specialInstructions.size() <= 600))\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidOrderMessage(data, orderId) {\n      return data.keys().hasAll([\'orderId\', \'senderId\', \'senderName\', \'senderRole\', \'text\', \'createdAt\'])\n        && data.keys().hasOnly([\'orderId\', \'senderId\', \'senderName\', \'senderRole\', \'text\', \'createdAt\'])\n        && data.orderId is string && data.orderId == orderId && isValidId(data.orderId)\n        && data.senderId is string && data.senderId == request.auth.uid && isValidId(data.senderId)\n        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100\n        && data.senderRole in [\'customer\', \'shop\', \'admin\']\n        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1200\n        && data.createdAt is timestamp;\n    }\n\n    function isValidReview(data) {\n      return data.keys().hasAll([\'shopId\', \'orderId\', \'customerId\', \'customerName\', \'rating\', \'comment\', \'verifiedOrder\', \'createdAt\'])\n        && data.keys().hasOnly([\'shopId\', \'orderId\', \'customerId\', \'customerName\', \'rating\', \'comment\', \'verifiedOrder\', \'createdAt\'])\n        && data.shopId is string && isValidId(data.shopId)\n        && data.orderId is string && isValidId(data.orderId)\n        && data.customerId is string && data.customerId == request.auth.uid && isValidId(data.customerId)\n        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100\n        && data.rating is int && data.rating >= 1 && data.rating <= 5\n        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 800\n        && data.verifiedOrder is bool\n        && data.createdAt is timestamp;\n    }\n\n    function isValidAuditLog(data) {\n      return data.keys().hasAll([\'actorId\', \'action\', \'targetType\', \'targetId\', \'createdAt\'])\n        && data.keys().hasOnly([\'actorId\', \'actorEmail\', \'action\', \'targetType\', \'targetId\', \'details\', \'createdAt\'])\n        && data.actorId is string && data.actorId == request.auth.uid && isValidId(data.actorId)\n        && (!(\'actorEmail\' in data) || (data.actorEmail is string && data.actorEmail.size() <= 160))\n        && data.action is string && data.action.size() >= 2 && data.action.size() <= 100\n        && data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 40\n        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128\n        && (!(\'details\' in data) || (data.details is string && data.details.size() <= 500))\n        && data.createdAt is timestamp;\n    }\n\n    // --- Collection Rules ---\n\n    // Trusted Admin Registry\n    match /admins/{adminId} {\n      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());\n      allow list, write: if false;\n    }\n\n    // Private User Profile & Subcollections (PII Isolated)\n    match /users/{userId} {\n      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());\n      allow list: if isAdmin();\n      allow create: if isVerifiedUser()\n        && isValidId(userId)\n        && isOwner(userId)\n        && isValidUserProfile(incoming(), userId)\n        && incoming().role in [\'customer\', \'shop_owner\']\n        && incoming().createdAt == request.time\