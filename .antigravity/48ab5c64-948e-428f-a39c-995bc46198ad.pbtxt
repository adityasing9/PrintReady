    }
    command_line: "set -eu\ntrap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\nplaywright-cli open about:blank\nplaywright-cli run-code \"async page => {\n  const fs = require(\'fs\');\n  const svgRegular = fs.readFileSync(\'public/icon.svg\', \'utf8\');\n  // Maskable version has full-bleed indigo background and 15% safe-zone padding around the printer mark\n  const svgMaskable = \'<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 512 512\\\" width=\\\"512\\\" height=\\\"512\\\"><rect width=\\\"512\\\" height=\\\"512\\\" fill=\\\"#4338ca\\\"/><g transform=\\\"translate(76.8,76.8) scale(0.7)\\\" fill=\\\"none\\\" stroke=\\\"#ffffff\\\" stroke-width=\\\"30\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M164 188V124a20 20 0 0 1 20-20h144a20 20 0 0 1 20 20v64\\\"/><rect x=\\\"116\\\" y=\\\"188\\\" width=\\\"280\\\" height=\\\"148\\\" rx=\\\"28\\\"/><path d=\\\"M164 288h184v100a20 20 0 0 1-20 20H184a20 20 0 0 1-20-20V288Z\\\" fill=\\\"#4338ca\\\"/><line x1=\\\"204\\\" y1=\\\"336\\\" x2=\\\"308\\\" y2=\\\"336\\\"/><line x1=\\\"204\\\" y1=\\\"372\\\" x2=\\\"272\\\" y2=\\\"372\\\"/><circle cx=\\\"348\\\" cy=\\\"236\\\" r=\\\"10\\\" fill=\\\"#ffffff\\\" stroke=\\\"none\\\"/></g></svg>\';\n\n  async function renderPng(svg, size, outPath) {\n    await page.setViewportSize({ width: size, height: size });\n    await page.setContent(\'<!doctype html><html><body style=\\\"margin:0;padding:0;overflow:hidden;background:transparent;\\\">\' + svg.replace(/width=\\\"512\\\" height=\\\"512\\\"/, \'width=\\\"\' + size + \'\\\" height=\\\"\' + size + \'\\\"\') + \'</body></html>\');\n    await page.screenshot({ path: outPath, omitBackground: true });\n  }\n\n  await renderPng(svgRegular, 192, \'public/pwa-192x192.png\');\n  await renderPng(svgRegular, 512, \'public/pwa-512x512.png\');\n  await renderPng(svgMaskable, 512, \'public/pwa-maskable-512x512.png\');\n  await renderPng(svgMaskable, 180, \'public/apple-touch-icon.png\');\n  console.log(\'Generated all 4 PNG icons cleanly.\');\n}\"\nls -lh public/*.png public/icon.svg\n"
    proposed_command_line: "set -eu\ntrap \'playwright-cli close >/dev/null 2>&1 || true\' EXIT\nplaywright-cli open about:blank\nplaywright-cli run-code \"async page => {\n  const fs = require(\'fs\');\n  const svgRegular = fs.readFileSync(\'public/icon.svg\', \'utf8\');\n  // Maskable version has full-bleed indigo background and 15% safe-zone padding around the printer mark\n  const svgMaskable = \'<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 512 512\\\" width=\\\"512\\\" height=\\\"512\\\"><rect width=\\\"512\\\" height=\\\"512\\\" fill=\\\"#4338ca\\\"/><g transform=\\\"translate(76.8,76.8) scale(0.7)\\\" fill=\\\"none\\\" stroke=\\\"#ffffff\\\" stroke-width=\\\"30\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M164 188V124a20 20 0 0 1 20-20h144a20 20 0 0 1 20 20v64\\\"/><rect x=\\\"116\\\" y=\\\"188\\\" width=\\\"280\\\" height=\\\"148\\\" rx=\\\"28\\\"/><path d=\\\"M164 288h184v100a20 20 0 0 1-20 20H184a20 20 0 0 1-20-20V288Z\\\" fill=\\\"#4338ca\\\"/><line x1=\\\"204\\\" y1=\\\"336\\\" x2=\\\"308\\\" y2=\\\"336\\\"/><line x1=\\\"204\\\" y1=\\\"372\\\" x2=\\\"272\\\" y2=\\\"372\\\"/><circle cx=\\\"348\\\" cy=\\\"236\\\" r=\\\"10\\\" fill=\\\"#ffffff\\\" stroke=\\\"none\\\"/></g></svg>\';\n\n  async function renderPng(svg, size, outPath) {\n    await page.setViewportSize({ width: size, height: size });\n    await page.setContent(\'<!doctype html><html><body style=\\\"margin:0;padding:0;overflow:hidden;background:transparent;\\\">\' + svg.replace(/width=\\\"512\\\" height=\\\"512\\\"/, \'width=\\\"\' + size + \'\\\" height=\\\"\' + size + \'\\\"\') + \'</body></html>\');\n    await page.screenshot({ path: outPath, omitBackground: true });\n  }\n\n  await renderPng(svgRegular, 192, \'public/pwa-192x192.png\');\n  await renderPng(svgRegular, 512, \'public/pwa-512x512.png\');\n  await renderPng(svgMaskable, 512, \'public/pwa-maskable-512x512.png\');\n  await renderPng(svgMaskable, 180, \'public/apple-touch-icon.png\');\n 