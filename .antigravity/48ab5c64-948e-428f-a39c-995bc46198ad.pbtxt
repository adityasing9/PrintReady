  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useMemo, useState } from \'react\';\nimport {\n  Bar,\n  BarChart,\n  CartesianGrid,\n  ResponsiveContainer,\n  Tooltip,\n  XAxis,\n  YAxis,\n} from \'recharts\';\nimport { CheckCircle2, ShieldAlert, ShieldCheck, Trash2, XCircle } from \'lucide-react\';\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\nimport { STATUS_LABELS } from \'../../domain/orderStateMachine\';\nimport { formatCurrency } from \'../../domain/printCalculator\';\nimport { formatFileSize } from \'../../domain/fileValidation\';\n\nexport function AdminPortalView() {\n  const {\n    activeTab,\n    shops,\n    orders,\n    documents,\n    reviews,\n    coupons,\n    supportTickets,\n    auditLogs,\n    platformSettings,\n    verifyShopAsAdmin,\n    transitionOrderStatus,\n    createCoupon,\n    toggleCouponActive,\n    moderateReview,\n    updateTicketStatus,\n    updatePlatformSettings,\n  } = usePrintReady();\n\n  const [couponCode, setCouponCode] = useState(\'\');\n  const [couponDesc, setCouponDesc] = useState(\'\');\n  const [couponVal, setCouponVal] = useState(15);\n  const [couponType, setCouponType] = useState<\'percent\' | \'flat\'>(\'percent\');\n  const [settingsDraft, setSettingsDraft] = useState(platformSettings);\n\n  const stats = useMemo(() => {\n    const verifiedShops = shops.filter((s) => s.verificationStatus === \'verified\').length;\n    const pendingShops = shops.filter((s) => s.verificationStatus === \'pending\').length;\n    const totalVolume = orders\n      .filter((o) => o.paymentStatus === \'verified\')\n      .reduce((sum, o) => sum + (o.confirmedTotal ?? o.estimatedTotal), 0);\n    const completedOrders = orders.filter((o) => o.status === \'completed\').length;\n    const refundRequests = orders.filter((o) => o.status === \'refund_requested\').length;\n    const storageBytes = documents.reduce((sum, d) => sum + d.sizeBytes, 0);\n    return { verifiedShops, pendingShops, totalVolume, completedOrders, refundRequests, storageBytes };\n  }, [documents, orders, shops]);\n\n  const statusChart = useMemo(() => {\n    const counts = new Map<string, number>();\n    orders.forEach((o) => {\n      const label = STATUS_LABELS[o.status];\n      counts.set(label, (counts.get(label) || 0) + 1);\n    });\n    return Array.from(counts.entries()).map(([status, count]) => ({ status, count }));\n  }, [orders]);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"pb-4 border-b border-slate-200 dark:border-slate-800\">\n        <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n          Privileged Administration \302\267 Role-Protected Governance & Audit Trail\n        </p>\n        <h2 className=\"text-xl font-bold text-slate-900 dark:text-white\">PrintReady Platform Control</h2>\n      </div>\n\n      {/* TAB 1: PLATFORM OVERVIEW */}\n      {activeTab === \'admin-overview\' && (\n        <div className=\"space-y-6\">\n          <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n            {[\n              { label: \'Verified / Total Shops\', value: `${stats.verifiedShops} / ${shops.length}`, sub: `${stats.pendingShops} awaiting verification` },\n              { label: \'Verified Payment Volume\', value: formatCurrency(stats.totalVolume), sub: `${orders.length} total orders` },\n              { label: \'Open Support & Refunds\', value: `${supportTickets.filter((t) => t.status !== \'resolved\').length + stats.refundRequests}`, sub: `${stats.refundRequests} refund requests` },\n              { label: \'Vault Storage Indexed\', value: formatFileSize(stats.storageBytes), sub: `${documents.length} stored files` },\n            ].map((kpi) => (\n              <div key={kpi.label} className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5\">\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">{kpi.label}</p>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-slate-900 dark:text-white mt-1\">{kpi.value}</p>\n                <p className=\"text-xs text-slate-500 mt-1\">{kpi.sub}</p>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n            <div className=\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\">\n              <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white\">Orders by Lifecycle Stage</h3>\n              <div className=\"h-64 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <BarChart data={statusChart}>\n                    <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#e2e8f0\" />\n                    <XAxis dataKey=\"status\" tick={{ fontSize: 11 }} />\n                    <YAxis allowDecimals={false} tick={{ fontSize: 12 }} />\n                    <Tooltip />\n                    <Bar dataKey=\"count\" fill=\"#4338CA\" radius={[6, 6, 0, 0]} />\n                  </BarChart>\n                </ResponsiveContainer>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\">\n              <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white\">Recent Audit Trail</h3>\n              <div className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\">\n                {auditLogs.slice(0, 6).map((log) => (\n                  <div key={log.id} className=\"py-2.5\">\n                    <p className=\"font-mono font-semibold text-slate-900 dark:text-white\">{log.action}</p>\n                    <p className=\"text-slate-600 dark:text-slate-400 mt-0.5\">{log.details}</p>\n                    <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                      {log.actorEmail} \302\267 {new Date(log.createdAt).toLocaleString()}\n                    </p>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: SHOP VERIFICATION QUEUE */}\n      {activeTab === \'admin-shops\' && (\n        <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-200 dark:border-slate-800\">\n            <h3 className=\"text-base font-semibold text-slate-900 dark:text-white\">\n              Registered Print Shops & Verification Governance\n            </h3>\n          </div>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse text-xs\">\n              <thead>\n                <tr className=\"border-b border-slate-200 dark:border-slate-800 text-slate-500\">\n                  <th className=\"py-3 px-4 font-medium\">Shop & Owner</th>\n                  <th className=\"py-3 px-3 font-medium\">City / Address</th>\n                  <th className=\"py-3 px-3 font-medium\">Status</th>\n                  <th className=\"py-3 px-4 font-medium text-right\">Governance Actions</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800\">\n                {shops.map((shop) => (\n                  <tr key={shop.id}>\n                    <td className=\"py-3.5 px-4\">\n                      <p className=\"font-semibold text-slate-900 dark:text-white\">{shop.name}</p>\n                      <p className=\"text-slate-500\">{shop.ownerName} \302\267 {shop.email}</p>\n                    </td>\n                    <td className=\"py-3.5 px-3 text-slate-600 dark:text-slate-300\">\n                      {shop.city} \302\267 {shop.address}\n                    </td>\n                    <td className=\"py-3.5 px-3 font-semibold capitalize\">\n                      <span\n                        className={\n                          shop.verificationStatus === \'verified\'\n                            ? \'text-emerald-700 dark:text-emerald-400\'\n                            : shop.verificationStatus === \'pending\'\n                            ? \'text-amber-700 dark:text-amber-400\'\n                            : \'text-red-600\'\n                        }\n                      >\n                        {shop.verificationStatus}\n                      </span>\n                    </td>\n                    <td className=\"py-3.5 px-4 text-right space-x-2 whitespace-nowrap\">\n                      {shop.verificationStatus !== \'verified\' && (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            verifyShopAsAdmin(shop.id, \'verified\', \'Verified business credentials and activated marketplace listing.\')\n                          }\n                          className=\"inline-flex items-center gap-1 px-3 py-1.5 font-medium text-white bg-emerald-700 hover:bg-emerald-800 rounded-md\"\n                        >\n                          <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                          Approve\n                        </button>\n                      )}\n                      {shop.verificationStatus !== \'suspended\' && (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            verifyShopAsAdmin(shop.id, \'suspended\', \'Suspended shop pending compliance review.\')\n                          }\n                          className=\"inline-flex items-center gap-1 px-3 py-1.5 font-medium text-red-600 border border-red-200 dark:border-red-900 rounded-md\"\n                        >\n                          <XCircle className=\"w-3.5 h-3.5\" />\n                          Suspend\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 3: ORDERS, REFUNDS & SUPPORT */}\n      {activeTab === \'admin-orders\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          <div className=\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\">\n            <div className=\"px-5 py-4 border-b border-slate-200 dark:border-slate-800\">\n              <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white\">Platform Orders & Refund Controls</h3>\n            </div>\n            <div className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\">\n              {orders.map((ord) => (\n                <div key={ord.id} className=\"p-4 flex items-center justify-between gap-3\">\n                  <div>\n                    <p className=\"font-mono font-bold text-slate-900 dark:text-white\">\n                      {ord.orderNumber} \302\267 {formatCurrency(ord.confirmedTotal ?? ord.estimatedTotal, ord.currency)}\n                    </p>\n                    <p className=\"text-slate-500\">\n                      {ord.customerName} \342\206\222 {ord.shopName} \302\267 {STATUS_LABELS[ord.status]} ({ord.paymentStatus})\n                    </p>\n                  </div>\n                  {ord.status === \'refund_requested\' && (\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        transitionOrderStatus(ord.id, \'refunded\', \'admin\', {\n                          note: \'Admin approved and issued refund reconciliation.\',\n                        })\n                      }\n                      className=\"px-3 py-1.5 font-medium text-white bg-indigo-700 rounded-md whitespace-nowrap\"\n                    >\n                      Approve Refund\n                    </button>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\">\n            <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5\">\n              <ShieldAlert className=\"w-4 h-4 text-amber-600\" />\n              Support Tickets & Disputes\n            </h3>\n            <div className=\"space-y-3 text-xs\">\n              {supportTickets.map((t) => (\n                <div key={t.id} className=\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-2\">\n                  <div className=\"flex justify-between items-start gap-2\">\n                    <div>\n                      <p className=\"font-semibold text-slate-900 dark:text-white\">{t.subject}</p>\n                      <p className=\"text-slate-500\">\n                        {t.userName} \302\267 {t.category.replace(\'_\', \' \')} {t.orderNumber ? `\302\267 ${t.orderNumber}` : \'\'}\n                      </p>\n                    </div>\n                    <select\n                      aria-label={`Status for ticket ${t.id}`}\n                      value={t.status}\n                      onChange={(e) => updateTicketStatus(t.id, e.target.value as \'open\' | \'investigating\' | \'resolved\')}\n                      className=\"px-2 py-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded\"\n                    >\n                      <option value=\"open\">Open</option>\n                      <option value=\"investigating\">Investigating</option>\n                      <option value=\"resolved\">Resolved</option>\n                    </select>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 4: COUPONS & REVIEW MODERATION */}\n      {activeTab === \'admin-promos\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          <section className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white\">Configurable Coupons & Promotions</h3>\n            <div className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\">\n              {coupons.map((c) => (\n                <div key={c.code} className=\"py-2.5 flex items-center justify-between gap-2\">\n                  <div>\n                    <p className=\"font-mono font-bold text-slate-900 dark:text-white\">{c.code}</p>\n                    <p className=\"text-slate-500\">{c.description}</p>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => toggleCouponActive(c.code)}\n                    className={`px-2.5 py-1 rounded font-medium ${\n                      c.active\n                        ? \'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40\'\n                        : \'text-slate-500 bg-slate-100 dark:bg-slate-800\'\n                    }`}\n                  >\n                    {c.active ? \'Active\' : \'Paused\'}\n                  </button>\n                </div>\n              ))}\n            </div>\n\n            <form\n              onSubmit={(e) => {\n                e.preventDefault();\n                if (!couponCode.trim()) return;\n                createCoupon({\n                  code: couponCode.trim().toUpperCase(),\n                  description: couponDesc.trim() || `${couponVal}${couponType === \'percent\' ? \'%\' : \' INR\'} promotional discount`,\n                  discountType: couponType,\n                  value: couponVal,\n                  minOrderAmount: 50,\n                  active: true,\n                  expiresAt: \'2027-12-31T23:59:59Z\',\n                });\n                setCouponCode(\'\');\n                setCouponDesc(\'\');\n              }}\n              className=\"pt-3 border-t border-slate-200 dark:border-slate-800 grid grid-cols-2 gap-2 text-xs\"\n            >\n              <input\n                type=\"text\"\n                placeholder=\"Code (e.g. EXAM20)\"\n                value={couponCode}\n                onChange={(e) => setCouponCode(e.target.value)}\n                className=\"px-2.5 py-1.5 font-mono uppercase bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\"\n              />\n              <div className=\"flex gap-1\">\n                <input\n                  type=\"number\"\n                  value={couponVal}\n                  onChange={(e) => setCouponVal(Number(e.target.value) || 0)}\n                  className=\"w-16 px-2 py-1.5 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\"\n                />\n                <select\n                  value={couponType}\n                  onChange={(e) => setCouponType(e.target.value as \'percent\' | \'flat\')}\n                  className=\"flex-1 px-2 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\"\n                >\n                  <option value=\"percent\">% Off</option>\n                  <option value=\"flat\">Flat INR</option>\n                </select>\n              </div>\n              <input\n                type=\"text\"\n                placeholder=\"Promotion description\"\n                value={couponDesc}\n                onChange={(e) => setCouponDesc(e.target.value)}\n                className=\"col-span-2 px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\"\n              />\n              <button type=\"submit\" className=\"col-span-2 py-2 font-medium text-white bg-indigo-700 rounded-md\">\n                Create Promotion Coupon\n              </button>\n            </form>\n          </section>\n\n          <section className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\">\n            <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white\">Review Moderation</h3>\n            <div className=\"space-y-3 text-xs\">\n              {reviews.map((r) => (\n                <div key={r.id} className=\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg flex items-start justify-between gap-3\">\n                  <div>\n                    <p className=\"font-semibold text-slate-900 dark:text-white\">\n                      {r.customerName} \302\267 {r.rating} \342\230\205\n                    </p>\n                    <p className=\"text-slate-600 dark:text-slate-300 mt-0.5\">{r.comment}</p>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => moderateReview(r.id, \'remove\')}\n                    aria-label={`Remove review by ${r.customerName}`}\n                    className=\"p-1.5 text-slate-400 hover:text-red-600 shrink-0\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              ))}\n            </div>\n          </section>\n        </div>\n      )}\n\n      {/* TAB 5: PLATFORM SETTINGS & AUDIT LOGS */}\n      {activeTab === \'admin-settings\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          <form\n            onSubmit={(e) => {\n              e.preventDefault();\n              updatePlatformSettings(settingsDraft);\n            }}\n            className=\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4 text-xs\"\n          >\n            <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5\">\n              <ShieldCheck className=\"w-4 h-4 text-indigo-600\" />\n              Retention & Platform Policies\n            </h3>\n            <div>\n              <label htmlFor=\"set-order-ret\" className=\"block text-slate-500 mb-1\">\n                Order File Shop Access Retention (Days)\n              </label>\n              <input\n                id=\"set-order-ret\"\n                type=\"number\"\n                min={1}\n                max={30}\n                value={settingsDraft.orderFileRetentionDays}\n                onChange={(e) =>\n                  setSettingsDraft((s) => ({ ...s, orderFileRetentionDays: Number(e.target.value) || 7 }))\n                }\n                className=\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n            <div>\n              <label htmlFor=\"set-trash-ret\" className=\"block text-slate-500 mb-1\">\n                Vault Trash Auto-Cleanup Retention (Days)\n              </label>\n              <input\n                id=\"set-trash-ret\"\n                type=\"number\"\n                min={7}\n                max={90}\n                value={settingsDraft.trashRetentionDays}\n                onChange={(e) =>\n                  setSettingsDraft((s) => ({ ...s, trashRetentionDays: Number(e.target.value) || 30 }))\n                }\n                className=\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n            <div>\n              <label htmlFor=\"set-comm\" className=\"block text-slate-500 mb-1\">\n                Marketplace Commission (%)\n              </label>\n              <input\n                id=\"set-comm\"\n                type=\"number\"\n                min={0}\n                max={25}\n                value={settingsDraft.commissionPercent}\n                onChange={(e) =>\n                  setSettingsDraft((s) => ({ ...s, commissionPercent: Number(e.target.value) || 0 }))\n                }\n                className=\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n            <button type=\"submit\" className=\"px-4 py-2 font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\">\n              Save Policy Configuration\n            </button>\n          </form>\n\n          <div className=\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-3\">\n            <h3 className=\"text-sm font-semibold text-slate-900 dark:text-white\">Immutable Privileged Audit Logs</h3>\n            <div className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs max-h-96 overflow-y-auto\">\n              {auditLogs.map((log) => (\n                <div key={log.id} className=\"py-3\">\n                  <div className=\"flex justify-between gap-2\">\n                    <span className=\"font-mono font-semibold text-slate-900 dark:text-white\">{log.action}</span>\n                    <span className=\"font-mono text-[11px] text-slate-400\">\n                      {new Date(log.createdAt).toLocaleString()}\n                    </span>\n                  </div>\n                  <p className=\"text-slate-600 dark:text-slate-300 mt-0.5\">{log.details}</p>\n                  <p className=\"text-[11px] text-slate-400\">\n                    Actor: {log.actorEmail} \302\267 Target: {log.targetType}/{log.targetId}\n                  </p>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/admin/AdminPortalView.tsx"
        }
        overwrite: true
      }
