:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\\\">\\n            <div className=\\\"px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between\\\">\\n              <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Recent Marketplace Orders</h3>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'orders\')}\\n                className=\\\"text-xs font-medium text-indigo-700 dark:text-indigo-400 hover:underline inline-flex items-center gap-1\\\"\\n              >\\n                View All Orders\\n                <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n              </button>\\n            </div>\"}, {\"AllowMultiple\":false, \"EndLine\":238, \"ReplacementContent\":\"                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setActiveTab(\'orders\')}\\n                      className=\\\"px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap\\\"\\n                    >\\n                      Open Request\\n                    </button>\", \"StartLine\":230, \"TargetContent\":\"                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setActiveTab(\'orders\')}\\n                      className=\\\"px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap\\\"\\n                    >\\n                      {ord.status === \'price_pending_approval\' ? \'Review Price\' : \'Track\'}\\n                    </button>\"}], \"TargetFile\":\"/src/components/customer/CustomerHomeView.tsx\", \"toolAction\":\"Updating CustomerHo