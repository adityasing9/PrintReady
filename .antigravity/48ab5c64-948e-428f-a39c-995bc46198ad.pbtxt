    command_line: "bash -c \'\nset -e\ntrap \"playwright-cli close >/dev/null 2>&1 || true\" EXIT\n\necho \"=== 1. Check built dist PWA files ===\"\nls -lh dist/manifest.webmanifest dist/sw.js dist/pwa-192x192.png dist/pwa-512x512.png dist/pwa-maskable-512x512.png dist/apple-touch-icon.png\n\necho \"=== 2. Wait for dev server and check live PWA endpoints ===\"\nfor i in $(seq 1 20); do\n  if curl -sf http://localhost:3000/api/health >/dev/null 2>&1; then break; fi\n  sleep 0.5\ndone\n\nfor url in /manifest.webmanifest /pwa-192x192.png /pwa-512x512.png /pwa-maskable-512x512.png /apple-touch-icon.png /icon.svg; do\n  code=$(curl -s -o /dev/null -w \"%{http_code}\" \"http://localhost:3000${url}\")\n  echo \"HTTP ${code} ${url}\"\n  test \"$code\" -eq 200\ndone\n\necho \"=== 3. Verify manifest JSON fields ===\"\ncurl -sf http://localhost:3000/manifest.webmanifest | node -e \"\n  const data = JSON.parse(require(\\\"fs\\\").readFileSync(0, \\\"utf8\\\"));\n  console.log({ id: data.id, name: data.name, short_name: data.short_name, display: data.display, start_url: data.start_url, scope: data.scope, iconsCount: data.icons.length });\n  if (!data.id || !data.name || !data.short_name || data.short_name.length > 12) process.exit(1);\n  if (data.display !== \\\"standalone\\\") process.exit(1);\n\"\n\necho \"=== 4. Playwright Desktop + Mobile E2E & Screenshots ===\"\nplaywright-cli open http://localhost:3000\nplaywright-cli resize 1440 900\n\nplaywright-cli run-code \"async (page) => {\n  await page.waitForSelector(\\\"h1\\\", { timeout: 10000 });\n  await page.waitForTimeout(800);\n\n  // Verify PWA meta & manifest links in DOM\n  const pwaCheck = await page.evaluate(async () => {\n    const manifestLink = document.querySelector(\\\"link[rel=manifest]\\\")?.getAttribute(\\\"href\\\");\n    const appleIcon = document.querySelector(\\\"link[rel=apple-touch-icon]\\\")?.getAttribute(\\\"href\\\");\n    const themeColor = document.querySelector(\\\"meta[name=theme-color]\\\")?.getAttribute(\\\"content\\\");\n    const hasWorkspaceSwitcher = !!document.querySelector(\\\"[role=tablist]\\\") && document.body.innerText.includes(\\\"Workspace\\\");\n    const overflow = document.documentElement.scrollWidth > window.innerWidth;\n    const swRegistered = \\\"serviceWorker\\\" in navigator ? (await navigator.serviceWorker.getRegistrations()).length : -1;\n    return { manifestLink, appleIcon, themeColor, hasWorkspaceSwitcher, overflow, swRegistered };\n  });\n  console.log(\\\"DESKTOP_PWA_CHECK:\\\", JSON.stringify(pwaCheck));\n  if (!pwaCheck.manifestLink || !pwaCheck.appleIcon || !pwaCheck.themeColor) throw new Error(\\\"Missing PWA head tags\\\");\n  if (pwaCheck.hasWorkspaceSwitcher) throw new Error(\\\"Workspace switcher should not appear in Customer App\\\");\n  if (pwaCheck.overflow) throw new Error(\\\"Desktop horizontal overflow detected\\\");\n}\"\n\nplaywright-cli screenshot --filename=.playwright-cli/cust-desktop-home.png\n\n# Test Account & Security -> Install App modal + Partner Portal switch & Back to Customer App\nplaywright-cli run-code \"async (page) => {\n  await page.getByRole(\\\"button\\\", { name: \\\"Account & Security\\\" }).click();\n  await page.waitForTimeout(400);\n  const accountText = await page.locator(\\\"main\\\").innerText();\n  if (accountText.includes(\\\"External Integration Configuration Status\\\")) {\n    throw new Error(\\\"Developer diagnostics should not appear in customer Account settings\\\");\n  }\n  if (!accountText.includes(\\\"Install PrintReady App\\\") || !accountText.includes(\\\"Run a Print Shop?\\\")) {\n    throw new Error(\\\"Missing consumer Install App or Partner Portal cards in Account settings\\\");\n  }\n  // Open Add to Home Screen modal\n  await page.getByRole(\\\"button\\\", { name: /Add to Home Screen|Install/i }).first().click();\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: \\\".playwright-cli/cust-install-modal.png\\\" });\n  await page.getByRole(\\\"button\\\", { name: \\\"Got it\\\" }).click();\n  await page.waitForTimeout(200);\n  await page.screenshot({ path: \\\".playwright-cli/cust-account.png\\\" });\n\n  // Switch to Shop Partner Portal and verify Back to Customer App\n  await page.getByRole(\\\"button\\\", { name: /Open Print Shop Partner Portal/i }).click();\n  await page.waitForTimeout(400);\n  const backBtn = page.getByRole(\\\"button\\\", { name: /Back to Customer App/i });\n  await backBtn.waitFor({ state: \\\"visible\\\", timeout: 5000 });\n  await backBtn.click();\n  await page.waitForTimeout(400);\n  const h1 = await page.locator(\\\"h1\\\").innerText();\n  console.log(\\\"RETURNED_TO_H1:\\\", h1);\n}\"\n\n# Resize to Mobile 390x844 and test mobile bottom nav bar + zero overflow\nplaywright-cli resize 390 844\nplaywright-cli run-code \"async (page) => {\n  await page.waitForTimeout(500);\n  const mobileHome = await page.evaluate(() => ({\n    overflow: document.documentElement.scrollWidth > window.innerWidth,\n    scrollWidth: document.documentElement.scrollWidth,\n    innerWidth: window.innerWidth,\n    bottomNavVisible: !!document.querySelector(\\\"nav[aria-label=\\\\\\\"Mobile quick navigation\\\\\\\"]\\\")\n  }));\n  console.log(\\\"MOBILE_HOME:\\\", JSON.stringify(mobileHome));\n  if (mobileHome.overflow) throw new Error(\\\"Mobile home horizontal overflow: \\\" + JSON.stringify(mobileHome));\n  if (!mobileHome.bottomNavVisible) throw new Error(\\\"Mobile bottom nav not visible\\\");\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/cust-mobile-home.png\n\nplaywright-cli run-code \"async (page) => {\n  const nav = page.locator(\\\"nav[aria-label=\\\\\\\"Mobile quick navigation\\\\\\\"]\\\");\n  await nav.getByRole(\\\"button\\\", { name: /Vault/i }).click();\n  await page.waitForTimeout(400);\n  const h1Vault = await page.locator(\\\"h1\\\").innerText();\n  const overflowVault = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  console.log(\\\"MOBILE_VAULT:\\\", JSON.stringify({ h1Vault, overflowVault }));\n  await page.screenshot({ path: \\\".playwright-cli/cust-mobile-vault.png\\\" });\n\n  await nav.getByRole(\\\"button\\\", { name: /Orders/i }).click();\n  await page.waitForTimeout(400);\n  const h1Orders = await page.locator(\\\"h1\\\").innerText();\n  const overflowOrders = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  console.log(\\\"MOBILE_ORDERS:\\\", JSON.stringify({ h1Orders, overflowOrders }));\n  await page.screenshot({ path: \\\".playwright-cli/cust-mobile-orders.png\\\" });\n}\"\n\necho \"=== 5. Console errors ===\"\nplaywright-cli console error || true\n\'"
    proposed_command_line: "bash -c \'\nset -e\ntrap \"playwright-cli close >/dev/null 2>&1 || true\" EXIT\n\necho \"=== 1. Check built dist PWA files ===\"\nls -lh dist/manifest.webmanifest dist/sw.js dist/pwa-192x192.png dist/pwa-512x512.png dist/pwa-maskable-512x512.png dist/apple-touch-icon.png\n\necho \"=== 2. Wait for dev server and check live PWA endpoints ===\"\nfor i in $(seq 1 20); do\n  if curl -sf http://localhost:3000/api/health >/dev/null 2>&1; then break; fi\n  sleep 0.5\ndone\n\nfor url in /manifest.webmanifest /pwa-192x192.png /pwa-512x512.png /pwa-maskable-512x512.png /apple-touch-icon.png /icon.svg; do\n  code=$(curl -s -o /dev/null -w \"%{http_code}\" \"http://localhost:3000${url}\")\n  echo \"HTTP ${code} ${url}\"\n  test \"$code\" -eq 200\ndone\n\necho \"=== 3. Verify manifest JSON fields ===\"\ncurl -sf http://localhost:3000/manifest.webmanifest | node -e \"\n  const data = JSON.parse(require(\\\"fs\\\").readFileSync(0, \\\"utf8\\\"));\n  console.log({ id: data.id, name: data.name, short_name: data.short_name, display: data.display, start_url: data.start_url, scope: data.scope, iconsCount: data.icons.length });\n  if (!data.id || !data.name || !data.short_name || data.short_name.length > 12) process.exit(1);\n  if (data.display !== \\\"standalone\\\") process.exit(1);\n\"\n\necho \"=== 4. Playwright Desktop + Mobile E2E & Screenshots ===\"\nplaywright-cli open http://localhost:3000\nplaywright-cli resize 1440 900\n\nplaywright-cli run-code \"async (page) => {\n  await page.waitForSelector(\\\"h1\\\", { timeout: 10000 });\n  await page.waitForTimeout(800);\n\n  // Verify PWA meta & manifest links in DOM\n  const pwaCheck = await page.evaluate(async () => {\n    const manifestLink = document.querySelector(\\\"link[rel=manifest]\\\")?.getAttribute(\\\"href\\\");\n    const appleIcon = document.querySelector(\\\"link[rel=apple-touch-icon]\\\")?.getAttribute(\\\"href\\\");\n    const themeColor = document.querySelector(\\\"meta[name=theme-color]\\\")?.getAttribute(\\\"content\\\");\n    const hasWorkspaceSwitcher = !!document.querySelector(\\\"[role=tablist]\\\") && document.body.innerText.includes(\\\"Workspace\\\");\n    const overflow = document.documentElement.scrollWidth > window.innerWidth;\n    const swRegistered = \\\"serviceWorker\\\" in navigator ? (await navigator.serviceWorker.getRegistrations()).length : -1;\n    return { manifestLink, appleIcon, themeColor, hasWorkspaceSwitcher, overflow, swRegistered };\n  });\n  console.log(\\\"DESKTOP_PWA_CHECK:\\\", JSON.stringify(pwaCheck));\n  if (!pwaCheck.manifestLink || !pwaCheck.appleIcon || !pwaCheck.themeColor) throw new Error(\\\"Missing PWA head tags\\\");\n  if (pwaCheck.hasWorkspaceSwitcher) throw new Error(\\\"Workspace switcher should not appear in Customer App\\\");\n  if (pwaCheck.overflow) throw new Error(\\\"Desktop horizontal overflow detected\\\");\n}\"\n\nplaywright-cli screenshot --filename=.playwright-cli/cust-desktop-home.png\n\n# Test Account & Security -> Install App modal + Partner Portal switch & Back to Customer App\nplaywright-cli run-code \"async (page) => {\n  await page.getByRole(\\\"button\\\", { name: \\\"Account & Security\\\" }).click();\n  await page.waitForTimeout(400);\n  const accountText = await page.locator(\\\"main\\\").innerText();\n  if (accountText.includes(\\\"External Integration Configuration Status\\\")) {\n    throw new Error(\\\"Developer diagnostics should not appear in customer Account settings\\\");\n  }\n  if (!accountText.includes(\\\"Install PrintReady App\\\") || !accountText.includes(\\\"Run a Print Shop?\\\")) {\n    throw new Error(\\\"Missing consumer Install App or Partner Portal cards in Account settings\\\");\n  }\n  // Open Add to Home Screen modal\n  await page.getByRole(\\\"button\\\", { name: /Add to Home Screen|Install/i }).first().click();\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: \\\".playwright-cli/cust-install-modal.png\\\" });\n  await page.getByRole(\\\"button\\\", { name: \\\"Got it\\\" }).click();\n  await page.waitForTimeout(200);\n  await page.screenshot({ path: \\\".playwright-cli/cust-account.png\\\" });\n\n  // Switch to Shop Partner Portal and verify Back to Customer App\n  await page.getByRole(\\\"button\\\", { name: /Open Print Shop Partner Portal/i }).click();\n  await page.waitForTimeout(400);\n  const backBtn = page.getByRole(\\\"button\\\", { name: /Back to Customer App/i });\n  await backBtn.waitFor({ state: \\\"visible\\\", timeout: 5000 });\n  await backBtn.click();\n  await page.waitForTimeout(400);\n  const h1 = await page.locator(\\\"h1\\\").innerText();\n  console.log(\\\"RETURNED_TO_H1:\\\", h1);\n}\"\n\n# Resize to Mobile 390x844 and test mobile bottom nav bar + zero overflow\nplaywright-cli resize 390 844\nplaywright-cli run-code \"async (page) => {\n  await page.waitForTimeout(500);\n  const mobileHome = await page.evaluate(() => ({\n    overflow: document.documentElement.scrollWidth > window.innerWidth,\n    scrollWidth: document.documentElement.scrollWidth,\n    innerWidth: window.innerWidth,\n    bottomNavVisible: !!document.querySelector(\\\"nav[aria-label=\\\\\\\"Mobile quick navigation\\\\\\\"]\\\")\n  }));\n  console.log(\\\"MOBILE_HOME:\\\", JSON.stringify(mobileHome));\n  if (mobileHome.overflow) throw new Error(\\\"Mobile home horizontal overflow: \\\" + JSON.stringify(mobileHome));\n  if (!mobileHome.bottomNavVisible) throw new Error(\\\"Mobile bottom nav not visible\\\");\n}\"\nplaywright-cli screenshot --filename=.playwright-cli/cust-mobile-home.png\n\nplaywright-cli run-code \"async (page) => {\n  const nav = page.locator(\\\"nav[aria-label=\\\\\\\"Mobile quick navigation\\\\\\\"]\\\");\n  await nav.getByRole(\\\"button\\\", { name: /Vault/i }).click();\n  await page.waitForTimeout(400);\n  const h1Vault = await page.locator(\\\"h1\\\").innerText();\n  const overflowVault = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  console.log(\\\"MOBILE_VAULT:\\\", JSON.stringify({ h1Vault, overflowVault }));\n  await page.screenshot({ path: \\\".playwright-cli/cust-mobile-vault.png\\\" });\n\n  await nav.getByRole(\\\"button\\\", { name: /Orders/i }).click();\n  await page.waitForTimeout(400);\n  const h1Orders = await page.locator(\\\"h1\\\").innerText();\n  const overflowOrders = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  console.log(\\\"MOBILE_ORDERS:\\\", JSON.stringify({ h1Orders, overflowOrders }));\n  await page.screenshot({ path: \\\".playwright-cli/cust-mobile-orders.png\\\" });\n}\"\n\necho \"=== 5. Console errors ===\"\nplaywright-cli console error || true\n\'"
