              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const copies = Math.max(1, Math.min(500, Math.floor(item.settings.copies || 1)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const pagesPerSheet = item.settings.pagesPerSheet || 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const logicalSidesPerCopy = Math.ceil(selectedPages / pagesPerSheet);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sheetsPerCopy ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    item.settings.sides === \'double\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
