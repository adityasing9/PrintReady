            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateItemPrintCost("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  item: PrintBasketItem,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  pricing: ShopPricingTable = DEFAULT_PRICING"
