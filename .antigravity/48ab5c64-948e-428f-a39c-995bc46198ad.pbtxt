            }
            lines {
              text: "  if (item.sizeBytes > 20 * 1024 * 1024) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    warnings.push(\'Large file (>20 MB): verify print bleed and resolution.\');"
