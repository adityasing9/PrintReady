    tool_calls {
      id: "call_12363497356658225386"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { CheckCircle2, Download, KeyRound, Shield, Sparkles, User } from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport { formatFileSize } from \'../../domain/fileValidation\';\\n\\nexport function AccountSettingsView() {\\n  const {\\n    userProfile,\\n    updateUserProfile,\\n    isCloudMode,\\n    firestoreConnected,\\n    signInWithGoogle,\\n    signOutUser,\\n    documents,\\n    folders,\\n    orders,\\n    coupons,\\n    integrations,\\n    notify,\\n  } = usePrintReady();\\n\\n  const [displayName, setDisplayName] = useState(userProfile.displayName);\\n  const [phone, setPhone] = useState(userProfile.phone);\\n  const [language, setLanguage] = useState(userProfile.preferredLanguage);\\n\\n  const usedBytes = documents.filter((d) => !d.isTrashed).reduce((s, d) => s + d.sizeBytes, 0);\\n\\n  const handleSaveProfile = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    updateUserProfile({\\n      displayName: displayName.trim() || userProfile.displayName,\\n      phone: phone.trim(),\\n      preferredLanguage: language,\\n    });\\n    notify(\'Profile updated\', \'Your account preferences were saved.\', \'success\');\\n  };\\n\\n  const handleExportAccountData = () => {\\n    const payload = {\\n      exportedAt: new Date().toISOString(),\\n      profile: userProfile,\\n      folders,\\n      documents: documents.map(({ previewDataUrl: _omit, ...meta }) => meta),\\n      orders,\\n    };\\n    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: \'application/json\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `PrintReady_Account_Export_${new Date().toISOString().slice(0, 10)}.json`;\\n    document.body.appendChild(a);\\n    a.click();\\n    a.remove();\\n    setTimeout(() => URL.revokeObjectURL(url), 4000);\\n    notify(\'Data export ready\', \'Downloaded complete JSON archive of your vault metadata and orders.\', \'success\');\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6 max-w-5xl\\\">\\n      <div>\\n        <h2 className=\\\"text-xl font-bold text-slate-900 dark:text-white\\\">Account, Privacy & Integrations</h2>\\n        <p className=\\\"text-sm text-slate-500 dark:text-slate-400\\\">\\n          Manage authentication, AI processing consent, cloud backup, subscription tiers, and verified integration readiness.\\n        </p>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n        {/* Profile Form */}\\n        <form\\n          onSubmit={handleSaveProfile}\\n          className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4\\\"\\n        >\\n          <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n            <User className=\\\"w-4 h-4 text-indigo-600\\\" />\\n            Profile Details\\n          </h3>\\n          <div className=\\\"space-y-3 text-xs\\\">\\n            <div>\\n              <label htmlFor=\\\"acc-name\\\" className=\\\"block text-slate-500 mb-1\\\">Full Name</label>\\n              <input\\n                id=\\\"acc-name\\\"\\n                type=\\\"text\\\"\\n                value={displayName}\\n                onChange={(e) => setDisplayName(e.target.value)}\\n                className=\\\"w-full px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"acc-email\\\" className=\\\"block text-slate-500 mb-1\\\">Email Address</label>\\n              <input\\n                id=\\\"acc-email\\\"\\n                type=\\\"email\\\"\\n                readOnly\\n                value={userProfile.email}\\n                className=\\\"w-full px-3 py-2 bg-slate-100 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 rounded-lg text-slate-500\\\"\\n              />\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"acc-phone\\\" className=\\\"block text-slate-500 mb-1\\\">Phone / WhatsApp</label>\\n                <input\\n                  id=\\\"acc-phone\\\"\\n                  type=\\\"text\\\"\\n                  value={phone}\\n                  onChange={(e) => setPhone(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"acc-lang\\\" className=\\\"block text-slate-500 mb-1\\\">Language</label>\\n                <select\\n                  id=\\\"acc-lang\\\"\\n                  value={language}\\n                  onChange={(e) => setLanguage(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                >\\n                  <option value=\\\"English\\\">English</option>\\n                  <option value=\\\"Hindi\\\">Hindi</option>\\n                  <option value=\\\"Kannada\\\">Kannada</option>\\n                  <option value=\\\"Tamil\\\">Tamil</option>\\n                </select>\\n              </div>\\n            </div>\\n          </div>\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n          >\\n            Save Profile Changes\\n          </button>\\n        </form>\\n\\n        {/* Security, Privacy & Cloud Sync */}\\n        <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4\\\">\\n          <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n            <Shield className=\\\"w-4 h-4 text-indigo-600\\\" />\\n            Security, Privacy & Cloud Sync\\n          </h3>\\n\\n          <div className=\\\"space-y-3 text-xs\\\">\\n            <div className=\\\"flex items-center justify-between gap-3 py-2 border-b border-slate-100 dark:border-slate-800\\\">\\n              <div>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white\\\">Firebase Google Authentication</p>\\n                <p className=\\\"text-slate-500\\\">\\n                  {isCloudMode\\n                    ? `Signed in (${userProfile.email}) \302\267 Cloud Firestore Active`\\n                    : `Demo Workspace Mode \302\267 Firestore Reachable: ${firestoreConnected ? \'Yes\' : \'Checking\'}`}\\n                </p>\\n              </div>\\n              {isCloudMode ? (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={signOutUser}\\n                  className=\\\"px-3 py-1.5 font-medium border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                >\\n                  Sign Out\\n                </button>\\n              ) : (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={signInWithGoogle}\\n                  className=\\\"px-3 py-1.5 font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg whitespace-nowrap\\\"\\n                >\\n                  Connect Google\\n                </button>\\n              )}\\n            </div>\\n\\n            <label className=\\\"flex items-center justify-between gap-3 py-1 cursor-pointer\\\">\\n              <div>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white flex items-center gap-1\\\">\\n                  <Sparkles className=\\\"w-3.5 h-3.5 text-indigo-600\\\" />\\n                  AI Document Intelligence\\n                </p>\\n                <p className=\\\"text-slate-500\\\">Allow server-side Gemini classification, OCR, and natural-language search.</p>\\n              </div>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={userProfile.aiEnabled}\\n                onChange={(e) => updateUserProfile({ aiEnabled: e.target.checked })}\\n                className=\\\"accent-indigo-700 w-4 h-4\\\"\\n              />\\n            </label>\\n\\n            <label className=\\\"flex items-center justify-between gap-3 py-1 cursor-pointer\\\">\\n              <div>\\n                <p className=\\\"font-medium text-slate-900 dark:text-white\\\">Cloud Vault Backup</p>\\n                <p className=\\\"text-slate-500\\\">Sync private vault metadata across authenticated devices.</p>\\n              </div>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={userProfile.cloudBackupEnabled}\\n                onChange={(e) => updateUserProfile({ cloudBackupEnabled: e.target.checked })}\\n                className=\\\"accent-indigo-700 w-4 h-4\\\"\\n              />\\n            </label>\\n\\n            <div className=\\\"pt-2 flex flex-wrap gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleExportAccountData}\\n                className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 font-medium border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800\\\"\\n              >\\n                <Download className=\\\"w-3.5 h-3.5\\\" />\\n                Export Account Data (JSON)\\n              </button>\\n            </div>\\n          </div>\\n        </section>\\n      </div>\\n\\n      {/* Subscription Plans & Loyalty */}\\n      <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n          <div>\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Subscription & Storage Plans</h3>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Current usage: <span className=\\\"font-mono tabular-nums\\\">{formatFileSize(usedBytes)}</span> \302\267 Loyalty Balance:{\' \'}\\n              <span className=\\\"font-mono tabular-nums font-semibold text-indigo-700 dark:text-indigo-400\\\">{userProfile.loyaltyPoints} pts</span>\\n            </p>\\n          </div>\\n          <div className=\\\"text-xs text-slate-500\\\">\\n            Active Coupons: {coupons.filter((c) => c.active).map((c) => c.code).join(\' \302\267 \')}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\\\">\\n          <div\\n            className={`p-4 rounded-xl border space-y-2 ${\\n              userProfile.subscriptionPlan === \'free\'\\n                ? \'border-indigo-600 bg-indigo-50/30 dark:bg-indigo-950/30\'\\n                : \'border-slate-200 dark:border-slate-800\'\\n            }`}\\n          >\\n            <div className=\\\"flex justify-between items-center\\\">\\n              <span className=\\\"text-sm font-bold text-slate-900 dark:text-white\\\">For Everyday Printing \342\200\224 Free</span>\\n              <span className=\\\"font-mono font-semibold text-slate-700 dark:text-slate-300\\\">\342\202\2710 / mo</span>\\n            </div>\\n            <p className=\\\"text-slate-600 dark:text-slate-400\\\">\\n              250 MB local vault \302\267 Saved shops \302\267 Direct WhatsApp & Email sharing \302\267 Basic print presets.\\n            </p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => updateUserProfile({ subscriptionPlan: \'free\', storageQuotaBytes: 250 * 1024 * 1024 })}\\n              className=\\\"px-3 py-1.5 font-medium border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n            >\\n              {userProfile.subscriptionPlan === \'free\' ? \'Current Plan\' : \'Switch to Free\'}\\n            </button>\\n          </div>\\n\\n          <div\\n            className={`p-4 rounded-xl border space-y-2 ${\\n              userProfile.subscriptionPlan === \'premium\'\\n                ? \'border-indigo-600 bg-indigo-50/30 dark:bg-indigo-950/30\'\\n                : \'border-slate-200 dark:border-slate-800\'\\n            }`}\\n          >\\n            <div className=\\\"flex justify-between items-center\\\">\\n              <span className=\\\"text-sm font-bold text-slate-900 dark:text-white\\\">For Power Users & Students \342\200\224 Premium</span>\\n              <span className=\\\"font-mono font-semibold text-indigo-700 dark:text-indigo-400\\\">Configurable Tier</span>\\n            </div>\\n            <p className=\\\"text-slate-600 dark:text-slate-400\\\">\\n              5 GB Cloud Sync \302\267 Unlimited AI Classification & OCR \302\267 Full PDF Tools \302\267 Priority Shop Orders.\\n            </p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => updateUserProfile({ subscriptionPlan: \'premium\', storageQuotaBytes: 5 * 1024 * 1024 * 1024 })}\\n              className=\\\"px-3 py-1.5 font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-md\\\"\\n            >\\n              {userProfile.subscriptionPlan === \'premium\' ? \'Active Plan\' : \'Activate Premium\'}\\n            </button>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Honest External Integration Readiness Matrix */}\\n      <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-3\\\">\\n        <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n          <KeyRound className=\\\"w-4 h-4 text-indigo-600\\\" />\\n          External Integration Configuration Status\\n        </h3>\\n        <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">Cloud Firestore & Firebase Auth</span>\\n            <span className=\\\"text-emerald-700 dark:text-emerald-400 inline-flex items-center gap-1\\\">\\n              <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" /> Provisioned & Hardened Rules Deployed\\n            </span>\\n          </div>\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">Server-Side Gemini AI (gemini-4-hydrogen)</span>\\n            <span className={integrations?.geminiAi.configured ? \'text-emerald-700 dark:text-emerald-400\' : \'text-amber-700 dark:text-amber-400\'}>\\n              {integrations?.geminiAi.configured ? \'Configured on Backend\' : \'Awaiting GEMINI_API_KEY in Secrets\'}\\n            </span>\\n          </div>\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">Payment Gateway (Razorpay Abstraction)</span>\\n            <span className=\\\"text-slate-600 dark:text-slate-300\\\">\\n              {integrations?.payments.note || \'Server-verified HMAC sandbox active.\'}\\n            </span>\\n          </div>\\n          <div className=\\\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n            <span className=\\\"font-medium text-slate-900 dark:text-white\\\">WhatsApp & Email Sharing</span>\\n            <span className=\\\"text-slate-600 dark:text-slate-300\\\">\\n              Direct WhatsApp / Mailto / Native Share active (user confirms send; official Cloud API optional via .env).\\n            </span>\\n          </div>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build AccountSettingsView with profile management, Firebase auth sync, AI/cloud toggles, JSON data export, subscriptions, and honest integration readiness\", \"Overwrite\":true, \"TargetFile\":\"/src/components/customer/AccountSettingsView.tsx\", \"toolAction\":\"Creating AccountSettingsView component\", \"toolSummary\":\"Create AccountSettingsView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12363497356658226661"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Bar,\\n  BarChart,\\n  CartesianGrid,\\n  ResponsiveContainer,\\n  Tooltip,\\n  XAxis,\\n  YAxis,\\n} from \'recharts\';\\nimport {\\n  AlertTriangle,\\n  Building2,\\n  CheckCircle2,\\n  MessageSquare,\\n  Plus,\\n  Printer,\\n  Send,\\n  UserPlus,\\n} from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport { getAvailableOrderActions, STATUS_LABELS } from \'../../domain/orderStateMachine\';\\nimport { formatCurrency } from \'../../domain/printCalculator\';\\nimport { ShopInventoryItem, ShopPrinter, ShopStaffMember } from \'../../domain/types\';\\n\\nconst SHOP_QUICK_REPLIES = [\\n  \'Order received \342\200\224 reviewing files now.\',\\n  \'Price confirmed. Please approve and pay to begin printing.\',\\n  \'Printing started on laser queue.\',\\n  \'Ready for pickup! Please bring your pickup code.\',\\n  \'Please clarify double-sided vs single-sided preference.\',\\n];\\n\\nexport function ShopPortalView() {\\n  const {\\n    activeTab,\\n    shops,\\n    activeShopId,\\n    setActiveShopId,\\n    orders,\\n    inventory,\\n    printers,\\n    staff,\\n    reviews,\\n    transitionOrderStatus,\\n    assignOrderResources,\\n    sendOrderMessage,\\n    updateShopPricing,\\n    updateShopProfile,\\n    updateInventoryStock,\\n    addInventoryItem,\\n    updatePrinterStatus,\\n    addShopPrinter,\\n    inviteStaffMember,\\n    replyToReview,\\n    registerNewShop,\\n  } = usePrintReady();\\n\\n  const currentShop = shops.find((s) => s.id === activeShopId) || shops[0];\\n  const shopOrders = useMemo(\\n    () => orders.filter((o) => o.shopId === currentShop?.id),\\n    [currentShop?.id, orders]\\n  );\\n  const shopInventory = useMemo(\\n    () => inventory.filter((i) => i.shopId === currentShop?.id),\\n    [currentShop?.id, inventory]\\n  );\\n  const shopPrinters = useMemo(\\n    () => printers.filter((p) => p.shopId === currentShop?.id),\\n    [currentShop?.id, printers]\\n  );\\n  const shopStaff = useMemo(\\n    () => staff.filter((st) => st.shopId === currentShop?.id),\\n    [currentShop?.id, staff]\\n  );\\n  const shopReviews = useMemo(\\n    () => reviews.filter((r) => r.shopId === currentShop?.id),\\n    [currentShop?.id, reviews]\\n  );\\n\\n  // Local UI state for orders & pricing\\n  const [selectedOrderId, setSelectedOrderId] = useState<string>(shopOrders[0]?.id || \'\');\\n  const [confirmPriceInput, setConfirmPriceInput] = useState<string>(\'\');\\n  const [queueSort, setQueueSort] = useState<\'priority\' | \'newest\'>(\'priority\');\\n  const [shopChatInput, setShopChatInput] = useState(\'\');\\n\\n  // Pricing editor\\n  const [pricingDraft, setPricingDraft] = useState(currentShop.pricing);\\n\\n  // Inventory & Printer forms\\n  const [newSupply, setNewSupply] = useState({\\n    name: \'\',\\n    category: \'paper\' as ShopInventoryItem[\'category\'],\\n    quantity: 10,\\n    unit: \'reams\',\\n    reorderLevel: 5,\\n    supplier: \'\',\\n  });\\n  const [newPrinterName, setNewPrinterName] = useState(\'\');\\n  const [newPrinterType, setNewPrinterType] = useState<ShopPrinter[\'type\']>(\'laser_color\');\\n\\n  // Staff invite & Review reply\\n  const [staffName, setStaffName] = useState(\'\');\\n  const [staffEmail, setStaffEmail] = useState(\'\');\\n  const [staffRole, setStaffRole] = useState<ShopStaffMember[\'role\']>(\'Operator\');\\n  const [replyDrafts, setReplyDrafts] = useState<Record<string, string>>({});\\n\\n  // Onboarding new shop\\n  const [onboardForm, setOnboardForm] = useState({\\n    name: \'\',\\n    ownerName: \'\',\\n    address: \'\',\\n    city: \'Bengaluru\',\\n    phone: \'\',\\n    whatsapp: \'\',\\n    email: \'\',\\n    openingHours: \'09:00 AM \342\200\223 09:00 PM\',\\n    pickupAvailable: true,\\n    deliveryAvailable: true,\\n    servicesText: \'B&W Laser, Color Laser, Spiral Binding, Lamination\',\\n  });\\n\\n  // Real Computed Business Metrics (zero fake stats)\\n  const metrics = useMemo(() => {\\n    const newCount = shopOrders.filter((o) => [\'submitted\', \'received\', \'awaiting_shop_response\'].includes(o.status)).length;\\n    const printingCount = shopOrders.filter((o) => [\'printing\', \'quality_check\'].includes(o.status)).length;\\n    const readyCount = shopOrders.filter((o) => [\'ready_for_pickup\', \'out_for_delivery\'].includes(o.status)).length;\\n    const completedCount = shopOrders.filter((o) => o.status === \'completed\').length;\\n    const paidRevenue = shopOrders\\n      .filter((o) => o.paymentStatus === \'verified\')\\n      .reduce((sum, o) => sum + (o.confirmedTotal ?? o.estimatedTotal), 0);\\n    const outstanding = shopOrders\\n      .filter((o) => o.paymentStatus !== \'verified\' && ![\'cancelled\', \'rejected\', \'refunded\'].includes(o.status))\\n      .reduce((sum, o) => sum + (o.confirmedTotal ?? o.estimatedTotal), 0);\\n    return { newCount, printingCount, readyCount, completedCount, paidRevenue, outstanding };\\n  }, [shopOrders]);\\n\\n  const chartData = useMemo(() => {\\n    return [\\n      { stage: \'New\', count: metrics.newCount },\\n      { stage: \'Printing\', count: metrics.printingCount },\\n      { stage: \'Ready\', count: metrics.readyCount },\\n      { stage: \'Completed\', count: metrics.completedCount },\\n    ];\\n  }, [metrics]);\\n\\n  const sortedQueue = useMemo(() => {\\n    return [...shopOrders].sort((a, b) => {\\n      if (queueSort === \'priority\' && a.priority !== b.priority) {\\n        return a.priority === \'urgent\' ? -1 : 1;\\n      }\\n      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\\n    });\\n  }, [queueSort, shopOrders]);\\n\\n  const activeOrder = shopOrders.find((o) => o.id === selectedOrderId) || sortedQueue[0] || null;\\n  const lowStockItems = shopInventory.filter((i) => i.quantity <= i.reorderLevel);\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Shop Context Header */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200 dark:border-slate-800\\\">\\n        <div>\\n          <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n            Print Shop Operations \302\267 Verification:{\' \'}\\n            <span\\n              className={\\n                currentShop.verificationStatus === \'verified\'\\n                  ? \'text-emerald-700 dark:text-emerald-400 font-semibold\'\\n                  : \'text-amber-700 dark:text-amber-400 font-semibold\'\\n              }\\n            >\\n              {currentShop.verificationStatus}\\n            </span>\\n          </p>\\n          <h2 className=\\\"text-xl font-bold text-slate-900 dark:text-white\\\">{currentShop.name}</h2>\\n        </div>\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <label htmlFor=\\\"active-shop-switch\\\" className=\\\"text-xs text-slate-500\\\">\\n            Managing Shop:\\n          </label>\\n          <select\\n            id=\\\"active-shop-switch\\\"\\n            value={currentShop.id}\\n            onChange={(e) => {\\n              setActiveShopId(e.target.value);\\n              const next = shops.find((s) => s.id === e.target.value);\\n              if (next) setPricingDraft(next.pricing);\\n            }}\\n            className=\\\"px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n          >\\n            {shops.map((s) => (\\n              <option key={s.id} value={s.id}>\\n                {s.name} ({s.verificationStatus})\\n              </option>\\n            ))}\\n          </select>\\n        </div>\\n      </div>\\n\\n      {/* TAB 1: SHOP DASHBOARD */}\\n      {activeTab === \'shop-dashboard\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n            {[\\n              { label: \'Verified Revenue\', value: formatCurrency(metrics.paidRevenue, currentShop.pricing.currency), sub: \'From settled orders\' },\\n              { label: \'Outstanding / Pending\', value: formatCurrency(metrics.outstanding, currentShop.pricing.currency), sub: \'Awaiting approval/payment\' },\\n              { label: \'Active Queue\', value: String(metrics.newCount + metrics.printingCount + metrics.readyCount), sub: `${metrics.newCount} new \302\267 ${metrics.printingCount} printing` },\\n              { label: \'Completed Orders\', value: String(metrics.completedCount), sub: `${shopReviews.length} customer reviews` },\\n            ].map((kpi) => (\\n              <div key={kpi.label} className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5\\\">\\n                <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">{kpi.label}</p>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-slate-900 dark:text-white mt-1\\\">{kpi.value}</p>\\n                <p className=\\\"text-xs text-slate-500 mt-1\\\">{kpi.sub}</p>\\n              </div>\\n            ))}\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n            <div className=\\\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\">\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Live Order Pipeline</h3>\\n              <div className=\\\"h-64 w-full\\\">\\n                <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                  <BarChart data={chartData}>\\n                    <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#e2e8f0\\\" />\\n                    <XAxis dataKey=\\\"stage\\\" tick={{ fontSize: 12 }} />\\n                    <YAxis allowDecimals={false} tick={{ fontSize: 12 }} />\\n                    <Tooltip />\\n                    <Bar dataKey=\\\"count\\\" fill=\\\"#4338CA\\\" radius={[6, 6, 0, 0]} />\\n                  </BarChart>\\n                </ResponsiveContainer>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\">\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n                <AlertTriangle className=\\\"w-4 h-4 text-amber-600\\\" />\\n                Low Inventory Warnings ({lowStockItems.length})\\n              </h3>\\n              {lowStockItems.length === 0 ? (\\n                <p className=\\\"text-xs text-slate-500\\\">All paper, toner, and binding supplies are above reorder thresholds.</p>\\n              ) : (\\n                <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n                  {lowStockItems.map((item) => (\\n                    <div key={item.id} className=\\\"py-2.5 flex items-center justify-between gap-2\\\">\\n                      <div>\\n                        <p className=\\\"font-medium text-slate-900 dark:text-white\\\">{item.name}</p>\\n                        <p className=\\\"text-slate-500\\\">\\n                          Remaining: <span className=\\\"font-mono text-amber-700 dark:text-amber-400 font-semibold\\\">{item.quantity} {item.unit}</span> (Reorder \342\211\244 {item.reorderLevel})\\n                        </p>\\n                      </div>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => updateInventoryStock(item.id, 10)}\\n                        className=\\\"px-2.5 py-1 text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 rounded-md whitespace-nowrap\\\"\\n                      >\\n                        +10 Restock\\n                      </button>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: ORDERS & PRINT QUEUE */}\\n      {activeTab === \'shop-orders\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <div className=\\\"lg:col-span-5 space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">\\n                Incoming & Active Print Queue ({sortedQueue.length})\\n              </h3>\\n              <select\\n                aria-label=\\\"Sort print queue\\\"\\n                value={queueSort}\\n                onChange={(e) => setQueueSort(e.target.value as \'priority\' | \'newest\')}\\n                className=\\\"px-2.5 py-1 text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              >\\n                <option value=\\\"priority\\\">Urgent First</option>\\n                <option value=\\\"newest\\\">Newest First</option>\\n              </select>\\n            </div>\\n\\n            {sortedQueue.map((ord) => (\\n              <button\\n                key={ord.id}\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setSelectedOrderId(ord.id);\\n                  setConfirmPriceInput(String(ord.confirmedTotal ?? ord.estimatedTotal));\\n                }}\\n                className={`w-full text-left p-4 rounded-xl border transition-colors space-y-1 ${\\n                  activeOrder?.id === ord.id\\n                    ? \'border-indigo-600 bg-indigo-50/40 dark:bg-indigo-950/40\'\\n                    : \'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800\'\\n                }`}\\n              >\\n                <div className=\\\"flex justify-between items-center text-sm\\\">\\n                  <span className=\\\"font-mono font-bold text-slate-900 dark:text-white\\\">\\n                    {ord.orderNumber}\\n                    {ord.priority === \'urgent\' && (\\n                      <span className=\\\"ml-2 text-xs font-sans font-semibold text-red-600\\\">Urgent</span>\\n                    )}\\n                  </span>\\n                  <span className=\\\"font-mono tabular-nums font-semibold\\\">\\n                    {formatCurrency(ord.confirmedTotal ?? ord.estimatedTotal, ord.currency)}\\n                  </span>\\n                </div>\\n                <p className=\\\"text-xs text-slate-700 dark:text-slate-300\\\">\\n                  {ord.customerName} \302\267 {ord.items.length} file(s) \302\267 {ord.fulfillmentType}\\n                </p>\\n                <p className=\\\"text-xs text-indigo-700 dark:text-indigo-400 font-medium\\\">\\n                  {STATUS_LABELS[ord.status]} \302\267 Payment: {ord.paymentStatus}\\n                </p>\\n              </button>\\n            ))}\\n          </div>\\n\\n          <div className=\\\"lg:col-span-7\\\">\\n            {activeOrder ? (\\n              <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-5\\\">\\n                <div className=\\\"flex flex-wrap justify-between gap-3 pb-4 border-b border-slate-200 dark:border-slate-800\\\">\\n                  <div>\\n                    <h3 className=\\\"text-lg font-bold font-mono text-slate-900 dark:text-white\\\">\\n                      {activeOrder.orderNumber}\\n                    </h3>\\n                    <p className=\\\"text-xs text-slate-500\\\">\\n                      Customer: {activeOrder.customerName} ({activeOrder.customerPhone}) \302\267 Pickup Code:{\' \'}\\n                      <span className=\\\"font-mono font-semibold text-slate-800 dark:text-slate-200\\\">{activeOrder.pickupCode}</span>\\n                    </p>\\n                  </div>\\n                  <div className=\\\"text-right\\\">\\n                    <p className=\\\"text-xs text-slate-500\\\">Current Stage</p>\\n                    <p className=\\\"text-sm font-bold text-indigo-700 dark:text-indigo-400\\\">{STATUS_LABELS[activeOrder.status]}</p>\\n                  </div>\\n                </div>\\n\\n                {/* Shop Price Confirmation + Workflow Transition Controls */}\\n                <div className=\\\"space-y-3\\\">\\n                  {[\'submitted\', \'received\', \'awaiting_shop_response\'].includes(activeOrder.status) && (\\n                    <div className=\\\"flex flex-wrap items-end gap-2.5 p-3.5 bg-slate-50 dark:bg-slate-950 rounded-lg border border-slate-200 dark:border-slate-800\\\">\\n                      <div className=\\\"flex-1 min-w-36\\\">\\n                        <label htmlFor=\\\"shop-confirm-price\\\" className=\\\"block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1\\\">\\n                          Confirmed Final Price ({activeOrder.currency})\\n                        </label>\\n                        <input\\n                          id=\\\"shop-confirm-price\\\"\\n                          type=\\\"number\\\"\\n                          step=\\\"0.5\\\"\\n                          value={confirmPriceInput || String(activeOrder.estimatedTotal)}\\n                          onChange={(e) => setConfirmPriceInput(e.target.value)}\\n                          className=\\\"w-full px-3 py-1.5 text-xs font-mono bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                        />\\n                      </div>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => {\\n                          const price = Number(confirmPriceInput) || activeOrder.estimatedTotal;\\n                          transitionOrderStatus(activeOrder.id, \'price_pending_approval\', \'shop\', {\\n                            confirmedTotal: price,\\n                            note: `Shop accepted order and confirmed price at ${formatCurrency(price, activeOrder.currency)}.`,\\n                          });\\n                        }}\\n                        className=\\\"px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg whitespace-nowrap\\\"\\n                      >\\n                        Accept & Send Price Confirmation\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          transitionOrderStatus(activeOrder.id, \'rejected\', \'shop\', {\\n                            note: \'Order rejected by print shop due to paper/equipment unavailability.\',\\n                          })\\n                        }\\n                        className=\\\"px-3 py-2 text-xs font-medium text-red-600 border border-red-200 dark:border-red-900 rounded-lg\\\"\\n                      >\\n                        Reject\\n                      </button>\\n                    </div>\\n                  )}\\n\\n                  <div className=\\\"flex flex-wrap gap-2\\\">\\n                    {getAvailableOrderActions(activeOrder.status, \'shop\', activeOrder.fulfillmentType)\\n                      .filter((a) => !a.requiresPriceConfirmation && a.nextStatus !== \'rejected\')\\n                      .map((act) => (\\n                        <button\\n                          key={act.label}\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            transitionOrderStatus(activeOrder.id, act.nextStatus, \'shop\', {\\n                              note: `Shop updated stage to ${STATUS_LABELS[act.nextStatus]}.`,\\n                            })\\n                          }\\n                          className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n                        >\\n                          <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                          {act.label}\\n                        </button>\\n                      ))}\\n                  </div>\\n                </div>\\n\\n                {/* Staff & Printer Assignment */}\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\\\">\\n                  <div>\\n                    <label htmlFor=\\\"assign-staff\\\" className=\\\"block text-slate-500 mb-1\\\">Assigned Operator</label>\\n                    <select\\n                      id=\\\"assign-staff\\\"\\n                      value={activeOrder.assignedStaffName || \'\'}\\n                      onChange={(e) =>\\n                        assignOrderResources(activeOrder.id, e.target.value, activeOrder.assignedPrinterName || shopPrinters[0]?.name || \'\')\\n                      }\\n                      className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                    >\\n                      <option value=\\\"\\\">Unassigned</option>\\n                      {shopStaff.map((st) => (\\n                        <option key={st.id} value={`${st.name} (${st.role})`}>\\n                          {st.name} ({st.role})\\n                        </option>\\n                      ))}\\n                    </select>\\n                  </div>\\n                  <div>\\n                    <label htmlFor=\\\"assign-printer\\\" className=\\\"block text-slate-500 mb-1\\\">Assigned Printer</label>\\n                    <select\\n                      id=\\\"assign-printer\\\"\\n                      value={activeOrder.assignedPrinterName || \'\'}\\n                      onChange={(e) =>\\n                        assignOrderResources(activeOrder.id, activeOrder.assignedStaffName || shopStaff[0]?.name || \'\', e.target.value)\\n                      }\\n                      className=\\\"w-full px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                    >\\n                      <option value=\\\"\\\">Unassigned</option>\\n                      {shopPrinters.map((pr) => (\\n                        <option key={pr.id} value={pr.name}>\\n                          {pr.name} ({pr.status})\\n                        </option>\\n                      ))}\\n                    </select>\\n                  </div>\\n                </div>\\n\\n                {/* Print Specifications */}\\n                <div className=\\\"space-y-2 text-xs\\\">\\n                  <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">Print Job Specifications</p>\\n                  {activeOrder.items.map((item) => (\\n                    <div key={item.id} className=\\\"p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-1\\\">\\n                      <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">{item.documentName}</p>\\n                      <p className=\\\"font-mono text-slate-600 dark:text-slate-300\\\">\\n                        Copies: {item.settings.copies} \302\267 {item.settings.paperSize} \302\267 {item.settings.colorMode.toUpperCase()} \302\267 {item.settings.sides} \302\267 Pages: {item.settings.pageRange} \302\267 Binding: {item.settings.binding}\\n                      </p>\\n                      {item.settings.specialInstructions && (\\n                        <p className=\\\"text-amber-700 dark:text-amber-400\\\">Note: {item.settings.specialInstructions}</p>\\n                      )}\\n                    </div>\\n                  ))}\\n                </div>\\n\\n                {/* Shop Chat with Quick Replies */}\\n                <div className=\\\"pt-3 border-t border-slate-200 dark:border-slate-800 space-y-2.5\\\">\\n                  <p className=\\\"text-xs font-semibold text-slate-900 dark:text-white flex items-center gap-1.5\\\">\\n                    <MessageSquare className=\\\"w-3.5 h-3.5 text-indigo-600\\\" />\\n                    Customer Communication\\n                  </p>\\n                  <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                    {SHOP_QUICK_REPLIES.map((qr) => (\\n                      <button\\n                        key={qr}\\n                        type=\\\"button\\\"\\n                        onClick={() => sendOrderMessage(activeOrder.id, \'shop\', qr)}\\n                        className=\\\"px-2.5 py-1 text-[11px] text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/50 hover:bg-indigo-100 rounded-md\\\"\\n                      >\\n                        {qr}\\n                      </button>\\n                    ))}\\n                  </div>\\n                  <form\\n                    onSubmit={(e) => {\\n                      e.preventDefault();\\n                      if (shopChatInput.trim()) {\\n                        sendOrderMessage(activeOrder.id, \'shop\', shopChatInput);\\n                        setShopChatInput(\'\');\\n                      }\\n                    }}\\n                    className=\\\"flex gap-2\\\"\\n                  >\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={shopChatInput}\\n                      onChange={(e) => setShopChatInput(e.target.value)}\\n                      placeholder=\\\"Reply to customer...\\\"\\n                      className=\\\"flex-1 px-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                    />\\n                    <button\\n                      type=\\\"submit\\\"\\n                      className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-white bg-indigo-700 rounded-lg\\\"\\n                    >\\n                      <Send className=\\\"w-3.5 h-3.5\\\" />\\n                      Send\\n                    </button>\\n                  </form>\\n                </div>\\n              </div>\\n            ) : (\\n              <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-10 text-center text-sm text-slate-500\\\">\\n                No incoming orders yet for this shop.\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: PRICING & PROFILE */}\\n      {activeTab === \'shop-pricing\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n          <form\\n            onSubmit={(e) => {\\n              e.preventDefault();\\n              updateShopPricing(currentShop.id, pricingDraft);\\n            }}\\n            className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4\\\"\\n          >\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Editable Price Matrix ({pricingDraft.currency})</h3>\\n            <div className=\\\"grid grid-cols-2 gap-3 text-xs\\\">\\n              <div>\\n                <label htmlFor=\\\"rate-bw\\\" className=\\\"block text-slate-500 mb-1\\\">A4 B&W per page</label>\\n                <input\\n                  id=\\\"rate-bw\\\"\\n                  type=\\\"number\\\"\\n                  step=\\\"0.5\\\"\\n                  value={pricingDraft.bwPerPageA4}\\n                  onChange={(e) => setPricingDraft((p) => ({ ...p, bwPerPageA4: Number(e.target.value) || 0 }))}\\n                  className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"rate-color\\\" className=\\\"block text-slate-500 mb-1\\\">A4 Color per page</label>\\n                <input\\n                  id=\\\"rate-color\\\"\\n                  type=\\\"number\\\"\\n                  step=\\\"0.5\\\"\\n                  value={pricingDraft.colorPerPageA4}\\n                  onChange={(e) => setPricingDraft((p) => ({ ...p, colorPerPageA4: Number(e.target.value) || 0 }))}\\n                  className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"rate-spiral\\\" className=\\\"block text-slate-500 mb-1\\\">Spiral Binding</label>\\n                <input\\n                  id=\\\"rate-spiral\\\"\\n                  type=\\\"number\\\"\\n                  value={pricingDraft.bindingPrices.spiral}\\n                  onChange={(e) =>\\n                    setPricingDraft((p) => ({\\n                      ...p,\\n                      bindingPrices: { ...p.bindingPrices, spiral: Number(e.target.value) || 0 },\\n                    }))\\n                  }\\n                  className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"rate-lam\\\" className=\\\"block text-slate-500 mb-1\\\">Lamination</label>\\n                <input\\n                  id=\\\"rate-lam\\\"\\n                  type=\\\"number\\\"\\n                  value={pricingDraft.bindingPrices.lamination}\\n                  onChange={(e) =>\\n                    setPricingDraft((p) => ({\\n                      ...p,\\n                      bindingPrices: { ...p.bindingPrices, lamination: Number(e.target.value) || 0 },\\n                    }))\\n                  }\\n                  className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"rate-delivery\\\" className=\\\"block text-slate-500 mb-1\\\">Delivery Fee</label>\\n                <input\\n                  id=\\\"rate-delivery\\\"\\n                  type=\\\"number\\\"\\n                  value={pricingDraft.deliveryFee}\\n                  onChange={(e) => setPricingDraft((p) => ({ ...p, deliveryFee: Number(e.target.value) || 0 }))}\\n                  className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"rate-tax\\\" className=\\\"block text-slate-500 mb-1\\\">Tax Rate (%)</label>\\n                <input\\n                  id=\\\"rate-tax\\\"\\n                  type=\\\"number\\\"\\n                  value={pricingDraft.taxRatePercent}\\n                  onChange={(e) => setPricingDraft((p) => ({ ...p, taxRatePercent: Number(e.target.value) || 0 }))}\\n                  className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n            </div>\\n            <button type=\\\"submit\\\" className=\\\"px-4 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\">\\n              Publish Updated Prices\\n            </button>\\n          </form>\\n\\n          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Operating Status & Capabilities</h3>\\n            <div className=\\\"space-y-3 text-xs\\\">\\n              <label className=\\\"flex items-center justify-between py-2 border-b border-slate-100 dark:border-slate-800 cursor-pointer\\\">\\n                <span>Accepting Orders (Shop Open)</span>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={currentShop.isOpen}\\n                  onChange={(e) => updateShopProfile(currentShop.id, { isOpen: e.target.checked })}\\n                  className=\\\"accent-indigo-700 w-4 h-4\\\"\\n                />\\n              </label>\\n              <label className=\\\"flex items-center justify-between py-2 border-b border-slate-100 dark:border-slate-800 cursor-pointer\\\">\\n                <span>Offer Shop Pickup</span>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={currentShop.pickupAvailable}\\n                  onChange={(e) => updateShopProfile(currentShop.id, { pickupAvailable: e.target.checked })}\\n                  className=\\\"accent-indigo-700 w-4 h-4\\\"\\n                />\\n              </label>\\n              <label className=\\\"flex items-center justify-between py-2 border-b border-slate-100 dark:border-slate-800 cursor-pointer\\\">\\n                <span>Offer Local Delivery</span>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={currentShop.deliveryAvailable}\\n                  onChange={(e) => updateShopProfile(currentShop.id, { deliveryAvailable: e.target.checked })}\\n                  className=\\\"accent-indigo-700 w-4 h-4\\\"\\n                />\\n              </label>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 4: INVENTORY & PRINTERS */}\\n      {activeTab === \'shop-inventory\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <div className=\\\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Paper, Ink, Toner & Binding Inventory</h3>\\n            <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n              {shopInventory.map((item) => {\\n                const low = item.quantity <= item.reorderLevel;\\n                return (\\n                  <div key={item.id} className=\\\"py-3 flex items-center justify-between gap-3\\\">\\n                    <div>\\n                      <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">{item.name}</p>\\n                      <p className=\\\"text-slate-500\\\">\\n                        {item.category} \302\267 Supplier: {item.supplier || \'Direct\'} \302\267{\' \'}\\n                        <span className={low ? \'text-amber-700 dark:text-amber-400 font-semibold\' : \'text-emerald-700 dark:text-emerald-400\'}>\\n                          {low ? \'Low Stock\' : \'In Stock\'}\\n                        </span>\\n                      </p>\\n                    </div>\\n                    <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => updateInventoryStock(item.id, -1)}\\n                        aria-label={`Use 1 ${item.name}`}\\n                        className=\\\"px-2 py-1 border border-slate-200 dark:border-slate-700 rounded\\\"\\n                      >\\n                        -1\\n                      </button>\\n                      <span className=\\\"font-mono tabular-nums font-semibold w-16 text-center\\\">\\n                        {item.quantity} {item.unit}\\n                      </span>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => updateInventoryStock(item.id, 5)}\\n                        aria-label={`Restock 5 ${item.name}`}\\n                        className=\\\"px-2 py-1 text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/60 rounded\\\"\\n                      >\\n                        +5\\n                      </button>\\n                    </div>\\n                  </div>\\n                );\\n              })}\\n            </div>\\n\\n            <form\\n              onSubmit={(e) => {\\n                e.preventDefault();\\n                if (!newSupply.name.trim()) return;\\n                addInventoryItem({ ...newSupply, shopId: currentShop.id });\\n                setNewSupply({ name: \'\', category: \'paper\', quantity: 10, unit: \'reams\', reorderLevel: 5, supplier: \'\' });\\n              }}\\n              className=\\\"pt-4 border-t border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-4 gap-2 text-xs\\\"\\n            >\\n              <input\\n                type=\\\"text\\\"\\n                placeholder=\\\"New supply item...\\\"\\n                value={newSupply.name}\\n                onChange={(e) => setNewSupply((s) => ({ ...s, name: e.target.value }))}\\n                className=\\\"sm:col-span-2 px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <input\\n                type=\\\"number\\\"\\n                value={newSupply.quantity}\\n                onChange={(e) => setNewSupply((s) => ({ ...s, quantity: Number(e.target.value) || 0 }))}\\n                aria-label=\\\"Initial stock quantity\\\"\\n                className=\\\"px-2.5 py-1.5 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <button type=\\\"submit\\\" className=\\\"inline-flex items-center justify-center gap-1 px-3 py-1.5 font-medium text-white bg-indigo-700 rounded-md\\\">\\n                <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                Add Supply\\n              </button>\\n            </form>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n              <Printer className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              Printers & Equipment\\n            </h3>\\n            <div className=\\\"space-y-3 text-xs\\\">\\n              {shopPrinters.map((pr) => (\\n                <div key={pr.id} className=\\\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-2\\\">\\n                  <div className=\\\"flex justify-between items-start gap-2\\\">\\n                    <div>\\n                      <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">{pr.name}</p>\\n                      <p className=\\\"text-slate-500\\\">\\n                        {pr.colorSupport ? \'Color\' : \'Mono\'} \302\267 {pr.duplexSupport ? \'Duplex\' : \'Simplex\'} \302\267 Sizes: {pr.supportedSizes.join(\', \')}\\n                      </p>\\n                    </div>\\n                    <select\\n                      aria-label={`Status for ${pr.name}`}\\n                      value={pr.status}\\n                      onChange={(e) => updatePrinterStatus(pr.id, e.target.value as ShopPrinter[\'status\'])}\\n                      className=\\\"px-2 py-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded text-xs\\\"\\n                    >\\n                      <option value=\\\"online\\\">Online</option>\\n                      <option value=\\\"busy\\\">Busy</option>\\n                      <option value=\\\"maintenance\\\">Maintenance</option>\\n                      <option value=\\\"offline\\\">Offline</option>\\n                    </select>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n\\n            <form\\n              onSubmit={(e) => {\\n                e.preventDefault();\\n                if (!newPrinterName.trim()) return;\\n                addShopPrinter({\\n                  shopId: currentShop.id,\\n                  name: newPrinterName.trim(),\\n                  type: newPrinterType,\\n                  supportedSizes: [\'A4\', \'A3\'],\\n                  colorSupport: newPrinterType !== \'laser_mono\',\\n                  duplexSupport: true,\\n                  status: \'online\',\\n                });\\n                setNewPrinterName(\'\');\\n              }}\\n              className=\\\"pt-3 border-t border-slate-200 dark:border-slate-800 space-y-2 text-xs\\\"\\n            >\\n              <input\\n                type=\\\"text\\\"\\n                value={newPrinterName}\\n                onChange={(e) => setNewPrinterName(e.target.value)}\\n                placeholder=\\\"Register printer model (e.g. Ricoh MP C3004)\\\"\\n                className=\\\"w-full px-3 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <div className=\\\"flex gap-2\\\">\\n                <select\\n                  value={newPrinterType}\\n                  onChange={(e) => setNewPrinterType(e.target.value as ShopPrinter[\'type\'])}\\n                  className=\\\"flex-1 px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                >\\n                  <option value=\\\"laser_color\\\">Color Laser</option>\\n                  <option value=\\\"laser_mono\\\">Mono Laser</option>\\n                  <option value=\\\"inkjet_photo\\\">Photo Inkjet</option>\\n                  <option value=\\\"wide_format\\\">Wide Format Plotter</option>\\n                </select>\\n                <button type=\\\"submit\\\" className=\\\"px-3.5 py-1.5 font-medium text-white bg-indigo-700 rounded-md\\\">\\n                  Add Printer\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 5: STAFF, CUSTOMERS & REVIEWS */}\\n      {activeTab === \'shop-team\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n          <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2\\\">\\n              <UserPlus className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              Shop Staff & Roles\\n            </h3>\\n            <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n              {shopStaff.map((m) => (\\n                <div key={m.id} className=\\\"py-2.5 flex justify-between items-center\\\">\\n                  <div>\\n                    <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">{m.name}</p>\\n                    <p className=\\\"text-slate-500\\\">{m.email} \302\267 {m.role} \302\267 {m.status}</p>\\n                  </div>\\n                  <span className=\\\"font-mono text-slate-500\\\">{m.ordersHandled} jobs</span>\\n                </div>\\n              ))}\\n            </div>\\n            <form\\n              onSubmit={(e) => {\\n                e.preventDefault();\\n                if (staffName.trim() && staffEmail.trim()) {\\n                  inviteStaffMember(currentShop.id, staffName, staffEmail, staffRole);\\n                  setStaffName(\'\');\\n                  setStaffEmail(\'\');\\n                }\\n              }}\\n              className=\\\"pt-3 border-t border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs\\\"\\n            >\\n              <input\\n                type=\\\"text\\\"\\n                placeholder=\\\"Staff name\\\"\\n                value={staffName}\\n                onChange={(e) => setStaffName(e.target.value)}\\n                className=\\\"px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <input\\n                type=\\\"email\\\"\\n                placeholder=\\\"Email\\\"\\n                value={staffEmail}\\n                onChange={(e) => setStaffEmail(e.target.value)}\\n                className=\\\"px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <div className=\\\"flex gap-1\\\">\\n                <select\\n                  value={staffRole}\\n                  onChange={(e) => setStaffRole(e.target.value as ShopStaffMember[\'role\'])}\\n                  className=\\\"flex-1 px-2 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                >\\n                  <option value=\\\"Manager\\\">Manager</option>\\n                  <option value=\\\"Operator\\\">Operator</option>\\n                  <option value=\\\"Cashier\\\">Cashier</option>\\n                  <option value=\\\"Delivery\\\">Delivery</option>\\n                </select>\\n                <button type=\\\"submit\\\" className=\\\"px-3 py-1.5 font-medium text-white bg-indigo-700 rounded-md\\\">\\n                  Invite\\n                </button>\\n              </div>\\n            </form>\\n          </section>\\n\\n          <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Customer Reviews & Responses</h3>\\n            {shopReviews.length === 0 ? (\\n              <p className=\\\"text-xs text-slate-500\\\">No reviews submitted yet.</p>\\n            ) : (\\n              shopReviews.map((rev) => (\\n                <div key={rev.id} className=\\\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-2 text-xs\\\">\\n                  <div className=\\\"flex justify-between\\\">\\n                    <span className=\\\"font-semibold text-slate-900 dark:text-white\\\">{rev.customerName}</span>\\n                    <span className=\\\"font-mono text-amber-600\\\">{rev.rating} \342\230\205</span>\\n                  </div>\\n                  <p className=\\\"text-slate-600 dark:text-slate-300\\\">{rev.comment}</p>\\n                  {rev.shopResponse ? (\\n                    <p className=\\\"text-indigo-700 dark:text-indigo-300\\\">Your reply: {rev.shopResponse}</p>\\n                  ) : (\\n                    <div className=\\\"flex gap-2\\\">\\n                      <input\\n                        type=\\\"text\\\"\\n                        value={replyDrafts[rev.id] || \'\'}\\n                        onChange={(e) => setReplyDrafts((d) => ({ ...d, [rev.id]: e.target.value }))}\\n                        placeholder=\\\"Write shop response...\\\"\\n                        className=\\\"flex-1 px-2.5 py-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded\\\"\\n                      />\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => {\\n                          if (replyDrafts[rev.id]?.trim()) {\\n                            replyToReview(rev.id, replyDrafts[rev.id]);\\n                          }\\n                        }}\\n                        className=\\\"px-3 py-1 font-medium text-white bg-indigo-700 rounded\\\"\\n                      >\\n                        Reply\\n                      </button>\\n                    </div>\\n                  )}\\n                </div>\\n              ))\\n            )}\\n          </section>\\n        </div>\\n      )}\\n\\n      {/* TAB 6: REGISTER NEW SHOP (ONBOARDING) */}\\n      {activeTab === \'shop-onboarding\' && (\\n        <form\\n          onSubmit={(e) => {\\n            e.preventDefault();\\n            if (!onboardForm.name.trim() || !onboardForm.address.trim()) return;\\n            registerNewShop({\\n              name: onboardForm.name,\\n              ownerName: onboardForm.ownerName || \'Shop Owner\',\\n              address: onboardForm.address,\\n              city: onboardForm.city,\\n              phone: onboardForm.phone,\\n              whatsapp: onboardForm.whatsapp,\\n              email: onboardForm.email,\\n              openingHours: onboardForm.openingHours,\\n              pickupAvailable: onboardForm.pickupAvailable,\\n              deliveryAvailable: onboardForm.deliveryAvailable,\\n              services: onboardForm.servicesText.split(\',\').map((s) => s.trim()).filter(Boolean),\\n            });\\n            setOnboardForm((f) => ({ ...f, name: \'\', address: \'\', phone: \'\', whatsapp: \'\', email: \'\' }));\\n          }}\\n          className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 max-w-2xl space-y-4\\\"\\n        >\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Building2 className=\\\"w-5 h-5 text-indigo-700\\\" />\\n            <div>\\n              <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">Register a Printing Business</h3>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                New registrations start as Pending Verification until reviewed in the Admin Console.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\\\">\\n            <input\\n              type=\\\"text\\\"\\n              required\\n              value={onboardForm.name}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, name: e.target.value }))}\\n              placeholder=\\\"Business Name *\\\"\\n              className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <input\\n              type=\\\"text\\\"\\n              required\\n              value={onboardForm.ownerName}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, ownerName: e.target.value }))}\\n              placeholder=\\\"Owner Full Name *\\\"\\n              className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <input\\n              type=\\\"text\\\"\\n              required\\n              value={onboardForm.address}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, address: e.target.value }))}\\n              placeholder=\\\"Shop Street Address *\\\"\\n              className=\\\"sm:col-span-2 px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <input\\n              type=\\\"text\\\"\\n              value={onboardForm.city}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, city: e.target.value }))}\\n              placeholder=\\\"City\\\"\\n              className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <input\\n              type=\\\"text\\\"\\n              value={onboardForm.phone}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, phone: e.target.value, whatsapp: e.target.value }))}\\n              placeholder=\\\"Phone / WhatsApp\\\"\\n              className=\\\"px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <input\\n              type=\\\"email\\\"\\n              value={onboardForm.email}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, email: e.target.value }))}\\n              placeholder=\\\"Business Email\\\"\\n              className=\\\"sm:col-span-2 px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n            <input\\n              type=\\\"text\\\"\\n              value={onboardForm.servicesText}\\n              onChange={(e) => setOnboardForm((f) => ({ ...f, servicesText: e.target.value }))}\\n              placeholder=\\\"Services (comma separated)\\\"\\n              className=\\\"sm:col-span-2 px-3 py-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n            />\\n          </div>\\n\\n          <button type=\\\"submit\\\" className=\\\"px-5 py-2.5 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\">\\n            Submit Shop for Verification\\n          </button>\\n        </form>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build complete ShopPortalView with real business KPIs, Recharts analytics, print queue, price confirmation, pricing editor, inventory, printers, staff, reviews, and shop onboarding\", \"Overwrite\":true, \"TargetFile\":\"/src/components/shop/ShopPortalView.tsx\", \"toolAction\":\"Creating ShopPortalView component\", \"toolSummary\":\"Create ShopPortalView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12363497356658227936"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Bar,\\n  BarChart,\\n  CartesianGrid,\\n  ResponsiveContainer,\\n  Tooltip,\\n  XAxis,\\n  YAxis,\\n} from \'recharts\';\\nimport { CheckCircle2, ShieldAlert, ShieldCheck, Trash2, XCircle } from \'lucide-react\';\\nimport { usePrintReady } from \'../../context/PrintReadyContext\';\\nimport { STATUS_LABELS } from \'../../domain/orderStateMachine\';\\nimport { formatCurrency } from \'../../domain/printCalculator\';\\nimport { formatFileSize } from \'../../domain/fileValidation\';\\n\\nexport function AdminPortalView() {\\n  const {\\n    activeTab,\\n    shops,\\n    orders,\\n    documents,\\n    reviews,\\n    coupons,\\n    supportTickets,\\n    auditLogs,\\n    platformSettings,\\n    verifyShopAsAdmin,\\n    transitionOrderStatus,\\n    createCoupon,\\n    toggleCouponActive,\\n    moderateReview,\\n    updateTicketStatus,\\n    updatePlatformSettings,\\n  } = usePrintReady();\\n\\n  const [couponCode, setCouponCode] = useState(\'\');\\n  const [couponDesc, setCouponDesc] = useState(\'\');\\n  const [couponVal, setCouponVal] = useState(15);\\n  const [couponType, setCouponType] = useState<\'percent\' | \'flat\'>(\'percent\');\\n  const [settingsDraft, setSettingsDraft] = useState(platformSettings);\\n\\n  const stats = useMemo(() => {\\n    const verifiedShops = shops.filter((s) => s.verificationStatus === \'verified\').length;\\n    const pendingShops = shops.filter((s) => s.verificationStatus === \'pending\').length;\\n    const totalVolume = orders\\n      .filter((o) => o.paymentStatus === \'verified\')\\n      .reduce((sum, o) => sum + (o.confirmedTotal ?? o.estimatedTotal), 0);\\n    const completedOrders = orders.filter((o) => o.status === \'completed\').length;\\n    const refundRequests = orders.filter((o) => o.status === \'refund_requested\').length;\\n    const storageBytes = documents.reduce((sum, d) => sum + d.sizeBytes, 0);\\n    return { verifiedShops, pendingShops, totalVolume, completedOrders, refundRequests, storageBytes };\\n  }, [documents, orders, shops]);\\n\\n  const statusChart = useMemo(() => {\\n    const counts = new Map<string, number>();\\n    orders.forEach((o) => {\\n      const label = STATUS_LABELS[o.status];\\n      counts.set(label, (counts.get(label) || 0) + 1);\\n    });\\n    return Array.from(counts.entries()).map(([status, count]) => ({ status, count }));\\n  }, [orders]);\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"pb-4 border-b border-slate-200 dark:border-slate-800\\\">\\n        <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n          Privileged Administration \302\267 Role-Protected Governance & Audit Trail\\n        </p>\\n        <h2 className=\\\"text-xl font-bold text-slate-900 dark:text-white\\\">PrintReady Platform Control</h2>\\n      </div>\\n\\n      {/* TAB 1: PLATFORM OVERVIEW */}\\n      {activeTab === \'admin-overview\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n            {[\\n              { label: \'Verified / Total Shops\', value: `${stats.verifiedShops} / ${shops.length}`, sub: `${stats.pendingShops} awaiting verification` },\\n              { label: \'Verified Payment Volume\', value: formatCurrency(stats.totalVolume), sub: `${orders.length} total orders` },\\n              { label: \'Open Support & Refunds\', value: `${supportTickets.filter((t) => t.status !== \'resolved\').length + stats.refundRequests}`, sub: `${stats.refundRequests} refund requests` },\\n              { label: \'Vault Storage Indexed\', value: formatFileSize(stats.storageBytes), sub: `${documents.length} stored files` },\\n            ].map((kpi) => (\\n              <div key={kpi.label} className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5\\\">\\n                <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">{kpi.label}</p>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-slate-900 dark:text-white mt-1\\\">{kpi.value}</p>\\n                <p className=\\\"text-xs text-slate-500 mt-1\\\">{kpi.sub}</p>\\n              </div>\\n            ))}\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n            <div className=\\\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\">\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Orders by Lifecycle Stage</h3>\\n              <div className=\\\"h-64 w-full\\\">\\n                <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                  <BarChart data={statusChart}>\\n                    <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#e2e8f0\\\" />\\n                    <XAxis dataKey=\\\"status\\\" tick={{ fontSize: 11 }} />\\n                    <YAxis allowDecimals={false} tick={{ fontSize: 12 }} />\\n                    <Tooltip />\\n                    <Bar dataKey=\\\"count\\\" fill=\\\"#4338CA\\\" radius={[6, 6, 0, 0]} />\\n                  </BarChart>\\n                </ResponsiveContainer>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\">\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Recent Audit Trail</h3>\\n              <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n                {auditLogs.slice(0, 6).map((log) => (\\n                  <div key={log.id} className=\\\"py-2.5\\\">\\n                    <p className=\\\"font-mono font-semibold text-slate-900 dark:text-white\\\">{log.action}</p>\\n                    <p className=\\\"text-slate-600 dark:text-slate-400 mt-0.5\\\">{log.details}</p>\\n                    <p className=\\\"text-[11px] text-slate-400 mt-0.5\\\">\\n                      {log.actorEmail} \302\267 {new Date(log.createdAt).toLocaleString()}\\n                    </p>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: SHOP VERIFICATION QUEUE */}\\n      {activeTab === \'admin-shops\' && (\\n        <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\\\">\\n          <div className=\\\"px-5 py-4 border-b border-slate-200 dark:border-slate-800\\\">\\n            <h3 className=\\\"text-base font-semibold text-slate-900 dark:text-white\\\">\\n              Registered Print Shops & Verification Governance\\n            </h3>\\n          </div>\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left border-collapse text-xs\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-slate-200 dark:border-slate-800 text-slate-500\\\">\\n                  <th className=\\\"py-3 px-4 font-medium\\\">Shop & Owner</th>\\n                  <th className=\\\"py-3 px-3 font-medium\\\">City / Address</th>\\n                  <th className=\\\"py-3 px-3 font-medium\\\">Status</th>\\n                  <th className=\\\"py-3 px-4 font-medium text-right\\\">Governance Actions</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-slate-100 dark:divide-slate-800\\\">\\n                {shops.map((shop) => (\\n                  <tr key={shop.id}>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">{shop.name}</p>\\n                      <p className=\\\"text-slate-500\\\">{shop.ownerName} \302\267 {shop.email}</p>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-3 text-slate-600 dark:text-slate-300\\\">\\n                      {shop.city} \302\267 {shop.address}\\n                    </td>\\n                    <td className=\\\"py-3.5 px-3 font-semibold capitalize\\\">\\n                      <span\\n                        className={\\n                          shop.verificationStatus === \'verified\'\\n                            ? \'text-emerald-700 dark:text-emerald-400\'\\n                            : shop.verificationStatus === \'pending\'\\n                            ? \'text-amber-700 dark:text-amber-400\'\\n                            : \'text-red-600\'\\n                        }\\n                      >\\n                        {shop.verificationStatus}\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-right space-x-2 whitespace-nowrap\\\">\\n                      {shop.verificationStatus !== \'verified\' && (\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            verifyShopAsAdmin(shop.id, \'verified\', \'Verified business credentials and activated marketplace listing.\')\\n                          }\\n                          className=\\\"inline-flex items-center gap-1 px-3 py-1.5 font-medium text-white bg-emerald-700 hover:bg-emerald-800 rounded-md\\\"\\n                        >\\n                          <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                          Approve\\n                        </button>\\n                      )}\\n                      {shop.verificationStatus !== \'suspended\' && (\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            verifyShopAsAdmin(shop.id, \'suspended\', \'Suspended shop pending compliance review.\')\\n                          }\\n                          className=\\\"inline-flex items-center gap-1 px-3 py-1.5 font-medium text-red-600 border border-red-200 dark:border-red-900 rounded-md\\\"\\n                        >\\n                          <XCircle className=\\\"w-3.5 h-3.5\\\" />\\n                          Suspend\\n                        </button>\\n                      )}\\n                    </td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: ORDERS, REFUNDS & SUPPORT */}\\n      {activeTab === \'admin-orders\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <div className=\\\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\\\">\\n            <div className=\\\"px-5 py-4 border-b border-slate-200 dark:border-slate-800\\\">\\n              <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Platform Orders & Refund Controls</h3>\\n            </div>\\n            <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n              {orders.map((ord) => (\\n                <div key={ord.id} className=\\\"p-4 flex items-center justify-between gap-3\\\">\\n                  <div>\\n                    <p className=\\\"font-mono font-bold text-slate-900 dark:text-white\\\">\\n                      {ord.orderNumber} \302\267 {formatCurrency(ord.confirmedTotal ?? ord.estimatedTotal, ord.currency)}\\n                    </p>\\n                    <p className=\\\"text-slate-500\\\">\\n                      {ord.customerName} \342\206\222 {ord.shopName} \302\267 {STATUS_LABELS[ord.status]} ({ord.paymentStatus})\\n                    </p>\\n                  </div>\\n                  {ord.status === \'refund_requested\' && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        transitionOrderStatus(ord.id, \'refunded\', \'admin\', {\\n                          note: \'Admin approved and issued refund reconciliation.\',\\n                        })\\n                      }\\n                      className=\\\"px-3 py-1.5 font-medium text-white bg-indigo-700 rounded-md whitespace-nowrap\\\"\\n                    >\\n                      Approve Refund\\n                    </button>\\n                  )}\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5\\\">\\n              <ShieldAlert className=\\\"w-4 h-4 text-amber-600\\\" />\\n              Support Tickets & Disputes\\n            </h3>\\n            <div className=\\\"space-y-3 text-xs\\\">\\n              {supportTickets.map((t) => (\\n                <div key={t.id} className=\\\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg space-y-2\\\">\\n                  <div className=\\\"flex justify-between items-start gap-2\\\">\\n                    <div>\\n                      <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">{t.subject}</p>\\n                      <p className=\\\"text-slate-500\\\">\\n                        {t.userName} \302\267 {t.category.replace(\'_\', \' \')} {t.orderNumber ? `\302\267 ${t.orderNumber}` : \'\'}\\n                      </p>\\n                    </div>\\n                    <select\\n                      aria-label={`Status for ticket ${t.id}`}\\n                      value={t.status}\\n                      onChange={(e) => updateTicketStatus(t.id, e.target.value as \'open\' | \'investigating\' | \'resolved\')}\\n                      className=\\\"px-2 py-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded\\\"\\n                    >\\n                      <option value=\\\"open\\\">Open</option>\\n                      <option value=\\\"investigating\\\">Investigating</option>\\n                      <option value=\\\"resolved\\\">Resolved</option>\\n                    </select>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 4: COUPONS & REVIEW MODERATION */}\\n      {activeTab === \'admin-promos\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n          <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-4\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Configurable Coupons & Promotions</h3>\\n            <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\\\">\\n              {coupons.map((c) => (\\n                <div key={c.code} className=\\\"py-2.5 flex items-center justify-between gap-2\\\">\\n                  <div>\\n                    <p className=\\\"font-mono font-bold text-slate-900 dark:text-white\\\">{c.code}</p>\\n                    <p className=\\\"text-slate-500\\\">{c.description}</p>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => toggleCouponActive(c.code)}\\n                    className={`px-2.5 py-1 rounded font-medium ${\\n                      c.active\\n                        ? \'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40\'\\n                        : \'text-slate-500 bg-slate-100 dark:bg-slate-800\'\\n                    }`}\\n                  >\\n                    {c.active ? \'Active\' : \'Paused\'}\\n                  </button>\\n                </div>\\n              ))}\\n            </div>\\n\\n            <form\\n              onSubmit={(e) => {\\n                e.preventDefault();\\n                if (!couponCode.trim()) return;\\n                createCoupon({\\n                  code: couponCode.trim().toUpperCase(),\\n                  description: couponDesc.trim() || `${couponVal}${couponType === \'percent\' ? \'%\' : \' INR\'} promotional discount`,\\n                  discountType: couponType,\\n                  value: couponVal,\\n                  minOrderAmount: 50,\\n                  active: true,\\n                  expiresAt: \'2027-12-31T23:59:59Z\',\\n                });\\n                setCouponCode(\'\');\\n                setCouponDesc(\'\');\\n              }}\\n              className=\\\"pt-3 border-t border-slate-200 dark:border-slate-800 grid grid-cols-2 gap-2 text-xs\\\"\\n            >\\n              <input\\n                type=\\\"text\\\"\\n                placeholder=\\\"Code (e.g. EXAM20)\\\"\\n                value={couponCode}\\n                onChange={(e) => setCouponCode(e.target.value)}\\n                className=\\\"px-2.5 py-1.5 font-mono uppercase bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <div className=\\\"flex gap-1\\\">\\n                <input\\n                  type=\\\"number\\\"\\n                  value={couponVal}\\n                  onChange={(e) => setCouponVal(Number(e.target.value) || 0)}\\n                  className=\\\"w-16 px-2 py-1.5 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                />\\n                <select\\n                  value={couponType}\\n                  onChange={(e) => setCouponType(e.target.value as \'percent\' | \'flat\')}\\n                  className=\\\"flex-1 px-2 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n                >\\n                  <option value=\\\"percent\\\">% Off</option>\\n                  <option value=\\\"flat\\\">Flat INR</option>\\n                </select>\\n              </div>\\n              <input\\n                type=\\\"text\\\"\\n                placeholder=\\\"Promotion description\\\"\\n                value={couponDesc}\\n                onChange={(e) => setCouponDesc(e.target.value)}\\n                className=\\\"col-span-2 px-2.5 py-1.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md\\\"\\n              />\\n              <button type=\\\"submit\\\" className=\\\"col-span-2 py-2 font-medium text-white bg-indigo-700 rounded-md\\\">\\n                Create Promotion Coupon\\n              </button>\\n            </form>\\n          </section>\\n\\n          <section className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 space-y-3\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Review Moderation</h3>\\n            <div className=\\\"space-y-3 text-xs\\\">\\n              {reviews.map((r) => (\\n                <div key={r.id} className=\\\"p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg flex items-start justify-between gap-3\\\">\\n                  <div>\\n                    <p className=\\\"font-semibold text-slate-900 dark:text-white\\\">\\n                      {r.customerName} \302\267 {r.rating} \342\230\205\\n                    </p>\\n                    <p className=\\\"text-slate-600 dark:text-slate-300 mt-0.5\\\">{r.comment}</p>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => moderateReview(r.id, \'remove\')}\\n                    aria-label={`Remove review by ${r.customerName}`}\\n                    className=\\\"p-1.5 text-slate-400 hover:text-red-600 shrink-0\\\"\\n                  >\\n                    <Trash2 className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n        </div>\\n      )}\\n\\n      {/* TAB 5: PLATFORM SETTINGS & AUDIT LOGS */}\\n      {activeTab === \'admin-settings\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <form\\n            onSubmit={(e) => {\\n              e.preventDefault();\\n              updatePlatformSettings(settingsDraft);\\n            }}\\n            className=\\\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-4 text-xs\\\"\\n          >\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5\\\">\\n              <ShieldCheck className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              Retention & Platform Policies\\n            </h3>\\n            <div>\\n              <label htmlFor=\\\"set-order-ret\\\" className=\\\"block text-slate-500 mb-1\\\">\\n                Order File Shop Access Retention (Days)\\n              </label>\\n              <input\\n                id=\\\"set-order-ret\\\"\\n                type=\\\"number\\\"\\n                min={1}\\n                max={30}\\n                value={settingsDraft.orderFileRetentionDays}\\n                onChange={(e) =>\\n                  setSettingsDraft((s) => ({ ...s, orderFileRetentionDays: Number(e.target.value) || 7 }))\\n                }\\n                className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"set-trash-ret\\\" className=\\\"block text-slate-500 mb-1\\\">\\n                Vault Trash Auto-Cleanup Retention (Days)\\n              </label>\\n              <input\\n                id=\\\"set-trash-ret\\\"\\n                type=\\\"number\\\"\\n                min={7}\\n                max={90}\\n                value={settingsDraft.trashRetentionDays}\\n                onChange={(e) =>\\n                  setSettingsDraft((s) => ({ ...s, trashRetentionDays: Number(e.target.value) || 30 }))\\n                }\\n                className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"set-comm\\\" className=\\\"block text-slate-500 mb-1\\\">\\n                Marketplace Commission (%)\\n              </label>\\n              <input\\n                id=\\\"set-comm\\\"\\n                type=\\\"number\\\"\\n                min={0}\\n                max={25}\\n                value={settingsDraft.commissionPercent}\\n                onChange={(e) =>\\n                  setSettingsDraft((s) => ({ ...s, commissionPercent: Number(e.target.value) || 0 }))\\n                }\\n                className=\\\"w-full px-3 py-2 font-mono bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n            <button type=\\\"submit\\\" className=\\\"px-4 py-2 font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\">\\n              Save Policy Configuration\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-3\\\">\\n            <h3 className=\\\"text-sm font-semibold text-slate-900 dark:text-white\\\">Immutable Privileged Audit Logs</h3>\\n            <div className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-xs max-h-96 overflow-y-auto\\\">\\n              {auditLogs.map((log) => (\\n                <div key={log.id} className=\\\"py-3\\\">\\n                  <div className=\\\"flex justify-between gap-2\\\">\\n                    <span className=\\\"font-mono font-semibold text-slate-900 dark:text-white\\\">{log.action}</span>\\n                    <span className=\\\"font-mono text-[11px] text-slate-400\\\">\\n                      {new Date(log.createdAt).toLocaleString()}\\n                    </span>\\n                  </div>\\n                  <p className=\\\"text-slate-600 dark:text-slate-300 mt-0.5\\\">{log.details}</p>\\n                  <p className=\\\"text-[11px] text-slate-400\\\">\\n                    Actor: {log.actorEmail} \302\267 Target: {log.targetType}/{log.targetId}\\n                  </p>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build AdminPortalView with platform KPIs, shop verification governance, orders & refunds, support tickets, coupons, review moderation, policies, and audit logs\", \"Overwrite\":true, \"TargetFile\":\"/src/components/admin/AdminPortalView.tsx\", \"toolAction\":\"Creating AdminPortalView component\", \"toolSummary\":\"Create AdminPortalView.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 192
      nanos: 720781206
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "9sP-arfjPLOokdUPnNuQ8Qg"
  }
}
