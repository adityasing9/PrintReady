dAt: \'2026-11-10\',\\n  },\\n  {\\n    id: \'inv-5\',\\n    shopId: \'shop-campus-press\',\\n    name: \'A4 Thermal Lamination Pouches (125 mic)\',\\n    category: \'lamination\',\\n    quantity: 18,\\n    unit: \'packs\',\\n    reorderLevel: 10,\\n    supplier: \'BindPro India\',\\n    lastRestockedAt: \'2026-11-11\',\\n  },\\n];\\n\\nexport const INITIAL_PRINTERS: ShopPrinter[] = [\\n  {\\n    id: \'prn-1\',\\n    shopId: \'shop-campus-press\',\\n    name: \'Konica Minolta Bizhub C360i\',\\n    type: \'laser_color\',\\n    supportedSizes: [\'A4\', \'A3\', \'A5\', \'Letter\', \'Legal\'],\\n    colorSupport: true,\\n    duplexSupport: true,\\n    status: \'online\',\\n    assignedJobsCount: 2,\\n    lastMaintenanceDate: \'2026-11-05\',\\n  },\\n  {\\n    id: \'prn-2\',\\n    shopId: \'shop-campus-press\',\\n    name: \'Canon imageRUNNER 2630i Mono\',\\n    type: \'laser_mono\',\\n    supportedSizes: [\'A4\', \'A3\', \'Legal\'],\\n    colorSupport: false,\\n    duplexSupport: true,\\n    status: \'busy\',\\n    assignedJobsCount: 4,\\n    lastMaintenanceDate: \'2026-10-29\',\\n  },\\n  {\\n    id: \'prn-3\',\\n    shopId: \'shop-campus-press\',\\n    name: \'Epson SureColor P700 Photo\',\\n    type: \'inkjet_photo\',\\n    supportedSizes: [\'A4\', \'A3\', \'A5\', \'Custom\'],\\n    colorSupport: true,\\n    duplexSupport: false,\\n    status: \'maintenance\',\\n    assignedJobsCount: 0,\\n    lastMaintenanceDate: \'2026-11-18\',\\n  },\\n];\\n\\nexport const INITIAL_STAFF: ShopStaffMember[] = [\\n  {\\n    id: \'stf-1\',\\n    shopId: \'shop-campus-press\',\\n    name: \'Rohan Kulkarni\',\\n    email: \'rohan@campuspress.in\',\\n    role: \'Owner\',\\n    status: \'active\',\\n    ordersHandled: 312,\\n  },\\n  {\\n    id: \'stf-2\',\\n    shopId: \'shop-campus-press\',\\n    name: \'Deepak Sharma\',\\n    email: \'deepak@campuspress.in\',\\n    role: \'Operator\',\\n    status: \'active\',\\n    ordersHandled: 194,\\n  },\\n  {\\n    id: \'stf-3\',\\n    shopId: \'shop-campus-press\',\\n    name: \'Neha Gowda\',\\n    email: \'neha@campuspress.in\',\\n    role: \'Cashier\',\\n    status: \'active\',\\n    ordersHandled: 158,\\n  },\\n];\\n\\nexport const INITIAL_REVIEWS: ShopReview[] = [\\n  {\\n    id: \'rev-1\',\\n    shopId: \'shop-campus-press\',\\n    orderId: \'ord-prev-01\',\\n    customerId: \'user-88\',\\n    customerName: \'Sneha Reddy\',\\n    rating: 5,\\n    comment: \'Super fast spiral binding for my seminar report. Color charts came out razor sharp.\',\\n    shopResponse: \'Thank you Sneha! Best wishes for your seminar presentation.\',\\n    verifiedOrder: true,\\n    flagged: false,\\n    createdAt: \'2026-11-12T15:30:00Z\',\\n  },\\n  {\\n    id: \'rev-2\',\\n    shopId: \'shop-metro-print\',\\n    orderId: \'ord-prev-02\',\\n    customerId: \'user-92\',\\n    customerName: \'Karthik Iyer\',\\n    rating: 5,\\n    comment: \'Printed 20 portfolio booklets on matte 100gsm paper. Delivered ahead of schedule.\',\\n    verifiedOrder: true,\\n    flagged: false,\\n    createdAt: \'2026-11-14T11:20:00Z\',\\n  },\\n];\\n\\nexport const INITIAL_COUPONS: Coupon[] = [\\n  {\\n    code: \'STUDENT10\',\\n    description: \'10% off student printing orders over \342\202\27150\',\\n    discountType: \'percent\',\\n    value: 10,\\n    minOrderAmount: 50,\\n    maxDiscount: 100,\\n    active: true,\\n    expiresAt: \'2027-06-30T23:59:59Z\',\\n  },\\n  {\\n    code: \'FIRSTPRINT25\',\\n    description: \'Flat \342\202\27125 off your marketplace print order over \342\202\271100\',\\n    discountType: \'flat\',\\n    value: 25,\\n    minOrderAmount: 100,\\n    active: true,\\n    expiresAt: \'2027-03-31T23:59:59Z\',\\n  },\\n];\\n\\nexport const INITIAL_SHARE_TEMPLATES: ShareTemplate[] = [\\n  {\\n    id: \'tpl-default\',\\n    name: \'Standard Print Request\',\\n    body: \'Hello {{shopName}}, this is {{customerName}}. Please print the attached file(s): {{documents}}. Settings: {{settings}}. Copies: {{copies}}. Preferred pickup: {{pickupTime}}. Ref: {{orderNumber}}. Please confirm total price and completion time.\',\\n    isDefault: true,\\n  },\\n  {\\n    id: \'tpl-urgent\',\\n    name: \'Urgent College Pickup\',\\n    body: \'Hi {{shopName}}, urgent print request from {{customerName}} \342\200\224 {{documents}} ({{copies}} copies, {{settings}}). I will collect by {{pickupTime}}. Please keep ready.\',\\n    isDefault: false,\\n  },\\n];\\n\\nexport const INITIAL_NOTIFICATIONS: NotificationItem[] = [\\n  {\\n    id: \'notif-1\',\\n    portal: \'customer\',\\n    title: \'Price Confirmed for PR-2026-101\',\\n    body: \'Campus Press confirmed \342\202\271480.00 for your capstone report. Approve & pay to start printing.\',\\n    type: \'order\',\\n    read: false,\\n    createdAt: \'2026-11-19T08:22:00Z\',\\n  },\\n  {\\n    id: \'notif-2\',\\n    portal: \'customer\',\\n    title: \'Document Expiry Reminder\',\\n    body: \'Passport_Biometric_Page_Scan.pdf expires on 2026-12-14 (25 days remaining).\',\\n    type: \'expiry\',\\n    read: false,\\n    createdAt: \'2026-11-19T07:00:00Z\',\\n  },\\n  {\\n    id: \'notif-3\',\\n    portal: \'shop\',\\n    title: \'Low Inventory Alert\',\\n    body: \'Executive Bond A4 100gsm (4 reams) and Cyan Laser Toner (2 units) are below reorder threshold.\',\\n    type: \'inventory\',\\n    read: false,\\n    createdAt: \'2026-11-19T08:00:00Z\',\\n  },\\n  {\\n    id: \'notif-4\',\\n    portal: \'admin\',\\n    title: \'Shop Verification Pending\',\\n    body: \'QuickCopy Koramangala Express submitted business verification documents.\',\\n    type: \'security\',\\n    read: false,\\n    createdAt: \'2026-11-18T11:30:00Z\',\\n  },\\n];\\n\\nexport const INITIAL_SUPPORT_TICKETS: SupportTicket[] = [\\n  {\\n    id: \'tkt-501\',\\n    userId: \'user-77\',\\n    userName: \'Ananya Deshmukh\',\\n    subject: \'Color print mismatch on A3 poster order\',\\n    category: \'order_dispute\',\\n    status: \'investigating\',\\n    orderNumber: \'PR-2026-089\',\\n    createdAt: \'2026-11-18T15:10:00Z\',\\n  },\\n  {\\n    id: \'tkt-502\',\\n    userId: \'owner-quick-004\',\\n    userName: \'Siddharth Verma\',\\n    subject: \'Business GST verification review request\',\\n    category: \'technical\',\\n    status: \'open\',\\n    createdAt: \'2026-11-18T12:05:00Z\',\\n  },\\n];\\n\\nexport const INITIAL_AUDIT_LOGS: AuditLogEntry[] = [\\n  {\\n    id: \'aud-1\',\\n    actorName: \'Platform Admin\',\\n    actorEmail: \'cypt300@gmail.com\',\\n    action: \'SHOP_VERIFIED\',\\n    targetType: \'shop\',\\n    targetId: \'shop-metro-print\',\\n    details: \'Approved Metro Print Studio business license and GST records.\',\\n    createdAt: \'2026-11-15T10:12:00Z\',\\n  },\\n  {\\n    id: \'aud-2\',\\n    actorName: \'Platform Admin\',\\n    actorEmail: \'cypt300@gmail.com\',\\n    action: \'RETENTION_POLICY_UPDATED\',\\n    targetType: \'settings\',\\n    targetId: \'order-file-retention\',\\n    details: \'Set active order temporary shop file access expiration to 7 days post-completion.\',\\n    createdAt: \'2026-11-12T16:40:00Z\',\\n  },\\n];\\n\", \"Description\":\"Create comprehensive realistic seed data for Demo Workspace mode across Customer, Shop, and Admin portals\", \"Overwrite\":true, \"TargetFile\":\"/src/data/seedData.ts\", \"toolAction\":\"Creating PrintReady demo seed dataset\", \"toolSummary\":\"Create src/data/seedData.ts\"}"
