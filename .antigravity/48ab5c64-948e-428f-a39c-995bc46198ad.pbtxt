e.getByText(/Status: Paid/i).isVisible().catch(() => false);\n\n  // Shop advances order through full lifecycle to Completed\n  await page.getByRole(\'tab\', { name: /^Shop$/i }).click();\n  await page.waitForTimeout(250);\n  await page.getByRole(\'button\', { name: /Orders & Queue/i }).first().click();\n  await page.waitForTimeout(300);\n  const stages = [];\n  for (const label of [/Start Printing/i, /Quality Check/i, /Ready for Pickup/i, /Mark Completed|Complete Order/i]) {\n    const btn = page.getByRole(\'button\', { name: label }).first();\n    if (await btn.isVisible().catch(() => false)) {\n      stages.push((await btn.innerText()).trim());\n      await btn.click();\n      await page.waitForTimeout(250);\n    }\n  }\n\n  await page.getByRole(\'button\', { name: /Shop Dashboard/i }).first().click();\n  await page.waitForTimeout(450);\n  await page.screenshot({ path: \'.playwright-cli/r2-verify-revenue.png\', fullPage: false });\n  const revText = await page.locator(\'main\').innerText();\n\n  console.log(JSON.stringify({\n    invalidToastVisible,\n    paidStatusVisible,\n    stages,\n    revenue178: revText.includes(\'178.50\'),\n    completedCount2: revText.includes(\'Completed Orders\\n2\'),\n    consoleErrors,\n    failedRequests\n  }, null, 2));\n}\"\n"
