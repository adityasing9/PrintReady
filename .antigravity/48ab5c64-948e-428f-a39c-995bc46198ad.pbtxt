      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Fix Document Vault table column widths so all 5 action buttons fit cleanly with zero horizontal clipping\", \"EndLine\":758, \"Instruction\":\"Use table-fixed with balanced column widths so Actions never clip on desktop viewports\", \"ReplacementContent\":\"          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full min-w-[680px] table-fixed text-left border-collapse\\\">\\n                <thead>\\n                  <tr className=\\\"border-b border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400\\\">\\n                    <th className=\\\"py-3 px-4 font-medium w-[40%]\\\">Document</th>\\n                    <th className=\\\"py-3 px-2.5 font-medium w-[21%]\\\">Category / Folder</th>\\n                    <th className=\\\"py-3 px-2 font-medium text-right w-[7%]\\\">Pages</th>\\n                    <th className=\\\"py-3 px-2.5 font-medium text-right w-[11%]\\\">Size</th>\\n                    <th className=\\\"py-3 px-3 font-medium text-right w-[21%]\\\">Actions</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-sm\\\">\\n                  {visibleDocs.length === 0 ? (\\n                    <tr>\\n                      <td colSpan={5} className=\\\"py-10 text-center text-slate-500 dark:text-slate-400 text-sm\\\">\\n                        {scope === \'trash\'\\n                          ? \'Trash is empty.\'\\n                          : \'No documents in this view yet. Upload a file above to get started.\'}\\n                      </td>\\n                    </tr>\\n                  ) : (\\n                    visibleDocs.map((doc) => {\\n                      const folderName = folders.find((f) => f.id === doc.folderId)?.name || \'Unfiled\';\\n                      const isRenaming = renamingId === doc.id;\\n                      return (\\n                        <tr\\n                          key={doc.id}\\n                          className=\\\"hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors\\\"\\n                        >\\n                          <td className=\\\"py-3 px-4\\\">\\n                            <div className=\\\"flex items-start gap-2.5 min-w-0\\\">\\n                              <FileText className=\\\"w-4 h-4 text-indigo-600 dark:text-indigo-400 mt-0.5 shrink-0\\\" />\\n                              <div className=\\\"min-w-0 flex-1\\\">\\n                                {isRenaming ? (\\n                                  <form\\n                                    onSubmit={(e) => {\\n                                      e.preventDefault();\\n                                      if (renameText.trim()) {\\n                                        updateDocument(doc.id, { name: renameText.trim(), version: doc.version + 1 });\\n                                        setRenamingId(null);\\n                                      }\\n                                    }}\\n                                    className=\\\"flex items-center gap-1.5\\\"\\n                                  >\\n                                    <input\\n                                      type=\\\"text\\\"\\n                                      value={renameText}\\n                                      onChange={(e) => setRenameText(e.target.value)}\\n                                      aria-label=\\\"New document name\\\"\\n                                      className=\\\"flex-1 min-w-0 px-2 py-1 text-xs border border-indigo-500 rounded bg-white dark:bg-slate-950\\\"\\n                                      autoFocus\\n                                    />\\n                                    <button type=\\\"submit\\\" className=\\\"text-xs font-medium text-indigo-700\\\">\\n                                      Save\\n                                    </button>\\n                                  </form>\\n                                ) : (\\n                                  <button\\n                                    type=\\\"button\\\"\\n                                    onClick={() => {\\n                                      setSelectedDoc(doc);\\n                                      setAiSuggestion(null);\\n                                    }}\\n                                    className=\\\"font-medium text-slate-900 dark:text-white hover:text-indigo-700 dark:hover:text-indigo-300 truncate block text-left w-full\\\"\\n                                  >\\n                                    {doc.name}\\n                                  </button>\\n                                )}\\n                                <p className=\\\"text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5\\\">\\n                                  {doc.extension.toUpperCase()} \302\267 v{doc.version}\\n                                  {doc.tags.length > 0 ? ` \302\267 ${doc.tags.join(\', \')}` : \'\'}\\n                                  {doc.expiryDate ? ` \302\267 Expires ${doc.expiryDate}` : \'\'}\\n                                </p>\\n                              </div>\\n                            </div>\\n                          </td>\\n                          <td className=\\\"py-3 px-2.5 text-xs text-slate-600 dark:text-slate-300 truncate\\\" title={`${doc.category} / ${folderName}`}>\\n                            {doc.category} / {folderName}\\n                          </td>\\n                          <td className=\\\"py-3 px-2 text-xs font-mono tabular-nums text-right text-slate-700 dark:text-slate-300\\\">\\n                            {doc.pageCount}\\n                          </td>\\n                          <td className=\\\"py-3 px-2.5 text-xs font-mono tabular-nums text-right text-slate-600 dark:text-slate-400 whitespace-nowrap\\\">\\n                            {formatFileSize(doc.sizeBytes)}\\n                          </td>\\n                          <td className=\\\"py-3 px-3\\\">\\n                            <div className=\\\"flex items-center justify-end gap-0.5\\\">\", \"StartLine\":667, \"TargetContent\":\"          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full text-left border-collapse\\\">\\n                <thead>\\n                  <tr className=\\\"border-b border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400\\\">\\n                    <th className=\\\"py-3 px-4 font-medium\\\">Document</th>\\n                    <th className=\\\"py-3 px-3 font-medium\\\">Category / Folder</th>\\n                    <th className=\\\"py-3 px-3 font-medium text-right\\\">Pages</th>\\n                    <th className=\\\"py-3 px-3 font-medium text-right\\\">Size</th>\\n                    <th className=\\\"py-3 px-4 font-medium text-right\\\">Actions</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-slate-100 dark:divide-slate-800 text-sm\\\">\\n                  {visibleDocs.length === 0 ? (\\n                    <tr>\\n                      <td colSpan={5} className=\\\"py-10 text-center text-slate-500 dark:text-slate-400 text-sm\\\">\\n                        {scope === \'trash\'\\n                          ? \'Trash is empty.\'\\n                          : \'No documents in this view yet. Upload a file above to get started.\'}\\n                      </td>\\n                    </tr>\\n                  ) : (\\n                    visibleDocs.map((doc) => {\\n                      const folderName = folders.find((f) => f.id === doc.folderId)?.name ||