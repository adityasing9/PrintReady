            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    itemId: item.id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
