      arguments_json: "{\"Description\":\"Add direct WhatsApp & Email redirect buttons to ShopDiscoveryView cards and profile drawer\", \"Instruction\":\"Add direct WhatsApp and Email links on Discover shop cards and Shop Profile drawer in ShopDiscoveryView.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":378, \"ReplacementContent\":\"                    <div className=\\\"flex items-center gap-1.5 pt-2 border-t border-slate-100 dark:border-slate-800\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setSelectedShop(shop)}\\n                        className=\\\"flex-1 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors\\\"\\n                      >\\n                        Profile & Rates\\n                      </button>\\n                      {shop.whatsapp && (\\n                        <a\\n                          href={buildWhatsAppUrl(shop.whatsapp, `Hello ${shop.name}, I have documents to print via PrintReady.`)}\\n                          target=\\\"_blank\\\"\\n                          rel=\\\"noopener noreferrer\\\"\\n                          aria-label={`WhatsApp ${shop.name}`}\\n                          title=\\\"Send on WhatsApp\\\"\\n                          className=\\\"p-2 text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 rounded-lg transition-colors\\\"\\n                        >\\n                          <MessageCircle className=\\\"w-4 h-4\\\" />\\n                        </a>\\n                      )}\\n                      {shop.email && (\\n                        <a\\n                          href={buildMailtoUrl(shop.email, \'Print Request via PrintReady\', `Hello ${shop.name},\\\\n\\\\nI have documents to print.`)}\\n                          aria-label={`Email ${shop.name}`}\\n                          title=\\\"Send via Email\\\"\\n                          className=\\\"p-2 text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/50 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 rounded-lg transition-colors\\\"\\n                        >\\n                          <Mail className=\\\"w-4 h-4\\\" />\\n                        </a>\\n                      )}\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          addSavedShop({\\n                            shopName: shop.name,\\n                            registeredShopId: shop.id,\\n                            ownerName: shop.ownerName,\\n                            phone: shop.phone,\\n                            whatsapp: shop.whatsapp,\\n                            email: shop.email,\\n                            address: shop.address,\\n                            openingHours: shop.openingHours,\\n                            group: \'Trusted\',\\n                            preferredContact: \'whatsapp\',\\n                            notes: `Saved from discovery (${shop.distanceKm} km).`,\\n                            isFavourite: false,\\n                            isDefault: false,\\n                          })\\n                        }\\n                        aria-label={`Save ${shop.name}`}\\n                        className=\\\"p-2 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg\\\"\\n                      >\\n                        <Bookmark className=\\\"w-4 h-4\\\" />\\n                      </button>\\n                    </div>\", \"StartLine\":345, \"TargetContent\":\"                    <div className=\\\"flex items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-800\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setSelectedShop(shop)}\\n                        className=\\\"flex-1 py-2 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg transition-colors\\\"\\n                      >\\n                        View Profile & Pricing\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          addSavedShop({\\n                            shopName: shop.name,\\n                            registeredShopId: shop.id,\\n                            ownerName: shop.ownerName,\\n                            phone: shop.phone,\\n                            whatsapp: shop.whatsapp,\\n                            email: shop.email,\\n                            address: shop.address,\\n                            openingHours: shop.openingHours,\\n                            group: \'Trusted\',\\n                            preferredContact: \'marketplace\',\\n                            notes: `Saved from discovery (${shop.distanceKm} km).`,\\n                            isFavourite: false,\\n                            isDefault: false,\\n                          })\\n                        }\\n                        aria-label={`Save ${shop.name}`}\\n                        className=\\\"p-2 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg\\\"\\n                      >\\n                        <Bookmark className=\\\"w-4 h-4\\\" />\\n                      </button>\\n                    </div>\"}, {\"AllowMultiple\":false, \"EndLine\":670, \"ReplacementContent\":\"            <div className=\\\"flex flex-wrap gap-2 pt-2\\\">\\n              <a\\n                href={buildWhatsAppUrl(selectedShop.whatsapp, `Hello ${selectedShop.name}, I have documents to print via PrintReady.`)}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-medium text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg\\\"\\n              >\\n                <MessageCircle className=\\\"w-3.5 h-3.5\\\" />\\n                WhatsApp Shop\\n              </a>\\n              <a\\n                href={buildMailtoUrl(selectedShop.email, \'Print Request via PrintReady\', `Hello ${selectedShop.name},\\\\n\\\\nI have documents to print.`)}\\n                className=\\\"flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n              >\\n                <Mail className=\\\"w-3.5 h-3.5\\\" />\\n                Email Shop\\n              </a>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setSelectedShop(null);\\n                  setActiveTab(\'basket\');\\n                }}\\n                className=\\\"inline-flex items-center justify-center gap-1.5 px-3 py-2.5 text-xs font-medium text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg\\\"\\n              >\\n                <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                Print Basket\\n              </button>\\n              <a\\n                href={`tel:${selectedShop.phone}`}\\n                className=\\\"inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-medium border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              >\\n                <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                Call\\n              </a>\\n            </div>\", \"StartLine\":641, \"TargetContent\":\"            <div className=\\\"flex flex-wrap gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setSelectedShop(null);\\n                  setActiveTab(\'basket\');\\n                }}\\n                className=\\\"flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-medium text-white bg-indigo-700 hover:bg-indigo-800 rounded-lg\\\"\\n              >\\n                <CheckCircle2 className=\\\"w-4 h-4\\\" />\\n                Order from {selectedShop.name}\\n              </button>\\n              <a\\n                href={`tel:${selectedShop.phone}`}\\n                className=\\\"inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-medium border border-slate-200 dark:border-slate-700 rounded-lg\\\"\\n              >\\n                <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                Call\\n              </a>\\n              <a\\n                href={buildWhatsAppUrl(selectedShop.whatsapp, `Hello ${selectedShop.name}, checking print availability via PrintReady.`)}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-medium text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900 rounded-lg\\\"\\n              >\\n                <MessageCircle className=\\\"w-3.5 h-3.5\\\" />\\n                WhatsApp\\n              </a>\\n            </div>\"}], \"TargetFile\":\"/src/components/customer/ShopDiscoveryView.tsx\", \"toolAction\":\"Adding WhatsApp & Email redirect buttons to ShopDiscoveryView\", \"toolSummary\":\"Update ShopDiscoveryView share buttons\"}"
