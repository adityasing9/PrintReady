              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      pageSet.add(page);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (/^\\d+\\s*-\\s*\\d+$/.test(token)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const [startStr, endStr] = token.split(\'-\').map((s) => s.trim());"
