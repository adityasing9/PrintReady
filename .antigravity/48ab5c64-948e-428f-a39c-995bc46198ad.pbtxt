502 errors!  await page.getByRole(\'tab\', { name: /^Customer$/i }).click();  await page.waitForTimeout(300);  await page.getByRole(\'button\', { name: /Scanner & PDF Tools/i }).first().click();  await page.waitForTimeout(350);  await page.getByRole(\'button\', { name: /Add Sample Scan/i }).first().click();  await page.waitForTimeout(300);  await page.getByRole(\'button\', { name: /Save PDF to Vault/i }).first().click();  await page.waitForTimeout(900);  console.log(JSON.stringify({    vaultTableScrollDiff,    advancedStages,    revenueUpdatedTo178: dashboardText.includes(\'178.50\'),    apiStatuses,    consoleErrors,    pageErrors,    failedRequests  }, null, 2));})(page);```\n\n### Latest snapshot (.playwright-cli/page-2026-11-19T09-59-58-203Z.yml)\n```yaml\n- generic [ref=e3]:\n  - complementary [ref=e4]:\n    - generic [ref=e5]:\n      - button [ref=e7]\n      - generic [ref=e13]:\n        - paragraph [ref=e14]: Workspace\n        - tablist \"Portal workspace\" [ref=e15]:\n          - tab \"Customer\" [selected] [ref=e16]\n          - tab \"Shop\" [ref=e17]\n          - tab \"Admin\" [ref=e18]\n      - navigation \"Customer Portal navigation\" [ref=e19]:\n        - button \"Home\" [ref=e20]\n        - button \"Document Vault\" [ref=e26]\n        - button \"Scanner & PDF Tools\" [ref=e32]\n        - button \"Print Basket 1\" [ref=e40]:\n          - generic [ref=e41]: Print Basket\n          - generic [ref=e46]: \"1\"\n        - button \"Print Shops\" [ref=e47]\n        - button \"Orders & Chat 1\" [ref=e54]:\n          - generic [ref=e55]: Orders & Chat\n          - generic [ref=e61]: \"1\"\n        - button \"Account & Security\" [ref=e62]\n      - generic [ref=e68]:\n        - generic [ref=e69]:\n          - generic [ref=e70]:\n            - paragraph [ref=e71]: Aarav Mehta\n            - paragraph [ref=e72]: Demo Workspace \302\267 Pro\n          - button \"Switch to dark mode\" [ref=e73]\n        - button \"Sign In with Google\" [ref=e76]\n  - generic [ref=e8