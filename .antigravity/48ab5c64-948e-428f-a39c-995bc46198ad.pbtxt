      thinking_signature: "\022\327\033\n\324\033\001i\024}\023\314\273|@I\207T*\021\216rq\343\244\n|\216\255s@\370\325iZ\r\211b\bJ#\321\232#\222o\266\020\320\357ggDJ\374\001\372zw2\021\220\021e\003`\275im\fH},\332J-.\202\nN1d\245\346\020$\234\335\346\206Dm6\203\304\031\323\217y\225\316\003C\345\341\270\341\244Qu\372\260%\252\261\273\364\321\206*\2121\204C\003\350Jl\223\325\371\247X%\215bDP\260l\030O\334\320{\'\t<\234\211\233F\276\023\334U4W\363i\201\231\252nF\273\024?\255\373EK\034\367\265Yv\241\213j\220\020\254(f\205;>\006\210\370T\031\250\315$\266\032j\273\234\262C \352t\027\307\372*t8\266\272p\336\026{\004\351\222\211Qph\356\247\030n\241\\\337\vT{\265t\361\006\327\021\265\332\017O>\235\006S\262,\264|\025^s\027\3151\326k`\214b\235\031J\212a7\301\347.t\361<.\355\326\306\234\303b7=\365\221\rs\343[\033EK$\002\302\320\303B\026\375\246\251X\203\334O\2466\234]\177[\206o\224\374\235~\265\330\345\200F\002c\177\rM\322\364\313\274\346\340Lv\366\307:k\316\246\372\265\322\277\335Kc\177\336\366\374Tl\234\341\377\203\017\356M}\v\331sW\334\241\222\222\260\267=\342\001F6\317\320\271#hj\236,\025\227\020_\223e.\001\234m\020)x\2563\026\271N\214\303\220{\305\033\356\243\371RPN\'\022\264X\000\251\300\275\365\274l\342\223P\2278eT\316\266>\033\310\373?F.\034\211\344\275z\331\263%\t\034l\"d\245\034\032\261\263\016\342\345E\361u\327\017\002\234\277a\f\027\313\323\'\302+\355=L\236\340\000t\030\364\260\314C\347\336>\nC\314\344uD\255\361g\373\315n%\307-\"k\026\2266\033\234r\b\002t\031x\257\242\256c\233\3051\273kT\345\357\256\033Xs\222m\252Q\222*\032e7:\207\324\375\036\027\216}\256\336!\314\364\235&\373i\217\277\212\217]z\346H\217\306\351\"\bt\223\347*c\314\350Un$\317\223j\224B\267\352&\bj/\310\327\337/\353B\300\024\225\023-\022\214\371\215\232\203\253\327;.\315\317\020\320\263\244\213\336\3516\266xr\270T\360\326\321Y\314\247\b\220;\216\305\274Q\326\313\300\004\005)\312`\300W\035\020\355>ly\254\205\322\033Vr\275\247\362{2^\311L\006\276\020\222R\310\313\207\244Z\271\231\330\211\271\300\232\37