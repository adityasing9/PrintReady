            lines {
              text: "  const ctx = canvas.getContext(\'2d\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!ctx) throw new Error(\'Canvas 2D context unavailable.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const filters: string[] = ["
